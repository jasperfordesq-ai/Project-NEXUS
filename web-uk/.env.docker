# =============================================================================
# Docker environment for the Web UK accessible frontend.
# =============================================================================
# Tracked, non-secret LOCAL DEVELOPMENT defaults. web-uk/compose.yml lists this
# file under `env_file:` for both services, so they will not start without it.
#
# The two secrets below are placeholders whose only job is to satisfy the
# minimum-length checks in local development. They are public, they are shared
# by every checkout, and they must never be used anywhere real. For a deployed
# environment, supply COOKIE_SECRET and SESSION_SECRET through an untracked
# .env or the platform's own secret store.
# =============================================================================
PORT=3001
ACCESSIBLE_BACKEND_TARGET=laravel
LARAVEL_BASE_URL=http://host.docker.internal:8090
# Browser-reachable origin for backend assets (tenant logos, uploads).
# host.docker.internal above resolves INSIDE the container only, so the
# browser needs the host-published origin or every logo 404s.
PUBLIC_ASSET_BASE_URL=http://127.0.0.1:8090
COOKIE_SECRET=docker-dev-cookie-secret-minimum-32-characters
SESSION_SECRET=docker-dev-session-secret-minimum-32-chars
NODE_ENV=development
TENANT_ID=1
ACCESSIBLE_TENANT_SLUG=hour-timebank

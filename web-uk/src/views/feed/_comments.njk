{# `returnTo` (optional): an event or opportunity page the actions return to
   instead of the feed (feed-actions.js socialReturnPath allowlists it). #}
{% from "feed/_reactions.njk" import COMMENT_REACTIONS, reactionForms %}

{# `translate` (optional): { postId, translation } on the single-post page — every
   comment and reply gets a Translate button (React CommentsSection, AWID feedback
   30 Oct 2026), and `translation` ({ commentId, text, locale }) is shown once under
   the comment it belongs to. #}
{% macro commentList(comments, depth, item, requiresAuth, currentUserId, csrfToken, urlFor, t, returnTo, translate) %}
  <ol class="govuk-list nexus-alpha-comments-list{% if depth > 0 %} nexus-alpha-comments-list--nested{% endif %}">
    {% for comment in comments %}
      {% set commentAuthorId = comment.author.id or comment.author_id or comment.user_id %}
      {% set authorName = comment.author.name or comment.author_name or t("feed.unknown_author") %}
      {% set ownComment = currentUserId and commentAuthorId == currentUserId and comment.id %}
      <li class="nexus-alpha-comment"{% if comment.id %} id="comment-{{ comment.id }}"{% endif %}>
        <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">
          {% if comment.author.avatarAssetUrl %}<img class="nexus-alpha-avatar nexus-alpha-avatar--small" src="{{ comment.author.avatarAssetUrl | thumb(64, 64) }}" alt="" loading="lazy" decoding="async" width="32" height="32">{% endif %}
          <strong>{{ authorName }}</strong>
          {% if comment.created_at %}<span aria-hidden="true"> | </span><span class="govuk-visually-hidden">{{ t("feed.comment_posted_on_prefix") }}</span><time datetime="{{ comment.created_at }}">{{ comment.created_at | formatDate }}</time>{% endif %}
        </p>
        <p class="govuk-body govuk-!-margin-bottom-2" dir="auto">{{ comment.content or comment.body }}</p>

        {% if translate and comment.id %}
          {% set displayedTranslation = comment.cachedTranslation %}
          {% if translate.translation and translate.translation.commentId == comment.id %}{% set displayedTranslation = translate.translation %}{% endif %}
          {% if displayedTranslation %}
            <div class="govuk-inset-text govuk-!-margin-top-0">
              <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ t("govuk_alpha_feed.translate.heading") }}</h3>
              <p class="govuk-hint govuk-!-margin-bottom-2">{{ t("govuk_alpha_feed.translate.original_above_hint") }}</p>
              <p class="govuk-body govuk-!-margin-bottom-0" lang="{{ displayedTranslation.locale }}">{{ displayedTranslation.text }}</p>
              <a class="govuk-link" href="{{ urlFor(returnTo + '?translation=original') }}">{{ t('ugc_translation.show_original') }}</a>
            </div>
          {% elif not requiresAuth and (comment.content or comment.body) %}
            <form method="post" action="{{ urlFor('/feed/comments/' + (comment.id | string) + '/translate') }}" class="govuk-!-margin-bottom-2" novalidate>
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              {% if translate.postId %}<input type="hidden" name="post_id" value="{{ translate.postId }}">{% else %}<input type="hidden" name="item_type" value="{{ translate.itemType }}"><input type="hidden" name="item_id" value="{{ translate.itemId }}"><input type="hidden" name="return_to" value="{{ translate.returnTo }}">{% endif %}
              <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("govuk_alpha_feed.translate.comment_button") }}<span class="govuk-visually-hidden"> {{ t("govuk_alpha_feed.translate.comment_by", { name: authorName }) }}</span></button>
            </form>
          {% endif %}
        {% endif %}

        {% if not requiresAuth and comment.id %}
          {# The six comment reactions React offers (useSocialInteractions AVAILABLE_REACTIONS). #}
          <div class="govuk-!-margin-bottom-2">
            {{ reactionForms(COMMENT_REACTIONS, urlFor('/feed/comments/' + (comment.id | string) + '/react'), csrfToken, t, comment.user_reactions or [], comment.reactions, { return_to: returnTo }, '', 'govuk_alpha_feed.reactions.comment_legend') }}
          </div>
        {% endif %}

        {% if not requiresAuth and comment.id and (depth < 4 or ownComment) %}
          <div class="nexus-alpha-comment-actions govuk-!-margin-bottom-2">
            {% if depth < 4 %}
              <details class="govuk-details govuk-!-margin-bottom-0" data-module="govuk-details">
                <summary class="govuk-details__summary"><span class="govuk-details__summary-text">{{ t("actions.reply") }}</span></summary>
                <div class="govuk-details__text">
                  <form method="post" action="{{ urlFor('/feed/items/' + item.type + '/' + (item.id | string) + '/comments') }}" novalidate>
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">{% if returnTo %}<input type="hidden" name="return_to" value="{{ returnTo }}">{% endif %}<input type="hidden" name="parent_id" value="{{ comment.id }}">
                    <div class="govuk-form-group"><label class="govuk-label" for="reply-{{ comment.id }}">{{ t("feed.reply_label") }}</label><textarea class="govuk-textarea" id="reply-{{ comment.id }}" name="content" rows="3"></textarea></div>
                    <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("actions.reply") }}</button>
                  </form>
                </div>
              </details>
            {% endif %}
            {% if ownComment %}
              <details class="govuk-details govuk-!-margin-bottom-0" data-module="govuk-details"><summary class="govuk-details__summary"><span class="govuk-details__summary-text">{{ t("feed.edit_comment") }}</span></summary><div class="govuk-details__text"><form method="post" action="{{ urlFor('/feed/comments/' + (comment.id | string) + '/update') }}" novalidate><input type="hidden" name="_csrf" value="{{ csrfToken }}">{% if returnTo %}<input type="hidden" name="return_to" value="{{ returnTo }}">{% endif %}<div class="govuk-form-group"><label class="govuk-label" for="edit-comment-{{ comment.id }}">{{ t("feed.edit_comment_label") }}</label><textarea class="govuk-textarea" id="edit-comment-{{ comment.id }}" name="content" rows="3">{{ comment.content or comment.body }}</textarea></div><button class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("actions.save_changes") }}</button></form></div></details>
              <details class="govuk-details govuk-!-margin-bottom-0" data-module="govuk-details"><summary class="govuk-details__summary"><span class="govuk-details__summary-text">{{ t("feed.delete_comment") }}</span></summary><div class="govuk-details__text"><p class="govuk-body">{{ t("feed.delete_comment_confirm") }}</p><form method="post" action="{{ urlFor('/feed/comments/' + (comment.id | string) + '/delete') }}" novalidate><input type="hidden" name="_csrf" value="{{ csrfToken }}">{% if returnTo %}<input type="hidden" name="return_to" value="{{ returnTo }}">{% endif %}<button class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("feed.delete_comment_button") }}</button></form></div></details>
            {% endif %}
          </div>
        {% endif %}

        {% if comment.replies and comment.replies.length %}{{ commentList(comment.replies, depth + 1, item, requiresAuth, currentUserId, csrfToken, urlFor, t, returnTo, translate) }}{% endif %}
      </li>
    {% endfor %}
  </ol>
{% endmacro %}

{% extends "layouts/base.njk" %}
{% from "feed/_comments.njk" import commentList %}
{% from "feed/_reactions.njk" import POST_REACTIONS, reactionForms %}
{% from "feed/_item-menu.njk" import itemMenu, translateForm, quoteShare %}

{% block beforeContent %}
  <a href="{{ urlFor('/feed') }}" class="govuk-back-link">{{ t("feed_t1.permalink_back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if statusMessage and statusMessage.type == "error" %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1"><div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list"><li><a href="#feed-item-post-{{ item.id }}">{{ statusMessage.text }}</a></li></ul>
          </div>
        </div></div>
      {% endif %}

      <span class="govuk-caption-xl">{{ t("feed.caption", { community: communityName }) }}</span>
      <h1 class="govuk-heading-xl">{{ t("feed_t1.permalink_heading") }}</h1>

      {% if statusMessage and statusMessage.type != "error" %}
        <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="permalink-status-title">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="permalink-status-title">{{ t("states.success_title") }}</h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">{{ statusMessage.text }}</p>
          </div>
        </div>
      {% endif %}

      {% if requiresAuth %}
        <div class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="permalink-auth-title">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="permalink-auth-title">{{ t("states.error_title") }}</h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">{{ t("states.auth_required") }}</p>
            <div class="govuk-button-group">
              <a class="govuk-button" href="{{ urlFor('/login') }}" role="button" draggable="false" data-module="govuk-button">{{ t("auth.login_action") }}</a>
            </div>
          </div>
        </div>
      {% endif %}

      {% if itemUnavailable %}
        <div class="govuk-inset-text">
          <h2 class="govuk-heading-m">{{ t("states.not_available") }}</h2>
          <p class="govuk-body">{{ t("feed_t1.permalink_not_available") }}</p>
        </div>
      {% else %}
      <article class="nexus-alpha-card" id="feed-item-post-{{ item.id }}">
        <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-2">
          {% if item.authorAvatar %}
            <img class="nexus-alpha-avatar nexus-alpha-avatar--small" src="{{ item.authorAvatar | thumb(64, 64) }}" alt="" loading="lazy" decoding="async" width="32" height="32">
          {% endif %}
          {{ t("feed.posted_by", { name: item.authorName }) }}
          {% if item.createdAt %}
            <span aria-hidden="true"> | </span>
            <span class="govuk-visually-hidden">{{ t("feed.posted_on_prefix") }}</span>
            <time datetime="{{ item.createdAt }}">{{ item.createdAt | formatDate }}</time>
          {% endif %}
        </p>

        {% for paragraph in item.contentParagraphs %}
          <p class="govuk-body">{{ paragraph }}</p>
        {% endfor %}

        {% if translation %}
          <div class="govuk-inset-text" id="post-translation">
            <h2 class="govuk-heading-s govuk-!-margin-bottom-1">{{ t("govuk_alpha_feed.translate.heading") }}</h2>
            <p class="govuk-hint govuk-!-margin-bottom-2">{{ t("govuk_alpha_feed.translate.hint") }}</p>
            <p class="govuk-body govuk-!-margin-bottom-0" lang="{{ translation.locale }}">{{ translation.text }}</p>
          </div>
        {% endif %}

        {% if item.media and item.media.length %}
          <ul class="nexus-alpha-feed-media" data-count="{{ item.media.length }}">
            {% for media in item.media %}
              <li>
                <a href="{{ media.fileUrl }}" target="_blank" rel="noopener noreferrer">
                  <span class="govuk-visually-hidden"> {{ t("opens_new_tab") }}</span>
                  <img src="{{ media.thumbnailUrl | thumb(640, 640) }}" width="320" height="320" alt="{{ media.altText or t('govuk_alpha_feed.item.image_alt') }}" class="nexus-alpha-feed-image" loading="lazy">
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        <p class="govuk-body-s nexus-alpha-meta">
          {{ tc("govuk_alpha_feed.engagement.likes", item.likeCount, { count: item.likeCount }) }} &middot; {{ tc("govuk_alpha_feed.engagement.comments", item.commentCount, { count: item.commentCount }) }}
        </p>

        {% if not requiresAuth %}
          {% if not translation %}{{ translateForm(item, csrfToken, urlFor, t) }}{% endif %}

          <div class="nexus-alpha-actions govuk-!-margin-bottom-3">
            <form method="post" action="{{ urlFor('/feed/items/post/' + (item.id | string) + '/like') }}">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="return_to" value="{{ returnTo }}">
              <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">
                {{ t("govuk_alpha_feed.engagement.unlike") if item.isLiked else t("govuk_alpha_feed.engagement.like") }}
              </button>
            </form>
          </div>

          <div class="nexus-alpha-reactions govuk-!-margin-bottom-3">
            {{ reactionForms(POST_REACTIONS, urlFor('/feed/posts/' + (item.id | string) + '/react'), csrfToken, t, item.userReaction, item.reactionCounts, { return_to: returnTo }) }}
          </div>

          {# Who reacted (React ReactionSummary): one list per reaction in use. #}
          {% set reactorLinks = [] %}
          {% for reaction in POST_REACTIONS %}
            {% if item.reactionCounts[reaction.type] %}{% set _ = reactorLinks.push(reaction) %}{% endif %}
          {% endfor %}
          {% if reactorLinks.length %}
            <ul class="govuk-list govuk-!-margin-bottom-3">
              {% for reaction in reactorLinks %}
                <li><a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor('/feed/posts/' + (item.id | string) + '/reactions/' + reaction.type) }}">{{ t("govuk_alpha_feed.reactions.see_who", { reaction: t("govuk_alpha_feed.reactions." + reaction.type), count: item.reactionCounts[reaction.type] }) }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}

          <div class="govuk-button-group govuk-!-margin-bottom-3">
            {% if not isOwn %}
              <form method="post" action="{{ urlFor('/feed/posts/' + (item.id | string) + '/share') }}">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="return_to" value="{{ returnTo }}">
                <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("feed_t1.unshare_button") if item.isShared else t("feed_t1.share_button") }}</button>
              </form>
            {% endif %}
            <form method="post" action="{{ urlFor('/feed/posts/' + (item.id | string) + '/save') }}">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="return_to" value="{{ returnTo }}">
              <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("feed_t1.unsave_button") if item.isBookmarked else t("feed_t1.save_button") }}</button>
            </form>
          </div>
          {% if not isOwn and not item.isShared %}{{ quoteShare(item, csrfToken, urlFor, t, { return_to: returnTo }) }}{% endif %}

          {% if isOwn %}
            <p class="govuk-body govuk-!-margin-bottom-3"><a class="govuk-link" href="{{ urlFor('/feed/posts/' + (item.id | string) + '/stats') }}">{{ t("govuk_alpha_feed.stats.link") }}</a></p>
          {% endif %}

          {{ itemMenu(item, currentUserId, csrfToken, urlFor, t, returnTo) }}
        {% endif %}

        <h2 class="govuk-heading-m govuk-!-margin-top-4">{{ t("feed.comments_summary") }}</h2>
        {% if comments and comments.length %}
          {{ commentList(comments, 0, item, requiresAuth, currentUserId, csrfToken, urlFor, t, returnTo) }}
        {% else %}
          <p class="govuk-body">{{ t("feed.no_comments") }}</p>
        {% endif %}

        {% if not requiresAuth %}
          <form method="post" action="{{ urlFor('/feed/items/post/' + (item.id | string) + '/comments') }}">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="return_to" value="{{ returnTo }}">
            <div class="govuk-form-group">
              <label class="govuk-label" for="permalink-comment-{{ item.id }}">{{ t("blog.comment_body_label") }}</label>
              <div id="permalink-comment-{{ item.id }}-hint" class="govuk-hint">{{ t("feed.comment_hint") }}</div>
              <textarea class="govuk-textarea" id="permalink-comment-{{ item.id }}" name="content" rows="3" aria-describedby="permalink-comment-{{ item.id }}-hint"></textarea>
            </div>
            <button class="govuk-button" data-module="govuk-button">{{ t("actions.comment") }}</button>
          </form>
        {% endif %}
      </article>
      {% endif %}
    </div>
  </div>
{% endblock %}

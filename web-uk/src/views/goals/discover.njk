{% extends "layouts/base.njk" %}
{% from "_load-more.njk" import loadMoreNext %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/goals') }}">{{ t("goals.back_to_goals") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {% if successMessage %}
        {{ govukNotificationBanner({
          type: "success",
          titleText: t("states.success_title"),
          text: successMessage
        }) }}
      {% endif %}

      {# A "become a buddy" failure is transient: no field was answered wrongly,
         so the summary carries no field link and does not steal focus on load. #}
      {% if errorMessage %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" data-disable-auto-focus="true" tabindex="-1">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
            <div class="govuk-error-summary__body"><p class="govuk-body">{{ errorMessage }}</p></div>
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-xl">{{ t("goals.caption", { community: tenantName }) }}</span>
      <h1 class="govuk-heading-xl" id="discover-goals">{{ t("polish_gamify.goals_discover_title") }}</h1>
      <p class="govuk-body-l">{{ t("polish_gamify.goals_discover_description") }}</p>

      {% if not goals or not goals.length %}
        <div class="govuk-inset-text">
          <p class="govuk-body">{{ t("polish_gamify.goals_discover_empty") }}</p>
        </div>
      {% else %}
        <div class="nexus-alpha-card-list">
          {% for goal in goals %}
            <article class="nexus-alpha-card">
              <h2 class="govuk-heading-s govuk-!-margin-bottom-1">
                <a class="govuk-link" href="{{ urlFor('/goals/' + (goal.id | string)) }}">{{ goal.title }}</a>
              </h2>
              <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">{{ t("goals.owned_by", { name: goal.ownerName }) }}</p>

              {% if goal.description %}
                <p class="govuk-body-s govuk-!-margin-bottom-1">{{ goal.description }}</p>
              {% endif %}

              <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">{{ t("goals.progress_label", { current: goal.currentText, target: goal.targetText }) }}</p>
              <progress max="100" value="{{ goal.progressPercent }}" aria-label="{{ goal.progressPercent }}%">{{ goal.progressPercent }}%</progress>

              <form method="post" action="{{ urlFor('/goals/' + (goal.id | string) + '/buddy') }}" class="govuk-!-margin-top-2">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button" type="submit">{{ t("polish_gamify.goals_discover_become_buddy") }}</button>
              </form>
            </article>
          {% endfor %}
        </div>
      {% endif %}

      {% if nextHref %}
        {{ loadMoreNext(urlFor(nextHref), t("actions.load_more")) }}
      {% endif %}
    </div>
  </div>
{% endblock %}

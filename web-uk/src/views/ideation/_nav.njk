{% set active = activeTab or 'challenges' %}
{# <nav> with a label, matching courses/marketplace/federation — see jobs/_nav.njk. #}
<nav class="govuk-!-margin-top-2 govuk-!-margin-bottom-4" aria-label="{{ t("govuk_alpha_ideation.nav.heading") }}">
  <ul class="nexus-alpha-filter-nav">
    <li>
      <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor('/ideation') }}"{% if active == 'challenges' %} aria-current="page"{% endif %}>{{ t("govuk_alpha_ideation.nav.challenges") }}</a>
    </li>
    <li>
      <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor('/ideation/campaigns') }}"{% if active == 'campaigns' %} aria-current="page"{% endif %}>{{ t("govuk_alpha_ideation.nav.campaigns") }}</a>
    </li>
    <li>
      <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor('/ideation/outcomes') }}"{% if active == 'outcomes' %} aria-current="page"{% endif %}>{{ t("govuk_alpha_ideation.nav.outcomes") }}</a>
    </li>
    {% if ideationIsAdmin %}
      <li>
        <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor('/ideation/new') }}"{% if active == 'create' %} aria-current="page"{% endif %}>{{ t("govuk_alpha_ideation.nav.create") }}</a>
      </li>
    {% endif %}
  </ul>

{% extends "layouts/base.njk" %}

{% block content %}
  <span class="govuk-caption-xl">{{ tenantName }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_ideation.outcomes.title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_ideation.outcomes.intro") }}</p>

  {% set activeTab = "outcomes" %}
  {% include "ideation/_nav.njk" %}

  <dl class="govuk-summary-list govuk-!-margin-bottom-6">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("govuk_alpha_ideation.outcomes.stat_total") }}</dt>
      <dd class="govuk-summary-list__value">{{ stats.total }}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("govuk_alpha_ideation.outcomes.stat_implemented") }}</dt>
      <dd class="govuk-summary-list__value">{{ stats.implemented }}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("govuk_alpha_ideation.outcomes.stat_in_progress") }}</dt>
      <dd class="govuk-summary-list__value">{{ stats.inProgress }}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("govuk_alpha_ideation.outcomes.stat_not_started") }}</dt>
      <dd class="govuk-summary-list__value">{{ stats.notStarted }}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("govuk_alpha_ideation.outcomes.stat_abandoned") }}</dt>
      <dd class="govuk-summary-list__value">{{ stats.abandoned }}</dd>
    </div>
  </dl>

  {% if outcomes and outcomes.length %}
    <div class="nexus-alpha-table-scroll" tabindex="0" role="region" aria-label="{{ t('govuk_alpha_ideation.outcomes.title') }}">
    <table class="govuk-table">
      <caption class="govuk-visually-hidden">{{ t("govuk_alpha_ideation.outcomes.title") }}</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">{{ t("feed.item_types.challenge") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_ideation.outcomes.winning_column") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_ideation.outcomes.status_column") }}</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for outcome in outcomes %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link" href="{{ urlFor('/ideation/' ~ outcome.challengeId) }}">{{ outcome.challengeTitle }}</a>
            </td>
            <td class="govuk-table__cell">{{ outcome.ideaTitle }}</td>
            <td class="govuk-table__cell">
              <strong class="govuk-tag {{ outcome.statusClass }}">{{ outcome.statusLabel }}</strong>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  {% else %}
    <div class="govuk-inset-text"><h2 class="govuk-heading-m">{{ t("states.empty_title") }}</h2>{{ t("govuk_alpha_ideation.outcomes.empty") }}</div>
  {% endif %}
{% endblock %}

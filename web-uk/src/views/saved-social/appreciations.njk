{% extends "layouts/base.njk" %}
{% from "_character-count.njk" import characterCount %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/members/' + (owner.id | string)) }}">{{ t("govuk_alpha_saved.wall.back_to_profile") }}</a>
{% endblock %}

{% block content %}
  {% set messageError = status == "appreciation-message-required" %}
  {% set errorStatuses = ["appreciation-message-required", "appreciation-self", "appreciation-too-long", "appreciation-rate-limited", "appreciation-safeguarding-restricted", "appreciation-safeguarding-unavailable", "appreciation-failed", "reaction-failed", "appreciation-visibility-failed", "appreciation-remove-failed"] %}
  {% set successStatuses = ["appreciation-sent", "reaction-updated", "appreciation-shown", "appreciation-hidden", "appreciation-removed"] %}
  {% set ownerLabel = owner.name or t("govuk_alpha_saved.wall.from_someone") %}


  {% if status in errorStatuses %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_saved.errors.summary_title") }}</h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            <li>{% if messageError %}<a href="#appreciation-message">{% endif %}{% if status == "appreciation-message-required" %}{{ t("govuk_alpha_saved.status.appreciation_message_required") }}{% elif status == "appreciation-self" %}{{ t("govuk_alpha_saved.status.appreciation_self") }}{% elif status == "appreciation-too-long" %}{{ t("govuk_alpha_saved.status.appreciation_too_long") }}{% elif status == "appreciation-rate-limited" %}{{ t("govuk_alpha_saved.status.appreciation_rate_limited") }}{% elif status == "appreciation-safeguarding-restricted" %}{{ t("safeguarding.errors.interaction_not_allowed") }}{% elif status == "appreciation-safeguarding-unavailable" %}{{ t("safeguarding.errors.policy_unavailable") }}{% elif status == "reaction-failed" %}{{ t("govuk_alpha_saved.status.reaction_failed") }}{% elif status == "appreciation-visibility-failed" %}{{ t("govuk_alpha_saved.status.appreciation_visibility_failed") }}{% elif status == "appreciation-remove-failed" %}{{ t("govuk_alpha_saved.status.appreciation_remove_failed") }}{% else %}{{ t("govuk_alpha_saved.status.appreciation_failed") }}{% endif %}{% if messageError %}</a>{% endif %}</li>
          </ul>
        </div>
      </div>
    </div>
  {% endif %}

  {% if status in successStatuses %}
    <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="saved-wall-status-title">
      <div class="govuk-notification-banner__header">
        {# Was errors.summary_title — "There is a problem" above a success message. #}
        <h2 class="govuk-notification-banner__title" id="saved-wall-status-title">{{ t("states.success_title") }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">{% if status == "appreciation-sent" %}{{ t("govuk_alpha_saved.status.appreciation_sent") }}{% elif status == "appreciation-shown" %}{{ t("govuk_alpha_saved.status.appreciation_shown") }}{% elif status == "appreciation-hidden" %}{{ t("govuk_alpha_saved.status.appreciation_hidden") }}{% elif status == "appreciation-removed" %}{{ t("govuk_alpha_saved.status.appreciation_removed") }}{% else %}{{ t("govuk_alpha_saved.status.reaction_updated") }}{% endif %}</p>
      </div>
    </div>
  {% endif %}
  <span class="govuk-caption-xl">{{ t("govuk_alpha_saved.wall.caption", { name: ownerLabel }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_saved.wall.heading", { name: ownerLabel }) }}</h1>


  {# A member's own page lists every note they have received, including the ones
     only they can see, so it cannot be described as "public notes". #}
  <p class="govuk-body-l">{% if isSelf %}{{ t("govuk_alpha_saved.wall.own_description") }}{% else %}{{ t("govuk_alpha_saved.wall.description") }}{% endif %}</p>

  {% if not isSelf %}
    <h2 class="govuk-heading-l">{{ t("govuk_alpha_saved.send.heading_to", { name: ownerLabel }) }}</h2>
    <p class="govuk-body">{{ t("govuk_alpha_saved.send.intro") }}</p>
    <form method="post" action="{{ urlFor('/users/' + (owner.id | string) + '/appreciations') }}" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {% call characterCount(500, characterCountMessages, "appreciation-message") %}
      <div class="govuk-form-group{% if messageError %} govuk-form-group--error{% endif %}">
        <label class="govuk-label" for="appreciation-message">{{ t("govuk_alpha_saved.send.message_label") }}</label>
        <div id="appreciation-message-hint" class="govuk-hint">{{ t("govuk_alpha_saved.send.message_hint") }}</div>
        {% if messageError %}
          <p id="appreciation-message-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("govuk_alpha_saved.errors.summary_title") }}:</span> {{ t("govuk_alpha_saved.status.appreciation_message_required") }}</p>
        {% endif %}
        <textarea class="govuk-textarea govuk-!-width-two-thirds govuk-js-character-count" id="appreciation-message" name="message" rows="4" maxlength="500" aria-describedby="appreciation-message-hint{% if messageError %} appreciation-message-error{% endif %} appreciation-private-hint appreciation-message-info">{% if appreciationForm %}{{ appreciationForm.message }}{% endif %}</textarea>
      </div>
      {% endcall %}
      {# 🔴 There is no "make this public" choice (owner, 12 Nov 2026). Every note is
         private until the person who RECEIVES it shows it on their profile, so the
         sender is told that instead of being asked. Do not bring the checkbox back. #}
      <p id="appreciation-private-hint" class="govuk-hint">{{ t("govuk_alpha_saved.send.private_hint") }}</p>
      <button type="submit" class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_saved.send.submit") }}</button>
    </form>
    <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--l">
  {% endif %}

  {% if appreciations and appreciations.length %}
    <ul class="govuk-list nexus-alpha-card-list">
      {% for appreciation in appreciations %}
        <li class="nexus-alpha-card" id="appreciation-{{ appreciation.id }}">
          <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">
            {% if appreciation.sender.id %}
              <a class="govuk-link" href="{{ urlFor('/members/' + (appreciation.sender.id | string)) }}">{{ appreciation.sender.name or t("govuk_alpha_saved.wall.from_someone") }}</a>
            {% else %}
              {{ appreciation.sender.name or t("govuk_alpha_saved.wall.from_someone") }}
            {% endif %}
            {% if appreciation.receivedOn %}<span class="govuk-!-margin-left-1">{{ t("govuk_alpha_saved.wall.received_on", { date: appreciation.receivedOn }) }}</span>{% endif %}
          </p>
          <p class="govuk-body">{{ appreciation.message }}</p>
          {% if isSelf %}
            {# The receiver's own controls. Nobody else is ever sent a private note,
               and Laravel refuses these actions (404) to anyone but the receiver. #}
            {% set noteFrom = t("govuk_alpha_saved.manage.for_note", { name: appreciation.sender.name or t("govuk_alpha_saved.wall.from_someone") }) %}
            <p class="govuk-body govuk-!-margin-bottom-2">
              {% if appreciation.isPublic %}{{ govukTag({ text: t("govuk_alpha_saved.wall.visibility_public"), classes: "govuk-tag--blue" }) }}{% else %}{{ govukTag({ text: t("govuk_alpha_saved.wall.visibility_private"), classes: "govuk-tag--grey" }) }}{% endif %}
            </p>
            <div class="govuk-button-group govuk-!-margin-bottom-2">
              <form method="post" action="{{ urlFor('/appreciations/' + (appreciation.id | string) + '/visibility') }}" class="nexus-alpha-linkform govuk-!-display-inline-block" novalidate>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="is_public" value="{{ '0' if appreciation.isPublic else '1' }}">
                <input type="hidden" name="owner_id" value="{{ owner.id }}">
                <input type="hidden" name="page" value="{{ currentPage }}">
                <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-font-size-16" data-module="govuk-button" data-prevent-double-click="true">{% if appreciation.isPublic %}{{ t("govuk_alpha_saved.manage.hide") }}{% else %}{{ t("govuk_alpha_saved.manage.show") }}{% endif %}<span class="govuk-visually-hidden"> {{ noteFrom }}</span></button>
              </form>
              <a class="govuk-link govuk-!-font-size-16" href="{{ urlFor('/appreciations/' + (appreciation.id | string) + '/remove' + ('?page=' + (currentPage | string) if currentPage > 1 else '')) }}">{{ t("govuk_alpha_saved.manage.remove") }}<span class="govuk-visually-hidden"> {{ noteFrom }}</span></a>
            </div>
          {% endif %}
          {# A note only its receiver can see takes no reactions: nobody else can see
             it, and Laravel answers 404 to a reaction on a private note. #}
          {% if not isSelf or appreciation.isPublic %}
          <fieldset class="govuk-fieldset govuk-!-margin-bottom-0">
            <legend class="govuk-fieldset__legend govuk-visually-hidden">{{ t("govuk_alpha_saved.react.legend") }}</legend>
            <div class="govuk-button-group govuk-!-margin-bottom-0">
              {% for reaction in reactionTypes %}
                {% set reactionLabel = t("govuk_alpha_saved.react." ~ reaction.value) %}
                {% set isMine = appreciation.myReaction == reaction.value %}
                <form method="post" action="{{ urlFor('/appreciations/' + (appreciation.id | string) + '/react') }}" class="nexus-alpha-linkform govuk-!-display-inline-block" novalidate>
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="hidden" name="reaction_type" value="{{ reaction.value }}">
                  <input type="hidden" name="owner_id" value="{{ owner.id }}">
                  <button type="submit" class="govuk-button{% if not isMine %} govuk-button--secondary{% endif %} govuk-!-margin-bottom-0 govuk-!-font-size-16" data-module="govuk-button" aria-label="{% if isMine %}{{ t('govuk_alpha_saved.react.remove_label', { reaction: reactionLabel }) }}{% else %}{{ t('govuk_alpha_saved.react.react_label', { reaction: reactionLabel }) }}{% endif %}" aria-pressed="{{ "true" if isMine else "false" }}">{{ reactionLabel }}{% if isMine %} <span aria-hidden="true">&check;</span>{% endif %}</button>
                </form>
              {% endfor %}
            </div>
          </fieldset>
          <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-top-1 govuk-!-margin-bottom-0">{{ tc("govuk_alpha_saved.wall.reactions_count", appreciation.reactionCount, { count: appreciation.reactionCount }) }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="govuk-inset-text">
      <h2 class="govuk-heading-m">{{ t("govuk_alpha_saved.wall.empty_title") }}</h2>
      <p class="govuk-body">{% if isSelf %}{{ t("govuk_alpha_saved.wall.own_empty_body") }}{% else %}{{ t("govuk_alpha_saved.wall.empty_body") }}{% endif %}</p>
    </div>
  {% endif %}

  {% if lastPage > 1 %}
    <nav class="govuk-pagination" role="navigation" aria-label="{{ t('govuk_alpha_saved.pagination.page_of', { current: currentPage, last: lastPage }) }}">
      {% if currentPage > 1 %}
        <div class="govuk-pagination__prev">
          <a class="govuk-link govuk-pagination__link" href="{{ urlFor('/users/' + (owner.id | string) + '/appreciations?page=' + ((currentPage - 1) | string)) }}" rel="prev">
            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.7441 1.4062-1.4062-4.3008-4.3398h11.379v-2h-11.397l4.2998-4.2998-1.4063-1.4063z"></path></svg>
            <span class="govuk-pagination__link-title govuk-pagination__link-title--decorated">{{ t("govuk_alpha_saved.pagination.previous") }}</span>
          </a>
        </div>
      {% endif %}
      {% if currentPage < lastPage %}
        <div class="govuk-pagination__next">
          <a class="govuk-link govuk-pagination__link" href="{{ urlFor('/users/' + (owner.id | string) + '/appreciations?page=' + ((currentPage + 1) | string)) }}" rel="next">
            <span class="govuk-pagination__link-title govuk-pagination__link-title--decorated">{{ t("govuk_alpha_saved.pagination.next") }}</span>
            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4062 1.4062 4.2998 4.2998h-11.397v2h11.379l-4.3008 4.3398 1.4062 1.4062 6.7441-6.7441-6.7266-6.7266z"></path></svg>
          </a>
        </div>
      {% endif %}
    </nav>
  {% endif %}
{% endblock %}

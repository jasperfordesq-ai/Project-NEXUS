{% extends "layouts/base.njk" %}
{% from "_character-count.njk" import characterCount %}
{% from "_date-input.njk" import nexusDateInput %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <a class="govuk-back-link" href="{{ urlFor('/polls') }}">{{ t("govuk_alpha_gamification.common.back_to_polls") }}</a>

      <span class="govuk-caption-xl">{{ t("govuk_alpha_gamification.poll_create.caption", { community: tenantName }) }}</span>
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_gamification.poll_create.title") }}</h1>
      <p class="govuk-body-l">{{ t("govuk_alpha_gamification.poll_create.description") }}</p>

      {% if statusBanner and statusBanner.type == "success" %}
        <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="poll-create-status-title">
          <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="poll-create-status-title">{{ t("govuk_alpha_gamification.states.success_title") }}</h2></div>
          <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ statusBanner.message }}</p></div>
        </div>
      {% elif (errorList and errorList.length) or formMessage %}
        {# 🔴 This was a single hardcoded `href="#poll-question"`, so "Enter a real date" and
           "The closing date must be in the future" both moved focus to the QUESTION box.
           The route now says which field each error belongs to, and keeps a whole-page save
           failure in `formMessage` as a sentence rather than a link to a field that is
           perfectly fine. #}
        <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_gamification.states.error_title") }}</h2>
            <div class="govuk-error-summary__body">
              {% if formMessage %}<p class="govuk-body">{{ formMessage }}</p>{% endif %}
              {% if errorList and errorList.length %}
                <ul class="govuk-list govuk-error-summary__list">
                  {% for error in errorList %}<li><a href="{{ error.href }}">{{ error.text }}</a></li>{% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}

      <form method="post" action="{{ urlFor('/polls/parity/create') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="govuk-form-group{% if fieldErrors.question %} govuk-form-group--error{% endif %}">
          <label class="govuk-label govuk-label--s" for="poll-question">{{ t("govuk_alpha_gamification.poll_create.question_label") }}</label>
          <div id="poll-question-hint" class="govuk-hint">{{ t("govuk_alpha_gamification.poll_create.question_hint") }}</div>
          {% if fieldErrors.question %}<p id="poll-question-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.question }}</p>{% endif %}
          <input class="govuk-input{% if fieldErrors.question %} govuk-input--error{% endif %}" id="poll-question" name="question" type="text" aria-describedby="poll-question-hint{% if fieldErrors.question %} poll-question-error{% endif %}" required maxlength="255" value="{{ form.question or '' }}">
        </div>
        {% call characterCount(2000, characterCountMessages, "poll-description") %}
        <div class="govuk-form-group">
          <label class="govuk-label govuk-label--s" for="poll-description">{{ t("govuk_alpha_gamification.poll_create.desc_label") }}</label>
          <div id="poll-desc-hint" class="govuk-hint">{{ t("govuk_alpha_gamification.poll_create.desc_hint") }}</div>
          <textarea class="govuk-textarea govuk-js-character-count" id="poll-description" name="description" rows="3" aria-describedby="poll-desc-hint poll-description-info" maxlength="2000">{{ form.description or '' }}</textarea>
        </div>
        {% endcall %}
        {% if categories.length %}
          <div class="govuk-form-group">
            <label class="govuk-label govuk-label--s" for="poll-category">{{ t("govuk_alpha_gamification.poll_create.category_label") }}</label>
            <select class="govuk-select" id="poll-category" name="category">
              <option value="">{{ t("govuk_alpha_gamification.poll_create.category_none") }}</option>
              {% for category in categories %}
                <option value="{{ category }}"{% if form and form.category == category %} selected{% endif %}>{{ category }}</option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
        {# "at least 2 options" is a rule about the GROUP, so GDS puts the error on the
           fieldset once rather than repeating it on all six boxes. The summary link targets
           the first box, which is where the member starts fixing it. #}
        <div class="govuk-form-group{% if fieldErrors.options %} govuk-form-group--error{% endif %}">
          <fieldset class="govuk-fieldset govuk-!-margin-bottom-4"{% if fieldErrors.options %} aria-describedby="poll-options-error"{% endif %}>
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_gamification.poll_create.options_legend") }} <span class="govuk-hint">{{ t("govuk_alpha_gamification.poll_create.options_hint") }}</span></legend>
            {% if fieldErrors.options %}<p id="poll-options-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.options }}</p>{% endif %}
            {% for number in [1, 2, 3, 4, 5, 6] %}
              <div class="govuk-form-group govuk-!-margin-bottom-2">
                <label class="govuk-label" for="poll-option-{{ number }}">{{ t("govuk_alpha_gamification.poll_create.option_label", { num: number }) }}</label>
                <input class="govuk-input govuk-input--width-30{% if fieldErrors.options and number <= 2 %} govuk-input--error{% endif %}" id="poll-option-{{ number }}" name="options[]" type="text" maxlength="255"{% if number <= 2 %} required{% endif %} value="{{ (form.options[number - 1] if form else '') or '' }}">
              </div>
            {% endfor %}
          </fieldset>
        </div>
        <div class="govuk-form-group">
          {{ nexusDateInput({
            name: "expires_at",
            idPrefix: "poll-expires",
            legend: t("govuk_alpha_gamification.poll_create.expires_label"),
            hint: t("web_uk.date_input.hint"),
            value: form.expiresAtParts if form else undefined,
            errorMessage: fieldErrors.expires_at if fieldErrors else undefined,
            errorFields: ["day", "month", "year"] if (fieldErrors and fieldErrors.expires_at) else undefined
          }, t) }}
        </div>
        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_gamification.poll_create.type_legend") }}</legend>
            <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="poll-type-standard" name="poll_type" type="radio" value="standard"{% if not form or form.pollType == 'standard' %} checked{% endif %}>
                <label class="govuk-label govuk-radios__label" for="poll-type-standard">{{ t("govuk_alpha_gamification.poll_create.type_standard") }}</label>
              </div>
              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="poll-type-ranked" name="poll_type" type="radio" value="ranked"{% if form and form.pollType == 'ranked' %} checked{% endif %}>
                <label class="govuk-label govuk-radios__label" for="poll-type-ranked">{{ t("govuk_alpha_gamification.poll_create.type_ranked") }}</label>
              </div>
            </div>
          </fieldset>
        </div>
        <button class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_gamification.poll_create.submit_button") }}</button>
      </form>
    </div>
  </div>
{% endblock %}

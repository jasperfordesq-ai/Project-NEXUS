{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{#
  The GOV.UK three-field date pattern, with this service's translations applied.

  🔴 Replaces the browser's native date input. GOV.UK guidance is explicit that native
  pickers fail users: they differ across browsers, a mobile calendar cannot practically
  reach a date years back, the device decides the display format, and validation cannot
  be presented in the service's own style.

  🔴 That sentence deliberately does NOT spell out the native input's markup. The
  shrink-only counter in `tests/date-input-contract.test.js` greps the whole views tree,
  so an example in this comment counted as an unconverted field and inflated the ceiling
  by one.

      {% from "_date-input.njk" import nexusDateInput %}
      {{ nexusDateInput({
        name: "deadline",
        legend: t("goals.deadline_label"),
        hint: t("web_uk.date_input.hint"),
        value: deadlineParts,
        errorMessage: dateError,
        errorFields: dateErrorFields
      }, t) }}

  The three inputs post as `{name}-day`, `{name}-month`, `{name}-year`. Recombine them
  server-side with `composeDate(req.body, name)` from `src/lib/date-input.js`, which
  returns the same `YYYY-MM-DD` string the routes and the Laravel API already expect.

  🔴 `inputmode="numeric"`, NOT `type="number"`. GDS uses text inputs here: a number
  spinner on a year field is meaningless, and `type="number"` silently discards a leading
  zero in some browsers.
#}
{#
  🔴 `visuallyHiddenText` on the error message must be passed, or govuk-frontend emits its
  own English "Error:" into the hidden span — so a screen reader announces an English word
  immediately before an Irish message. Found by rendering this in Irish rather than
  assuming it was fine. It reuses the already-translated `states.error_prefix`, the same
  key the page-title prefix uses, so the two cannot drift apart.

  🔴 The trailing colon is stripped because govuk-frontend appends its own — the template
  renders `{{ visuallyHiddenText }}:`. Our key already ends in one, so passing it straight
  through produced "Error::" / "Earráid::" / "خطأ::". Caught by reading the rendered
  output rather than trusting the parameter name.

  🔴 Nunjucks cannot take a comment inside a macro call's argument list — it is a parse
  error, not a no-op, which is why this note lives out here. And a comment must not
  contain the comment-closing token itself: writing it out ends the comment early and
  spills the remaining prose into the page. Both mistakes were made writing this file.
#}
{% macro nexusDateInput(params, t) %}
{% set errorFields = params.errorFields or [] %}
{# `idPrefix` lets the same posted field name appear more than once on a page (a partial
   included in both an add and an edit form) with unique element ids; `namePrefix` — and
   therefore the posted `name` — stays put so the route reads the same fields. #}
{{ govukDateInput({
  id: params.idPrefix or params.name,
  namePrefix: params.name,
  fieldset: {
    legend: {
      text: params.legend,
      classes: params.legendClasses or "govuk-fieldset__legend--s"
    }
  },
  hint: { text: params.hint } if params.hint else undefined,
  errorMessage: {
    text: params.errorMessage,
    visuallyHiddenText: t("states.error_prefix") | replace(":", "") | trim
  } if params.errorMessage else undefined,
  items: [
    {
      name: "day",
      label: t("web_uk.date_input.day_label"),
      value: (params.value.day if params.value else ""),
      classes: "govuk-input--width-2" + (" govuk-input--error" if "day" in errorFields else ""),
      inputmode: "numeric"
    },
    {
      name: "month",
      label: t("web_uk.date_input.month_label"),
      value: (params.value.month if params.value else ""),
      classes: "govuk-input--width-2" + (" govuk-input--error" if "month" in errorFields else ""),
      inputmode: "numeric"
    },
    {
      name: "year",
      label: t("web_uk.date_input.year_label"),
      value: (params.value.year if params.value else ""),
      classes: "govuk-input--width-4" + (" govuk-input--error" if "year" in errorFields else ""),
      inputmode: "numeric"
    }
  ]
}) }}
{% endmacro %}

{#
  Date AND time, for a field that used to be a native combined date-and-time input.
  🔴 That native type is deliberately NOT spelled out here: the shrink-only counter in
  this file's contract test greps the views tree, so writing the literal attribute in a
  comment counts as an unconverted field and inflates the ceiling by one (the same trap
  the date macro's comment above avoids).
  It is the three-field date pattern above plus GOV.UK's "asking for times" pattern: ONE
  free-text time field ("Let users enter the time in a way they're familiar with"), not
  hour/minute spinners.

  The four inputs post as `{name}-day/-month/-year/-time`. Recombine them server-side with
  `readDateTime(req.body, name)` from `src/lib/date-input.js`, which returns the same
  `YYYY-MM-DDTHH:MM` string the native input posted, so nothing downstream changes.

      {% from "_date-input.njk" import nexusDateTimeInput %}
      {{ nexusDateTimeInput({
        name: "scheduled_for",
        legend: "<a translated legend>",
        value: scheduledForParts,       (from splitDateTime; has day, month, year, time)
        errorMessage: dtError,
        errorFields: dtErrorFields
      }, t) }}

  🔴 `composeDateTime` returns EITHER a date error (day/month/year in errorFields) OR a
  time error ('time' in errorFields), never both — so the message is routed to whichever
  sub-field owns it: the date-input shows a date error, the time input shows a time error.
#}
{% macro nexusDateTimeInput(params, t) %}
{% set errorFields = params.errorFields or [] %}
{% set timeError = params.errorMessage if ("time" in errorFields) else undefined %}
{% set dateError = params.errorMessage if (params.errorMessage and not ("time" in errorFields)) else undefined %}
{{ nexusDateInput({
  name: params.name,
  idPrefix: params.idPrefix,
  legend: params.legend,
  legendClasses: params.legendClasses,
  hint: params.hint,
  value: params.value,
  errorMessage: dateError,
  errorFields: errorFields
}, t) }}
{{ govukInput({
  id: (params.idPrefix or params.name) + "-time",
  name: params.name + "-time",
  label: { text: t("web_uk.date_input.time_label"), classes: "govuk-label--s" },
  hint: { text: t("web_uk.date_input.time_hint") },
  value: (params.value.time if params.value else ""),
  classes: "govuk-input--width-5" + (" govuk-input--error" if "time" in errorFields else ""),
  autocomplete: "off",
  errorMessage: {
    text: timeError,
    visuallyHiddenText: t("states.error_prefix") | replace(":", "") | trim
  } if timeError else undefined
}) }}
{% endmacro %}

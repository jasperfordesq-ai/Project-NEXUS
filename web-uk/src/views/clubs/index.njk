{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block mainContent %}
  <span class="govuk-caption-xl">{{ t("clubs.caption", { community: tenantName }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("clubs.title") }}</h1>
  <p class="govuk-body-l">{{ t("clubs.description") }}</p>

  <form method="get" action="{{ urlFor('/clubs') }}" class="govuk-!-margin-bottom-6">
    <div class="govuk-form-group">
      <label class="govuk-label" for="q">{{ t("clubs.search_label") }}</label>
      <div id="q-hint" class="govuk-hint">{{ t("clubs.search_hint") }}</div>
      <input class="govuk-input govuk-!-width-two-thirds" id="q" name="q" type="search" value="{{ clubsQuery }}" aria-describedby="q-hint">
    </div>
    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("actions.search") }}</button>
  </form>

  {% if not clubs.length %}
    <div class="govuk-inset-text"><h2 class="govuk-heading-m">{{ t("states.empty_title") }}</h2><p class="govuk-body">{{ t("clubs.empty") }}</p></div>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for club in clubs %}
        <article class="nexus-alpha-card" id="club-{{ club.id }}">
          <div class="nexus-alpha-module-row">
            {% if club.logoUrl %}
              <img class="nexus-alpha-avatar" src="{{ club.logoUrl | thumb(96, 96) }}" alt="" aria-hidden="true" loading="lazy" decoding="async" width="48" height="48">
            {% endif %}
            <h2 class="govuk-heading-s govuk-!-margin-bottom-1">{{ club.name }}</h2>
            {{ govukTag({ text: tc("clubs.members_count", club.memberCount, { count: club.memberCount }), classes: "govuk-tag--blue" }) }}
          </div>

          {% if club.description %}
            <p class="govuk-body govuk-!-margin-bottom-2">{{ club.description }}</p>
          {% endif %}

          <dl class="nexus-alpha-inline-list">
            {% if club.meetingSchedule %}
              <div><dt>{{ t("clubs.schedule_label") }}</dt><dd>{{ club.meetingSchedule }}</dd></div>
            {% endif %}
            {% if club.contactEmail %}
              <div><dt>{{ t("clubs.contact_label") }}</dt><dd><a class="govuk-link" href="mailto:{{ club.contactEmail }}">{{ club.contactEmail }}</a></dd></div>
            {% endif %}
          </dl>

          {% if club.websiteHref %}
            <p class="govuk-body govuk-!-margin-bottom-0">
              <a class="govuk-link" href="{{ club.websiteHref }}" rel="noopener noreferrer" target="_blank">{{ t("clubs.visit_website") }}<span class="govuk-visually-hidden"> {{ t("opens_new_tab") }}</span></a>
            </p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

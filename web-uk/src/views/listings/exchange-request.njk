{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/listings/' + (listing.id | string)) }}">{{ t("actions.back_to_listings") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  {% if status %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <p>{{ status.message }}</p>
        </div>
      </div>
    </div>
  {% endif %}

  <span class="govuk-caption-xl">{{ t("exchanges.request_title") }}</span>
  <h1 class="govuk-heading-xl">{{ listing.title or listing.name or t("listings.title") }}</h1>
  <p class="govuk-body-l">{{ t("exchanges.request_description") }}</p>

  <dl class="govuk-summary-list govuk-!-margin-bottom-7">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("listings.type") }}</dt>
      <dd class="govuk-summary-list__value">{{ t("listings.request") if listingType == "request" else t("listings.offer") }}</dd>
    </div>
    {% if listing.category_name or listing.categoryName %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("listings.category") }}</dt>
        <dd class="govuk-summary-list__value">{{ listing.category_name or listing.categoryName }}</dd>
      </div>
    {% endif %}
    {% if listing.location %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("listings.location") }}</dt>
        <dd class="govuk-summary-list__value">{{ listing.location }}</dd>
      </div>
    {% endif %}
    {% if listing.hours_estimate or listing.estimated_hours %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("listings.hours_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ tc("listings.hours", listing.hours_estimate or listing.estimated_hours, { count: listing.hours_estimate or listing.estimated_hours }) }}</dd>
      </div>
    {% endif %}
    {% if authorName %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("listings.posted_by_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ authorName }}</dd>
      </div>
    {% endif %}
  </dl>

  {% if walletBalance !== null and walletBalance !== undefined %}
    <div class="govuk-inset-text">
      {{ t("exchanges.balance_context", { balance: walletBalanceLabel }) }}
    </div>
    {% if walletBalance < suggestedHours %}
      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-visually-hidden">{{ t("states.warning") }}</span>
          {{ t("exchanges.balance_low_warning", { hours: suggestedHoursLabel }) }}
        </strong>
      </div>
    {% endif %}
  {% endif %}

  <form method="post" action="{{ urlFor('/listings/' + (listing.id | string) + '/exchange-request') }}" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {# 🔴 Single-use: creating an exchange moves time credits, and this was the one
       money form here with no protection at all. The server consumes this token, so a
       double click or a back-button resubmit cannot create a second exchange even
       without JavaScript. #}
    <input type="hidden" name="submission_token" value="{{ submissionToken }}">

    <div class="govuk-form-group">
      <label class="govuk-label" for="proposed_hours">{{ t("exchanges.hours_label") }}</label>
      <div id="proposed-hours-hint" class="govuk-hint">{{ t("exchanges.hours_hint") }}</div>
      <input class="govuk-input govuk-input--width-5" id="proposed_hours" name="proposed_hours" type="number" min="0.25" max="24" step="0.25" value="{{ suggestedHours }}" aria-describedby="proposed-hours-hint" required>
    </div>

    <div class="govuk-form-group">
      <label class="govuk-label" for="prep_time">{{ t("exchanges.prep_time_label") }}</label>
      <div id="prep-time-hint" class="govuk-hint">{{ t("exchanges.prep_time_hint") }}</div>
      <input class="govuk-input govuk-input--width-5" id="prep_time" name="prep_time" type="number" min="0" max="24" step="0.25" aria-describedby="prep-time-hint">
    </div>

    <div class="govuk-form-group">
      <label class="govuk-label" for="message">{{ t("exchanges.request_message_label") }}</label>
      <div id="message-hint" class="govuk-hint">{{ t("exchanges.request_message_hint") }}</div>
      <textarea class="govuk-textarea" id="message" name="message" rows="6" aria-describedby="message-hint"></textarea>
    </div>

    <button class="govuk-button" data-module="govuk-button" data-prevent-double-click="true">{{ t("actions.send_request") }}</button>
  </form>
    </div>
  </div>
{% endblock %}

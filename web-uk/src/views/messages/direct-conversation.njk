{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

{% block beforeContent %}
  <a href="{{ urlFor('/messages') }}" class="govuk-back-link">{{ t("govuk_alpha.actions.back_to_messages") }}</a>
{% endblock %}

{% block mainContent %}
      {% if directStatus and directStatus.type == "success" %}
        {% set notificationMessage = directStatus.message %}
        {% set notificationType = "success" %}
        {% include "partials/notification-banner.njk" %}
      {% endif %}

      {% if directStatus and directStatus.type == "error" %}
        {{ govukErrorSummary({
          titleText: t("govuk_alpha.states.error_title"),
          errorList: [{ text: directStatus.message, href: directStatus.href }],
          attributes: { tabindex: "-1" }
        }) }}
      {% endif %}

      <span class="govuk-caption-xl">{{ t("govuk_alpha.messages.title") }}</span>
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha.messages.conversation_title", { name: conversation.otherUser.name }) }}</h1>
      {% if conversation.otherUser.isOnline %}<p class="govuk-body">{{ govukTag({ text: t("govuk_alpha_messages.conversation.online_badge"), classes: "govuk-tag--turquoise" }) }}</p>{% endif %}

      {% if listing %}
        <div class="govuk-inset-text">
          <a class="govuk-link" href="{{ urlFor('/listings/' + (listing.id | string)) }}">
            {{ t("govuk_alpha.messages.listing_context", { title: listing.title or listing.name }) }}
          </a>
        </div>
      {% endif %}

      {# What the conversation is about (React MessageContextCard). #}
      {% if messageContext %}
        <div class="govuk-inset-text">
          <p class="govuk-body-s govuk-!-margin-bottom-1">{{ t("govuk_alpha_messages.context.regarding") }}: {{ messageContext.typeLabel }}</p>
          <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-link" href="{{ urlFor(messageContext.href) }}">{{ messageContext.title }}</a></p>
        </div>
      {% endif %}

      {% if not directMessagingEnabled %}
        <div class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="conversation-disabled-title">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="conversation-disabled-title">{{ t("govuk_alpha.messages.disabled_title") }}</h2>
          </div>
          <div class="govuk-notification-banner__content"><p class="govuk-body">{{ t("govuk_alpha.messages.disabled_detail") }}</p></div>
        </div>
      {% elseif restricted %}
        <div class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="conversation-restricted-title">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="conversation-restricted-title">{{ t("govuk_alpha.messages.disabled_title") }}</h2>
          </div>
          <div class="govuk-notification-banner__content"><p class="govuk-body">{{ t("govuk_alpha.messages.restricted_detail") }}</p></div>
        </div>
      {% elseif safeguarding and safeguarding.restricted %}
        <div id="safeguarding-notice" class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="conversation-safeguarding-title">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="conversation-safeguarding-title">{{ safeguarding.title or t("safeguarding.errors.contact_restricted_title") }}</h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ safeguarding.detail or safeguarding.message or t("safeguarding.errors.contact_restricted") }}</p>
            {% if safeguarding.required_vetting_labels and safeguarding.required_vetting_labels.length %}
              <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ t("govuk_alpha_messages.safeguarding.required_checks") }}</p>
              <ul class="govuk-list govuk-list--bullet">
                {% for label in safeguarding.required_vetting_labels %}<li>{{ label }}</li>{% endfor %}
              </ul>
            {% endif %}
            {# The two ways forward React offers (ConversationPage): ask a coordinator
               when the API allows it, and ask for a vetting review when vetting is the
               reason. The vetting review is the existing profile-settings journey. #}
            {% if safeguarding.can_request_coordinator %}
              <form method="post" action="{{ urlFor('/messages/' + (conversation.id | string) + '/request-coordinator') }}" class="govuk-!-margin-bottom-4" novalidate>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <p class="govuk-body">{{ t("govuk_alpha_messages.safeguarding.coordinator_hint") }}</p>
                {{ govukButton({ text: t("govuk_alpha_messages.safeguarding.coordinator_button"), classes: "govuk-!-margin-bottom-0" }) }}
              </form>
            {% endif %}
            {% if safeguarding.code == "VETTING_REQUIRED" %}
              <form method="post" action="{{ urlFor('/profile/safeguarding/vetting-review') }}" novalidate>
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <p class="govuk-body">{{ t("govuk_alpha_messages.safeguarding.vetting_hint") }}</p>
                {{ govukButton({ text: t("govuk_alpha_messages.safeguarding.vetting_button"), classes: "govuk-button--secondary govuk-!-margin-bottom-0" }) }}
              </form>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {# ONE cause-agnostic visibility notice for coordinator review AND supporter
         message access, folded together so a reader can never tell which applies
         or to whom (parity: conversation.blade.php, React ConversationPage). The
         fail-open decision is made in the route. #}
      {% if visibilityNoticeRequired %}
        <div class="govuk-inset-text">
          <p class="govuk-body govuk-!-margin-bottom-0">{{ t("govuk_alpha.messages.visibility_notice") }}</p>
        </div>
      {% endif %}

      {# The member's OWN standing reminder that a supporter they chose can read
         their messages, with the way back to manage or withdraw it. #}
      {% if ownMessagesShared %}
        <div class="govuk-inset-text">
          <p class="govuk-body govuk-!-margin-bottom-0">
            {{ t("govuk_alpha.messages.own_messages_shared_reminder") }}
            <a class="govuk-link" href="{{ linkedAccountsHref }}#parents">{{ t("govuk_alpha.messages.own_messages_shared_manage") }}</a>
          </p>
        </div>
      {% endif %}

      {% if meta.hasMore and olderHref %}
        <nav class="govuk-pagination govuk-pagination--block govuk-!-margin-bottom-4" aria-label="{{ t('govuk_alpha.messages.older_pagination_label') }}">
          <div class="govuk-pagination__prev">
            <a class="govuk-link govuk-pagination__link" href="{{ urlFor(olderHref) }}" rel="prev">
              <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.4492-4.1856-3.9765h12.896v-2h-12.984l4.2931-4.293-1.414-1.4141z"></path></svg>
              <span class="govuk-pagination__link-title govuk-pagination__link-title--decorated">{{ t("govuk_alpha.messages.show_older") }}</span>
            </a>
          </div>
        </nav>
      {% endif %}

      {% if messages and messages.length %}
        <ol class="govuk-list govuk-list--spaced">
          {% for message in messages %}
            <li id="m-{{ message.id }}" class="nexus-alpha-card">
              <div class="nexus-alpha-card-head">
                {% if message.sender and message.sender.avatarAssetUrl %}
                  <img class="nexus-alpha-avatar" src="{{ message.sender.avatarAssetUrl | thumb(80, 80) }}" alt="" loading="lazy" decoding="async" width="48" height="48">
                {% else %}
                  <span class="nexus-alpha-avatar nexus-alpha-avatar--placeholder" aria-hidden="true">{{ message.displaySenderName | first | upper }}</span>
                {% endif %}
                <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-0">{{ message.displaySenderName }}</p>
              </div>

              {% if message.created_at or message.createdAt %}
                <p class="govuk-hint govuk-!-margin-bottom-2">
                  {{ t("govuk_alpha.messages.sent_label") }} {{ (message.created_at or message.createdAt) | formatBladeDateTime }}
                  {% if (message.is_edited or message.isEdited) and not message.isDeleted %} <span class="govuk-!-font-weight-regular">· {{ t("govuk_alpha.messages.edited") }}</span>{% endif %}
                  {% if message.isOwn and not message.isDeleted %} <span class="govuk-!-font-weight-regular">· {{ t("govuk_alpha.messages.receipt_read") if message.isRead else t("govuk_alpha.messages.receipt_sent") }}</span>{% endif %}
                </p>
              {% endif %}

                {% if message.isDeleted %}
                  <p class="govuk-body govuk-hint">{{ t("govuk_alpha.messages.deleted_placeholder") }}</p>
                {% else %}
                  {% if message.body and message.searchSegments %}
                    <div class="govuk-body">{% for segment in message.searchSegments %}{% if segment.match %}<mark class="nexus-alpha-search-match">{{ segment.text }}</mark>{% else %}{{ segment.text }}{% endif %}{% endfor %}</div>
                  {% elif message.body %}
                    <div class="govuk-body">{{ message.body }}</div>
                  {% endif %}

                  {% if (message.is_voice or message.isVoice) and message.audioAssetUrl %}
                    {# The player needs an accessible name like the podcast
                       players already have. #}
                    <audio controls preload="none" src="{{ message.audioAssetUrl }}" aria-label="{{ t('govuk_alpha_messages.voice.player_label') }}">
                      {{ t("govuk_alpha_messages.voice.no_audio_support") }}
                    </audio>
                    {% if message.transcript %}
                      <details class="govuk-details govuk-!-margin-top-2" data-module="govuk-details">
                        <summary class="govuk-details__summary">
                          <span class="govuk-details__summary-text">{{ t("govuk_alpha_messages.voice.transcript_toggle") }}</span>
                        </summary>
                        <div class="govuk-details__text">{{ message.transcript }}</div>
                      </details>
                    {% endif %}
                  {% endif %}

                  {% set attachments = message.attachments or [] %}
                  {% if attachments.length %}
                    <ul class="govuk-list govuk-list--bullet">
                      {% for attachment in attachments %}
                        {% set attachmentHref = attachment.assetUrl %}
                        {% set attachmentName = attachment.name or attachment.file_name or attachment.filename or t("govuk_alpha_messages.attachments.default_name") %}
                        {% set attachmentMime = attachment.mime_type or attachment.mimeType or attachment.type or '' %}
                        <li>
                          {% if attachmentHref %}
                            {% if attachmentMime.startsWith('image/') %}
                              <a class="govuk-link" href="{{ attachmentHref }}" target="_blank" rel="noopener"><span class="govuk-visually-hidden"> {{ t("govuk_alpha.opens_new_tab") }}</span>
                                <img src="{{ attachmentHref }}" alt="{{ attachmentName }}" width="220" loading="lazy" decoding="async">
                              </a>
                            {% else %}
                              <a class="govuk-link" href="{{ attachmentHref }}" download>{{ attachmentName }}</a>
                            {% endif %}
                          {% else %}
                            {{ attachmentName }}
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}

                  {% if translation and translation.id == message.id and translation.text %}
                    <div class="govuk-inset-text govuk-!-margin-top-2">
                      <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ t("govuk_alpha_messages.translate.translated_label") }}</p>
                      <p class="govuk-body govuk-!-margin-bottom-0">{{ translation.text }}</p>
                    </div>
                  {% elseif translationEnabled and message.id and (message.body | trim) %}
                    <form method="post" action="{{ urlFor('/messages/' + (conversation.id | string) + '/m/' + (message.id | string) + '/translate') }}" class="govuk-!-margin-top-2" novalidate>
                      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                      <input type="hidden" name="target_language" value="{{ locale }}">
                      {{ govukButton({ text: t("govuk_alpha_messages.translate.button"), classes: "govuk-button--secondary govuk-!-margin-bottom-0" }) }}
                    </form>
                  {% endif %}
                {% endif %}

                {# Reactions (React MessageBubble): what others chose, and the six to choose from. #}
                {% if not message.isDeleted and message.reactionCounts and message.reactionCounts.length %}
                  <p class="govuk-body govuk-!-margin-top-2 govuk-!-margin-bottom-2">
                    {% for reaction in message.reactionCounts %}
                      <span class="govuk-tag govuk-tag--grey govuk-!-margin-right-1">{{ t("govuk_alpha_messages.reactions.count_label", { emoji: reaction.emoji, count: reaction.count }) }}</span>
                    {% endfor %}
                  </p>
                {% endif %}
                {% if canSend and not message.isDeleted and message.id %}
                  <details class="govuk-details govuk-!-margin-top-2 govuk-!-margin-bottom-2" data-module="govuk-details">
                    <summary class="govuk-details__summary">
                      <span class="govuk-details__summary-text">{{ t("govuk_alpha_messages.reactions.heading") }}</span>
                    </summary>
                    <div class="govuk-details__text">
                      <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_messages.reactions.add_legend") }}</legend>
                        <div class="govuk-button-group govuk-!-margin-bottom-0">
                          {% for reaction in message.reactionOptions %}
                            <form method="post" action="{{ urlFor('/messages/' + (conversation.id | string) + '/m/' + (message.id | string) + '/react') }}" class="govuk-!-display-inline" novalidate>
                              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                              <input type="hidden" name="emoji" value="{{ reaction.emoji }}">
                              <button type="submit" class="govuk-button{% if not reaction.mine %} govuk-button--secondary{% endif %} govuk-!-margin-bottom-0" data-module="govuk-button">
                                <span aria-hidden="true">{{ reaction.emoji }}</span>
                                <span class="govuk-visually-hidden">{% if reaction.mine %}{{ t("govuk_alpha_messages.reactions.remove_with", { emoji: reaction.emoji }) }}{% else %}{{ t("govuk_alpha_messages.reactions.react_with", { emoji: reaction.emoji }) }}{% endif %}</span>
                              </button>
                            </form>
                          {% endfor %}
                        </div>
                      </fieldset>
                    </div>
                  </details>
                {% endif %}

                {# Only the receiver of a message may report it, so the link is on the
                   other person's messages only. #}
                {% if not message.isOwn and not message.isDeleted and message.id %}
                  <p class="govuk-body-s govuk-!-margin-top-2 govuk-!-margin-bottom-0">
                    <a class="govuk-link" href="{{ urlFor('/messages/' + (conversation.id | string) + '/m/' + (message.id | string) + '/report') }}">{{ t("govuk_alpha_members.concern_report.link_message") }}</a>
                  </p>
                {% endif %}

                {% if message.canManage %}
                  <details class="govuk-details govuk-!-margin-top-2" data-module="govuk-details">
                    <summary class="govuk-details__summary">
                      <span class="govuk-details__summary-text">{{ t("govuk_alpha.messages.edit_delete_toggle") }}</span>
                    </summary>
                    <div class="govuk-details__text">
                      {% if message.canEdit %}
                        <form method="post" action="{{ urlFor('/messages/' + (conversation.id | string) + '/m/' + (message.id | string) + '/edit') }}" class="govuk-!-margin-bottom-3" novalidate>
                          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                          {{ govukTextarea({
                            label: { text: t("govuk_alpha.messages.edit_label"), classes: "govuk-label--s" },
                            hint: { text: t("govuk_alpha.messages.edit_window_hint") },
                            id: "edit-body-" + (message.id | string),
                            name: "body",
                            rows: 3,
                            value: message.body
                          }) }}
                          {{ govukButton({ text: t("govuk_alpha.messages.edit_button"), classes: "govuk-button--secondary" }) }}
                        </form>
                      {% else %}
                        <p class="govuk-hint">{{ t("govuk_alpha.messages.edit_expired_notice") }}</p>
                      {% endif %}

                      <form method="post" action="{{ urlFor('/messages/' + (conversation.id | string) + '/m/' + (message.id | string) + '/delete') }}" novalidate>
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <fieldset class="govuk-fieldset govuk-!-margin-bottom-3">
                          <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha.messages.delete_legend") }}</legend>
                          <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
                            <div class="govuk-radios__item">
                              <input class="govuk-radios__input" id="delete-scope-self-{{ message.id }}" name="scope" type="radio" value="self" checked aria-describedby="delete-scope-self-hint-{{ message.id }}">
                              <label class="govuk-label govuk-radios__label" for="delete-scope-self-{{ message.id }}">{{ t("govuk_alpha.messages.delete_scope_self") }}</label>
                              <div id="delete-scope-self-hint-{{ message.id }}" class="govuk-hint govuk-radios__hint">{{ t("govuk_alpha.messages.delete_scope_self_hint") }}</div>
                            </div>
                            <div class="govuk-radios__item">
                              <input class="govuk-radios__input" id="delete-scope-everyone-{{ message.id }}" name="scope" type="radio" value="everyone" aria-describedby="delete-scope-everyone-hint-{{ message.id }}">
                              <label class="govuk-label govuk-radios__label" for="delete-scope-everyone-{{ message.id }}">{{ t("govuk_alpha.messages.delete_scope_everyone") }}</label>
                              <div id="delete-scope-everyone-hint-{{ message.id }}" class="govuk-hint govuk-radios__hint">{{ t("govuk_alpha.messages.delete_scope_everyone_hint") }}</div>
                            </div>
                          </div>
                        </fieldset>
                        {{ govukButton({ text: t("govuk_alpha.messages.delete_button"), classes: "govuk-button--warning" }) }}
                      </form>
                    </div>
                  </details>
                {% endif %}
            </li>
          {% endfor %}
        </ol>
      {% else %}
        <div class="govuk-inset-text"><h2 class="govuk-heading-m">{{ t("states.no_messages_title") }}</h2><p class="govuk-body">{{ t("govuk_alpha.messages.empty_conversation") }}</p></div>
      {% endif %}

      <div class="nexus-alpha-card govuk-!-margin-top-6 govuk-!-margin-bottom-4">
        <form method="get" action="{{ urlFor('/messages/' + (conversation.id | string)) }}">
          {% if listingId %}
            <input type="hidden" name="listing" value="{{ listingId }}">
          {% endif %}
          {{ govukInput({
            label: { text: t("polish_members.conversation_filter_label"), classes: "govuk-label--s" },
            hint: { text: t("polish_members.conversation_filter_hint") },
            id: "conv-search",
            name: "q",
            value: query,
            classes: "govuk-!-width-two-thirds"
          }) }}
          <div class="govuk-button-group">
            {{ govukButton({ text: t("govuk_alpha.polish_members.conversation_filter_submit"), classes: "govuk-button--secondary" }) }}
            {% if query %}
              <a class="govuk-link" href="{{ urlFor('/messages/' + (conversation.id | string)) }}">{{ t("govuk_alpha.polish_members.conversation_filter_clear") }}</a>
            {% endif %}
          </div>
        </form>
      </div>

      {% if canSend %}
        <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
        <h2 class="govuk-heading-m">{{ t("govuk_alpha.actions.reply") }}</h2>
        <form method="post" action="{{ urlFor('/messages/' + (conversation.id | string)) }}" enctype="multipart/form-data" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="idempotency_key" value="{{ messageIdempotencyKey }}">
          {% if listingId %}
            <input type="hidden" name="context_type" value="listing">
            <input type="hidden" name="context_id" value="{{ listingId }}">
          {% elif messageContext and messageContext.fromQuery %}
            <input type="hidden" name="context_type" value="{{ messageContext.type }}">
            <input type="hidden" name="context_id" value="{{ messageContext.id }}">
          {% endif %}
          {{ govukTextarea({
            label: { text: t("govuk_alpha.messages.message_label"), classes: "govuk-label--m" },
            hint: { text: t("govuk_alpha.messages.message_hint") },
            id: "body",
            name: "body",
            rows: 5
          }) }}
          <div class="govuk-form-group">
            <label class="govuk-label govuk-label--s" for="attachments">{{ t("govuk_alpha_messages.attachments.label") }}</label>
            <div id="attachments-hint" class="govuk-hint">{{ t("govuk_alpha_messages.attachments.hint") }}</div>
            <input class="govuk-file-upload" id="attachments" name="attachments[]" type="file" multiple aria-describedby="attachments-hint" accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.txt,.csv,.doc,.docx,.xls,.xlsx">
          </div>
          {{ govukButton({ text: t("govuk_alpha.actions.reply") }) }}
        </form>

        <form method="post" action="{{ urlFor('/messages/' + (conversation.id | string) + '/voice') }}" enctype="multipart/form-data" class="govuk-!-margin-top-4" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <div class="govuk-form-group govuk-!-margin-bottom-2">
            <label class="govuk-label govuk-label--s" for="voice">{{ t("govuk_alpha_messages.voice.label") }}</label>
            <div id="voice-hint" class="govuk-hint">{{ t("govuk_alpha_messages.voice.hint") }}</div>
            <input class="govuk-file-upload" id="voice" name="voice" type="file" accept="audio/*" capture aria-describedby="voice-hint" data-voice-duration-target="voice-duration">
          </div>
          {# Filled by /js/voice-duration.js; empty (no-JS) means the server
             omits the duration, exactly as before the enhancement. #}
          <input type="hidden" name="duration" value="" id="voice-duration">
          {{ govukButton({ text: t("govuk_alpha_messages.voice.submit"), classes: "govuk-button--secondary" }) }}
        </form>
      {% endif %}

      <form method="post" action="{{ urlFor('/messages/' + (conversation.id | string) + '/archive') }}" class="govuk-!-margin-top-6" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ govukButton({ text: t("govuk_alpha.actions.archive_conversation"), classes: "govuk-button--secondary" }) }}
      </form>
      <p class="govuk-body"><a class="govuk-link" href="{{ urlFor('/messages/' + (conversation.id | string) + '/delete') }}">{{ t("govuk_alpha_messages.delete_conversation.link") }}</a></p>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script src="/js/voice-duration.js" defer></script>
{% endblock %}

{% extends "layouts/base.njk" %}

{# One Help Centre topic: /help/:audience/:sectionId. Lists the guides in it that
   this community has switched on. #}

{% block beforeContent %}
  {% include "support/_help-breadcrumbs.njk" %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">{{ audienceTitle }}</span>
      <h1 class="govuk-heading-xl">{{ section.title }}</h1>
      <p class="govuk-body-l">{{ section.summary }}</p>

      <h2 class="govuk-heading-m">{{ ct("articles_count", { count: section.articles.length }) }}</h2>
      <ul class="govuk-list nexus-help-list">
        {% for item in section.articles %}
          <li class="govuk-!-margin-bottom-4">
            <a class="govuk-link govuk-!-font-weight-bold" href="{{ urlFor(item.href) }}">{{ item.title }}</a>
            <p class="govuk-body govuk-!-margin-bottom-0">{{ item.summary }}</p>
          </li>
        {% endfor %}
      </ul>

      {% include "support/_help-contact.njk" %}
    </div>
  </div>
{% endblock %}

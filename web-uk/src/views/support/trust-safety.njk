{% extends "layouts/base.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">{{ t("trust_safety.caption", { community: communityName }) }}</span>
      <h1 class="govuk-heading-xl">{{ t("trust_safety.title") }}</h1>
      <p class="govuk-body-l">{{ t("trust_safety.subtitle", { name: communityName }) }}</p>

      {# This is signposting, not a consequence, so it is inset text under a real
         heading rather than warning text with a bolded pseudo-heading inside it. #}
      <h2 class="govuk-heading-m">{{ t("trust_safety.safeguarding_title") }}</h2>
      <div class="govuk-inset-text">
        <p class="govuk-body govuk-!-margin-bottom-0">{{ t("trust_safety.safeguarding_body") }}</p>
      </div>

      {% for section in sections %}
        <h2 class="govuk-heading-m">{{ section.heading }}</h2>
        {% if section.intro %}
          <p class="govuk-body">{{ section.intro }}</p>
        {% endif %}
        {% if section.items.length %}
          <ul class="govuk-list govuk-list--bullet">
            {% for item in section.items %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endfor %}

      <h2 class="govuk-heading-m">{{ t("trust_safety.contact_cta_title") }}</h2>
      <p class="govuk-body">{{ t("trust_safety.contact_cta_body") }}</p>
      <div class="govuk-button-group">
        <a class="govuk-button" data-module="govuk-button" href="{{ urlFor('/contact') }}">{{ t("trust_safety.contact_cta_button") }}</a>
        <a class="govuk-link" href="{{ urlFor('/legal/community-guidelines') }}">{{ t("trust_safety.community_guidelines_link") }}</a>
      </div>
    </div>
  </div>
{% endblock %}

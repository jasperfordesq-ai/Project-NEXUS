{% extends "layouts/base.njk" %}

{# A guide that does not exist, or is about a feature this community has not
   switched on (React HelpNotFound). Served with status 404. #}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ ct("not_found_title") }}</h1>
      <p class="govuk-body">{{ ct("not_found_body") }}</p>
      <p class="govuk-body">
        <a class="govuk-link" href="{{ urlFor('/help') }}">{{ ct("not_found_button") }}</a>
      </p>
    </div>
  </div>
{% endblock %}

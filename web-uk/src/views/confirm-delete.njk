{#
  Shared "are you sure?" interstitial for destructive actions (GOV.UK pattern:
  a deliberate confirmation page for anything permanent). The caller passes the
  already-translated heading, warning and confirm-button text, the POST action,
  and a cancel link. The confirm button carries the double-click guard.
#}
{% extends "layouts/base.njk" %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ confirmHeading }}</h1>
      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-visually-hidden">{{ t("states.warning") }}</span>
          {{ confirmWarning }}
        </strong>
      </div>
      <div class="govuk-button-group">
        <form method="post" action="{{ urlFor(confirmAction) }}">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="govuk-button govuk-button--warning" data-module="govuk-button" data-prevent-double-click="true">{{ confirmButton }}</button>
        </form>
        <a class="govuk-link" href="{{ urlFor(cancelHref) }}">{{ t("actions.cancel") }}</a>
      </div>
    </div>
  </div>
{% endblock %}

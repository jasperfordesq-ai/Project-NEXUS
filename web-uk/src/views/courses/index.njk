{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block mainContent %}
  <span class="govuk-caption-xl">{{ tenantName }}</span>
  <h1 class="govuk-heading-xl">{{ t("courses.title") }}</h1>
  <p class="govuk-body-l">{{ t("courses.description") }}</p>

  {% set activeTab = 'browse' %}
  {% include "courses/_nav.njk" %}

  <form method="get" action="{{ urlFor('/courses') }}" class="govuk-!-margin-bottom-6">
    <div class="govuk-form-group">
      <label class="govuk-label" for="q">{{ t("courses.search_label") }}</label>
      <div id="q-hint" class="govuk-hint">{{ t("govuk_alpha_courses.search_hint") }}</div>
      <input class="govuk-input govuk-!-width-two-thirds" id="q" name="q" type="search" value="{{ coursesQuery }}" aria-describedby="q-hint">
    </div>

    {% if categories and categories.length %}
      <div class="govuk-form-group">
        <label class="govuk-label" for="category">{{ t("govuk_alpha_courses.category_label") }}</label>
        <select class="govuk-select" id="category" name="category">
          <option value="">{{ t("govuk_alpha_courses.category_all") }}</option>
          {% for category in categories %}
            <option value="{{ category.id }}"{% if courseCategoryId == category.id %} selected{% endif %}>{{ category.name }}</option>
          {% endfor %}
        </select>
      </div>
    {% endif %}

    <div class="govuk-form-group">
      <label class="govuk-label" for="level">{{ t("govuk_alpha_courses.level_filter_label") }}</label>
      <select class="govuk-select" id="level" name="level">
        <option value="">{{ t("courses.all_levels") }}</option>
        {% for level in levels %}
          <option value="{{ level.value }}"{% if courseLevel == level.value %} selected{% endif %}>{{ level.label }}</option>
        {% endfor %}
      </select>
    </div>

    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("govuk_alpha_courses.search_button") }}</button>
  </form>

  {% if not courses or not courses.length %}
    <div class="govuk-inset-text">
      <h2 class="govuk-heading-m">{{ t("states.empty_title") }}</h2>
      <p class="govuk-body">{{ t("courses.empty") }}</p>
    </div>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for course in courses %}
        <article class="nexus-alpha-card">
          <div class="nexus-alpha-module-row">
            <h2 class="govuk-heading-s govuk-!-margin-bottom-1">
              <a class="govuk-link" href="{{ urlFor('/courses/' + (course.id | string)) }}">{{ course.title }}</a>
            </h2>
            {{ govukTag({ text: course.costLabel, classes: (course.costTagClass) }) }}
          </div>
          {% if course.excerpt %}
            <p class="govuk-body govuk-!-margin-bottom-1">{{ course.excerpt }}</p>
          {% endif %}
          {% if course.levelLabel %}
            <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-0">{{ t("govuk_alpha_courses.level_meta", { level: course.levelLabel }) }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/courses/instructor') }}">{{ t("govuk_alpha_courses.back_to_teaching") }}</a>
{% endblock %}

{% block mainContent %}
  {% set activeTab = 'teaching' %}
  {% include "courses/_nav.njk" %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_courses.analytics_caption") }}</span>
  <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">{{ course.title }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_courses.analytics_intro") }}</p>

  {% if analytics.total == 0 %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("govuk_alpha_courses.analytics_no_data") }}</p></div>
  {% endif %}

  <dl class="govuk-summary-list">
    {% for stat in stats %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ stat.label }}</dt>
        <dd class="govuk-summary-list__value">{{ stat.value }}</dd>
      </div>
    {% endfor %}
  </dl>

  <h2 class="govuk-heading-l govuk-!-margin-top-7">{{ t("govuk_alpha_courses.completions_by_lesson") }}</h2>
  <p class="govuk-body">{{ t("govuk_alpha_courses.completions_intro") }}</p>

  {% if not perLesson or not perLesson.length %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("govuk_alpha_courses.analytics_no_lessons") }}</p></div>
  {% else %}
    <div class="nexus-alpha-table-scroll" tabindex="0" role="region" aria-label="{{ t('govuk_alpha_courses.completions_by_lesson') }}">
    <table class="govuk-table">
      <caption class="govuk-visually-hidden">{{ t("govuk_alpha_courses.completions_by_lesson") }}</caption>
      <tbody class="govuk-table__body">
        {% for row in perLesson %}
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header govuk-!-width-one-half">{{ row.title }}</th>
            <td class="govuk-table__cell">
              <progress value="{{ row.completed }}" max="{{ maxLessonCompleted }}" aria-label="{{ t('govuk_alpha_courses.lesson_completed_count', { count: row.completed }) }}">{{ row.completed }}</progress>
              <span class="govuk-body-s nexus-alpha-meta govuk-!-margin-left-2">{{ t("govuk_alpha_courses.lesson_completed_count", { count: row.completed }) }}</span>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  {% endif %}
{% endblock %}

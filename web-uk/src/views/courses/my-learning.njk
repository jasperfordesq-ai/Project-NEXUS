{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a href="{{ urlFor('/courses') }}" class="govuk-back-link">{{ t("courses.back") }}</a>
{% endblock %}

{% block mainContent %}
  <span class="govuk-caption-xl">{{ t("govuk_alpha_courses.my_learning_caption", { community: tenantName }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_courses.my_learning_title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_courses.my_learning_intro") }}</p>

  {% set activeTab = 'learning' %}
  {% include "courses/_nav.njk" %}

  {% if not enrollments or not enrollments.length %}
    <div class="govuk-inset-text">
      <p class="govuk-body">{{ t("govuk_alpha_courses.my_learning_empty") }}</p>
    </div>
    <p class="govuk-body">
      <a class="govuk-button" href="{{ urlFor('/courses') }}" role="button" draggable="false" data-module="govuk-button">{{ t("govuk_alpha_courses.browse_courses") }}</a>
    </p>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for enrollment in enrollments %}
        <article class="nexus-alpha-card">
          <div class="nexus-alpha-listing-row">
            {% if enrollment.course.cover_image %}
              <div class="nexus-alpha-listing-row__media">
                <img class="nexus-alpha-card-thumb" src="{{ enrollment.course.cover_image }}" alt="{{ enrollment.course.title }}" width="120" height="90" loading="lazy" decoding="async">
              </div>
            {% endif %}
            <div class="nexus-alpha-listing-row__body">
              <div class="nexus-alpha-module-row">
                <h2 class="govuk-heading-s govuk-!-margin-bottom-1">{{ enrollment.course.title }}</h2>
                <strong class="govuk-tag {% if enrollment.completed %}govuk-tag--green{% else %}govuk-tag--blue{% endif %}">{{ enrollment.statusLabel }}</strong>
              </div>
              <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">{{ t("govuk_alpha_courses.percent_complete", { percent: enrollment.percent }) }}</p>
              <progress value="{{ enrollment.percent }}" max="100" aria-label="{{ t('govuk_alpha_courses.percent_complete', { percent: enrollment.percent }) }}">{{ enrollment.percent }}%</progress>
              <div class="nexus-alpha-actions govuk-!-margin-top-2">
                <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" href="{{ urlFor('/courses/' + (enrollment.course.id | string) + '/learn') }}" role="button" draggable="false" data-module="govuk-button">{% if enrollment.percent > 0 %}{{ t("govuk_alpha_courses.resume") }}{% else %}{{ t("govuk_alpha_courses.start_learning") }}{% endif %}</a>
              </div>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

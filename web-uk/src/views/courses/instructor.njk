{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a href="{{ urlFor('/courses') }}" class="govuk-back-link">{{ t("courses.back") }}</a>
{% endblock %}

{% block mainContent %}
  {% set activeTab = 'teaching' %}
  {% include "courses/_nav.njk" %}

  {% if status %}
    {% if status.type == 'success' %}
      <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="course-instructor-status" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="course-instructor-status">{{ t("states.success_title") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list"><li>{{ status.message }}</li></ul></div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_courses.teaching_caption", { community: tenantName }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_courses.teaching_title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_courses.teaching_intro") }}</p>

  {% if canAuthor %}
    <p class="govuk-body">
      <a class="govuk-button" href="{{ urlFor('/courses/instructor/new') }}" role="button" draggable="false" data-module="govuk-button">{{ t("govuk_alpha_courses.create_course") }}</a>
    </p>
  {% else %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("govuk_alpha_courses.not_approved_author") }}</p></div>
  {% endif %}

  {% if not courses or not courses.length %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("govuk_alpha_courses.no_courses_created") }}</p></div>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for course in courses %}
        <article class="nexus-alpha-card">
          <div class="nexus-alpha-module-row">
            <h2 class="govuk-heading-s govuk-!-margin-bottom-1">{{ course.title }}</h2>
            {{ govukTag({ text: course.instructorStatusLabel, classes: (course.instructorStatusClass) }) }}
          </div>
          <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-2">
            {{ t("govuk_alpha_courses.enrolments_count", { count: course.enrollmentCount }) }}
            &middot;
            {{ t("govuk_alpha_courses.completions_count", { count: course.completionCount }) }}
          </p>
          <div class="nexus-alpha-actions">
            <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" href="{{ urlFor('/courses/instructor/' + (course.id | string) + '/edit') }}" role="button" draggable="false" data-module="govuk-button">{{ t("govuk_alpha_courses.edit_course") }}</a>
            <a class="govuk-link govuk-!-margin-left-3" href="{{ urlFor('/courses/instructor/' + (course.id | string) + '/analytics') }}">{{ t("govuk_alpha_courses.view_analytics") }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

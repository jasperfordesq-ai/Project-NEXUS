{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "_character-count.njk" import characterCount %}

{% block beforeContent %}
  <a href="{{ urlFor('/courses') }}" class="govuk-back-link">{{ t("courses.back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  {% if status %}
    {% if status.key == 'enrolled' %}
      <div class="govuk-panel govuk-panel--confirmation govuk-!-margin-bottom-6">
        <h2 class="govuk-panel__title">{{ t("states.success_title") }}</h2>
        <div class="govuk-panel__body">{{ status.message }}</div>
      </div>
    {% elif status.type == 'success' %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="course-status">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="course-status">{{ t("states.success_title") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <li>{{ status.message }}</li>
            </ul>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-xl">{{ course.authorName or tenantName }}</span>
  <div class="nexus-alpha-module-row">
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">{{ course.title }}</h1>
    {{ govukTag({ text: course.costLabel, classes: (course.costTagClass) }) }}
  </div>

  {% if course.levelLabel %}
    <p class="govuk-body-s nexus-alpha-meta">{{ t("govuk_alpha_courses.level_meta", { level: course.levelLabel }) }}</p>
  {% endif %}

  {% if course.description %}
    <h2 class="govuk-heading-l">{{ t("courses.about_label") }}</h2>
    <div class="govuk-body">{{ course.description | nl2br | safe }}</div>
  {% endif %}

  {% if prerequisites and prerequisites.length %}
    <h2 class="govuk-heading-l">{{ t("courses.prerequisites_label") }}</h2>
    <ul class="govuk-list">
      {% for prerequisite in prerequisites %}
        <li class="govuk-!-margin-bottom-1">
          {% if prerequisite.id %}
            <a class="govuk-link" href="{{ urlFor('/courses/' + (prerequisite.id | string)) }}">{{ prerequisite.title }}</a>
          {% else %}
            {{ prerequisite.title }}
          {% endif %}
          {% if prerequisite.completed %}
            {{ govukTag({ text: t("govuk_alpha_courses.completed_tag"), classes: "govuk-tag--green" }) }}
          {% else %}
            {{ govukTag({ text: t("courses.prerequisite_todo"), classes: "govuk-tag--grey" }) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if isCompleted %}
    <h2 class="govuk-heading-l">{{ t("courses.certificate_label") }}</h2>
    <p class="govuk-body">
      <a class="govuk-button govuk-button--secondary" role="button" data-module="govuk-button" href="{{ urlFor('/courses/' + (course.id | string) + '/certificate') }}" target="_blank" rel="noopener noreferrer">{{ t("courses.certificate_download") }}<span class="govuk-visually-hidden"> {{ t("opens_new_tab") }}</span></a>
    </p>
  {% endif %}

  <h2 class="govuk-heading-l govuk-!-margin-top-7" id="reviews">{{ t("courses.reviews_label") }}</h2>
  {% if course.ratingCount > 0 %}
    <p class="govuk-body-l govuk-!-margin-bottom-1">
      <span aria-hidden="true">{{ course.ratingStars }}</span>
      <strong>{{ course.ratingAvgLabel }}</strong> {{ t("courses.out_of_5") }}
    </p>
    <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-4">{{ tc("govuk_alpha_courses.review_count", course.ratingCount, { count: course.ratingCount }) }}</p>
  {% endif %}

  {% if reviews and reviews.length %}
    <ul class="govuk-list govuk-!-margin-bottom-6">
      {% for review in reviews %}
        <li class="govuk-!-margin-bottom-3">
          <p class="govuk-body-s govuk-!-margin-bottom-1">
            <span aria-hidden="true">{{ review.stars }}</span>
            <span class="govuk-visually-hidden">{{ t("govuk_alpha_courses.rated_out_of_5", { rating: review.rating }) }}</span>
            <strong>{{ review.name }}</strong>{% if review.createdAtLabel %} · {{ review.createdAtLabel }}{% endif %}
          </p>
          {% if review.body %}
            <p class="govuk-body govuk-!-margin-bottom-0">{{ review.body }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% elif course.ratingCount == 0 %}
    <p class="govuk-body">{{ t("courses.no_reviews_yet") }}</p>
  {% endif %}

  {% if canReview %}
    <h3 class="govuk-heading-m">{{ t("courses.leave_review_heading") }}</h3>
    <form method="post" action="{{ urlFor('/courses/' + (course.id | string) + '/reviews') }}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="govuk-form-group">
        <label class="govuk-label" for="rating">{{ t("courses.rating_label") }}</label>
        <select class="govuk-select" id="rating" name="rating">
          {% for rating in [5, 4, 3, 2, 1] %}
            <option value="{{ rating }}">{{ t("govuk_alpha_courses.rating_option", { rating: rating }) }}</option>
          {% endfor %}
        </select>
      </div>
      {% call characterCount(2000, characterCountMessages, "body") %}
      <div class="govuk-form-group">
        <label class="govuk-label" for="body">{{ t("courses.review_body_label") }}</label>
        <textarea class="govuk-textarea govuk-js-character-count" id="body" name="body" rows="4" maxlength="2000" aria-describedby="body-info"></textarea>
      </div>
      {% endcall %}
      <button class="govuk-button" data-module="govuk-button">{{ t("courses.review_submit") }}</button>
    </form>
  {% endif %}

  {% if sections and sections.length %}
    <h2 class="govuk-heading-l">{{ t("courses.contents_label") }}</h2>
    {% for section in sections %}
      {% if section.title or section.lessons.length %}
        <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ section.title or t("govuk_alpha_courses.what_you_will_learn") }}</h3>
        {% if section.lessons and section.lessons.length %}
          <ul class="govuk-list govuk-list--bullet">
            {% for lesson in section.lessons %}
              <li>{{ lesson.title }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

  <h2 class="govuk-heading-l govuk-!-margin-top-7">{{ t("govuk_alpha_courses.join_course") }}</h2>
  {% if isEnrolled %}
    <div class="govuk-inset-text">
      <p class="govuk-body">{{ t("courses.enrolled_notice") }}</p>
    </div>
  {% else %}
    {% if course.creditCost > 0 %}
      <p class="govuk-body">{{ tc("govuk_alpha_courses.credit_cost", course.creditCost, { count: course.creditCost }) }}</p>
    {% else %}
      <p class="govuk-body">{{ t("courses.free_notice") }}</p>
    {% endif %}
    <form method="post" action="{{ urlFor('/courses/' + (course.id | string) + '/enrol') }}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="govuk-button" data-module="govuk-button">{{ t("courses.enrol_button") }}</button>
    </form>
  {% endif %}
    </div>
  </div>
{% endblock %}

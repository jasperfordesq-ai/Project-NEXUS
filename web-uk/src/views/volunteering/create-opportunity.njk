{% extends "layouts/base.njk" %}
{% from "_date-input.njk" import nexusDateInput %}

{% block content %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering/my-organisations') }}">{{ t("govuk_alpha_volunteering.shared.back_to_my_organisations") }}</a>

  {% if status %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          {% if status.type == "validation" %}
            <ul class="govuk-list govuk-error-summary__list">
              {% for error in status.errors %}
                <li><a href="{{ error.href }}">{{ error.text }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p>{{ status.message }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if loadError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <p>{{ loadError }}</p>
        </div>
      </div>
    </div>
  {% endif %}

  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_volunteering.create_opp.title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_volunteering.create_opp.description") }}</p>

  {% if not organizations.length %}
    <div class="govuk-inset-text">
      <p class="govuk-body">{{ t("govuk_alpha_volunteering.create_opp.no_orgs") }}</p>
      <p class="govuk-body govuk-!-margin-bottom-0">{{ t("govuk_alpha_volunteering.create_opp.no_orgs_cta") }}</p>
    </div>
  {% else %}
    <form method="post" action="{{ urlFor('/volunteering/opportunities/create') }}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <div class="govuk-form-group">
        <label class="govuk-label" for="organization_id">{{ t("govuk_alpha_volunteering.create_opp.org_label") }}</label>
        <div id="organization_id-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.create_opp.org_hint") }}</div>
        <select class="govuk-select" id="organization_id" name="organization_id" aria-describedby="organization_id-hint" required>
          <option value="">{{ t("govuk_alpha_volunteering.create_opp.org_select") }}</option>
          {% for organization in organizations %}
            <option value="{{ organization.id }}"{% if form and (organization.id | string) == form.organizationId %} selected{% endif %}>{{ organization.name }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label" for="title">{{ t("govuk_alpha_volunteering.create_opp.opp_title_label") }}</label>
        <div id="title-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.create_opp.opp_title_hint") }}</div>
        <input class="govuk-input" id="title" name="title" type="text" maxlength="200" value="{{ form.title if form else '' }}" aria-describedby="title-hint" required>
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label" for="description">{{ t("govuk_alpha_volunteering.create_opp.opp_description_label") }}</label>
        <div id="description-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.create_opp.opp_description_hint") }}</div>
        <textarea class="govuk-textarea" id="description" name="description" rows="6" aria-describedby="description-hint" required>{{ form.description if form else '' }}</textarea>
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label" for="location">{{ t("govuk_alpha_volunteering.create_opp.location_label") }}</label>
        <div id="location-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.create_opp.location_hint") }}</div>
        <input class="govuk-input" id="location" name="location" type="text" maxlength="255" value="{{ form.location if form else '' }}" aria-describedby="location-hint">
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label" for="skills_needed">{{ t("govuk_alpha_volunteering.create_opp.skills_label") }}</label>
        <div id="skills_needed-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.create_opp.skills_hint") }}</div>
        <input class="govuk-input" id="skills_needed" name="skills_needed" type="text" maxlength="255" value="{{ form.skillsNeeded if form else '' }}" aria-describedby="skills_needed-hint">
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label" for="category_id">{{ t("govuk_alpha_volunteering.create_opp.category_label") }}</label>
        <select class="govuk-select" id="category_id" name="category_id">
          <option value="">{{ t("govuk_alpha_volunteering.create_opp.category_select") }}</option>
          {% for category in categories %}
            <option value="{{ category.id }}"{% if form and (category.id | string) == form.categoryId %} selected{% endif %}>{{ category.name }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
          {{ nexusDateInput({
  name: "start_date",
  legend: t("govuk_alpha_volunteering.create_opp.start_date_label"),
  hint: t("govuk_alpha_volunteering.create_opp.start_date_hint"),
  value: form.startDateParts if form else undefined
}, t) }}
        </div>
        <div class="govuk-grid-column-one-half">
          {{ nexusDateInput({
  name: "end_date",
  legend: t("govuk_alpha_volunteering.create_opp.end_date_label"),
  hint: t("web_uk.date_input.hint"),
  value: form.endDateParts if form else undefined
}, t) }}
        </div>
      </div>

      <fieldset class="govuk-fieldset govuk-!-margin-bottom-4">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_volunteering.create_opp.visibility_legend") }}</legend>
        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
          <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" id="is_remote" name="is_remote" type="checkbox" value="1"{% if form and form.isRemote %} checked{% endif %}>
            <label class="govuk-label govuk-checkboxes__label" for="is_remote">{{ t("govuk_alpha_volunteering.create_opp.remote_label") }}</label>
          </div>
          <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" id="federated_visibility" name="federated_visibility" type="checkbox" value="1" aria-describedby="federated-hint"{% if form and form.federatedVisibility %} checked{% endif %}>
            <label class="govuk-label govuk-checkboxes__label" for="federated_visibility">{{ t("govuk_alpha_volunteering.create_opp.federated_label") }}</label>
            <div id="federated-hint" class="govuk-hint govuk-checkboxes__hint">{{ t("govuk_alpha_volunteering.create_opp.federated_hint") }}</div>
          </div>
        </div>
      </fieldset>

      <button class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_volunteering.create_opp.submit_button") }}</button>
    </form>
  {% endif %}
{% endblock %}

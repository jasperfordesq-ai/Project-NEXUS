{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "_character-count.njk" import characterCount %}
{% from "_card-payment.njk" import confirmingPayment, paymentCancelled, paymentSucceeded, paymentProblem %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering') }}">{{ t("actions.back_to_volunteering") }}</a>
{% endblock %}

{% block content %}
  {# Back from Stripe's card payment page: the state comes from the server's status call. #}
  {% if cardReturn %}
    {% if cardReturn.state == "completed" %}
      {{ paymentSucceeded(cardReturn.title, cardReturn.message, t) }}
    {% elif cardReturn.state == "confirming" %}
      {{ confirmingPayment(checkAgainHref, t) }}
    {% elif cardReturn.state == "cancelled" %}
      {{ paymentCancelled(t) }}
    {% else %}
      {{ paymentProblem(t("govuk_alpha_volunteering.donations.card_payment_failed"), t) }}
    {% endif %}
  {% endif %}
  {% if status %}
    {% if status.type == "success" %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="donations-success-title">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="donations-success-title">{{ t("govuk_alpha_volunteering.shared.success_title") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <li><a href="#{{ status.field or 'donate-amount' }}">{{ status.message }}</a></li>
            </ul>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_volunteering.donations.caption") }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_volunteering.donations.title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_volunteering.donations.description") }}</p>

  <div class="govuk-inset-text" role="note" aria-labelledby="donations-intro-heading">
    <h2 class="govuk-heading-s govuk-!-margin-bottom-2" id="donations-intro-heading">{{ t("govuk_alpha_volunteering.donations.intro_title") }}</h2>
    <p class="govuk-body govuk-!-margin-bottom-0">{{ t("govuk_alpha_volunteering.donations.intro_desc") }}</p>
  </div>

  {% if loadError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <p>{{ loadError }}</p>
        </div>
      </div>
    </div>
  {% endif %}

  <h2 class="govuk-heading-l">{{ t("govuk_alpha_volunteering.donations.stats_title") }}</h2>
  {# The donor tile summed every campaign's donor count, so one person giving to two
     campaigns counted twice. It shows what this member has given instead (React 0a17f2acd). #}
  <dl class="nexus-alpha-stat-grid">
    <div class="nexus-alpha-stat">
      <dt>{{ t("govuk_alpha_volunteering.donations.stat_live_campaigns") }}</dt>
      <dd>{{ dashboard.stats.liveCampaigns }}</dd>
    </div>
    <div class="nexus-alpha-stat">
      <dt>{{ t("govuk_alpha_volunteering.donations.stat_raised") }} <span class="govuk-body-s">({{ t("govuk_alpha_volunteering.donations.stat_raised_hint") }})</span></dt>
      <dd>{{ dashboard.stats.raisedLiveLabel }} {{ tenantCurrency }}</dd>
    </div>
    <div class="nexus-alpha-stat">
      <dt>{{ t("govuk_alpha_volunteering.donations.stat_you_gave") }}</dt>
      <dd>{{ dashboard.stats.givenLabel }} {{ tenantCurrency }}
        {% if dashboard.stats.pendingPledges %}<span class="govuk-body-s govuk-!-display-block">{{ t("govuk_alpha_volunteering.donations.stat_pending_pledges", { number: dashboard.stats.pendingPledges }) }}</span>{% endif %}
      </dd>
    </div>
  </dl>

  {% macro campaignCard(day) %}
        <li class="nexus-alpha-card">
          <h3 class="govuk-heading-m govuk-!-margin-bottom-1">
            {{ day.title }}
            {{ govukTag({ text: day.status.label, classes: (day.status.className) }) }}
          </h3>
          {% if day.organizationName %}
            <p class="govuk-body govuk-!-font-weight-bold">
              {% if day.organizationId and organisationsEnabled !== false %}
                <a class="govuk-link" href="{{ urlFor('/organisations/' ~ day.organizationId) }}">{{ t("govuk_alpha_volunteering.donations.for_organisation", { name: day.organizationName }) }}</a>
              {% else %}
                {{ t("govuk_alpha_volunteering.donations.for_organisation", { name: day.organizationName }) }}
              {% endif %}
            </p>
          {% endif %}
          {% if day.description %}
            <p class="govuk-body">{{ day.description }}</p>
          {% endif %}
          <p class="govuk-body govuk-!-margin-bottom-1">{{ t("govuk_alpha_volunteering.donations.progress_label", { raised: day.raisedLabel, goal: day.goalLabel }) }}</p>
          <progress max="100" value="{{ day.percent }}" aria-label="{{ t('govuk_alpha_volunteering.donations.progress_aria', { percent: day.percent }) }}">{{ day.percent }}%</progress>
          <p class="nexus-alpha-meta govuk-!-margin-top-1">
            <span>{{ tc("govuk_alpha_volunteering.donations.donors_count", day.donorCount, { count: day.donorCount }) }}</span>
            {% if day.endDateLabel %}
              <span>{{ t("govuk_alpha_volunteering.donations.ends_label") }}: {{ day.endDateLabel }}</span>
            {% endif %}
          </p>
          {% if day.id and day.isLive %}
            <a class="govuk-link" href="#donate-form" data-vol-giving-day="{{ day.id }}">{{ t("govuk_alpha_volunteering.donations.donate_to_day") }}<span class="govuk-visually-hidden">: {{ day.title }}</span></a>
          {% endif %}
        </li>
  {% endmacro %}

  <h2 class="govuk-heading-l">{{ t("govuk_alpha_volunteering.donations.live_campaigns") }}</h2>
  {% if dashboard.liveGivingDays.length %}
    <ul class="nexus-alpha-card-list govuk-list">
      {% for day in dashboard.liveGivingDays %}{{ campaignCard(day) }}{% endfor %}
    </ul>
  {% else %}
    <div class="govuk-inset-text">{{ t("govuk_alpha_volunteering.donations.giving_days_empty") }}</div>
  {% endif %}

  {% if dashboard.upcomingGivingDays.length %}
    <h2 class="govuk-heading-m">{{ t("govuk_alpha_volunteering.donations.upcoming_campaigns") }}</h2>
    <ul class="nexus-alpha-card-list govuk-list">
      {% for day in dashboard.upcomingGivingDays %}{{ campaignCard(day) }}{% endfor %}
    </ul>
  {% endif %}

  {% if dashboard.pastGivingDays.length %}
    <h2 class="govuk-heading-m">{{ t("govuk_alpha_volunteering.donations.past_campaigns") }}</h2>
    <p class="govuk-body">{{ t("govuk_alpha_volunteering.donations.past_campaigns_hint") }}</p>
    <ul class="nexus-alpha-card-list govuk-list">
      {% for day in dashboard.pastGivingDays %}{{ campaignCard(day) }}{% endfor %}
    </ul>
  {% endif %}

  <h2 class="govuk-heading-l">{{ t("govuk_alpha_volunteering.donations.history_title") }}</h2>
  <p class="govuk-body">{{ t("govuk_alpha_volunteering.donations.my_donations_hint") }}</p>
  {% if dashboard.donations.length %}
    <div class="nexus-alpha-table-scroll" tabindex="0" role="region" aria-label="{{ t('govuk_alpha_volunteering.donations.history_title') }}">
    <table class="govuk-table">
      <caption class="govuk-visually-hidden">{{ t("govuk_alpha_volunteering.donations.history_title") }}</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.donations.col_amount") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.donations.col_campaign") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.donations.col_status") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.donations.col_method") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.donations.col_when") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.donations.col_message") }}</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for donation in dashboard.donations %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">{{ donation.amountLabel }} {{ donation.currency }}</td>
            <td class="govuk-table__cell">
              {{ donation.campaignTitle or t("govuk_alpha_volunteering.donations.general_campaign") }}
              {% if donation.organizationName %}
                <br>
                {% if donation.organizationId and organisationsEnabled !== false %}
                  <a class="govuk-link" href="{{ urlFor('/organisations/' ~ donation.organizationId) }}">{{ t("govuk_alpha_volunteering.donations.for_organisation", { name: donation.organizationName }) }}</a>
                {% else %}
                  {{ t("govuk_alpha_volunteering.donations.for_organisation", { name: donation.organizationName }) }}
                {% endif %}
              {% endif %}
            </td>
            <td class="govuk-table__cell">
              {{ govukTag({ text: donation.status.label, classes: (donation.status.className) }) }}
              {% if donation.isAnonymous %}
                {{ govukTag({ text: t("govuk_alpha_volunteering.donations.anonymous_tag"), classes: "govuk-tag--grey" }) }}
              {% endif %}
              {% if donation.status.value == "pending" %}
                <p class="govuk-body-s govuk-!-margin-top-2 govuk-!-margin-bottom-0">{{ t("govuk_alpha_volunteering.donations.pending_pledge_note") }}</p>
              {% endif %}
              {% if donation.status.value == "completed" and donation.id %}
                <p class="govuk-body-s govuk-!-margin-top-2 govuk-!-margin-bottom-0">
                  <a class="govuk-link" href="{{ urlFor('/volunteering/donations/' ~ donation.id ~ '/receipt') }}">{{ t("govuk_alpha_volunteering.donations.view_receipt") }}<span class="govuk-visually-hidden"> {{ t("govuk_alpha_volunteering.donations.receipt_link_hidden", { amount: donation.amountLabel ~ " " ~ donation.currency, date: donation.createdAtLabel }) }}</span></a>
                </p>
              {% endif %}
            </td>
            <td class="govuk-table__cell">{{ donation.methodLabel }}</td>
            <td class="govuk-table__cell">{{ donation.createdAtLabel or "—" }}</td>
            <td class="govuk-table__cell">{{ donation.message }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  {% else %}
    <div class="govuk-inset-text">{{ t("govuk_alpha_volunteering.donations.history_empty") }}</div>
  {% endif %}

  <h2 class="govuk-heading-l" id="donate-form">{{ t("govuk_alpha_volunteering.donations.form_title") }}</h2>
  <p class="govuk-body">{{ t("govuk_alpha_volunteering.donations.pledge_intro") }}</p>
  <p class="govuk-body" id="donate-card-intro">{{ t("govuk_alpha_volunteering.donations.card_intro") }}</p>
  <p class="govuk-body">{{ t("govuk_alpha_volunteering.donations.currency_fixed_hint", { currency: tenantCurrency }) }}</p>
  <form id="donate" method="post" action="{{ urlFor('/volunteering/donations#donate') }}" class="govuk-!-margin-bottom-8">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {# Single-use: a second submit of this page can never open a second card payment. #}
    <input type="hidden" name="form_token" value="{{ donationFormToken }}">

    <div class="govuk-form-group{% if status and status.type == 'error' %} govuk-form-group--error{% endif %}">
      <label class="govuk-label govuk-label--s" for="donate-amount">{{ t("govuk_alpha_volunteering.donations.amount_label") }}</label>
      <div id="donate-amount-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.donations.amount_hint") }}</div>
      {% if status and status.type == 'error' %}
        <p id="donate-amount-error" class="govuk-error-message">
          <span class="govuk-visually-hidden">There is a problem:</span>
          {{ status.message }}
        </p>
      {% endif %}
      <div class="govuk-input__wrapper">
        <div class="govuk-input__prefix">{{ tenantCurrency }}</div>
        <input class="govuk-input govuk-input--width-10{% if status and status.type == 'error' %} govuk-input--error{% endif %}" id="donate-amount" name="amount" type="text" inputmode="decimal" spellcheck="false" aria-describedby="donate-amount-hint{% if status and status.type == 'error' %} donate-amount-error{% endif %}" value="{{ donateForm.amount if donateForm else '' }}">
      </div>
    </div>

    {# Only live campaigns can be given to; ended and coming-up ones are not offered. #}
    {% if dashboard.liveGivingDays.length %}
      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="donate-giving-day">{{ t("govuk_alpha_volunteering.donations.campaign_label") }}</label>
        <div id="donate-giving-day-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.donations.campaign_hint") }}</div>
        <select class="govuk-select" id="donate-giving-day" name="giving_day_id" aria-describedby="donate-giving-day-hint">
          <option value="0">{{ t("govuk_alpha_volunteering.donations.campaign_general") }}</option>
          {% for day in dashboard.liveGivingDays %}
            {% if day.id %}
              <option value="{{ day.id }}"{% if donateForm and donateForm.givingDayId == (day.id | string) %} selected{% endif %}>{{ day.title }}{% if day.organizationName %} ({{ t("govuk_alpha_volunteering.donations.for_organisation", { name: day.organizationName }) }}){% endif %}</option>
            {% endif %}
          {% endfor %}
        </select>
      </div>
    {% endif %}

    <div class="govuk-form-group">
      <fieldset class="govuk-fieldset" aria-describedby="donate-method-hint">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_volunteering.donations.method_label") }}</legend>
        <div id="donate-method-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.donations.method_hint") }}</div>
        <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
          {% for method in dashboard.paymentMethods %}
            <div class="govuk-radios__item">
              <input class="govuk-radios__input" id="donate-method-{{ method.value }}" name="payment_method" type="radio" value="{{ method.value }}"{% if (donateForm.paymentMethod == method.value) if donateForm else method.checked %} checked{% endif %}>
              <label class="govuk-label govuk-radios__label" for="donate-method-{{ method.value }}">{{ method.label }}</label>
            </div>
          {% endfor %}
        </div>
      </fieldset>
    </div>

    <div class="govuk-form-group">
      <label class="govuk-label govuk-label--s" for="donate-reference">{{ t("govuk_alpha_volunteering.donations.reference_label") }}</label>
      <div id="donate-reference-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.donations.reference_hint") }}</div>
      <input class="govuk-input govuk-input--width-20" id="donate-reference" name="payment_reference" type="text" maxlength="100" spellcheck="false" aria-describedby="donate-reference-hint" value="{{ donateForm.paymentReference if donateForm else '' }}">
    </div>

    {% call characterCount(500, characterCountMessages, "donate-message") %}
    <div class="govuk-form-group">
      <label class="govuk-label govuk-label--s" for="donate-message">{{ t("govuk_alpha_volunteering.donations.message_label") }} {{ t("govuk_alpha_volunteering.shared.optional") }}</label>
      <div id="donate-message-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.donations.message_hint") }}</div>
      {# Refilled after a failure — a rejected amount used to take the message with it. #}
      <textarea class="govuk-textarea govuk-js-character-count" id="donate-message" name="message" rows="3" maxlength="500" aria-describedby="donate-message-hint donate-message-info">{% if donateForm %}{{ donateForm.message }}{% endif %}</textarea>
    </div>
    {% endcall %}

    <div class="govuk-form-group">
      <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
          <input class="govuk-checkboxes__input" id="donate-anonymous" name="is_anonymous" type="checkbox" value="1"{% if donateForm and donateForm.isAnonymous %} checked{% endif %} aria-describedby="donate-anonymous-hint">
          <label class="govuk-label govuk-checkboxes__label" for="donate-anonymous">{{ t("govuk_alpha_volunteering.donations.anonymous_label") }}</label>
          <div id="donate-anonymous-hint" class="govuk-hint govuk-checkboxes__hint">{{ t("govuk_alpha_volunteering.donations.anonymous_hint") }}</div>
        </div>
      </div>
    </div>

    {# "Continue", not "Record donation": with Card chosen it opens the payment page. #}
    <button class="govuk-button" data-module="govuk-button" data-prevent-double-click="true">{{ t("govuk_alpha.onboarding.continue") }}</button>
  </form>
{% endblock %}

{# Withdraw one of your own qualifications, with a reason (gap B15). #}
{% extends "layouts/base.njk" %}

{% set K = "govuk_alpha_volunteering.my_qualifications." %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering/qualifications') }}">{{ t(K ~ "form.cancel") }}</a>
{% endblock %}

{% block content %}
  <span class="govuk-caption-xl">{{ qualification.label }}</span>
  <h1 class="govuk-heading-xl">{{ t(K ~ "withdraw.title") }}</h1>
  <p class="govuk-body">{{ t(K ~ "withdraw.body") }}</p>

  <form method="post" action="{{ urlFor('/volunteering/qualifications/' ~ qualification.id ~ '/withdraw') }}">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="govuk-form-group">
      <fieldset class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">{{ t(K ~ "withdraw.reason") }}</legend>
        <div class="govuk-radios" data-module="govuk-radios">
          {% for reason in reasons %}
            <div class="govuk-radios__item">
              <input class="govuk-radios__input" id="reason-{{ reason.value }}" name="reason" type="radio" value="{{ reason.value }}"{% if loop.first %} checked{% endif %}>
              <label class="govuk-label govuk-radios__label" for="reason-{{ reason.value }}">{{ reason.label }}</label>
            </div>
          {% endfor %}
        </div>
      </fieldset>
    </div>
    <div class="govuk-button-group">
      <button class="govuk-button govuk-button--warning" data-module="govuk-button">{{ t(K ~ "withdraw.confirm") }}</button>
      <a class="govuk-link" href="{{ urlFor('/volunteering/qualifications') }}">{{ t(K ~ "form.cancel") }}</a>
    </div>
  </form>
{% endblock %}

{#
  A volunteer's own qualifications register (routes/volunteering-my-qualifications.js,
  gap B15). Nothing is uploaded: the volunteer records a qualification and keeps the
  certificate themselves.
#}
{% extends "layouts/base.njk" %}

{% set K = "govuk_alpha_volunteering.my_qualifications." %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering') }}">{{ t("govuk_alpha.actions.back_to_volunteering") }}</a>
{% endblock %}

{% block content %}
  {% if outcome %}
    {% if outcome.type == "success" %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="my-qualifications-outcome-title">
        <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="my-qualifications-outcome-title">{{ t("states.success_title") }}</h2></div>
        <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ outcome.message }}</p></div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body"><p class="govuk-body">{{ outcome.message }}</p></div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha.volunteering.title") }}</span>
  <h1 class="govuk-heading-xl">{{ t(K ~ "heading") }}</h1>

  <div class="govuk-inset-text" data-testid="qualifications-intro">
    <p class="govuk-body">{{ t(K ~ "intro_body") }}</p>
    <p class="govuk-body">{{ t(K ~ "intro_show_or_send") }}</p>
    <p class="govuk-body govuk-!-margin-bottom-0">{{ t(K ~ "intro_vetting") }} <a class="govuk-link" href="{{ urlFor('/profile/settings#vetting-status') }}">{{ t(K ~ "vetting_link") }}</a></p>
  </div>

  <a class="govuk-button" data-module="govuk-button" href="{{ urlFor('/volunteering/qualifications/new') }}">{{ t(K ~ "add") }}</a>

  {% if loadError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
        <div class="govuk-error-summary__body"><p class="govuk-body">{{ loadError }}</p></div>
      </div>
    </div>
  {% elif not hasItems %}
    <h2 class="govuk-heading-m">{{ t(K ~ "empty_title") }}</h2>
    <p class="govuk-body">{{ t(K ~ "empty_body") }}</p>
  {% else %}
    {% for group in groups %}
      <h2 class="govuk-heading-l govuk-!-margin-top-6">{{ group.heading }}</h2>
      {% if group.key == "attention" %}<p class="govuk-body">{{ t(K ~ "attention_body") }}</p>{% endif %}
      {% for item in group.items %}
        <div class="govuk-summary-card" data-testid="qualification-{{ item.id }}">
          <div class="govuk-summary-card__title-wrapper">
            <h3 class="govuk-summary-card__title">{{ item.label }}{% if item.title %} — {{ item.title }}{% endif %}</h3>
            {% if item.status != "withdrawn" %}
              <ul class="govuk-summary-card__actions">
                <li class="govuk-summary-card__action"><a class="govuk-link" href="{{ urlFor('/volunteering/qualifications/' ~ item.id ~ '/edit') }}">{{ t(K ~ "actions.edit") }}<span class="govuk-visually-hidden"> {{ item.label }}</span></a></li>
                <li class="govuk-summary-card__action"><a class="govuk-link" href="{{ urlFor('/volunteering/qualifications/' ~ item.id ~ '/withdraw') }}">{{ t(K ~ "actions.withdraw") }}<span class="govuk-visually-hidden"> {{ item.label }}</span></a></li>
              </ul>
            {% endif %}
          </div>
          <div class="govuk-summary-card__content">
            <p class="govuk-body">
              <strong class="govuk-tag {{ item.statusClass }}">{{ item.statusLabel }}</strong>
              {% if item.isExpiring %}<strong class="govuk-tag govuk-tag--yellow">{{ t(K ~ "status.expiring") }}</strong>{% endif %}
            </p>
            <ul class="govuk-list">
              {% if item.issuer %}<li>{{ item.issuer }}</li>{% endif %}
              {% if item.reference %}<li>{{ item.reference }}</li>{% endif %}
              {% if item.obtained %}<li>{{ item.obtained }}</li>{% endif %}
              <li{% if item.needsAttention %} class="govuk-!-font-weight-bold"{% endif %}>{{ item.expiryLabel }}</li>
              {% if item.confirmedLine %}<li>{{ item.confirmedLine }}</li>{% endif %}
              {% if item.withdrawnLine %}<li>{{ item.withdrawnLine }}</li>{% endif %}
            </ul>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endblock %}

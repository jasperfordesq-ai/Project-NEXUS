{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering') }}">{{ t("actions.back_to_volunteering") }}</a>
{% endblock %}

{% block content %}
  {% if status %}
    {% if status.type == "success" %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="swap-success-title">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="swap-success-title">{{ t("govuk_alpha.states.success_title") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("govuk_alpha.states.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <p>{{ status.message }}</p>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-xl">{{ t("volunteering.title") }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha.vol_depth.swaps_title") }}</h1>
  <p class="govuk-body-l">{{ t("vol_depth.swaps_description") }}</p>

  {# Gap B3 (7 Oct 2026): this used to be a form asking for a "shift number" and a
     "member number", neither of which is shown anywhere on this site. A member now
     picks one of their own upcoming shifts here, and the shift they would rather do on
     the next page; they never choose or see a person. #}
  <h2 class="govuk-heading-l">{{ t("vol_depth.swap_request_title") }}</h2>
  {% if not myShifts.length %}
    <div class="govuk-inset-text">{{ t("vol_depth.swap_no_shifts") }}</div>
  {% else %}
    <p class="govuk-body">{{ t("vol_depth.swap_pick_own") }}</p>
    <dl class="govuk-summary-list govuk-!-margin-bottom-8" data-testid="swap-own-shifts">
      {% for shift in myShifts %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ shift.title }}</dt>
          <dd class="govuk-summary-list__value">{{ shift.whenLabel }}</dd>
          <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="{{ urlFor('/volunteering/swaps/new/' ~ shift.id) }}">{{ t("vol_depth.swap_ask_link") }}<span class="govuk-visually-hidden">: {{ shift.title }}, {{ shift.whenLabel }}</span></a>
          </dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}

  <h2 class="govuk-heading-l">{{ t("vol_depth.swaps_list_title") }}</h2>
  {% if loadError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha.states.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <p>{{ loadError }}</p>
        </div>
      </div>
    </div>
  {% elif not swaps.length %}
    <div class="govuk-inset-text">{{ t("vol_depth.swaps_empty") }}</div>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for swap in swaps %}
        <article class="nexus-alpha-card">
          <p class="govuk-!-margin-bottom-2">
            {{ govukTag({ text: swap.directionLabel, classes: (swap.directionClassName) }) }}
            {{ govukTag({ text: swap.status.label, classes: (swap.status.className) }) }}
          </p>
          {% if swap.direction == "sent" and swap.recipientName %}
            <p class="govuk-body-s govuk-!-margin-bottom-3">{{ t("vol_depth.swap_to", { name: swap.recipientName }) }}</p>
          {% elif swap.direction == "sent" %}
            {# The API names the other volunteer only once they agree (ShiftSwapService). #}
            <p class="govuk-body-s govuk-!-margin-bottom-3">{{ t("vol_depth.swap_to_unnamed") }}</p>
          {% elif swap.direction == "received" and swap.requesterName %}
            <p class="govuk-body-s govuk-!-margin-bottom-3">{{ t("vol_depth.swap_from", { name: swap.requesterName }) }}</p>
          {% endif %}

          <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
              <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ t("vol_depth.swap_your_shift") }}</h3>
              <p class="govuk-body govuk-!-margin-bottom-1">{{ swap.ownShift.title }}</p>
              {% if swap.ownShift.organizationName %}
                <p class="govuk-body-s govuk-!-margin-bottom-1">{{ swap.ownShift.organizationName }}</p>
              {% endif %}
              {% if swap.ownShift.startLabel %}
                <p class="govuk-body-s govuk-!-margin-bottom-0">{{ swap.ownShift.startLabel }}</p>
              {% endif %}
            </div>
            <div class="govuk-grid-column-one-half">
              <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ t("vol_depth." ~ ("swap_original_shift" if swap.direction == "received" else "swap_proposed_shift")) }}</h3>
              <p class="govuk-body govuk-!-margin-bottom-1">{{ swap.otherShift.title }}</p>
              {% if swap.otherShift.organizationName %}
                <p class="govuk-body-s govuk-!-margin-bottom-1">{{ swap.otherShift.organizationName }}</p>
              {% endif %}
              {% if swap.otherShift.startLabel %}
                <p class="govuk-body-s govuk-!-margin-bottom-0">{{ swap.otherShift.startLabel }}</p>
              {% endif %}
            </div>
          </div>

          {% if swap.message %}
            <p class="govuk-body govuk-!-margin-top-3 govuk-!-margin-bottom-3"><span class="govuk-!-font-weight-bold">{{ t("vol_depth.swap_message_from") }}</span> {{ swap.message }}</p>
          {% endif %}

          {% if swap.direction == "received" and swap.status.value == "pending" %}
            <form method="post" action="{{ urlFor('/volunteering/swaps/' ~ swap.id ~ '/respond') }}">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <div class="govuk-button-group">
                <button class="govuk-button govuk-!-margin-bottom-0" name="action" value="accept" data-module="govuk-button">{{ t("vol_depth.swap_accept") }}</button>
                <button class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" name="action" value="reject" data-module="govuk-button">{{ t("vol_depth.swap_reject") }}</button>
              </div>
            </form>
          {% elif swap.direction == "sent" and (swap.status.value == "pending" or swap.status.value == "admin_pending") %}
            <form method="post" action="{{ urlFor('/volunteering/swaps/' ~ swap.id ~ '/cancel') }}">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("vol_depth.swap_cancel") }}</button>
            </form>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

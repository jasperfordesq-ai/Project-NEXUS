{% extends "layouts/base.njk" %}
{% from "_character-count.njk" import characterCount %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering') }}">{{ t("actions.back_to_volunteering") }}</a>
{% endblock %}

{% block content %}
  {% if status %}
    {% if status.type == "success" %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="accessibility-saved-title">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="accessibility-saved-title">{{ t("govuk_alpha.states.success_title") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("govuk_alpha.states.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <p>{{ status.message }}</p>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-l">{{ t("govuk_alpha.volunteering.title") }}</span>
  <h1 class="govuk-heading-xl">{{ t("volunteering.accessibility_title") }}</h1>
  <p class="govuk-body-l">{{ t("volunteering.accessibility_description") }}</p>

  <form method="post" action="{{ urlFor('/volunteering/accessibility') }}">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div class="govuk-form-group">
      <fieldset class="govuk-fieldset" aria-describedby="need-types-hint">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
          <h2 class="govuk-fieldset__heading">{{ t("volunteering.need_types_legend") }}</h2>
        </legend>
        <div id="need-types-hint" class="govuk-hint">{{ t("volunteering.need_types_hint") }}</div>
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
          {% for needType in needTypes %}
            <div class="govuk-checkboxes__item">
              <input class="govuk-checkboxes__input" id="need-{{ needType.value }}" name="need_types[]" type="checkbox" value="{{ needType.value }}"{% if selectedTypes.includes(needType.value) %} checked{% endif %}>
              <label class="govuk-label govuk-checkboxes__label" for="need-{{ needType.value }}">{{ needType.label }}</label>
            </div>
          {% endfor %}
        </div>
      </fieldset>
    </div>

    {#
      🔴 One detail group PER NEED, not one shared set.
      Until 2026-08-17 this form had a single description, accommodations and
      emergency contact. The read path surfaced the first non-empty value across all
      of a member's needs and the save handler wrote it back to every one of them, so
      a member with a mobility need and a separate sensory need lost one of them the
      next time they pressed Save.
      Every label and hint below is the one this page already used, reused inside each
      need's own fieldset and legended with that need's existing translated name — so
      this carries no new translation keys.
      Groups are rendered for every need type, not only the ticked ones, because
      without JavaScript there is nothing to reveal a hidden group when a member ticks
      a box.
    #}
    {% for needType in needTypes %}
      {% set detail = accessibilityByType[needType.value] or {} %}
      <fieldset class="govuk-fieldset govuk-!-margin-bottom-6">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
          <h2 class="govuk-fieldset__heading">{{ needType.label }}</h2>
        </legend>

        {% call characterCount(2000, characterCountMessages, "description-" + needType.value) %}
        <div class="govuk-form-group">
          <label class="govuk-label govuk-label--s" for="description-{{ needType.value }}">{{ t("volunteering.accessibility_description_label") }}</label>
          <div id="description-hint-{{ needType.value }}" class="govuk-hint">{{ t("volunteering.accessibility_description_hint") }}</div>
          <textarea class="govuk-textarea govuk-js-character-count" id="description-{{ needType.value }}" name="description[{{ needType.value }}]" rows="3" maxlength="2000" aria-describedby="description-hint-{{ needType.value }} description-{{ needType.value }}-info">{{ detail.description }}</textarea>
        </div>
        {% endcall %}

        {% call characterCount(2000, characterCountMessages, "accommodations_required-" + needType.value) %}
        <div class="govuk-form-group">
          <label class="govuk-label govuk-label--s" for="accommodations_required-{{ needType.value }}">{{ t("volunteering.accessibility_accommodations_label") }}</label>
          <div id="accommodations-hint-{{ needType.value }}" class="govuk-hint">{{ t("volunteering.accessibility_accommodations_hint") }}</div>
          <textarea class="govuk-textarea govuk-js-character-count" id="accommodations_required-{{ needType.value }}" name="accommodations_required[{{ needType.value }}]" rows="3" maxlength="2000" aria-describedby="accommodations-hint-{{ needType.value }} accommodations_required-{{ needType.value }}-info">{{ detail.accommodations }}</textarea>
        </div>
        {% endcall %}

        <div class="govuk-form-group">
          <label class="govuk-label" for="emergency_contact_name-{{ needType.value }}">{{ t("volunteering.emergency_name_label") }}</label>
          <input class="govuk-input govuk-!-width-two-thirds" id="emergency_contact_name-{{ needType.value }}" name="emergency_contact_name[{{ needType.value }}]" type="text" maxlength="255" value="{{ detail.emergencyName }}" autocomplete="name">
        </div>
        <div class="govuk-form-group">
          <label class="govuk-label" for="emergency_contact_phone-{{ needType.value }}">{{ t("volunteering.emergency_phone_label") }}</label>
          <div id="emergency-phone-hint-{{ needType.value }}" class="govuk-hint">{{ t("volunteering.emergency_phone_hint") }}</div>
          <input class="govuk-input govuk-input--width-20" id="emergency_contact_phone-{{ needType.value }}" name="emergency_contact_phone[{{ needType.value }}]" type="tel" maxlength="32" value="{{ detail.emergencyPhone }}" autocomplete="tel" aria-describedby="emergency-phone-hint-{{ needType.value }}">
        </div>
      </fieldset>
    {% endfor %}

    {#
      A need recorded under a type this build does not know is carried through
      untouched. The API call replaces the member's whole set, so omitting these
      would delete them.
    #}
    {% for extra in unknownNeeds %}
      <input type="hidden" name="preserved_need_types[]" value="{{ extra.needType }}">
      <input type="hidden" name="description[{{ extra.needType }}]" value="{{ extra.description }}">
      <input type="hidden" name="accommodations_required[{{ extra.needType }}]" value="{{ extra.accommodations }}">
      <input type="hidden" name="emergency_contact_name[{{ extra.needType }}]" value="{{ extra.emergencyName }}">
      <input type="hidden" name="emergency_contact_phone[{{ extra.needType }}]" value="{{ extra.emergencyPhone }}">
    {% endfor %}

    <button class="govuk-button" data-module="govuk-button">{{ t("volunteering.accessibility_submit") }}</button>
  </form>
{% endblock %}

{#
  Who applied to one opportunity, for the people who run it
  (routes/volunteering-opportunity-applicants.js, parity gap 4). The decision form is the
  organisation review list's (volunteering/org-manage.njk), posting to this opportunity.
#}
{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "_load-more.njk" import loadMoreNext %}

{% set K = "govuk_alpha_volunteering.opp_applicants." %}
{% set base = '/volunteering/opportunities/' ~ opportunityId %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor(base) }}">{{ t("govuk_alpha_volunteering.shift_manager.back_to_opportunity") }}</a>
{% endblock %}

{% block mainContent %}
  {% if outcome %}
    {% if outcome.type == "success" %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="applicants-outcome-title">
        <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="applicants-outcome-title">{{ t("states.success_title") }}</h2></div>
        <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ outcome.message }}</p></div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
          <div class="govuk-error-summary__body"><p class="govuk-body">{{ outcome.message }}</p></div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  {% if opportunityTitle %}<span class="govuk-caption-xl">{{ opportunityTitle }}</span>{% endif %}
  <h1 class="govuk-heading-xl">{{ t(K ~ "title") }}</h1>
  <p class="govuk-body-l">{{ t(K ~ "intro") }}</p>

  <nav class="govuk-!-margin-bottom-4" aria-label="{{ t('volunteering.application_status_label') }}">
    <ul class="nexus-alpha-filter-nav">
      {% for filter in filters %}
        <li>
          <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor(filter.href) }}"{% if filter.current %} aria-current="page"{% endif %} data-testid="applicants-filter-{{ filter.value }}">{{ filter.label }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>

  {% if not applications.length %}
    <div class="govuk-inset-text" data-testid="applicants-empty">{{ emptyMessage }}</div>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for application in applications %}
        <article class="nexus-alpha-card" id="application-{{ application.id }}" data-testid="applicant-{{ application.id }}">
          <h2 class="govuk-heading-m govuk-!-margin-bottom-2">
            {% if application.applicant.id %}
              <a class="govuk-link" href="{{ urlFor('/members/' ~ application.applicant.id) }}">{{ application.applicant.name }}</a>
            {% else %}
              {{ application.applicant.name }}
            {% endif %}
          </h2>
          {% if application.shiftLabel or application.appliedLabel %}
            <dl class="govuk-summary-list govuk-!-margin-bottom-0">
              {% if application.shiftLabel %}
                <div class="govuk-summary-list__row">
                  <dt class="govuk-summary-list__key">{{ t("govuk_alpha.vol_org.shift_label") }}</dt>
                  <dd class="govuk-summary-list__value">{{ application.shiftLabel }}</dd>
                </div>
              {% endif %}
              {% if application.appliedLabel %}
                <div class="govuk-summary-list__row">
                  <dt class="govuk-summary-list__key">{{ t("govuk_alpha.vol_org.applied_on") }}</dt>
                  <dd class="govuk-summary-list__value">{{ application.appliedLabel }}</dd>
                </div>
              {% endif %}
            </dl>
          {% endif %}
          {% if application.message %}
            <p class="govuk-body govuk-!-margin-top-3 govuk-!-margin-bottom-1"><strong>{{ t("govuk_alpha.vol_org.applicant_message") }}</strong></p>
            <div class="govuk-inset-text govuk-!-margin-top-0">{{ application.message }}</div>
          {% endif %}
          {% if application.status != "pending" %}
            <p class="govuk-!-margin-top-3 govuk-!-margin-bottom-0" data-testid="applicant-status-{{ application.id }}">{{ govukTag({ text: application.statusLabel, classes: application.statusClass }) }}</p>
            {% if application.orgNote %}<p class="govuk-body-s govuk-!-margin-top-2 govuk-!-margin-bottom-0">{{ application.orgNote }}</p>{% endif %}
          {% else %}
            <form method="post" action="{{ urlFor(base ~ '/applications/' ~ application.id) }}" novalidate>
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="hidden" name="show" value="{{ show }}">
              <div class="govuk-form-group govuk-!-margin-bottom-2 govuk-!-margin-top-4">
                <label class="govuk-label" for="org_note_{{ application.id }}">{{ t("govuk_alpha.vol_org.org_note_label") }}</label>
                <div id="org-note-hint-{{ application.id }}" class="govuk-hint">{{ t("govuk_alpha.vol_org.org_note_hint") }}</div>
                <textarea class="govuk-textarea" id="org_note_{{ application.id }}" name="org_note" rows="2" maxlength="1000" aria-describedby="org-note-hint-{{ application.id }}"></textarea>
              </div>
              <p class="govuk-hint govuk-!-margin-top-2 govuk-!-margin-bottom-1">{{ t("govuk_alpha.vol_clarity.org_application_action_hint") }}</p>
              <div class="govuk-button-group govuk-!-margin-top-0">
                <button class="govuk-button govuk-!-margin-bottom-0" name="action" value="approve" data-module="govuk-button" data-prevent-double-click="true">{{ t("govuk_alpha.vol_org.approve") }}<span class="govuk-visually-hidden"> {{ t("govuk_alpha.vol_org.application_for", { name: application.applicant.name }) }}</span></button>
                <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" name="action" value="decline" data-module="govuk-button" data-prevent-double-click="true">{{ t("govuk_alpha.vol_org.decline") }}<span class="govuk-visually-hidden"> {{ t("govuk_alpha.vol_org.application_for", { name: application.applicant.name }) }}</span></button>
              </div>
            </form>
          {% endif %}
        </article>
      {% endfor %}
    </div>
    {% if nextHref %}{{ loadMoreNext(urlFor(nextHref), t("actions.load_more"), t("volunteering.applications_more_label")) }}{% endif %}
  {% endif %}
{% endblock %}

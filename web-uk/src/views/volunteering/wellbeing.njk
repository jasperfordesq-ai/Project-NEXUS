{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "_character-count.njk" import characterCount %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering') }}">{{ t("govuk_alpha.actions.back_to_volunteering") }}</a>
{% endblock %}

{% block content %}
  {% if status %}
    {% if status.type == "warning" %}
      {# The check-in was saved; nobody could be told yet. A notice, not an error. #}
      <div class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="wellbeing-notice-title">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="wellbeing-notice-title">{{ t("govuk_alpha.states.important") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% elif status.type == "success" %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="wellbeing-success-title">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="wellbeing-success-title">{{ t("govuk_alpha_volunteering.shared.success_title") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <p>{{ status.message }}</p>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha.volunteering.title") }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_volunteering.wellbeing.title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_volunteering.wellbeing.description") }}</p>

  {% if loadError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <p>{{ loadError }}</p>
        </div>
      </div>
    </div>
  {% endif %}

  {% if wellbeing.hasScore %}
    <div class="govuk-form-group">
      <label class="govuk-label govuk-label--m" for="wellbeing-score">{{ t("govuk_alpha_volunteering.wellbeing.score_label") }}</label>
      <p class="govuk-body govuk-!-margin-bottom-1">{{ wellbeing.score }} {{ t("govuk_alpha_volunteering.wellbeing.score_out_of") }}</p>
      <progress id="wellbeing-score" max="100" value="{{ wellbeing.score }}" aria-label="{{ t('govuk_alpha_volunteering.wellbeing.score_label') }}">{{ wellbeing.score }}%</progress>
    </div>

    <p class="govuk-body">
      {{ t("govuk_alpha_volunteering.wellbeing.risk_label") }}:
      {{ govukTag({ text: wellbeing.risk.label, classes: (wellbeing.risk.className) }) }}
    </p>
    {% if wellbeing.lastToldLabel %}
      <p class="govuk-body-s">{{ wellbeing.lastToldLabel }}</p>
    {% endif %}
  {% elif not wellbeing.loaded %}
    {# The API could not be read (21 Oct 2026). No score, no risk tag: nothing is
       made up beside the error. The check-in form below still works. #}
    <div class="govuk-inset-text">{{ t("govuk_alpha_volunteering.wellbeing.assessment_unavailable") }}</div>
  {% else %}
    {# score_basis is no_data: nothing to score yet. The 100/100 the API still
       sends is not a result, so it is not shown. #}
    <div class="govuk-inset-text">{{ t("govuk_alpha_volunteering.wellbeing.score_no_data") }}</div>
  {% endif %}

  {% if wellbeing.support %}
    {# The community's own support text and links, or the platform default (20 Oct 2026). #}
    <div class="govuk-inset-text">
      <h2 class="govuk-heading-m">{{ t("govuk_alpha_volunteering.wellbeing.support_title") }}</h2>
      {% if wellbeing.support.text %}<p class="govuk-body">{{ wellbeing.support.text }}</p>{% endif %}
      {% if wellbeing.support.links.length %}
        <ul class="govuk-list">
          {% for link in wellbeing.support.links %}
            <li><a class="govuk-link" href="{% if link.internal %}{{ urlFor(link.url) }}{% else %}{{ link.url }}{% endif %}">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endif %}

  <dl class="nexus-alpha-stat-grid">
    <div class="nexus-alpha-stat">
      <dt>{{ t("govuk_alpha_volunteering.wellbeing.hours_week") }}</dt>
      <dd>{{ wellbeing.hoursThisWeekLabel }}</dd>
    </div>
    <div class="nexus-alpha-stat">
      <dt>{{ t("govuk_alpha_volunteering.wellbeing.hours_month") }}</dt>
      <dd>{{ wellbeing.hoursThisMonthLabel }}</dd>
    </div>
    <div class="nexus-alpha-stat">
      <dt>{{ t("govuk_alpha_volunteering.wellbeing.streak_days") }}</dt>
      <dd>{{ wellbeing.streakDays }}</dd>
    </div>
  </dl>

  {% if wellbeing.hasScore %}
    <h2 class="govuk-heading-l">{{ t("govuk_alpha_volunteering.wellbeing.warnings_title") }}</h2>
    {% if wellbeing.warnings.length %}
      <ul class="govuk-list govuk-list--bullet">
        {% for warning in wellbeing.warnings %}
          <li>{{ warning }}</li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="govuk-inset-text">{{ t("govuk_alpha_volunteering.wellbeing.no_warnings") }}</div>
    {% endif %}
  {% endif %}

  <h2 class="govuk-heading-l">{{ t("govuk_alpha_volunteering.wellbeing.checkin_title") }}</h2>
  <p class="govuk-body">{{ t("govuk_alpha_volunteering.wellbeing.checkin_hint") }}</p>
  <form method="post" action="{{ urlFor('/volunteering/wellbeing/checkin') }}" class="govuk-!-margin-bottom-8">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_volunteering.wellbeing.mood_label") }}</legend>
      <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
        {% for mood in wellbeing.moodOptions %}
          <div class="govuk-radios__item">
            <input class="govuk-radios__input" id="mood-{{ mood.value }}" name="mood" type="radio" value="{{ mood.value }}"{% if (checkinForm.mood == mood.value) if checkinForm else mood.checked %} checked{% endif %}>
            <label class="govuk-label govuk-radios__label" for="mood-{{ mood.value }}">{{ mood.label }}</label>
          </div>
        {% endfor %}
      </div>
    </fieldset>
    {% call characterCount(500, characterCountMessages, "note") %}
    <div class="govuk-form-group govuk-!-margin-top-4">
      <label class="govuk-label" for="note">{{ t("govuk_alpha_volunteering.wellbeing.note_label") }} {{ t("govuk_alpha_volunteering.shared.optional") }}</label>
      <div id="note-hint" class="govuk-hint">{{ t("govuk_alpha_volunteering.wellbeing.note_hint") }}</div>
      {# Refilled after a failure; this box used to come back empty, discarding the whole
         written check-in over a mood radio or a passing API failure. #}
      <textarea class="govuk-textarea govuk-js-character-count" id="note" name="note" rows="3" maxlength="500" aria-describedby="note-hint note-info">{% if checkinForm %}{{ checkinForm.note }}{% endif %}</textarea>
    </div>
    {% endcall %}
    {# Ticked by default. An unticked checkbox submits nothing, so the replayed choice
       is the only way to keep an untick across a failed submission. The route decides
       whether to share: only for Low or Struggling, and only when this is ticked. #}
    {% set shareChecked = true %}
    {% if checkinForm and checkinForm.shareWithTeam === false %}{% set shareChecked = false %}{% endif %}
    {{ govukCheckboxes({
      idPrefix: "share_with_team",
      name: "share_with_team",
      classes: "govuk-checkboxes--small",
      items: [{
        value: "1",
        text: t("govuk_alpha_volunteering.wellbeing.share_label"),
        hint: { text: t("govuk_alpha_volunteering.wellbeing.share_hint") },
        checked: shareChecked
      }]
    }) }}
    <button class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_volunteering.wellbeing.checkin_button") }}</button>
  </form>

  <h2 class="govuk-heading-l">{{ t("govuk_alpha_volunteering.wellbeing.recent_title") }}</h2>
  {% if wellbeing.recentCheckins.length %}
    <div class="nexus-alpha-table-scroll" tabindex="0" role="region" aria-label="{{ t('govuk_alpha_volunteering.wellbeing.recent_title') }}">
    <table class="govuk-table">
      <caption class="govuk-visually-hidden">{{ t("govuk_alpha_volunteering.wellbeing.recent_title") }}</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.wellbeing.recent_when") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.wellbeing.recent_mood") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.wellbeing.note_label") }}</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for checkin in wellbeing.recentCheckins %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">{{ checkin.createdAtLabel or "—" }}</td>
            <td class="govuk-table__cell">
              {{ checkin.moodLabel }}
              {% if checkin.shared %}
                <span class="govuk-hint govuk-!-display-block govuk-!-margin-bottom-0 govuk-!-font-size-16">{{ t("govuk_alpha_volunteering.wellbeing.recent_shared") }}</span>
              {% endif %}
            </td>
            <td class="govuk-table__cell">{{ checkin.note }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  {% else %}
    <div class="govuk-inset-text">{{ t("govuk_alpha_volunteering.wellbeing.recent_empty") }}</div>
  {% endif %}
{% endblock %}

{# "Are you sure?" before a campaign is ended (routes/volunteering-org-fundraising.js). #}
{% extends "layouts/base.njk" %}

{% set K = "govuk_alpha_volunteering.org_fundraising." %}
{% set base = '/volunteering/organisations/' ~ orgId ~ '/fundraising' %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor(base) }}">{{ t(K ~ "back_to_list") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">{{ campaign.title }}</span>
      <h1 class="govuk-heading-l">{{ t(K ~ "end") }}</h1>
      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-visually-hidden">{{ t("states.warning") }}</span>
          {{ t(K ~ "end_confirm") }}
        </strong>
      </div>
      <div class="govuk-button-group">
        <form method="post" action="{{ urlFor(base ~ '/' ~ campaign.id ~ '/end') }}">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="govuk-button govuk-button--warning" data-module="govuk-button" data-prevent-double-click="true">{{ t(K ~ "end") }}</button>
        </form>
        {% if campaign.canPause %}
          <form method="post" action="{{ urlFor(base ~ '/' ~ campaign.id ~ '/pause') }}">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button class="govuk-button govuk-button--secondary" data-module="govuk-button" data-prevent-double-click="true">{{ t(K ~ "pause") }}</button>
          </form>
        {% endif %}
        <a class="govuk-link" href="{{ urlFor(base) }}">{{ t(K ~ "keep_running") }}</a>
      </div>
    </div>
  </div>
{% endblock %}

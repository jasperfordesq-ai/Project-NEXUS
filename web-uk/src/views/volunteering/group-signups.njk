{#
  Group sign-ups (routes/volunteering-actions.js). Since gap B5 (8 Oct 2026) every
  control opens its own page: reserving places, adding a member by name, and the
  two "are you sure?" pages. Nothing here asks for a member number.
#}
{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering') }}">{{ t("actions.back_to_volunteering") }}</a>
{% endblock %}

{% block content %}
  {% if status %}
    {% if status.type == "success" %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="group-success-title">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="group-success-title">{{ t("govuk_alpha_volunteering.shared.success_title") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <li>{{ status.message }}</li>
            </ul>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_volunteering.group_signups.caption") }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_volunteering.group_signups.title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_volunteering.group_signups.description") }}</p>

  {% if loadError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_volunteering.shared.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <p>{{ loadError }}</p>
        </div>
      </div>
    </div>
  {% endif %}

  <a class="govuk-button" data-module="govuk-button" href="{{ urlFor('/volunteering/group-signups/new') }}" role="button" draggable="false">{{ t("govuk_alpha_volunteering.group_signups.reserve_link") }}</a>

  {% if not reservations.length %}
    <div class="govuk-inset-text"><h2 class="govuk-heading-m">{{ t("states.nothing_yet_title") }}</h2>{{ t("govuk_alpha_volunteering.group_signups.empty") }}</div>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for reservation in reservations %}
        <article class="nexus-alpha-card">
          <h2 class="govuk-heading-m govuk-!-margin-bottom-2">{{ reservation.groupName }}</h2>
          <p class="govuk-body govuk-!-margin-bottom-2">
            {{ govukTag({ text: reservation.status.label, classes: (reservation.status.className) }) }}
            {% if reservation.isLeader %}
              {{ govukTag({ text: t("govuk_alpha_volunteering.group_signups.leader_tag"), classes: "govuk-tag--purple" }) }}
            {% endif %}
          </p>

          <dl class="govuk-summary-list govuk-!-margin-bottom-4">
            {% if reservation.opportunityTitle %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">{{ t("govuk_alpha_volunteering.group_signups.opportunity_label") }}</dt>
                <dd class="govuk-summary-list__value">
                  {% if reservation.opportunityId %}
                    <a class="govuk-link" href="{{ urlFor('/volunteering/opportunities/' ~ reservation.opportunityId) }}">{{ reservation.opportunityTitle }}</a>
                  {% else %}
                    {{ reservation.opportunityTitle }}
                  {% endif %}
                </dd>
              </div>
            {% endif %}
            {% if reservation.organizationName %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">{{ t("govuk_alpha_volunteering.group_signups.organisation_label") }}</dt>
                <dd class="govuk-summary-list__value">{{ reservation.organizationName }}</dd>
              </div>
            {% endif %}
            {% if reservation.location %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">{{ t("govuk_alpha_volunteering.group_signups.location_label") }}</dt>
                <dd class="govuk-summary-list__value">{{ reservation.location }}</dd>
              </div>
            {% endif %}
            {% if reservation.shiftLabel %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">{{ t("govuk_alpha_volunteering.group_signups.shift_label") }}</dt>
                <dd class="govuk-summary-list__value">{{ reservation.shiftLabel }}</dd>
              </div>
            {% endif %}
            {% if reservation.createdAtLabel %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">{{ t("govuk_alpha_volunteering.group_signups.created_label") }}</dt>
                <dd class="govuk-summary-list__value">{{ reservation.createdAtLabel }}</dd>
              </div>
            {% endif %}
          </dl>

          <h3 class="govuk-heading-s govuk-!-margin-bottom-2">
            {{ t("govuk_alpha_volunteering.group_signups.members_title") }} ({{ reservation.membersCountLabel }})
          </h3>
          {% if not reservation.members.length %}
            <p class="govuk-body">{{ t("govuk_alpha_volunteering.group_signups.no_members") }}</p>
          {% else %}
            <div class="nexus-alpha-table-scroll" tabindex="0" role="region" aria-label="{{ t('govuk_alpha_volunteering.group_signups.members_title') }}">
            <table class="govuk-table">
              <caption class="govuk-visually-hidden">{{ t("govuk_alpha_volunteering.group_signups.members_title") }}</caption>
              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.group_signups.members_title") }}</th>
                  <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_volunteering.group_signups.status_label") }}</th>
                  {% if reservation.isLeader and not reservation.isCancelled %}
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">{{ t("govuk_alpha_volunteering.group_signups.remove_member_button") }}</span></th>
                  {% endif %}
                </tr>
              </thead>
              <tbody class="govuk-table__body">
                {% for member in reservation.members %}
                  <tr class="govuk-table__row">
                    <td class="govuk-table__cell">{{ member.name }}</td>
                    <td class="govuk-table__cell">{{ govukTag({ text: member.status.label, classes: (member.status.className) }) }}</td>
                    {% if reservation.isLeader and not reservation.isCancelled %}
                      <td class="govuk-table__cell">
                        {% if member.id and member.status.value == "confirmed" %}
                          <a class="govuk-link" href="{{ urlFor('/volunteering/group-signups/' ~ reservation.id ~ '/members/' ~ member.id ~ '/remove') }}">{{ t("govuk_alpha_volunteering.group_signups.remove_member_button") }}<span class="govuk-visually-hidden"> {{ t("govuk_alpha_volunteering.group_signups.remove_member_for", { name: member.name }) }}</span></a>
                        {% endif %}
                      </td>
                    {% endif %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
            </div>
          {% endif %}

          {% if reservation.isLeader and not reservation.isCancelled %}
            <ul class="govuk-list govuk-!-margin-top-4">
              {% if reservation.canAddMembers %}
                <li><a class="govuk-link" href="{{ urlFor('/volunteering/group-signups/' ~ reservation.id ~ '/members/new') }}">{{ t("govuk_alpha_volunteering.group_signups.add_member_title") }}<span class="govuk-visually-hidden"> — {{ reservation.groupName }}</span></a></li>
              {% endif %}
              <li><a class="govuk-link" href="{{ urlFor('/volunteering/group-signups/' ~ reservation.id ~ '/cancel') }}">{{ t("govuk_alpha_volunteering.group_signups.cancel_button") }}<span class="govuk-visually-hidden"> {{ t("govuk_alpha_volunteering.group_signups.cancel_button_for", { group: reservation.groupName }) }}</span></a></li>
            </ul>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

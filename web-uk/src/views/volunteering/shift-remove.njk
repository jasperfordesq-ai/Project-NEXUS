{#
  "Are you sure?" before a shift is removed (routes/volunteering-shifts.js). Says how
  many volunteers hold a place, and that they keep their application and will be told.
#}
{% extends "layouts/base.njk" %}

{% set K = "govuk_alpha_volunteering.shift_manager." %}
{% set base = '/volunteering/opportunities/' ~ opportunityId %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor(base ~ '/shifts') }}">{{ t(K ~ "back_to_shifts") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if opportunityTitle %}<span class="govuk-caption-xl">{{ opportunityTitle }}</span>{% endif %}
      <h1 class="govuk-heading-l">{{ t(K ~ "remove_title") }}</h1>

      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t(K ~ "col_date") }}</dt>
          <dd class="govuk-summary-list__value">{{ shift.dayLabel }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t(K ~ "col_time") }}</dt>
          <dd class="govuk-summary-list__value">{{ shift.timeLabel }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t(K ~ "col_places") }}</dt>
          <dd class="govuk-summary-list__value">{{ shift.placesLabel }}</dd>
        </div>
      </dl>

      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-visually-hidden">{{ t("states.warning") }}</span>
          {{ holdersMessage }}
        </strong>
      </div>

      <div class="govuk-button-group">
        <form method="post" action="{{ urlFor(base ~ '/shifts/' ~ shift.id ~ '/remove') }}">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="govuk-button govuk-button--warning" data-module="govuk-button" data-prevent-double-click="true">{{ t(K ~ "remove_confirm") }}</button>
        </form>
        <a class="govuk-link" href="{{ urlFor(base ~ '/shifts') }}">{{ t("actions.cancel") }}</a>
      </div>
    </div>
  </div>
{% endblock %}

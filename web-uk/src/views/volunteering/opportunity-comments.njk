{% extends "layouts/base.njk" %}
{% from "partials/target-social.njk" import targetSocial %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/volunteering/opportunities/' + (opportunity.id | string)) }}">{{ t("govuk_alpha_events.social.back_to_opportunity") }}</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">{{ opportunity.title }}</span>
      {{ targetSocial({
        item: { type: "volunteer", id: opportunity.id },
        comments: comments,
        currentUserId: currentUserId,
        returnTo: "/volunteering/opportunities/" + (opportunity.id | string) + "/comments",
        socialStatus: socialStatus,
        asPage: true
      }, csrfToken, urlFor, t) }}
    </div>
  </div>
{% endblock %}

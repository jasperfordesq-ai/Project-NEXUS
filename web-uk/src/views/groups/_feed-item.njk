{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "feed/_reactions.njk" import reactionForms, POST_REACTIONS %}

{#
  One post in the group feed, with the actions React's FeedCard offers in a group
  (GroupFeedTab): like, react, vote in a poll, open the post and its comments,
  delete your own post, and hide / mute / report anyone else's. Every action is a
  plain form that returns to the group feed (routes/groups.js).
#}
{% macro groupFeedItem(post, group, feedCursor, csrfToken, urlFor, t, tc) %}
  {% set groupPath = '/groups/' + (group.id | string) %}
  {% set itemPath = groupPath + '/feed/items/' + post.type + '/' + (post.id | string) %}
  {% set feedState = { feed_cursor: feedCursor } %}
  {% set typeLabel = t("feed.item_types." + post.type) if post.type in ["post", "poll", "listing", "event", "goal", "review", "job", "challenge", "volunteer", "blog", "discussion", "resource"] else t("feed.item_types.activity") %}
  {% set postHeading = post.title or t("feed.item_heading_by", { type: typeLabel, name: post.authorName }) %}
  <article class="nexus-alpha-card" id="group-feed-item-{{ post.type }}-{{ post.id }}">
    {% if post.type != "post" %}
      <p class="govuk-body-s govuk-!-margin-bottom-1">{{ govukTag({ text: typeLabel, classes: "govuk-tag--yellow" if post.type == "poll" else "govuk-tag--grey" }) }}</p>
    {% endif %}
    {% if post.title %}<h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ post.title }}</h3>{% endif %}
    <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-2">
      {% if post.authorAvatar %}<img class="nexus-alpha-avatar nexus-alpha-avatar--small" src="{{ post.authorAvatar | thumb(64, 64) }}" alt="" loading="lazy" decoding="async" width="32" height="32">{% endif %}
      {{ t("groups_t1.feed_posted_by", { name: post.authorName }) }}
      {% if post.createdAtLabel %}<span aria-hidden="true"> | </span><span class="govuk-visually-hidden">{{ t("groups_t1.feed_posted_on_prefix") }}</span> <time datetime="{{ post.createdAt }}">{{ post.createdAtLabel }}</time>{% endif %}
    </p>
    {% for paragraph in post.contentParagraphs %}<p class="govuk-body">{{ paragraph }}</p>{% endfor %}
    {% if post.media.length > 0 %}
      <ul class="nexus-alpha-feed-media" data-count="{{ post.media.length }}">
        {% for media in post.media %}
          <li><a href="{{ media.fullUrl }}" target="_blank" rel="noopener noreferrer"><span class="govuk-visually-hidden"> {{ t("govuk_alpha.opens_new_tab") }}</span><img src="{{ media.thumbnailUrl | thumb(640, 640) }}" width="320" height="320" alt="{{ media.altText or t('groups_t1.image_alt', { group: group.name }) }}" class="nexus-alpha-feed-image" loading="lazy">{% if loop.last and post.mediaExtra > 0 %}<span class="nexus-alpha-feed-media__more" aria-hidden="true">+{{ post.mediaExtra }}</span><span class="govuk-visually-hidden">{{ t("feed.media_more", { count: post.mediaExtra }) }}</span>{% endif %}</a></li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if post.poll and post.poll.options.length > 0 %}
      {% if post.poll.canVote %}
        <form method="post" action="{{ urlFor(groupPath + '/feed/polls/' + (post.id | string) + '/vote') }}" class="govuk-!-margin-bottom-3" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          {% if feedCursor %}<input type="hidden" name="feed_cursor" value="{{ feedCursor }}">{% endif %}
          <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
              <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("feed.poll_vote_legend") }}<span class="govuk-visually-hidden"> {{ postHeading }}</span></legend>
              <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
                {% for option in post.poll.options %}
                  <div class="govuk-radios__item">
                    <input class="govuk-radios__input" id="group-poll-{{ post.id }}-opt-{{ option.id }}" name="option_id" type="radio" value="{{ option.id }}">
                    <label class="govuk-label govuk-radios__label" for="group-poll-{{ post.id }}-opt-{{ option.id }}">{{ option.label }}</label>
                  </div>
                {% endfor %}
              </div>
            </fieldset>
          </div>
          <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("feed.poll_vote_submit") }}</button>
        </form>
      {% else %}
        <ul class="govuk-list govuk-!-margin-bottom-2">
          {% for option in post.poll.options %}
            <li>
              <span class="govuk-!-font-weight-bold">{{ option.label }}</span>
              {% if option.isUserChoice %}{{ govukTag({ text: t("feed.poll_your_choice"), classes: "govuk-tag--blue" }) }}{% endif %}
              <span class="govuk-body-s nexus-alpha-meta">{{ tc("feed.poll_votes", option.voteCount, { count: option.voteCount }) }}{% if option.percentage != null %} ({{ option.percentage }}%){% endif %}</span>
              {% if option.percentage != null %}<progress class="nexus-alpha-poll-bar" max="100" value="{{ option.percentage }}" aria-label="{{ t('feed.poll_result_share', { option: option.label, percent: option.percentage }) }}">{{ option.percentage }}%</progress>{% endif %}
            </li>
          {% endfor %}
        </ul>
        <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-2">{% if post.poll.userVoteOptionId %}{{ t("feed.poll_you_voted") }}{% elif not post.poll.isActive %}{{ t("feed.poll_closed") }}{% endif %}</p>
      {% endif %}
    {% endif %}

    {% if post.likeCount > 0 or post.commentCount > 0 %}
      <p class="govuk-body-s nexus-alpha-meta">
        {{ tc("feed.likes", post.likeCount, { count: post.likeCount }) }}
        <span aria-hidden="true"> &middot; </span>
        {{ tc("feed.comments", post.commentCount, { count: post.commentCount }) }}
      </p>
    {% endif %}

    <div class="nexus-alpha-reactions govuk-!-margin-bottom-3">
      <form action="{{ urlFor(itemPath + '/like') }}" method="post" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if feedCursor %}<input type="hidden" name="feed_cursor" value="{{ feedCursor }}">{% endif %}
        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" aria-pressed="{{ 'true' if post.isLiked else 'false' }}">
          {{ t("actions.unlike") if post.isLiked else t("actions.like") }}
          <span class="govuk-visually-hidden">{{ t("feed.action_for", { title: postHeading }) }}</span>
        </button>
      </form>
      {% if post.type == "post" %}
        {% if post.reactionTotal > 0 %}<p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">{{ tc("feed_t1.reaction_count", post.reactionTotal, { count: post.reactionTotal }) }}</p>{% endif %}
        {{ reactionForms(POST_REACTIONS, urlFor(itemPath + '/react'), csrfToken, t, post.userReaction, post.reactionCounts, feedState, t("feed_t1.reaction_for", { name: post.authorName })) }}
      {% endif %}
    </div>

    {% if post.detailHref %}
      <p class="govuk-body-s govuk-!-margin-bottom-3">
        <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor(post.detailHref) }}">{{ t("govuk_alpha_groups.feed.open_post") }}<span class="govuk-visually-hidden"> {{ t("feed_t1.view_post_for", { name: post.authorName }) }}</span></a>
      </p>
    {% endif %}

    {% if post.isOwn %}
      {% if post.type == "post" %}
        <p class="govuk-body-s govuk-!-margin-bottom-0">
          <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor(groupPath + '/feed/posts/' + (post.id | string) + '/delete') }}">{{ t("feed.delete_post") }}<span class="govuk-visually-hidden"> {{ postHeading }}</span></a>
        </p>
      {% endif %}
    {% else %}
      <details class="govuk-details govuk-!-margin-bottom-0" data-module="govuk-details">
        <summary class="govuk-details__summary"><span class="govuk-details__summary-text">{{ t("feed.moderation_summary") }}<span class="govuk-visually-hidden"> {{ postHeading }}</span></span></summary>
        <div class="govuk-details__text">
          <form method="post" action="{{ urlFor(itemPath + '/hide') }}" class="govuk-!-margin-bottom-4" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            {% if feedCursor %}<input type="hidden" name="feed_cursor" value="{{ feedCursor }}">{% endif %}
            <p class="govuk-body govuk-!-margin-bottom-2">{{ t("feed.hide_hint") }}</p>
            <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("feed.hide_button") }}</button>
          </form>
          {% if post.authorId %}
            <form method="post" action="{{ urlFor(groupPath + '/feed/users/' + (post.authorId | string) + '/mute') }}" class="govuk-!-margin-bottom-4" novalidate>
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              {% if feedCursor %}<input type="hidden" name="feed_cursor" value="{{ feedCursor }}">{% endif %}
              <p class="govuk-body govuk-!-margin-bottom-2">{{ t("feed.mute_hint", { name: post.authorName }) }}</p>
              <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("feed.mute_button") }}<span class="govuk-visually-hidden"> {{ post.authorName }}</span></button>
            </form>
          {% endif %}
          <form method="post" action="{{ urlFor(itemPath + '/report') }}" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            {% if feedCursor %}<input type="hidden" name="feed_cursor" value="{{ feedCursor }}">{% endif %}
            <div class="govuk-form-group govuk-!-margin-bottom-2">
              <label class="govuk-label" for="group-report-{{ post.type }}-{{ post.id }}">{{ t("feed.report_reason_label") }}</label>
              <div class="govuk-hint" id="group-report-{{ post.type }}-{{ post.id }}-hint">{{ t("feed.report_hint") }}</div>
              <input class="govuk-input" id="group-report-{{ post.type }}-{{ post.id }}" name="reason" type="text" maxlength="500" aria-describedby="group-report-{{ post.type }}-{{ post.id }}-hint">
            </div>
            <button class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("feed.report_button") }}</button>
          </form>
        </div>
      </details>
    {% endif %}
  </article>
{% endmacro %}

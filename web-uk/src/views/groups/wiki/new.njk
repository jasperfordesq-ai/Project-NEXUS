{% extends "layouts/base.njk" %}
{% import "groups/qa/_tool-macros.njk" as tools with context %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set base = '/groups/' + (group.id | string) + '/wiki' %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor(base) }}">{{ t("govuk_alpha_group_tools.wiki.back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ tools.toolErrors(errorList) }}
      {{ tools.toolStatus(statusBanner) }}
      <span class="govuk-caption-xl">{{ group.name }}</span>
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_group_tools.wiki.create_title") }}</h1>
      <form method="post" action="{{ urlFor(base + '/new') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ govukInput({
          label: { text: t("govuk_alpha_group_tools.wiki.title_label"), classes: "govuk-label--m" },
          id: "title",
          name: "title",
          value: values.title,
          attributes: { maxlength: "255" },
          errorMessage: { text: errors.title, visuallyHiddenText: t("states.error_prefix") | replace(":", "") | trim } if errors.title else undefined
        }) }}
        {% if parentOptions.length > 1 %}
          {{ govukSelect({
            id: "parent_id",
            name: "parent_id",
            label: { text: t("govuk_alpha_group_tools.wiki.parent_label"), classes: "govuk-label--m" },
            items: parentOptions
          }) }}
        {% endif %}
        {{ govukTextarea({
          label: { text: t("govuk_alpha_group_tools.wiki.content_label"), classes: "govuk-label--m" },
          id: "content",
          name: "content",
          rows: 14,
          value: values.content,
          errorMessage: { text: errors.content, visuallyHiddenText: t("states.error_prefix") | replace(":", "") | trim } if errors.content else undefined
        }) }}
        {{ govukButton({ text: t("govuk_alpha_group_tools.wiki.create") }) }}
      </form>
    </div>
  </div>
{% endblock %}

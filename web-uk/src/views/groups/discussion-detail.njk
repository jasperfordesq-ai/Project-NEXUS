{% extends "layouts/base.njk" %}

{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "_load-more.njk" import loadMoreNext %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/groups/' + (group.id | string) + '/discussions') }}">{{ t("groups.discussions.back") }}</a>
{% endblock %}

{% block mainContent %}
{# Translate for the discussion and each reply (React GroupDiscussionTab, AWID
   feedback 30 Oct 2026). A translation made on the previous request is shown
   once, under the text it belongs to. #}
{% macro translateBlock(messageId, buttonKey, byName, anchorId) %}
  {% if translation and translation.messageId == messageId %}
    <div class="govuk-inset-text govuk-!-margin-bottom-0" id="{{ anchorId }}">
      <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ t("govuk_alpha_feed.translate.heading") }}</h3>
      <p class="govuk-hint govuk-!-margin-bottom-2">{{ t("govuk_alpha_feed.translate.original_above_hint") }}</p>
      <p class="govuk-body govuk-!-margin-bottom-0" lang="{{ translation.locale }}">{{ translation.text }}</p>
    </div>
  {% else %}
    <form method="post" action="{{ urlFor('/groups/' + (group.id | string) + '/discussions/' + (discussion.id | string) + '/translate') }}" class="govuk-!-margin-top-2 govuk-!-margin-bottom-0" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {% if messageId %}<input type="hidden" name="message_id" value="{{ messageId }}">{% endif %}
      {% if currentCursor %}<input type="hidden" name="cursor" value="{{ currentCursor }}">{% endif %}
      <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t(buttonKey) }}{% if byName %}<span class="govuk-visually-hidden"> {{ t("govuk_alpha_feed.translate.reply_by", { name: byName }) }}</span>{% endif %}</button>
    </form>
  {% endif %}
{% endmacro %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  {% if statusBanner and statusBanner.type == "success" %}
    {{ govukNotificationBanner({
      type: "success",
      titleText: statusBanner.title,
      text: statusBanner.message
    }) }}
  {% elif statusBanner and statusBanner.type == "error" %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ statusBanner.title }}</h2>
        <div class="govuk-error-summary__body"><p class="govuk-body">{{ statusBanner.message }}</p></div>
      </div>
    </div>
  {% endif %}
  {% if fieldErrors.content %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
        <div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list"><li><a href="#content">{{ fieldErrors.content }}</a></li></ul></div>
      </div>
    </div>
  {% endif %}
  <span class="govuk-caption-xl">{{ group.name }}</span>
  <h1 class="govuk-heading-xl">{{ discussion.title }}</h1>



  <article class="nexus-alpha-card govuk-!-margin-bottom-4">
    {% if discussion.authorName %}
      <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">
        {{ t("groups.discussions.started_by", { name: discussion.authorName }) }}{% if discussion.createdAtLabel %}<span aria-hidden="true"> · </span><time datetime="{{ discussion.createdAt }}">{{ discussion.createdAtLabel }}</time>{% endif %}
      </p>
    {% endif %}
    <div class="govuk-body" dir="auto">{{ discussion.content | striptags | nl2br | safe }}</div>
    {% if discussion.content %}{{ translateBlock(null, "govuk_alpha_feed.translate.discussion_button", "", "discussion-translation") }}{% endif %}
  </article>

  <h2 class="govuk-heading-l" id="discussion-replies">{{ tc("groups.discussions.replies_count", (discussion.replyCount or messages.length), { count: (discussion.replyCount or messages.length) }) }}</h2>

  {% if not messages.length %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("groups.discussions.no_replies") }}</p></div>
  {% else %}
    <div class="nexus-alpha-card-list">
    {% for message in messages %}
      <article class="nexus-alpha-card" id="reply-{{ message.id }}">
        {% if message.authorName %}
          <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">
            {{ t("polish_groups.reply_posted_by", { name: message.authorName }) }}{% if message.createdAtLabel %}<span aria-hidden="true"> · </span><time datetime="{{ message.createdAt }}">{{ message.createdAtLabel }}</time>{% endif %}
          </p>
        {% endif %}
        <div class="govuk-body govuk-!-margin-bottom-0" dir="auto">{{ message.content | striptags | nl2br | safe }}</div>
        {% if message.content %}{{ translateBlock(message.id, "govuk_alpha_feed.translate.reply_button", message.authorName or "", "reply-translation-" + (message.id | string)) }}{% endif %}
      </article>
    {% endfor %}
    </div>
    {% if newerRepliesHref %}{{ loadMoreNext(urlFor(newerRepliesHref), t("actions.load_more")) }}{% endif %}
  {% endif %}

  <form method="post" action="{{ urlFor('/groups/' + (group.id | string) + '/discussions/' + (discussion.id | string) + '/reply') }}" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="govuk-form-group{% if fieldErrors.content %} govuk-form-group--error{% endif %}">
      <label class="govuk-label govuk-label--m" for="content">{{ t("groups.discussions.reply_label") }}</label>
      <div id="content-hint" class="govuk-hint">{{ t("groups.discussions.reply_hint") }}</div>
      {% if fieldErrors.content %}<p id="content-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.content }}</p>{% endif %}
      <textarea class="govuk-textarea{% if fieldErrors.content %} govuk-textarea--error{% endif %}" id="content" name="content" rows="4" aria-describedby="content-hint{% if fieldErrors.content %} content-error{% endif %}">{{ replyValues.content or '' }}</textarea>
    </div>
    <button class="govuk-button" data-module="govuk-button">{{ t("groups.discussions.reply_submit") }}</button>
  </form>
    </div>
  </div>
{% endblock %}

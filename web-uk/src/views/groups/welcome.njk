{% extends "layouts/base.njk" %}

{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block beforeContent %}
  {{ super() }}
  <a class="govuk-back-link" href="{{ urlFor('/groups/' + (group.id | string)) }}">{{ t("govuk_alpha_groups.common.back_to_group") }}</a>
{% endblock %}

{% block mainContent %}
  {% if statusMessage %}
    {% if statusMessage.type == "error" %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body"><p class="govuk-body">{{ statusMessage.text }}</p></div>
        </div>
      </div>
    {% else %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="welcome-status">
        <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="welcome-status">{{ t("states.success_title") }}</h2></div>
        <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ statusMessage.text }}</p></div>
      </div>
    {% endif %}
  {% endif %}
  <span class="govuk-caption-xl">{{ group.name }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_groups.welcome.title") }}</h1>


  <p class="govuk-body-l">{{ t("govuk_alpha_groups.welcome.intro") }}</p>

  <form method="post" action="{{ urlFor('/groups/' + (group.id | string) + '/welcome') }}" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {{ govukCheckboxes({
      name: "enabled",
      classes: "govuk-checkboxes--small",
      items: [{ value: "1", text: t("govuk_alpha_groups.welcome.enabled_label"), checked: welcome.enabled }]
    }) }}
    {{ govukTextarea({
      id: "message",
      name: "message",
      rows: 6,
      label: { text: t("govuk_alpha_groups.welcome.message_label"), classes: "govuk-label--m" },
      hint: { text: t("govuk_alpha_groups.welcome.message_hint") },
      value: welcome.message,
      attributes: { maxlength: "5000" }
    }) }}
    {{ govukButton({ text: t("govuk_alpha_groups.welcome.save") }) }}
  </form>
{% endblock %}

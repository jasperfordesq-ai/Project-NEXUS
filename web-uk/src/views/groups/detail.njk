{% extends "layouts/base.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "_date-input.njk" import nexusDateInput, nexusDateTimeInput %}
{% from "groups/_feed-item.njk" import groupFeedItem %}

{% block beforeContent %}
  {{ super() }}
  <a class="govuk-back-link" href="{{ urlFor('/groups') }}">{{ t("actions.back_to_groups") }}</a>
{% endblock %}

{% block mainContent %}
  {% set isPrivate = group.visibility != "public" %}
  <span class="govuk-caption-xl">{{ t("groups.caption", { community: tenantName or serviceName }) }}</span>
  <div class="nexus-alpha-module-row">
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">{{ group.name }}</h1>
    {{ govukTag({
      text: t("groups.visibility_private") if isPrivate else t("groups.visibility_public"),
      classes: "govuk-tag--grey" if isPrivate else "govuk-tag--green"
    }) }}
  </div>

  {% set groupSuccessStates = ["group-joined", "group-requested", "group-left", "group-created", "group-updated"] %}
  {% set groupErrorStates = ["group-failed", "group-safeguarding-restricted", "group-safeguarding-unavailable", "group-update-failed", "group-delete-failed"] %}
  {% set groupFeedSuccessStates = ["group-posted"] %}
  {% if status == "group-request-cancelled" %}
    <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="grp-request-status">
      <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="grp-request-status">{{ t("states.success_title") }}</h2></div>
      <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ t("govuk_alpha_groups.states.group-request-cancelled") }}</p></div>
    </div>
  {% endif %}
  {% set groupFeedErrorStates = ["group-post-empty", "group-post-failed", "group-post-forbidden"] %}
  {% if status in groupSuccessStates %}
    <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="grp-status">
      <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="grp-status">{{ t("states.success_title") }}</h2></div>
      <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ t("groups.states." + status) }}</p></div>
    </div>
  {% elif status in groupErrorStates %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
        <div class="govuk-error-summary__body"><p class="govuk-body">{% if status == "group-safeguarding-restricted" %}{{ t("safeguarding.errors.interaction_not_allowed") }}{% elif status == "group-safeguarding-unavailable" %}{{ t("safeguarding.errors.policy_unavailable") }}{% else %}{{ t("groups.states." + status) }}{% endif %}</p></div>
      </div>
    </div>
  {% elif status in groupFeedSuccessStates %}
    <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="grp-feed-status">
      <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="grp-feed-status">{{ t("states.success_title") }}</h2></div>
      <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ t("groups_t1.states." + status) }}</p></div>
    </div>
  {% elif status in groupFeedErrorStates %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
        <div class="govuk-error-summary__body"><p class="govuk-body">{{ t("groups_t1.states." + status) }}</p></div>
      </div>
    </div>
  {% endif %}

  {% if group.description %}
    <p class="govuk-body-l">{{ group.description }}</p>
  {% endif %}

  <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-6">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("polish_groups.meta_visibility_label") }}</dt>
      <dd class="govuk-summary-list__value">{{ govukTag({
        text: t("groups.visibility_private") if isPrivate else t("groups.visibility_public"),
        classes: "govuk-tag--grey" if isPrivate else "govuk-tag--green"
      }) }}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("polish_groups.meta_members_label") }}</dt>
      <dd class="govuk-summary-list__value">
        {{ displayMemberCount }}
        {% if isAdmin %}&ensp;<a class="govuk-link" href="{{ urlFor('/groups/' + (group.id | string) + '/manage') }}">{{ t("polish_groups.meta_manage_link") }}</a>{% endif %}
      </dd>
    </div>
    {% if group.location %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("polish_groups.location_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ group.location }}</dd>
      </div>
    {% endif %}
    {% if group.createdAt or group.created_at %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("polish_groups.meta_created_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ group.createdAtLabel }}</dd>
      </div>
    {% endif %}
  </dl>

  <div class="govuk-!-margin-bottom-6">
    {% if isMember %}
      <div class="govuk-inset-text"><p class="govuk-body">{{ t("groups.you_are_member") }}</p></div>
      {# One list, not three consecutive single-link paragraphs: these are a set
         of related places to go, and a list says so to a screen reader ("list,
         3 items") as well as tightening the spacing. #}
      <ul class="govuk-list">
        <li><a class="govuk-link" href="{{ urlFor('/groups/' + (group.id | string) + '/discussions') }}">{{ t("groups.discussions.link") }}</a></li>
        <li><a class="govuk-link" href="{{ urlFor('/groups/' + (group.id | string) + '/notifications') }}">{{ t("govuk_alpha_groups.nav.notification_settings") }}</a></li>
        <li><a class="govuk-link" href="{{ urlFor('/groups/' + (group.id | string) + '/files') }}">{{ t("govuk_alpha_groups.files.nav_files") }}</a></li>
        <li><a class="govuk-link" href="{{ urlFor('/groups/' + (group.id | string) + '/announcements') }}">{{ t("govuk_alpha_groups.announcements.title") }}</a></li>
      </ul>
      <form method="post" action="{{ urlFor('/groups/' + (group.id | string) + '/leave') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ govukButton({ text: t("groups.leave"), classes: "govuk-button--warning govuk-!-margin-bottom-0" }) }}
      </form>
    {% elif isPending %}
      <div class="govuk-inset-text"><p class="govuk-body">{{ t("groups.pending_member") }}</p></div>
      {# React lets a member withdraw a pending request (27 Oct 2026). #}
      <form method="post" action="{{ urlFor('/groups/' + (group.id | string) + '/cancel-request') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ govukButton({ text: t("govuk_alpha_groups.membership.cancel_request"), classes: "govuk-button--secondary govuk-!-margin-bottom-0" }) }}
      </form>
    {% else %}
      <form method="post" action="{{ urlFor('/groups/' + (group.id | string) + '/join') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {{ govukButton({ text: t("groups.join"), classes: "govuk-!-margin-bottom-0" }) }}
      </form>
    {% endif %}
  </div>

  {% if isAdmin %}
    <div class="govuk-button-group govuk-!-margin-bottom-6">
      <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" href="{{ urlFor('/groups/' + (group.id | string) + '/edit') }}">{{ t("polish_groups.edit_link") }}</a>
      <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" href="{{ urlFor('/groups/' + (group.id | string) + '/manage') }}">{{ t("polish_groups.manage_link") }}</a>
      <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" href="{{ urlFor('/groups/' + (group.id | string) + '/invite') }}">{{ t("govuk_alpha_groups.nav.invite_members") }}</a>
      <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" href="{{ urlFor('/groups/' + (group.id | string) + '/image') }}">{{ t("govuk_alpha_groups.nav.group_image") }}</a>
      <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" href="{{ urlFor('/groups/' + (group.id | string) + '/announcements') }}">{{ t("govuk_alpha_groups.announcements.manage_link") }}</a>
      <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" href="{{ urlFor('/groups/' + (group.id | string) + '/welcome') }}">{{ t("govuk_alpha_groups.welcome.link") }}</a>
      <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" href="{{ urlFor('/groups/' + (group.id | string) + '/scheduled-posts') }}">{{ t("govuk_alpha_groups.scheduled.link") }}</a>
      {% for link in (sectionLinks.admin if sectionLinks else []) %}
      <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" href="{{ urlFor(link.path) }}">{{ t(link.key) }}</a>
      {% endfor %}
    </div>
  {% endif %}

  {% if pinnedAnnouncements and pinnedAnnouncements.length > 0 %}
    <h2 class="govuk-heading-l">{{ t("polish_groups.announcements_heading") }}</h2>
    <div class="nexus-alpha-card-list govuk-!-margin-bottom-6">
      {% for announcement in pinnedAnnouncements %}
        <article class="nexus-alpha-card">
          <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">
            {{ govukTag({ text: t("polish_groups.announcement_pinned_tag"), classes: "govuk-tag--blue" }) }}
          </p>
          <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ announcement.title }}</h3>
          {% if announcement.content %}<p class="govuk-body">{{ announcement.content }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
    {% if isMember %}
      <p class="govuk-body govuk-!-margin-bottom-6"><a class="govuk-link" href="{{ urlFor('/groups/' + (group.id | string) + '/announcements') }}">{{ t("govuk_alpha_groups.announcements.title") }}</a></p>
    {% endif %}
  {% endif %}

  {% if members.length > 0 %}
    <h2 class="govuk-heading-l">{{ t("groups.members_title") }}</h2>
    <ul class="govuk-list">
      {% for member in members %}
        {% set memberName = member.name or ((member.first_name or member.firstName or "") + " " + (member.last_name or member.lastName or "")) %}
        {% set memberId = member.user_id or member.userId or member.id %}
        {% if memberName | trim %}
          <li>{% if memberId %}<a class="govuk-link" href="{{ urlFor('/members/' + (memberId | string)) }}">{{ memberName | trim }}</a>{% else %}{{ memberName | trim }}{% endif %}</li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
  {% if groupCanParticipate or not isPrivate %}
    <p class="govuk-body govuk-!-margin-bottom-6"><a class="govuk-link" href="{{ urlFor('/groups/' + (group.id | string) + '/member-list') }}">{{ t("govuk_alpha_groups.members_page.link") }}</a></p>
  {% endif %}

  {% if sectionLinks and sectionLinks.member.length %}
    <nav aria-labelledby="group-sections-heading" class="govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m" id="group-sections-heading">{{ t("govuk_alpha_group_tools.sections_heading") }}</h2>
      <ul class="govuk-list">
        {% for link in sectionLinks.member %}
          <li><a class="govuk-link" href="{{ urlFor(link.path) }}">{{ t(link.key) }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

  {% if subGroups and subGroups.length > 0 %}
    <h2 class="govuk-heading-l" id="group-subgroups">{{ t("govuk_alpha_groups.subgroups.heading") }}</h2>
    <p class="govuk-body">{{ t("govuk_alpha_groups.subgroups.intro") }}</p>
    <div class="nexus-alpha-card-list govuk-!-margin-bottom-6">
      {% for subGroup in subGroups %}
        <article class="nexus-alpha-card">
          <div class="nexus-alpha-listing-row">
            {% if subGroup.imageUrl %}
              <div class="nexus-alpha-listing-row__media">
                <img class="nexus-alpha-card-thumb" src="{{ subGroup.imageUrl }}" alt="" width="120" height="90" loading="lazy" decoding="async">
              </div>
            {% endif %}
            <div class="nexus-alpha-listing-row__body">
              <h3 class="govuk-heading-m govuk-!-margin-bottom-1">
                <a class="govuk-link" href="{{ urlFor('/groups/' + (subGroup.id | string)) }}">{{ subGroup.name }}</a>
              </h3>
              <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">
                {{ govukTag({ text: t("govuk_alpha_groups.subgroups.visibility_private") if subGroup.isPrivate else t("govuk_alpha_groups.subgroups.visibility_public"), classes: ('govuk-tag--grey' if subGroup.isPrivate else 'govuk-tag--green') }) }}
                <span aria-hidden="true"> | </span>
                {{ tc("govuk_alpha_groups.subgroups.members_count", subGroup.memberCount, { count: subGroup.memberCount }) }}
              </p>
              {% if subGroup.description %}<p class="govuk-body">{{ subGroup.description | truncate(160) }}</p>{% endif %}
              <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor('/groups/' + (subGroup.id | string)) }}">{{ t("govuk_alpha_groups.subgroups.view_link") }}</a>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}

  <h2 class="govuk-heading-l" id="group-events">{{ t("groups_t1.events_title") }}</h2>
  <p class="govuk-body">{{ t("groups_t1.events_description") }}</p>
  {# The create handler always accepted a group; this is the entry point that
     was missing, so members could never actually make a group event. #}
  {% if groupCanParticipate and canCreateEvents %}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ urlFor('/events/new?group_id=' + (group.id | string)) }}">{{ t("groups_t1.create_event_link") }}</a>
    </p>
  {% endif %}
  {% if groupCanParticipate or not isPrivate %}
    <p class="govuk-body"><a class="govuk-link" href="{{ urlFor('/groups/' + (group.id | string) + '/events') }}">{{ t("govuk_alpha_groups.events_page.link") }}</a></p>
  {% endif %}
  {% if not groupCanParticipate and isPrivate %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("groups_t1.events_members_only") }}</p></div>
  {% elif events.length == 0 %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("groups_t1.events_empty") }}</p></div>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for event in events %}
        <article class="nexus-alpha-card">
          <div class="nexus-alpha-listing-row">
            {% if event.coverImage %}
              <div class="nexus-alpha-listing-row__media">
                <img class="nexus-alpha-card-thumb" src="{{ event.coverImage }}" alt="" width="120" height="90" loading="lazy" decoding="async">
              </div>
            {% endif %}
            <div class="nexus-alpha-listing-row__body">
              <h3 class="govuk-heading-m govuk-!-margin-bottom-2"><a class="govuk-link" href="{{ urlFor('/events/' + (event.id | string)) }}">{{ event.title }}</a></h3>
              <dl class="nexus-alpha-inline-list">
                {% if event.startsAt %}<div><dt>{{ t("groups_t1.event_starts") }}</dt><dd>{{ event.startsAt | formatBladeDateTime }}</dd></div>{% endif %}
                <div><dt>{{ t("groups_t1.event_location") }}</dt><dd>{{ event.location or t("groups_t1.event_online") }}</dd></div>
              </dl>
              <a class="govuk-link govuk-link--no-visited-state" href="{{ urlFor('/events/' + (event.id | string)) }}">{{ t("actions.view_details") }}</a>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if showFeed %}
  <h2 class="govuk-heading-l" id="group-feed">{{ t("groups_t1.feed_title") }}</h2>
  <p class="govuk-body">{{ t("groups_t1.feed_description") }}</p>
  {% if feedStatus %}
    {% if feedStatus.type == "error" %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h3 class="govuk-error-summary__title">{{ t("states.error_title") }}</h3>
          <div class="govuk-error-summary__body">
            {% if feedStatus.href %}
              <ul class="govuk-list govuk-error-summary__list"><li><a href="{{ feedStatus.href }}">{{ feedStatus.text }}</a></li></ul>
            {% else %}
              <p class="govuk-body">{{ feedStatus.text }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    {% else %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="grp-feed-action-status">
        <div class="govuk-notification-banner__header"><h3 class="govuk-notification-banner__title" id="grp-feed-action-status">{{ t("states.success_title") }}</h3></div>
        <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ feedStatus.text }}</p></div>
      </div>
    {% endif %}
  {% endif %}
  {% if not groupCanParticipate %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("groups_t1.feed_members_only") }}</p></div>
  {% else %}
    <form method="post" action="{{ urlFor('/groups/' + (group.id | string) + '/feed') }}" enctype="multipart/form-data" class="govuk-!-margin-bottom-7" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--m" for="group-feed-content">{{ t("groups_t1.compose_label") }}</label>
        <div id="group-feed-content-hint" class="govuk-hint">{{ t("groups_t1.compose_hint") }}</div>
        <textarea class="govuk-textarea" id="group-feed-content" name="content" rows="4" aria-describedby="group-feed-content-hint"></textarea>
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="group-feed-image">{{ t("groups_t1.compose_image_label") }}</label>
        <div id="group-feed-image-hint" class="govuk-hint">{{ t("groups_t1.compose_image_hint") }}</div>
        <input class="govuk-file-upload" id="group-feed-image" name="image" type="file" accept="image/jpeg,image/png,image/gif,image/webp" aria-describedby="group-feed-image-hint">
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="group-feed-image-alt">{{ t("groups_t1.compose_image_alt_label") }}</label>
        <div id="group-feed-image-alt-hint" class="govuk-hint">{{ t("groups_t1.compose_image_alt_hint") }}</div>
        <input class="govuk-input" id="group-feed-image-alt" name="image_alt" type="text" maxlength="500" aria-describedby="group-feed-image-alt-hint">
      </div>
      {# Up to ten photos per post, as React allows; each photo keeps its own
         description next to it. #}
      <details class="govuk-details" data-module="govuk-details">
        <summary class="govuk-details__summary"><span class="govuk-details__summary-text">{{ t("govuk_alpha_groups.compose.more_images_summary", { max: 10 }) }}</span></summary>
        <div class="govuk-details__text">
          {% for number in range(2, 11) %}
            <div class="govuk-form-group">
              <label class="govuk-label" for="group-feed-image-{{ number }}">{{ t("govuk_alpha_groups.compose.image_n_label", { number: number }) }}</label>
              <input class="govuk-file-upload" id="group-feed-image-{{ number }}" name="image_{{ number }}" type="file" accept="image/jpeg,image/png,image/gif,image/webp">
            </div>
            <div class="govuk-form-group">
              <label class="govuk-label" for="group-feed-image-{{ number }}-alt">{{ t("govuk_alpha_groups.compose.image_n_alt_label", { number: number }) }}</label>
              <input class="govuk-input" id="group-feed-image-{{ number }}-alt" name="image_{{ number }}_alt" type="text" maxlength="500">
            </div>
          {% endfor %}
        </div>
      </details>
      <details class="govuk-details" data-module="govuk-details">
        <summary class="govuk-details__summary"><span class="govuk-details__summary-text">{{ t("govuk_alpha_groups.compose.schedule_summary") }}</span></summary>
        <div class="govuk-details__text">
          {{ nexusDateTimeInput({
            name: "schedule",
            idPrefix: "group-feed-schedule",
            legend: t("govuk_alpha_groups.compose.schedule_legend"),
            hint: t("govuk_alpha_groups.compose.schedule_hint")
          }, t) }}
        </div>
      </details>
      <button class="govuk-button" data-module="govuk-button">{{ t("groups_t1.compose_submit") }}</button>
    </form>

    {% if canCreatePolls %}
      <h3 class="govuk-heading-m" id="group-poll">{{ t("govuk_alpha_groups.poll.heading") }}</h3>
      <form method="post" action="{{ urlFor('/groups/' + (group.id | string) + '/feed/polls') }}" class="govuk-!-margin-bottom-7" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="govuk-form-group">
          <label class="govuk-label" for="group-poll-question">{{ t("govuk_alpha_groups.poll.question_label") }}</label>
          <input class="govuk-input" id="group-poll-question" name="question" type="text" maxlength="500">
        </div>
        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset" aria-describedby="group-poll-options-hint">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_groups.poll.options_legend") }}</legend>
            <div id="group-poll-options-hint" class="govuk-hint">{{ t("govuk_alpha_groups.poll.options_hint", { max: 6 }) }}</div>
            {% for number in range(1, 7) %}
              <div class="govuk-form-group">
                <label class="govuk-label" for="group-poll-option-{{ number }}">{{ t("govuk_alpha_groups.poll.option_label", { number: number }) }}</label>
                <input class="govuk-input govuk-!-width-two-thirds" id="group-poll-option-{{ number }}" name="option_{{ number }}" type="text" maxlength="200">
              </div>
            {% endfor %}
          </fieldset>
        </div>
        {{ nexusDateInput({
          name: "expires_at",
          idPrefix: "group-poll-expires",
          legend: t("govuk_alpha_groups.poll.expires_legend"),
          hint: t("govuk_alpha_groups.poll.expires_hint")
        }, t) }}
        <button class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("govuk_alpha_groups.poll.submit") }}</button>
      </form>
    {% endif %}

    {% if groupFeed.length == 0 %}
      <div class="govuk-inset-text"><p class="govuk-body">{{ t("groups_t1.feed_empty") }}</p></div>
    {% else %}
      <div class="nexus-alpha-card-list">
        {% for post in groupFeed %}
          {{ groupFeedItem(post, group, feedCursor, csrfToken, urlFor, t, tc) }}
        {% endfor %}
      </div>
      {% if feedNextHref %}
        <nav class="govuk-pagination govuk-pagination--block govuk-!-margin-top-6" aria-label="{{ t('feed.pagination_label') }}">
          <div class="govuk-pagination__next">
            <a class="govuk-link govuk-pagination__link" href="{{ urlFor(feedNextHref) }}" rel="next">
              <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path></svg>
              <span class="govuk-pagination__link-title">{{ t("actions.load_more") }}</span>
              <span class="govuk-visually-hidden">:</span>
              <span class="govuk-pagination__link-label">{{ t("feed.more_results_label") }}</span>
            </a>
          </div>
        </nav>
      {% endif %}
    {% endif %}
  {% endif %}
  {% endif %}
{% endblock %}

{% extends "layouts/base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set base = '/groups/' + (group.id | string) + '/tasks' %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor(base) }}">{{ t("govuk_alpha_group_tools.tasks.back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">{{ group.name }}</span>
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_group_tools.tasks.delete_title") }}</h1>
      {{ govukWarningText({ text: t("govuk_alpha_group_tools.tasks.delete_confirm", { name: task.title }), iconFallbackText: t("govuk_alpha_groups.common.warning") }) }}
      <form method="post" action="{{ urlFor(base + '/' + (task.id | string) + '/delete') }}">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="govuk-button-group">
          {{ govukButton({ text: t("govuk_alpha_group_tools.tasks.delete"), classes: "govuk-button--warning" }) }}
          <a class="govuk-link" href="{{ urlFor(base) }}">{{ t("govuk_alpha_group_tools.common.cancel") }}</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

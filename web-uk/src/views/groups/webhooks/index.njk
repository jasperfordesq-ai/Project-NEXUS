{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/groups/' + (group.id | string)) }}">{{ t("govuk_alpha_groups.common.back_to_group") }}</a>
{% endblock %}

{% block mainContent %}
  {% set hooksBase = '/groups/' + (group.id | string) + '/webhooks' %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_group_media.webhooks.caption", { group: group.name }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_group_media.webhooks.title") }}</h1>

  {% include "groups/gallery/_status-banner.njk" %}

  <p class="govuk-body">{{ t("govuk_alpha_group_media.webhooks.intro") }}</p>
  <a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="{{ urlFor(hooksBase + '/new') }}">{{ t("govuk_alpha_group_media.webhooks.add_link") }}</a>

  {% if not webhooks.length %}
    <p class="govuk-body">{{ t("govuk_alpha_group_media.webhooks.empty") }}</p>
  {% else %}
    {% for hook in webhooks %}
      <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title" style="overflow-wrap:anywhere">{{ hook.url }}</h2>
        </div>
        <div class="govuk-summary-card__content">
          <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t("govuk_alpha_group_media.webhooks.row_status") }}</dt>
              <dd class="govuk-summary-list__value">
                {% if hook.isActive %}{{ govukTag({ text: t("govuk_alpha_group_media.webhooks.active"), classes: "govuk-tag--green" }) }}{% else %}{{ govukTag({ text: t("govuk_alpha_group_media.webhooks.inactive"), classes: "govuk-tag--grey" }) }}{% endif %}
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t("govuk_alpha_group_media.webhooks.row_events") }}</dt>
              <dd class="govuk-summary-list__value">
                <ul class="govuk-list govuk-!-margin-bottom-0">
                  {% for label in hook.eventLabels %}<li>{{ label }}</li>{% endfor %}
                </ul>
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t("govuk_alpha_group_media.webhooks.row_last_fired") }}</dt>
              <dd class="govuk-summary-list__value">{{ hook.lastFiredLabel or t("govuk_alpha_group_media.webhooks.never") }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t("govuk_alpha_group_media.webhooks.row_failures") }}</dt>
              <dd class="govuk-summary-list__value">{{ hook.failureCount }}</dd>
            </div>
          </dl>
          <div class="govuk-button-group">
            <form method="post" action="{{ urlFor(hooksBase + '/' + (hook.id | string) + '/toggle') }}">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <input type="hidden" name="is_active" value="{{ '0' if hook.isActive else '1' }}">
              <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{% if hook.isActive %}{{ t("govuk_alpha_group_media.webhooks.turn_off") }}{% else %}{{ t("govuk_alpha_group_media.webhooks.turn_on") }}{% endif %}<span class="govuk-visually-hidden">: {{ hook.url }}</span></button>
            </form>
            <a class="govuk-link" href="{{ urlFor(hooksBase + '/' + (hook.id | string) + '/delete') }}">{{ t("govuk_alpha_group_media.webhooks.delete_link") }}<span class="govuk-visually-hidden">: {{ hook.url }}</span></a>
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}
{% endblock %}

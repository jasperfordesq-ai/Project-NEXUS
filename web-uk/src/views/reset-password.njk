{% extends "layouts/base.njk" %}

{# titleErrorPrefix comes from layouts/base.njk — keep it on any pageTitle override. #}
{% block pageTitle %}{{ titleErrorPrefix }}{{ t("auth.reset_title") }} - {{ serviceName }}{% endblock %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/login') }}">{{ t("auth.back_to_sign_in") }}</a>
{% endblock %}

{% block mainContent %}
  {# GDS: back link at the top of a question page, consistent position. #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errors and errors.length %}
        {{ govukErrorSummary({
          titleText: t("states.error_title"),
          errorList: errors,
          attributes: { tabindex: "-1" }
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">{{ t("auth.reset_title") }}</h1>

      <p class="govuk-body">
        {{ t("auth.reset_description") }}
      </p>

      <form method="post" action="{{ urlFor(formAction or '/password/reset') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="token" value="{{ resetToken }}">

        {{ govukInput({
          label: {
            text: t("auth.reset_password_label"),
            classes: "govuk-label--m"
          },
          hint: {
            text: t("auth.reset_password_hint")
          },
          id: "password",
          name: "password",
          type: "password",
          autocomplete: "new-password",
          spellcheck: false,
          errorMessage: { visuallyHiddenText: t("states.error_prefix") | replace(":", "") | trim, text: fieldErrors.password } if fieldErrors.password else undefined,
          describedBy: "password-strength-msg",
          attributes: {
            "minlength": "12"
          }
        }) }}
        <p id="password-strength-msg" class="govuk-body-s govuk-!-margin-top-2" aria-live="polite"
          data-msg-idle="{{ t('auth.password_strength.idle') }}"
          data-msg-too-short="{{ t('auth.password_strength.too_short') }}"
          data-msg-checking="{{ t('auth.password_strength.checking') }}"
          data-msg-breached="{{ t('auth.password_strength.breached') }}"
          data-msg-strong="{{ t('auth.password_strength.strong') }}"></p>
        <script src="/js/password-strength.js" defer></script>

        {{ govukInput({
          label: {
            text: t("auth.reset_confirm_label"),
            classes: "govuk-label--m"
          },
          id: "password_confirmation",
          name: "password_confirmation",
          type: "password",
          autocomplete: "new-password",
          spellcheck: false,
          errorMessage: { visuallyHiddenText: t("states.error_prefix") | replace(":", "") | trim, text: fieldErrors.password_confirmation } if fieldErrors.password_confirmation else undefined,
          attributes: {
            "required": "required"
          }
        }) }}

        {{ govukButton({
          text: t("auth.reset_submit")
        }) }}
      </form>

      <p class="govuk-body govuk-!-margin-top-6">
        <a href="{{ urlFor('/login') }}" class="govuk-link">{{ t("auth.back_to_sign_in") }}</a>
      </p>

    </div>
  </div>
{% endblock %}

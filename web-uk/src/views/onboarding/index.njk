{% extends "layouts/base.njk" %}
{% from "_character-count.njk" import characterCount %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block mainContent %}
  {% set bagOffers = bag.offerSkills or [] %}
  {% set bagNeeds = bag.needSkills or [] %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ t("govuk_alpha.onboarding.caption", { community: communityName }) }} — {{ t("govuk_alpha.onboarding.progress", { current: stepNumber, total: totalSteps }) }}</span>

      {% if statusBanner and statusBanner.type == "error" %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
            <div class="govuk-error-summary__body">
              <ul class="govuk-list govuk-error-summary__list">
                <li>
                  {% if statusBanner.anchor %}
                    <a href="#{{ statusBanner.anchor }}">{{ statusBanner.message }}</a>
                  {% else %}
                    {{ statusBanner.message }}
                  {% endif %}
                </li>
              </ul>
            </div>
          </div>
        </div>
      {% elif statusBanner and statusBanner.type == "success" %}
        <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="ob-status">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="ob-status">{{ t("states.success_title") }}</h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">{{ statusBanner.message }}</p>
          </div>
        </div>
      {% endif %}

      {% if step == "welcome" %}
        <h1 class="govuk-heading-xl">{{ t("onboarding.welcome.title") }}</h1>
        <p class="govuk-body-l">{{ t("onboarding.welcome.body") }}</p>
        <ul class="govuk-list govuk-list--bullet">
          <li>{{ t("onboarding.welcome.benefit_earn") }}</li>
          <li>{{ t("onboarding.welcome.benefit_community") }}</li>
          <li>{{ t("onboarding.welcome.benefit_skills") }}</li>
        </ul>
        <form method="post" action="{{ urlFor('/onboarding/welcome') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="govuk-button" data-module="govuk-button">{{ t("onboarding.welcome.start") }}</button>
        </form>

      {% elif step == "profile" %}
        <h1 class="govuk-heading-xl">{{ t("govuk_alpha.onboarding.profile.title") }}</h1>
        <p class="govuk-body">{{ t("onboarding.profile.hint") }}</p>

        <form method="post" action="{{ urlFor('/onboarding/avatar') }}" enctype="multipart/form-data" class="govuk-!-margin-bottom-6" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <div class="govuk-form-group{% if statusBanner and statusBanner.anchor == 'avatar' %} govuk-form-group--error{% endif %}">
            <label class="govuk-label govuk-label--s" for="avatar">{{ t("govuk_alpha.onboarding.profile.avatar_label") }}</label>
            <div id="avatar-hint" class="govuk-hint">{{ t("onboarding.profile.avatar_hint") }}</div>
            {% if statusBanner and statusBanner.anchor == "avatar" %}
              <p id="avatar-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ statusBanner.message }}</p>
            {% endif %}
            {% if onboardingUser.avatar_url %}
              <p class="govuk-body-s nexus-alpha-meta">{{ t("govuk_alpha.onboarding.profile.current_photo") }}</p>
              <img class="nexus-alpha-avatar nexus-alpha-avatar--large govuk-!-margin-bottom-2" src="{{ onboardingUser.avatar_url | thumb(128, 128) }}" alt="" width="96" height="96">
            {% endif %}
            <input class="govuk-file-upload" id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/gif,image/webp" aria-describedby="avatar-hint{% if statusBanner and statusBanner.anchor == 'avatar' %} avatar-error{% endif %}">
          </div>
          <button class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("onboarding.profile.upload_button") }}</button>
        </form>

        <form method="post" action="{{ urlFor('/onboarding/profile') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          {% call characterCount(2000, characterCountMessages, "bio") %}
          <div class="govuk-form-group{% if statusBanner and statusBanner.anchor == 'bio' %} govuk-form-group--error{% endif %}">
            <label class="govuk-label govuk-label--s" for="bio">{{ t("govuk_alpha.onboarding.profile.bio_label") }}</label>
            <div id="bio-hint" class="govuk-hint">{{ t("onboarding.profile.bio_hint") }}</div>
            {% if statusBanner and statusBanner.anchor == "bio" %}
              <p id="bio-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ statusBanner.message }}</p>
            {% endif %}
            <textarea class="govuk-textarea govuk-js-character-count" id="bio" name="bio" rows="4" maxlength="2000" aria-describedby="bio-hint{% if statusBanner and statusBanner.anchor == 'bio' %} bio-error{% endif %} bio-info">{{ onboardingUser.bio or "" }}</textarea>
          </div>
          {% endcall %}

          {# Only a member whose location is empty is asked (`location_missing` is
             decided on the server; only a literal true counts). Plain free text —
             there is no suggestion list on this site and no JavaScript is needed. #}
          {% if onboardingUser.location_missing === true %}
            {{ govukInput({
              label: { text: t("govuk_alpha.onboarding.profile.location_label"), classes: "govuk-label--s" },
              hint: { text: t("govuk_alpha.onboarding.profile.location_hint") },
              id: "location",
              name: "location",
              autocomplete: "address-level2",
              classes: "govuk-!-width-two-thirds",
              errorMessage: { visuallyHiddenText: t("states.error_prefix") | replace(":", "") | trim, text: statusBanner.message } if (statusBanner and statusBanner.anchor == "location") else undefined,
              attributes: { maxlength: "255" }
            }) }}
          {% endif %}
          <button class="govuk-button" data-module="govuk-button">{{ t("onboarding.profile.save_continue") }}</button>
        </form>

      {#
        Skills are saved by NAME into the member's skills (user_skills), as the
        React wizard has done since 2026-10-02: matching, Explore and the
        personalised feed read them. The community's listing categories are
        offered as ready-made suggestions; anything else is typed in. The old
        "Your interests" step is gone — nothing ever read its answers.
      #}
      {% elif step == "skills" %}
        <h1 class="govuk-heading-xl">{{ t("govuk_alpha.onboarding.skills.title") }}</h1>
        <p class="govuk-body">{{ t("govuk_alpha.onboarding.skills.intro") }}</p>
        <form method="post" action="{{ urlFor('/onboarding/skills') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          {% for direction in [
            { key: "offers", field: "offers", selected: bagOffers, label: t("onboarding.skills.offers_label"), hint: t("onboarding.skills.offers_hint"), otherLabel: t("govuk_alpha.onboarding.skills.offers_other_label") },
            { key: "needs", field: "needs", selected: bagNeeds, label: t("onboarding.skills.needs_label"), hint: t("onboarding.skills.needs_hint"), otherLabel: t("govuk_alpha.onboarding.skills.needs_other_label") }
          ] %}
          <div class="govuk-form-group">
            <fieldset class="govuk-fieldset" aria-describedby="{{ direction.key }}-hint">
              <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">{{ direction.label }}</legend>
              <div id="{{ direction.key }}-hint" class="govuk-hint">{{ direction.hint }}</div>
              {% if skillChoices and skillChoices.length %}
              <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                {% for choice in skillChoices %}
                  <div class="govuk-checkboxes__item">
                    <input class="govuk-checkboxes__input" id="{{ direction.key }}-{{ choice.id }}" name="{{ direction.field }}[]" type="checkbox" value="{{ choice.name }}"{% if choice.name in direction.selected %} checked{% endif %}>
                    <label class="govuk-label govuk-checkboxes__label" for="{{ direction.key }}-{{ choice.id }}">{{ choice.name }}</label>
                  </div>
                {% endfor %}
              </div>
              {% endif %}
              <div class="govuk-form-group govuk-!-margin-top-4 govuk-!-margin-bottom-0">
                <label class="govuk-label" for="{{ direction.key }}-other">{{ direction.otherLabel }}</label>
                <div id="{{ direction.key }}-other-hint" class="govuk-hint">{{ t("govuk_alpha.onboarding.skills.other_hint") }}</div>
                <input class="govuk-input" id="{{ direction.key }}-other" name="{{ direction.field }}_other" type="text" spellcheck="true" aria-describedby="{{ direction.key }}-other-hint">
              </div>
            </fieldset>
          </div>
          {% endfor %}

          <button class="govuk-button" data-module="govuk-button">{{ t("onboarding.continue") }}</button>
        </form>

      {% elif step == "safeguarding" %}
        {% set noneOption = null %}
        <h1 class="govuk-heading-xl">{{ t("govuk_alpha.onboarding.safeguarding.title") }}</h1>
        <p class="govuk-body">{{ t("onboarding.safeguarding.intro") }}</p>
        <div class="govuk-inset-text">{{ t("onboarding.safeguarding.gdpr_notice") }}</div>

        <form method="post" action="{{ urlFor('/onboarding/safeguarding') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">

          {# `option_type: "info"` rows are explanatory prose, not answers to the
             legend's question, so they are read before the fieldset rather than
             being nested inside `.govuk-checkboxes` (which only accepts
             __item / __divider / __conditional children). #}
          {% for option in safeguardingOptions %}
            {% if option.option_key != "none_apply" and option.option_type == "info" %}
              <div class="govuk-inset-text">
                <p class="govuk-body govuk-!-margin-bottom-0">{{ option.label }}{% if option.description %} — {{ option.description }}{% endif %}</p>
              </div>
            {% endif %}
          {% endfor %}

          {% set safeguardingError = statusBanner and statusBanner.type == "error" and statusBanner.field == "safeguarding" %}
          <div class="govuk-form-group{% if safeguardingError %} govuk-form-group--error{% endif %}">
          <fieldset class="govuk-fieldset"{% if safeguardingError %} aria-describedby="safeguarding-error"{% endif %}>
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">{{ t("govuk_alpha.onboarding.safeguarding.options_legend") }}</legend>
            {% if safeguardingError %}
              <p id="safeguarding-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ statusBanner.message }}</p>
            {% endif %}
            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
              {% for option in safeguardingOptions %}
                {% if option.option_key == "none_apply" %}
                  {% set noneOption = option %}
                {% elif option.option_type != "info" and option.option_type != "select" %}
                  <div class="govuk-checkboxes__item">
                    {% set describedBy = "" %}
                    {% if option.description %}{% set describedBy = describedBy ~ " sg-" ~ option.id ~ "-hint" %}{% endif %}
                    {% if option.effects.length %}{% set describedBy = describedBy ~ " sg-" ~ option.id ~ "-effects" %}{% endif %}
                    {% if option.help_url %}{% set describedBy = describedBy ~ " sg-" ~ option.id ~ "-help" %}{% endif %}
                    <input class="govuk-checkboxes__input" id="sg-{{ option.id }}" name="safeguarding[{{ option.id }}]" type="checkbox" value="1"{% if describedBy %} aria-describedby="{{ describedBy | trim }}"{% endif %}>
                    <label class="govuk-label govuk-checkboxes__label" for="sg-{{ option.id }}">{{ option.label }}</label>
                    {% if option.description %}<div id="sg-{{ option.id }}-hint" class="govuk-hint govuk-checkboxes__hint">{{ option.description }}</div>{% endif %}
                    {# What ticking this really does, in the API's own translated
                       words. Read out with the checkbox via aria-describedby. #}
                    {% if option.effects.length %}
                      <div id="sg-{{ option.id }}-effects" class="govuk-hint govuk-checkboxes__hint">
                        <p class="govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ t("profile_settings.safeguarding.effects_heading") }}</p>
                        <ul class="govuk-list govuk-list--bullet govuk-body-s govuk-!-margin-bottom-0">
                          {% for effect in option.effects %}
                            <li>{{ effect }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}
                    {% if option.help_url %}<div id="sg-{{ option.id }}-help" class="govuk-hint govuk-checkboxes__hint"><a class="govuk-link" href="{{ option.help_url }}" rel="noopener">{{ t("govuk_alpha.help.title") }}</a></div>{% endif %}
                  </div>
                {% endif %}
              {% endfor %}

              {# "None of these apply" is the exclusive answer to the SAME question,
                 so it stays inside this fieldset behind the GDS "or" divider. It
                 used to sit in a second .govuk-checkboxes outside the fieldset,
                 where the legend was never announced for it. #}
              {% if noneOption %}
                <div class="govuk-checkboxes__divider">{{ t("onboarding.safeguarding.none_separator") }}</div>
                <div class="govuk-checkboxes__item">
                  <input class="govuk-checkboxes__input" id="sg-{{ noneOption.id }}" name="safeguarding[{{ noneOption.id }}]" type="checkbox" value="1">
                  <label class="govuk-label govuk-checkboxes__label" for="sg-{{ noneOption.id }}">{{ noneOption.label or t("govuk_alpha.onboarding.safeguarding.none_label") }}</label>
                </div>
              {% endif %}
            </div>
          </fieldset>
          </div>

          {# Each `option_type: "select"` row is its own labelled question, so it
             gets its own form group after the checkbox fieldset. #}
          {% for option in safeguardingOptions %}
            {% if option.option_key != "none_apply" and option.option_type == "select" %}
              <div class="govuk-form-group govuk-!-margin-top-4">
                <label class="govuk-label" for="sg-{{ option.id }}">{{ option.label }}</label>
                {% if option.description %}<div id="sg-{{ option.id }}-hint" class="govuk-hint">{{ option.description }}</div>{% endif %}
                {% if option.effects.length %}
                  <div id="sg-{{ option.id }}-effects" class="govuk-hint">
                    <p class="govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ t("profile_settings.safeguarding.effects_heading") }}</p>
                    <ul class="govuk-list govuk-list--bullet govuk-body-s govuk-!-margin-bottom-0">
                      {% for effect in option.effects %}
                        <li>{{ effect }}</li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
                {% set selectDescribedBy = "" %}
                {% if option.description %}{% set selectDescribedBy = selectDescribedBy ~ " sg-" ~ option.id ~ "-hint" %}{% endif %}
                {% if option.effects.length %}{% set selectDescribedBy = selectDescribedBy ~ " sg-" ~ option.id ~ "-effects" %}{% endif %}
                <select class="govuk-select" id="sg-{{ option.id }}" name="safeguarding[{{ option.id }}]"{% if selectDescribedBy %} aria-describedby="{{ selectDescribedBy | trim }}"{% endif %}>
                  <option value="">{{ t("govuk_alpha.onboarding.safeguarding.select_none") }}</option>
                  {% for value, label in option.select_options %}
                    <option value="{{ value }}">{{ label }}</option>
                  {% endfor %}
                </select>
              </div>
            {% endif %}
          {% endfor %}

          <div class="govuk-button-group govuk-!-margin-top-4">
            <button class="govuk-button" data-module="govuk-button">{{ t("onboarding.continue") }}</button>
            {% if not stepRequired %}
              <button class="govuk-button govuk-button--secondary" name="skip" value="1" data-module="govuk-button">{{ t("onboarding.skip") }}</button>
            {% endif %}
          </div>
        </form>

      {% else %}
        <h1 class="govuk-heading-xl">{{ t("onboarding.confirm.title") }}</h1>
        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">{{ t("govuk_alpha.onboarding.confirm.photo_row") }}</dt>
            <dd class="govuk-summary-list__value">{% if onboardingUser.avatar_url %}{{ t("govuk_alpha.onboarding.confirm.photo_added") }}{% else %}{{ t("govuk_alpha.onboarding.confirm.photo_missing") }}{% endif %}</dd>
            {# Five "Change" links share one accessible name without the hidden
               row context (GDS check-your-answers pattern; WCAG 2.4.4). #}
            <dd class="govuk-summary-list__actions"><a class="govuk-link" href="{{ urlFor('/onboarding/profile') }}">{{ t("govuk_alpha.onboarding.confirm.change") }}<span class="govuk-visually-hidden"> — {{ t("govuk_alpha.onboarding.confirm.photo_row") }}</span></a></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">{{ t("onboarding.confirm.bio_row") }}</dt>
            <dd class="govuk-summary-list__value">{{ (onboardingUser.bio or "") | truncate(120, true, '...') }}</dd>
            <dd class="govuk-summary-list__actions"><a class="govuk-link" href="{{ urlFor('/onboarding/profile') }}">{{ t("govuk_alpha.onboarding.confirm.change") }}<span class="govuk-visually-hidden"> — {{ t("onboarding.confirm.bio_row") }}</span></a></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">{{ t("onboarding.confirm.skills_offers_row") }}</dt>
            <dd class="govuk-summary-list__value">{{ bagOffers | join(", ") if bagOffers.length else t("govuk_alpha.onboarding.count_selected", { count: 0 }) }}</dd>
            <dd class="govuk-summary-list__actions"><a class="govuk-link" href="{{ urlFor('/onboarding/skills') }}">{{ t("govuk_alpha.onboarding.confirm.change") }}<span class="govuk-visually-hidden"> — {{ t("onboarding.confirm.skills_offers_row") }}</span></a></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">{{ t("onboarding.confirm.skills_needs_row") }}</dt>
            <dd class="govuk-summary-list__value">{{ bagNeeds | join(", ") if bagNeeds.length else t("govuk_alpha.onboarding.count_selected", { count: 0 }) }}</dd>
            <dd class="govuk-summary-list__actions"><a class="govuk-link" href="{{ urlFor('/onboarding/skills') }}">{{ t("govuk_alpha.onboarding.confirm.change") }}<span class="govuk-visually-hidden"> — {{ t("onboarding.confirm.skills_needs_row") }}</span></a></dd>
          </div>
        </dl>
        <p class="govuk-body">{{ t("onboarding.confirm.finish_note") }}</p>
        <form method="post" action="{{ urlFor('/onboarding/confirm') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="govuk-button" data-module="govuk-button">{{ t("onboarding.confirm.complete_button") }}</button>
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}

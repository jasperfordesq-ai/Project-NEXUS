{#
    Your caring relationships, and requests about you.

    Two audiences on one page, as in React: relationships this member ASKED FOR,
    and requests where this member is the person being cared for and is the only
    one who can answer.

    🔴 Every action is a plain form POST with a submit button. Agreeing and
    refusing both work with JavaScript switched off, which matters more here
    than on most pages: the people these relationships are about are exactly the
    people most likely to be on assistive technology or an old browser.

    🔴 The tools an ACTIVE relationship unlocks are rendered from `link.isActive`
    and nothing else. A pending or refused relationship must show no route into
    them at all — not a disabled one.
#}

{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% import "caring/_status.njk" as caring %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/caring') }}">{{ t("govuk_alpha_caring.shared.back_to_caring") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {{ caring.caringStatus(statusKey, statusIsSuccess, statusIsError, t) }}

      <span class="govuk-caption-xl">{{ t("govuk_alpha_caring.caregiver.caption") }}</span>
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_caring.caregiver.title") }}</h1>

      {# Requests awaiting THIS member's answer come first: they are the only
         thing on this page that needs a decision from them. #}
      <h2 class="govuk-heading-l" id="caring-incoming">{{ t("govuk_alpha_caring.caregiver.incoming_title") }}</h2>
      {% if not incoming.length %}
        <p class="govuk-inset-text">{{ t("govuk_alpha_caring.caregiver.incoming_none") }}</p>
      {% else %}
        <p class="govuk-body">{{ t("govuk_alpha_caring.caregiver.incoming_intro") }}</p>
        {% for request in incoming %}
          {% set requesterName = request.caregiver_name or t("govuk_alpha_caring.shared.unknown_member") %}
          <div class="govuk-summary-card" data-caring-incoming="{{ request.id }}">
            <div class="govuk-summary-card__title-wrapper">
              <h3 class="govuk-summary-card__title">{{ requesterName }}</h3>
            </div>
            <div class="govuk-summary-card__content">
              <p class="govuk-body">{{ t("govuk_alpha_caring.caregiver.incoming_explanation") }}</p>

              <div class="govuk-button-group">
                <form method="post" action="{{ urlFor('/caring/caregiver/incoming/respond') }}">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="hidden" name="link_id" value="{{ request.id }}">
                  <input type="hidden" name="action" value="confirm">
                  <button class="govuk-button" data-module="govuk-button" type="submit">
                    {{ t("govuk_alpha_caring.caregiver.confirm_button") }}
                  </button>
                </form>

                <form method="post" action="{{ urlFor('/caring/caregiver/incoming/respond') }}">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="hidden" name="link_id" value="{{ request.id }}">
                  <input type="hidden" name="action" value="reject">
                  <button class="govuk-button govuk-button--warning" data-module="govuk-button" type="submit">
                    {{ t("govuk_alpha_caring.caregiver.reject_button") }}
                  </button>
                </form>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}

      <h2 class="govuk-heading-l govuk-!-margin-top-8" id="caring-mine">{{ t("govuk_alpha_caring.caregiver.intro") }}</h2>

      {% if not links.length %}
        <p class="govuk-inset-text">{{ t("govuk_alpha_caring.caregiver.none") }}</p>
      {% else %}
        {% for link in links %}
          {% set caredForName = link.cared_for_name or t("govuk_alpha_caring.shared.unknown_member") %}
          <div class="govuk-summary-card" data-caring-link="{{ link.id }}" data-caring-status="{{ link.status }}">
            <div class="govuk-summary-card__title-wrapper">
              <h3 class="govuk-summary-card__title">{{ caredForName }}</h3>
            </div>
            <div class="govuk-summary-card__content">
              <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                  <dt class="govuk-summary-list__key">{{ t("govuk_alpha_caring.caregiver.status_heading") }}</dt>
                  <dd class="govuk-summary-list__value">
                    {{ govukTag({ text: t("govuk_alpha_caring.caregiver." + link.stageKey), classes: link.tagClass }) }}
                  </dd>
                </div>
                <div class="govuk-summary-list__row">
                  <dt class="govuk-summary-list__key">{{ t("govuk_alpha_caring.caregiver.relationship_heading") }}</dt>
                  <dd class="govuk-summary-list__value">{{ t("govuk_alpha_caring.caregiver.relationship_" + link.relationship_type) }}</dd>
                </div>
                {% if link.startedLabel %}
                  <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">{{ t("govuk_alpha_caring.caregiver.started_heading") }}</dt>
                    <dd class="govuk-summary-list__value">{{ link.startedLabel }}</dd>
                  </div>
                {% endif %}
                {% if link.status === 'rejected' and link.rejection_reason %}
                  <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">{{ t("govuk_alpha_caring.caregiver.reason_heading") }}</dt>
                    <dd class="govuk-summary-list__value">{{ link.rejection_reason }}</dd>
                  </div>
                {% endif %}
              </dl>

              {% if link.isActive %}
                <h4 class="govuk-heading-s">{{ t("govuk_alpha_caring.caregiver.active_tools_title") }}</h4>
                <a class="govuk-link" href="{{ urlFor('/caring/caregiver/on-behalf/' + (link.cared_for_id | string)) }}">
                  {{ t("govuk_alpha_caring.caregiver.request_on_behalf_link") }}
                </a>
              {% else %}
                {# Said plainly rather than left to inference. A member who has
                   asked to care for someone should not have to work out from an
                   absence that they currently hold nothing. #}
                <p class="govuk-body-s">{{ t("govuk_alpha_caring.caregiver.pending_no_tools") }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}

      <a class="govuk-button govuk-button--secondary govuk-!-margin-top-4" data-module="govuk-button" href="{{ urlFor('/caring/caregiver/link') }}">
        {{ t("govuk_alpha_caring.caregiver.become_button") }}
      </a>

    </div>
  </div>
{% endblock %}

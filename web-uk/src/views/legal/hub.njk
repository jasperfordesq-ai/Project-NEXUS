{% extends "layouts/base.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">{{ t("legal.caption", { community: communityName }) }}</span>
      <h1 class="govuk-heading-xl">{{ t("legal.hub_title") if t else title }}</h1>
      <p class="govuk-body-l">{{ t("legal.hub_intro", { name: communityName }) }}</p>

      {# section, not a bare div: aria-label is prohibited on role-less generic
         elements and was silently ignored. #}
      <section class="nexus-alpha-card-list" aria-label="{{ t("polish_federation.legal_hub_list_label") }}">
        {% for document in documents %}
          <article class="nexus-alpha-card">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-1">
              <a class="govuk-link" href="{{ urlFor(document.path) }}">{{ document.title }}</a>
            </h2>
            <p class="govuk-body govuk-!-margin-bottom-0">{{ document.summary }}</p>
          </article>
        {% endfor %}
      </section>

      {#
        The platform provider's own documents, kept apart from the community's
        policies above as React's legal hub keeps them ("Platform Provider Legal").
      #}
      {% if platformDocuments and platformDocuments.length %}
        <h2 class="govuk-heading-l govuk-!-margin-top-8">{{ t("govuk_alpha_platform_legal.hub.section_title") }}</h2>
        <p class="govuk-body">{{ t("govuk_alpha_platform_legal.hub.section_desc") }}</p>
        <ul class="govuk-list">
          {% for document in platformDocuments %}
            <li><a class="govuk-link" href="{{ urlFor(document.path) }}">{{ document.title }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endblock %}

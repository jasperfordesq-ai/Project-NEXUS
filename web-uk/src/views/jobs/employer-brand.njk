{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/jobs') }}">{{ t("govuk_alpha_jobs.shared.back_to_jobs") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="nexus-alpha-module-row govuk-!-margin-bottom-2">
    {% if employer.avatarUrl %}
      <img class="nexus-alpha-avatar" src="{{ employer.avatarUrl | thumb(80, 80) }}" alt="" aria-hidden="true" loading="lazy" decoding="async" width="64" height="64">
    {% else %}
      <span class="nexus-alpha-avatar nexus-alpha-avatar--placeholder" aria-hidden="true">{{ employer.initial }}</span>
    {% endif %}
    <div>
      <span class="govuk-caption-xl">{{ t("govuk_alpha_jobs.employer.title") }}</span>
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-1">{{ employer.name }}</h1>
      {% if employer.headline %}
        <p class="govuk-body-l govuk-!-margin-bottom-0">{{ employer.headline }}</p>
      {% endif %}
    </div>
  </div>

  <p class="govuk-body-s nexus-alpha-meta">
    {% if employer.location %}{{ employer.location }}{% endif %}
    {% if employer.memberSinceLabel %} &middot; {{ t("govuk_alpha_jobs.employer.member_since", { date: employer.memberSinceLabel }) }}{% endif %}
  </p>

  {% if employer.bio %}
    <div class="govuk-body govuk-!-margin-bottom-6" dir="auto">{{ employer.bio | nl2br | safe }}</div>
  {% endif %}

  <h2 class="govuk-heading-m">{{ t("govuk_alpha_jobs.employer.open_jobs_heading") }}</h2>
  <p class="govuk-body-s nexus-alpha-meta">{{ tc("govuk_alpha_jobs.employer.open_jobs_count", openJobs.length, { count: openJobs.length }) }}</p>

  {% if openJobs.length %}
    <div class="nexus-alpha-card-list govuk-!-margin-bottom-6">
      {% for job in openJobs %}
        <article class="nexus-alpha-card">
          <h3 class="govuk-heading-s govuk-!-margin-bottom-1">
            <a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id) }}">{{ job.title }}</a>
          </h3>
          <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">
            {{ t(job.typeTranslationKey) }}{% if job.commitmentLabel %} &middot; {{ t(job.commitmentTranslationKey) }}{% endif %}{% if job.locationLabel %} &middot; {{ job.locationLabel }}{% endif %}
          </p>
          {% if job.deadlineLabel %}
            <p class="govuk-body-s govuk-!-margin-bottom-0">{{ t("jobs.deadline", { date: job.deadlineLabel }) }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("govuk_alpha_jobs.employer.no_open_jobs") }}</p></div>
  {% endif %}

  <h2 class="govuk-heading-m">{{ t("govuk_alpha_jobs.employer.reviews_heading") }}</h2>
  {% if reviewSuccessMessage %}
    {% set notificationMessage = reviewSuccessMessage %}
    {% set notificationType = "success" %}
    {% include "partials/notification-banner.njk" %}
  {% endif %}
  {% if reviewErrorMessage %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list"><li>{% if reviewStatus == "review-rating-required" %}<a href="#rating">{{ reviewErrorMessage }}</a>{% else %}{{ reviewErrorMessage }}{% endif %}</li></ul>
        </div>
      </div>
    </div>
  {% endif %}
  {% if reviewStats.totalReviews == 0 %}
    <div class="govuk-inset-text"><p class="govuk-body">{{ t("govuk_alpha_jobs.employer.no_reviews") }}</p></div>
  {% else %}
    {% if reviewStats.averageRating != null %}
      <p class="govuk-body">
        <strong>{{ t("govuk_alpha_jobs.employer.average_rating") }}:</strong>
        {{ reviewStats.averageRating }} / 5
        <progress value="{{ reviewStats.averageRating }}" max="5" aria-label="{{ t('govuk_alpha_jobs.employer.rating_aria', { rating: reviewStats.averageRating }) }}">{{ reviewStats.averageRating }} / 5</progress>
        <span class="govuk-body-s nexus-alpha-meta">{{ tc("govuk_alpha_jobs.employer.reviews_count", reviewStats.totalReviews, { count: reviewStats.totalReviews }) }}</span>
      </p>
    {% endif %}

    {% if reviewStats.dimensionRows.length %}
    <h3 class="govuk-heading-s">{{ t("govuk_alpha_jobs.employer.dimensions_heading") }}</h3>
    <div class="nexus-alpha-table-scroll" tabindex="0" role="region" aria-label="{{ t("govuk_alpha_jobs.employer.dimensions_heading") }}">
    <table class="govuk-table">
      <caption class="govuk-table__caption govuk-visually-hidden">{{ t("govuk_alpha_jobs.employer.dimensions_heading") }}</caption>
      <tbody class="govuk-table__body">
      {% for row in reviewStats.dimensionRows %}
        <tr class="govuk-table__row"><th scope="row" class="govuk-table__header govuk-!-font-weight-regular">{{ t(row.labelKey) }}</th><td class="govuk-table__cell"><progress value="{{ row.score }}" max="5" aria-label="{{ t('govuk_alpha_jobs.employer.dimension_aria', { dimension: t(row.labelKey), score: row.score }) }}">{{ row.score }} / 5</progress></td><td class="govuk-table__cell govuk-table__cell--numeric">{{ row.score }} / 5</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}

    <div class="nexus-alpha-card-list">
      {% for review in employerReviews %}
        <article class="nexus-alpha-card">
          <p class="govuk-body govuk-!-margin-bottom-1"><strong>{{ review.rating }} / 5</strong> <progress value="{{ review.rating }}" max="5" aria-label="{{ t('govuk_alpha_jobs.employer.review_rating_aria', { rating: review.rating }) }}">{{ review.rating }} / 5</progress></p>
          {% if review.comment %}
            <div class="govuk-body govuk-!-margin-bottom-1">{{ review.comment | nl2br | safe }}</div>
          {% endif %}
          <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-0">{% if review.reviewerName %}{{ review.reviewerName }}{% endif %}{% if review.createdLabel %} &middot; {{ review.createdLabel }}{% endif %}</p>
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if canReview %}
    <h2 class="govuk-heading-m govuk-!-margin-top-8" id="write-review">{{ t("govuk_alpha_jobs.employer.write_review_heading") }}</h2>
    <p class="govuk-body">{{ t("govuk_alpha_jobs.employer.write_review_hint") }}</p>
    <form method="post" action="{{ urlFor('/jobs/employers/' ~ employer.id ~ '/reviews') }}" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="govuk-form-group{% if reviewStatus == 'review-rating-required' %} govuk-form-group--error{% endif %}">
        <fieldset class="govuk-fieldset"{% if reviewStatus == 'review-rating-required' %} aria-describedby="rating-error"{% endif %}>
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_jobs.employer.review_rating_legend") }}</legend>
          {% if reviewStatus == 'review-rating-required' %}<p id="rating-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ reviewErrorMessage }}</p>{% endif %}
          <div class="govuk-radios govuk-radios--small govuk-radios--inline" data-module="govuk-radios">
            {% for score in [1, 2, 3, 4, 5] %}
              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="{% if loop.first %}rating{% else %}rating-{{ score }}{% endif %}" name="rating" type="radio" value="{{ score }}">
                <label class="govuk-label govuk-radios__label" for="{% if loop.first %}rating{% else %}rating-{{ score }}{% endif %}">{{ t("govuk_alpha_jobs.employer.review_rating_option", { rating: score }) }}</label>
              </div>
            {% endfor %}
          </div>
        </fieldset>
      </div>
      {% for dimension in reviewDimensions %}
        <div class="govuk-form-group">
          <label class="govuk-label govuk-label--s" for="review-{{ dimension }}">{{ t("govuk_alpha_jobs.employer.dimension_" ~ dimension) }}</label>
          <select class="govuk-select" id="review-{{ dimension }}" name="{{ dimension }}">
            <option value="">{{ t("govuk_alpha_jobs.employer.review_dimension_same") }}</option>
            {% for score in [1, 2, 3, 4, 5] %}<option value="{{ score }}">{{ t("govuk_alpha_jobs.employer.review_rating_option", { rating: score }) }}</option>{% endfor %}
          </select>
        </div>
      {% endfor %}
      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="review-comment">{{ t("govuk_alpha_jobs.employer.review_comment_label") }}</label>
        <textarea class="govuk-textarea" id="review-comment" name="comment" rows="4" maxlength="2000"></textarea>
      </div>
      <button type="submit" class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_jobs.employer.review_submit") }}</button>
    </form>
  {% endif %}
{% endblock %}

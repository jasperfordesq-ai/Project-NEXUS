{% extends "layouts/base.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/pipeline') }}">{{ t("govuk_alpha_jobs.pipeline.title") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "jobs/_hiring-errors.njk" %}
      <span class="govuk-caption-l">{{ t("govuk_alpha_jobs.hiring.candidate_caption", { name: application.applicantName }) }}</span>
      <h1 class="govuk-heading-l">{{ t("govuk_alpha_jobs.hiring.scorecard_title") }}</h1>
      <p class="govuk-body">{{ t("govuk_alpha_jobs.hiring.scorecard_intro") }}</p>
      {% if prefilled %}
        <div class="govuk-inset-text">{{ t("govuk_alpha_jobs.hiring.scorecard_prefilled") }}</div>
      {% endif %}

      <form method="post" action="{{ urlFor('/jobs/' ~ job.id ~ '/applications/' ~ application.id ~ '/scorecard') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% for criterion in criteria %}
          {{ govukInput({
            id: criterion.name,
            name: criterion.name,
            label: { text: criterion.label, classes: "govuk-label--s" },
            hint: { text: t("govuk_alpha_jobs.hiring.scorecard_score_hint") },
            value: criterion.value,
            inputmode: "numeric",
            spellcheck: false,
            classes: "govuk-input--width-2",
            errorMessage: { text: criterion.error, visuallyHiddenText: t("states.error_prefix") | replace(":", "") | trim } if criterion.error else undefined
          }) }}
        {% endfor %}

        {{ govukTextarea({
          id: "notes",
          name: "notes",
          label: { text: t("govuk_alpha_jobs.hiring.scorecard_notes_label"), classes: "govuk-label--m" },
          hint: { text: t("govuk_alpha_jobs.hiring.scorecard_notes_hint") },
          value: notes,
          attributes: { maxlength: "5000" }
        }) }}

        <div class="govuk-button-group">
          <button type="submit" class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_jobs.hiring.scorecard_submit") }}</button>
          <a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/pipeline') }}">{{ t("govuk_alpha_jobs.hiring.cancel") }}</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

{#
  The no-JavaScript form of React's duplicate-advert warning. The advert has NOT
  been posted yet. Every field the member typed travels forward as a hidden input,
  so "post anyway" sends exactly the same advert and "go back" restores the form.
#}
{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_jobs.posting.duplicate_title") }}</h1>
      <p class="govuk-body">{{ t("govuk_alpha_jobs.posting.duplicate_intro") }}</p>

      <ul class="govuk-list govuk-list--bullet">
        {% for duplicate in duplicates %}
          <li>
            <a class="govuk-link" href="{{ urlFor('/jobs/' + (duplicate.id | string)) }}">{{ duplicate.title }}</a>
            {% if duplicate.statusTranslationKey %}{{ govukTag({ text: t(duplicate.statusTranslationKey), classes: "govuk-tag--grey" }) }}{% endif %}
          </li>
        {% endfor %}
      </ul>

      <form method="post" action="{{ urlFor('/jobs') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% for field in replayFields %}
          <input type="hidden" name="{{ field.name }}" value="{{ field.value }}">
        {% endfor %}
        <input type="hidden" name="confirm_duplicate" value="1">
        <div class="govuk-button-group">
          <button type="submit" class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_jobs.posting.duplicate_post_anyway") }}</button>
          <button type="submit" name="intent" value="edit" class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("govuk_alpha_jobs.posting.duplicate_go_back") }}</button>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

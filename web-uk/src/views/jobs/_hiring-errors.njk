{% if errors and errors.length %}
  <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
    <div role="alert">
      <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_jobs.hiring.error_title") }}</h2>
      <div class="govuk-error-summary__body">
        <ul class="govuk-list govuk-error-summary__list">
          {% for error in errors %}
            <li>{% if error.href %}<a href="{{ error.href }}">{{ error.text }}</a>{% else %}{{ error.text }}{% endif %}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
{% endif %}

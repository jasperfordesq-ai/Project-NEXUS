{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "_character-count.njk" import characterCount %}

{% block beforeContent %}
  {{ super() }}
  <a href="{{ urlFor('/jobs') }}" class="govuk-back-link">{{ t("jobs.back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  {% if successMessage %}
    {% set notificationMessage = successMessage %}
    {% set notificationType = "success" %}
    {% include "partials/notification-banner.njk" %}
  {% endif %}

  {% if errorMessage %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            <li>{% if status in ["cv-invalid", "cv-too-large"] %}<a href="#cv">{{ errorMessage }}</a>{% else %}{{ errorMessage }}{% endif %}</li>
          </ul>
        </div>
      </div>
    </div>
  {% endif %}

  <span class="govuk-caption-xl">{{ job.posterName or tenantName or serviceName }}</span>
  <div class="nexus-alpha-module-row">
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">{{ job.title }}</h1>
    {{ govukTag({ text: t(job.typeTranslationKey), classes: "govuk-tag--blue" }) }}
  </div>

  {% if not job.isOwner %}
    {% if job.isSaved %}
      <form method="post" action="{{ urlFor('/jobs/' ~ job.id ~ '/unsave') }}" class="govuk-!-margin-bottom-4" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="from" value="detail">
        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("jobs_t2.unsave_button") }}</button>
      </form>
    {% else %}
      <form method="post" action="{{ urlFor('/jobs/' ~ job.id ~ '/save') }}" class="govuk-!-margin-bottom-4" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="from" value="detail">
        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("jobs_t2.save_button") }}</button>
      </form>
    {% endif %}
  {% endif %}

  <dl class="govuk-summary-list govuk-!-margin-bottom-6">
    {% if job.commitmentLabel %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("jobs_t2.commitment_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ t(job.commitmentTranslationKey) }}</dd>
      </div>
    {% endif %}
    {% if job.locationLabel %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("jobs.location_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ t("jobs.remote") if job.isRemote else job.locationLabel }}</dd>
      </div>
    {% endif %}
    {% if job.categoryLabel %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_jobs.detail.category_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ job.categoryLabel }}</dd>
      </div>
    {% endif %}
    {% if job.hoursPerWeek !== null and job.hoursPerWeek !== undefined %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_jobs.detail.hours_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ job.hoursPerWeek }}</dd>
      </div>
    {% endif %}
    {% if job.timeCredits !== null and job.timeCredits !== undefined %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_jobs.detail.time_credits_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ job.timeCredits }}</dd>
      </div>
    {% endif %}
    {% if job.salaryLabel %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("jobs.salary_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ job.salaryLabel }}</dd>
      </div>
    {% endif %}
    {% if job.deadlineLabel %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("jobs.deadline_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ job.deadlineLabel }}</dd>
      </div>
    {% endif %}
    {% if job.contactEmail %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_jobs.detail.contact_email_label") }}</dt>
        <dd class="govuk-summary-list__value"><a class="govuk-link" href="mailto:{{ job.contactEmail }}">{{ job.contactEmail }}</a></dd>
      </div>
    {% endif %}
    {% if job.contactPhone %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_jobs.detail.contact_phone_label") }}</dt>
        <dd class="govuk-summary-list__value">{% if job.contactPhoneHref %}<a class="govuk-link" href="tel:{{ job.contactPhoneHref }}">{{ job.contactPhone }}</a>{% else %}{{ job.contactPhone }}{% endif %}</dd>
      </div>
    {% endif %}
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("jobs_t2.views_label") }}</dt>
      <dd class="govuk-summary-list__value">{{ job.viewsCount }}</dd>
    </div>
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("jobs_t2.applications_label") }}</dt>
      <dd class="govuk-summary-list__value">{{ job.applicationsCount }}</dd>
    </div>
  </dl>

  {% if job.description %}
    <h2 class="govuk-heading-l">{{ t("jobs.about_label") }}</h2>
    <div class="govuk-body">{{ job.description | nl2br | safe }}</div>
  {% endif %}

  {% if job.hasBranding %}
    <h2 class="govuk-heading-m">{{ t("govuk_alpha_jobs.posting.about_company") }}</h2>
    {% if job.tagline %}
      <div class="govuk-inset-text">{{ job.tagline }}</div>
    {% endif %}
    {% if job.companySize %}
      <p class="govuk-body"><strong>{{ t("govuk_alpha_jobs.posting.company_size_label") }}:</strong> {{ t("govuk_alpha_jobs.posting.company_size_people", { size: job.companySize }) }}</p>
    {% endif %}
    {% if job.benefitsList.length %}
      <h3 class="govuk-heading-s">{{ t("govuk_alpha_jobs.posting.benefits_label") }}</h3>
      <ul class="govuk-list govuk-list--bullet">
        {% for benefit in job.benefitsList %}<li>{{ benefit }}</li>{% endfor %}
      </ul>
    {% endif %}
    {% if job.videoHref %}
      <p class="govuk-body"><a class="govuk-link" href="{{ job.videoHref }}" target="_blank" rel="noopener noreferrer">{{ t("govuk_alpha_jobs.posting.watch_video") }}<span class="govuk-visually-hidden"> {{ t("opens_new_tab") }}</span></a></p>
    {% endif %}
  {% endif %}

  {% if job.skillsList.length %}
    <h2 class="govuk-heading-m">{{ t("jobs.skills_label") }}</h2>
    <ul class="govuk-list nexus-alpha-tag-list">
      {% for skill in job.skillsList %}
        <li>{{ govukTag({ text: skill, classes: "govuk-tag--grey" }) }}</li>
      {% endfor %}
    </ul>
    {% if not job.isOwner %}
      <p class="govuk-body"><a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/qualified') }}">{{ t("govuk_alpha_jobs.qualification.title") }}</a></p>
    {% endif %}
  {% endif %}

  {% if jobMatch and jobMatch.required_skills and jobMatch.required_skills.length %}
    <h2 class="govuk-heading-m govuk-!-margin-top-6">{{ t("jobs_t2.match_heading") }}</h2>
    <p class="govuk-body govuk-!-font-weight-bold">{{ t("jobs_t2.match_percent", { percent: jobMatch.percentage or 0 }) }}</p>
    <progress max="100" value="{{ jobMatch.percentage or 0 }}" aria-label="{{ t('jobs_t2.match_percent', { percent: jobMatch.percentage or 0 }) }}">{{ jobMatch.percentage or 0 }}%</progress>
    {% if jobMatch.matched and jobMatch.matched.length %}
      <h3 class="govuk-heading-s govuk-!-margin-top-3">{{ t("jobs_t2.match_have") }}</h3>
      <ul class="govuk-list nexus-alpha-tag-list">
        {% for skill in jobMatch.matched %}<li>{{ govukTag({ text: skill, classes: "govuk-tag--green" }) }}</li>{% endfor %}
      </ul>
    {% endif %}
    {% if jobMatch.missing and jobMatch.missing.length %}
      <h3 class="govuk-heading-s govuk-!-margin-top-3">{{ t("jobs_t2.match_missing") }}</h3>
      <ul class="govuk-list nexus-alpha-tag-list">
        {% for skill in jobMatch.missing %}<li>{{ govukTag({ text: skill, classes: "govuk-tag--orange" }) }}</li>{% endfor %}
      </ul>
    {% endif %}
  {% endif %}

  {% if job.isOwner %}
    <div class="govuk-inset-text govuk-!-margin-top-6">{{ t("jobs_t2.owner_notice") }}</div>
    <div class="nexus-alpha-actions govuk-!-margin-bottom-2">
      <a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/applications') }}">{{ t("jobs_t3.manage_button") }}</a>
      <a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/edit') }}">{{ t("jobs_t3.edit_button") }}</a>
      <a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/analytics') }}">{{ t("govuk_alpha_jobs.analytics.title") }}</a>
      <a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/pipeline') }}">{{ t("govuk_alpha_jobs.pipeline.title") }}</a>
      <a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/rules') }}">{{ t("govuk_alpha_jobs.hiring.rules_link") }}</a>
      <a class="govuk-link" href="{{ urlFor('/jobs/' ~ job.id ~ '/team') }}">{{ t("govuk_alpha_jobs.hiring.team_link") }}</a>
    </div>
    <div class="govuk-button-group">
      <form method="post" action="{{ urlFor('/jobs/' ~ job.id ~ '/renew') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="govuk-form-group govuk-!-margin-bottom-2">
          <label class="govuk-label" for="renew-days">{{ t("jobs_t3.renew_days_label") }}</label>
          <select class="govuk-select" id="renew-days" name="days">
            {% for d in [7, 14, 30, 60, 90] %}<option value="{{ d }}"{% if d == 30 %} selected{% endif %}>{{ d }}</option>{% endfor %}
          </select>
        </div>
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("jobs_t3.renew_button") }}</button>
      </form>
      {% if job.status == 'open' %}
        <form method="post" action="{{ urlFor('/jobs/' ~ job.id ~ '/close') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">{{ t("govuk_alpha_jobs.detail.close_button") }}</button>
        </form>
      {% else %}
        <form method="post" action="{{ urlFor('/jobs/' ~ job.id ~ '/reopen') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("govuk_alpha_jobs.detail.reopen_button") }}</button>
        </form>
      {% endif %}
    </div>
  {% else %}
    <h2 class="govuk-heading-l govuk-!-margin-top-7" id="apply">{{ t("jobs.apply_title") }}</h2>
    {% if cvSkills and cvSkills.length %}
      <h3 class="govuk-heading-s">{{ t("govuk_alpha_jobs.apply_extras.cv_skills_heading") }}</h3>
      <ul class="govuk-list nexus-alpha-tag-list">
        {% for skill in cvSkills %}<li>{{ govukTag({ text: skill, classes: "govuk-tag--blue" }) }}</li>{% endfor %}
      </ul>
    {% endif %}
    {% if job.hasApplied %}
      <div class="govuk-inset-text">
        <p class="govuk-body">{{ t("jobs.already_applied") }}</p>
      </div>
    {% else %}
      {% if savedProfile %}
        <div class="govuk-inset-text">
          <p class="govuk-body">{{ t("govuk_alpha_jobs.apply_extras.saved_found") }}</p>
          <form method="post" action="{{ urlFor('/jobs/' ~ job.id ~ '/quick-apply') }}" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <p class="govuk-body-s">{{ t("govuk_alpha_jobs.apply_extras.quick_apply_hint") }}</p>
            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("govuk_alpha_jobs.apply_extras.quick_apply_button") }}</button>
          </form>
        </div>
      {% endif %}
      <form method="post" action="{{ urlFor('/jobs/' ~ job.id ~ '/apply') }}" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% call characterCount(5000, characterCountMessages, "cover_letter") %}
        <div class="govuk-form-group">
          <label class="govuk-label" for="cover_letter">{{ t("jobs.cover_letter_label") }}</label>
          <textarea class="govuk-textarea govuk-js-character-count" id="cover_letter" name="cover_letter" rows="5" maxlength="5000" aria-describedby="cover_letter-info">{{ coverLetterValue or "" }}</textarea>
        </div>
        {% endcall %}
        <div class="govuk-form-group">
          <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
              <input class="govuk-checkboxes__input" id="remember_message" name="remember_message" type="checkbox" value="1" checked>
              <label class="govuk-label govuk-checkboxes__label" for="remember_message">{{ t("govuk_alpha_jobs.apply_extras.remember_label") }}</label>
            </div>
          </div>
        </div>
        <div class="govuk-form-group{% if status in ["cv-invalid", "cv-too-large"] %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="cv">{{ t("jobs.cv_label") }}</label>
          <div id="cv-hint" class="govuk-hint">{{ t("jobs.cv_hint") }}</div>
          {% if status in ["cv-invalid", "cv-too-large"] %}<p id="cv-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ errorMessage }}</p>{% endif %}
          <input class="govuk-file-upload{% if status in ["cv-invalid", "cv-too-large"] %} govuk-file-upload--error{% endif %}" id="cv" name="cv" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-describedby="cv-hint{% if status in ["cv-invalid", "cv-too-large"] %} cv-error{% endif %}">
        </div>
        <button type="submit" class="govuk-button" data-module="govuk-button">{{ t("jobs.apply_button") }}</button>
      </form>
    {% endif %}
  {% endif %}
    {% if similarJobs and similarJobs.length %}
      <h2 class="govuk-heading-m govuk-!-margin-top-8">{{ t("jobs_t3.similar_jobs") }}</h2>
      <ul class="govuk-list govuk-list--spaced">
        {% for sj in similarJobs %}
          <li><a class="govuk-link" href="{{ urlFor('/jobs/' ~ sj.id) }}">{{ sj.title }}</a>{% if sj.organisation %} <span class="govuk-hint govuk-!-display-inline">— {{ sj.organisation }}</span>{% endif %}</li>
        {% endfor %}
      </ul>
    {% endif %}
    </div>
  </div>
{% endblock %}

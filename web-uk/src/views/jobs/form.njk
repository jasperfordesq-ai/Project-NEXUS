{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "_date-input.njk" import nexusDateInput %}
{% from "_character-count.njk" import characterCount %}

{% block beforeContent %}
  <a href="{{ urlFor('/jobs/mine') }}" class="govuk-back-link">{{ t("govuk_alpha.jobs_t3.nav_mine") }}</a>
{% endblock %}

{% block mainContent %}
  {% if jobFormErrors and jobFormErrors.length %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha.states.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            {% for error in jobFormErrors %}
              <li>{% if error.href %}<a href="{{ error.href }}">{{ error.text }}</a>{% else %}{{ error.text or error }}{% endif %}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  {% endif %}

  {% if jobFormNotice %}
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="job-form-notice-title" data-module="govuk-notification-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="job-form-notice-title">{{ t("govuk_alpha.states.success_title") }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">{{ jobFormNotice }}</p>
      </div>
    </div>
  {% endif %}
  <span class="govuk-caption-xl">{{ t("govuk_alpha.jobs_t3.create_caption", { community: tenantName }) }}</span>
  <h1 class="govuk-heading-xl">{% if formMode == "edit" %}{{ t("govuk_alpha.jobs_t3.edit_title") }}{% else %}{{ t("govuk_alpha.jobs_t3.create_title") }}{% endif %}</h1>
  <p class="govuk-body-l">{% if formMode == "edit" %}{{ t("govuk_alpha.jobs_t3.edit_description") }}{% else %}{{ t("govuk_alpha.jobs_t3.create_description") }}{% endif %}</p>



  {% if formMode != "edit" and jobTemplates and jobTemplates.length %}
    <h2 class="govuk-heading-m">{{ t("govuk_alpha_jobs.posting.templates_heading") }}</h2>
    <p class="govuk-body">{{ t("govuk_alpha_jobs.posting.templates_hint") }}</p>
    <dl class="govuk-summary-list">
      {% for template in jobTemplates %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ template.name }}{% if template.isPublic %} {{ govukTag({ text: t("govuk_alpha_jobs.posting.template_shared_tag"), classes: "govuk-tag--grey" }) }}{% endif %}</dt>
          <dd class="govuk-summary-list__actions">
            <ul class="govuk-summary-list__actions-list">
              <li class="govuk-summary-list__actions-list-item">
                <a class="govuk-link" href="{{ urlFor('/jobs/create?template=' + (template.id | string)) }}">{{ t("govuk_alpha_jobs.posting.template_use") }}<span class="govuk-visually-hidden"> {{ template.name }}</span></a>
              </li>
              {% if template.isOwn %}
                <li class="govuk-summary-list__actions-list-item">
                  <form method="post" action="{{ urlFor('/jobs/templates/' + (template.id | string) + '/delete') }}" class="govuk-!-display-inline" novalidate>
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("govuk_alpha_jobs.posting.template_delete") }}<span class="govuk-visually-hidden"> {{ template.name }}</span></button>
                  </form>
                </li>
              {% endif %}
            </ul>
          </dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}

  {% if formMode == "edit" and jobForm.id %}
    {# React shows the hiring team on the edit page; here it is its own page. #}
    <p class="govuk-body"><a class="govuk-link" href="{{ urlFor('/jobs/' ~ jobForm.id ~ '/team') }}">{{ t("govuk_alpha_jobs.hiring.manage_team_link") }}</a></p>
  {% endif %}

  <form method="post" action="{{ urlFor(formAction) }}" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="posting_extras" value="1">

    <div class="govuk-form-group{% if jobErr.title %} govuk-form-group--error{% endif %}">
      <label class="govuk-label govuk-label--m" for="title">{{ t("govuk_alpha.jobs_t3.label_title") }}</label>
      <div id="title-hint" class="govuk-hint">{{ t("govuk_alpha.jobs_t3.hint_title") }}</div>
      {% if jobErr.title %}<p id="title-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.title }}</p>{% endif %}
      <input class="govuk-input{% if jobErr.title %} govuk-input--error{% endif %}" id="title" name="title" type="text" value="{{ jobForm.title or "" }}" maxlength="255" aria-describedby="{% if jobErr.title %}title-error {% endif %}title-hint">
    </div>

    {% call characterCount(5000, characterCountMessages, "description") %}
    <div class="govuk-form-group{% if jobErr.description %} govuk-form-group--error{% endif %}">
      <label class="govuk-label govuk-label--m" for="description">{{ t("govuk_alpha.jobs_t3.label_description") }}</label>
      <div id="description-hint" class="govuk-hint">{{ t("govuk_alpha.jobs_t3.hint_description") }}</div>
      {% if jobErr.description %}<p id="description-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.description }}</p>{% endif %}
      <textarea class="govuk-textarea govuk-js-character-count{% if jobErr.description %} govuk-textarea--error{% endif %}" id="description" name="description" rows="6" maxlength="5000" aria-describedby="{% if jobErr.description %}description-error {% endif %}description-hint description-info">{{ jobForm.description or "" }}</textarea>
    </div>
    {% endcall %}

    <div class="govuk-form-group{% if jobErr.type %} govuk-form-group--error{% endif %}">
      <label class="govuk-label govuk-label--m" for="type">{{ t("govuk_alpha.jobs_t3.label_type") }}</label>
      {% if jobErr.type %}<p id="type-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.type }}</p>{% endif %}
      <select class="govuk-select{% if jobErr.type %} govuk-select--error{% endif %}" id="type"{% if jobErr.type %} aria-describedby="type-error"{% endif %} name="type">
        <option value="volunteer"{% if not jobForm.type or jobForm.type == "volunteer" %} selected{% endif %}>{{ t("jobs.type_volunteer") }}</option>
        <option value="paid"{% if jobForm.type == "paid" %} selected{% endif %}>{{ t("jobs.type_paid") }}</option>
        <option value="timebank"{% if jobForm.type == "timebank" %} selected{% endif %}>{{ t("jobs.type_timebank") }}</option>
      </select>
    </div>

    <div class="govuk-form-group{% if jobErr.commitment %} govuk-form-group--error{% endif %}">
      <label class="govuk-label govuk-label--m" for="commitment">{{ t("govuk_alpha.jobs_t3.label_commitment") }}</label>
      {% if jobErr.commitment %}<p id="commitment-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.commitment }}</p>{% endif %}
      <select class="govuk-select{% if jobErr.commitment %} govuk-select--error{% endif %}" id="commitment"{% if jobErr.commitment %} aria-describedby="commitment-error"{% endif %} name="commitment">
        <option value="flexible"{% if not jobForm.commitment or jobForm.commitment == "flexible" %} selected{% endif %}>{{ t("jobs_t2.commitment_flexible") }}</option>
        <option value="full_time"{% if jobForm.commitment == "full_time" %} selected{% endif %}>{{ t("jobs_t2.commitment_full_time") }}</option>
        <option value="part_time"{% if jobForm.commitment == "part_time" %} selected{% endif %}>{{ t("jobs_t2.commitment_part_time") }}</option>
        <option value="one_off"{% if jobForm.commitment == "one_off" %} selected{% endif %}>{{ t("jobs_t2.commitment_one_off") }}</option>
      </select>
    </div>

    <div class="govuk-form-group{% if jobErr.category %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="category">{{ t("govuk_alpha.jobs_t3.label_category") }}</label>
      {% if jobErr.category %}<p id="category-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.category }}</p>{% endif %}
      <input class="govuk-input govuk-!-width-two-thirds{% if jobErr.category %} govuk-input--error{% endif %}" id="category"{% if jobErr.category %} aria-describedby="category-error"{% endif %} name="category" type="text" value="{{ jobForm.category or "" }}" maxlength="100">
    </div>

    <div class="govuk-form-group{% if jobErr.location %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="location">{{ t("govuk_alpha.jobs_t3.label_location") }}</label>
      {% if jobErr.location %}<p id="location-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.location }}</p>{% endif %}
      <input class="govuk-input govuk-!-width-two-thirds{% if jobErr.location %} govuk-input--error{% endif %}" id="location"{% if jobErr.location %} aria-describedby="location-error"{% endif %} name="location" type="text" value="{{ jobForm.location or "" }}" maxlength="255">
    </div>

    <div class="govuk-form-group">
      <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
          <input type="hidden" name="is_remote" value="0">
          <input class="govuk-checkboxes__input" id="is_remote" name="is_remote" type="checkbox" value="1"{% if jobForm.is_remote %} checked{% endif %}>
          <label class="govuk-label govuk-checkboxes__label" for="is_remote">{{ t("jobs_t3.label_remote") }}</label>
        </div>
      </div>
    </div>

    <div class="govuk-form-group{% if jobErr.skills_required %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="skills_required">{{ t("jobs_t3.label_skills") }}</label>
      <div id="skills-hint" class="govuk-hint">{{ t("govuk_alpha.jobs_t3.hint_skills") }}</div>
      {% if jobErr.skills_required %}<p id="skills_required-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.skills_required }}</p>{% endif %}
      <input class="govuk-input govuk-!-width-two-thirds{% if jobErr.skills_required %} govuk-input--error{% endif %}" id="skills_required" name="skills_required" type="text" value="{{ jobForm.skills_required or "" }}" maxlength="500" aria-describedby="{% if jobErr.skills_required %}skills_required-error {% endif %}skills-hint">
    </div>

    {{ nexusDateInput({
  name: "deadline",
  legend: t("govuk_alpha.jobs_t3.label_deadline"),
  hint: t("jobs_t3.hint_deadline"),
  value: jobForm.deadlineParts
}, t) }}

    <fieldset class="govuk-fieldset govuk-!-margin-bottom-4">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">{{ t("govuk_alpha.jobs.salary_label") }}</legend>
      {% if salaryBenchmark %}
        <div class="govuk-inset-text" id="salary-benchmark">{{ salaryBenchmark }}</div>
      {% endif %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third">
          <div class="govuk-form-group{% if jobErr.salary_min %} govuk-form-group--error{% endif %}">
            <label class="govuk-label" for="salary_min">{{ t("jobs_t3.label_salary_min") }}</label>
            {% if jobErr.salary_min %}<p id="salary_min-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.salary_min }}</p>{% endif %}
            <input class="govuk-input{% if jobErr.salary_min %} govuk-input--error{% endif %}" id="salary_min"{% if jobErr.salary_min %} aria-describedby="salary_min-error"{% endif %} name="salary_min" type="text" spellcheck="false" value="{{ jobForm.salary_min or "" }}" inputmode="decimal">
          </div>
        </div>
        <div class="govuk-grid-column-one-third">
          <div class="govuk-form-group{% if jobErr.salary_max %} govuk-form-group--error{% endif %}">
            <label class="govuk-label" for="salary_max">{{ t("jobs_t3.label_salary_max") }}</label>
            {% if jobErr.salary_max %}<p id="salary_max-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.salary_max }}</p>{% endif %}
            <input class="govuk-input{% if jobErr.salary_max %} govuk-input--error{% endif %}" id="salary_max"{% if jobErr.salary_max %} aria-describedby="salary_max-error"{% endif %} name="salary_max" type="text" spellcheck="false" value="{{ jobForm.salary_max or "" }}" inputmode="decimal">
          </div>
        </div>
        <div class="govuk-grid-column-one-third">
          <div class="govuk-form-group{% if jobErr.salary_currency %} govuk-form-group--error{% endif %}">
            <label class="govuk-label" for="salary_currency">{{ t("jobs_t3.label_salary_currency") }}</label>
            <div id="currency-hint" class="govuk-hint">{{ t("jobs_t3.hint_salary_currency") }}</div>
            {% if jobErr.salary_currency %}<p id="salary_currency-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.salary_currency }}</p>{% endif %}
            <input class="govuk-input govuk-input--width-5{% if jobErr.salary_currency %} govuk-input--error{% endif %}" id="salary_currency" name="salary_currency" type="text" value="{{ jobForm.salary_currency or "" }}" maxlength="3" aria-describedby="{% if jobErr.salary_currency %}salary_currency-error {% endif %}currency-hint">
          </div>
        </div>
      </div>
      <div class="govuk-form-group{% if jobErr.salary_type %} govuk-form-group--error{% endif %}">
        <label class="govuk-label" for="salary_type">{{ t("jobs_t3.label_salary_type") }}</label>
        {% if jobErr.salary_type %}<p id="salary_type-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.salary_type }}</p>{% endif %}
        <select class="govuk-select{% if jobErr.salary_type %} govuk-select--error{% endif %}" id="salary_type"{% if jobErr.salary_type %} aria-describedby="salary_type-error"{% endif %} name="salary_type">
          <option value=""{% if not jobForm.salary_type %} selected{% endif %}>{{ t("jobs_t3.salary_type_none") }}</option>
          <option value="hourly"{% if jobForm.salary_type == "hourly" %} selected{% endif %}>{{ t("jobs_t3.salary_type_hourly") }}</option>
          <option value="monthly"{% if jobForm.salary_type == "monthly" %} selected{% endif %}>{{ t("jobs_t3.salary_type_monthly") }}</option>
          <option value="annual"{% if jobForm.salary_type == "annual" %} selected{% endif %}>{{ t("jobs_t3.salary_type_annual") }}</option>
        </select>
      </div>
      <div class="govuk-form-group">
        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
          <div class="govuk-checkboxes__item">
            <input type="hidden" name="salary_negotiable" value="0">
            <input class="govuk-checkboxes__input" id="salary_negotiable" name="salary_negotiable" type="checkbox" value="1"{% if jobForm.salary_negotiable %} checked{% endif %}>
            <label class="govuk-label govuk-checkboxes__label" for="salary_negotiable">{{ t("jobs_t3.label_salary_negotiable") }}</label>
          </div>
        </div>
      </div>
    </fieldset>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-half">
        <div class="govuk-form-group{% if jobErr.hours_per_week %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="hours_per_week">{{ t("jobs_t3.label_hours") }}</label>
          {% if jobErr.hours_per_week %}<p id="hours_per_week-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.hours_per_week }}</p>{% endif %}
          <input class="govuk-input govuk-input--width-5{% if jobErr.hours_per_week %} govuk-input--error{% endif %}" id="hours_per_week"{% if jobErr.hours_per_week %} aria-describedby="hours_per_week-error"{% endif %} name="hours_per_week" type="text" spellcheck="false" value="{{ jobForm.hours_per_week or "" }}" inputmode="decimal">
        </div>
      </div>
      <div class="govuk-grid-column-one-half">
        <div class="govuk-form-group{% if jobErr.time_credits %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="time_credits">{{ t("jobs_t3.label_credits") }}</label>
          {% if jobErr.time_credits %}<p id="time_credits-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.time_credits }}</p>{% endif %}
          <input class="govuk-input govuk-input--width-5{% if jobErr.time_credits %} govuk-input--error{% endif %}" id="time_credits"{% if jobErr.time_credits %} aria-describedby="time_credits-error"{% endif %} name="time_credits" type="text" spellcheck="false" value="{{ jobForm.time_credits or "" }}" inputmode="decimal">
        </div>
      </div>
    </div>

    <div class="govuk-form-group{% if jobErr.contact_email %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="contact_email">{{ t("govuk_alpha.jobs_t3.label_contact_email") }}</label>
      {% if jobErr.contact_email %}<p id="contact_email-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.contact_email }}</p>{% endif %}
      <input class="govuk-input govuk-!-width-two-thirds{% if jobErr.contact_email %} govuk-input--error{% endif %}" id="contact_email"{% if jobErr.contact_email %} aria-describedby="contact_email-error"{% endif %} name="contact_email" type="email" value="{{ jobForm.contact_email or "" }}" maxlength="255" autocomplete="email">
    </div>

    <div class="govuk-form-group{% if jobErr.contact_phone %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="contact_phone">{{ t("govuk_alpha_jobs.posting.contact_phone_label") }}</label>
      {% if jobErr.contact_phone %}<p id="contact_phone-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.contact_phone }}</p>{% endif %}
      <input class="govuk-input govuk-input--width-20{% if jobErr.contact_phone %} govuk-input--error{% endif %}" id="contact_phone"{% if jobErr.contact_phone %} aria-describedby="contact_phone-error"{% endif %} name="contact_phone" type="tel" value="{{ jobForm.contact_phone or "" }}" maxlength="50" autocomplete="tel">
    </div>

    <div class="govuk-form-group">
      <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
          <input type="hidden" name="blind_hiring" value="0">
          <input class="govuk-checkboxes__input" id="blind_hiring" name="blind_hiring" type="checkbox" value="1"{% if jobForm.blind_hiring %} checked{% endif %} aria-describedby="blind_hiring-hint">
          <label class="govuk-label govuk-checkboxes__label" for="blind_hiring">{{ t("govuk_alpha_jobs.posting.blind_hiring_label") }}</label>
          <div id="blind_hiring-hint" class="govuk-hint govuk-checkboxes__hint">{{ t("govuk_alpha_jobs.posting.blind_hiring_hint") }}</div>
        </div>
      </div>
    </div>

    <fieldset class="govuk-fieldset govuk-!-margin-bottom-6" aria-describedby="branding-hint">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">{{ t("govuk_alpha_jobs.posting.branding_legend") }}</legend>
      <div id="branding-hint" class="govuk-hint">{{ t("govuk_alpha_jobs.posting.branding_hint") }}</div>

      <div class="govuk-form-group{% if jobErr.tagline %} govuk-form-group--error{% endif %}">
        <label class="govuk-label" for="tagline">{{ t("govuk_alpha_jobs.posting.tagline_label") }}</label>
        <div id="tagline-hint" class="govuk-hint">{{ t("govuk_alpha_jobs.posting.tagline_hint") }}</div>
        {% if jobErr.tagline %}<p id="tagline-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.tagline }}</p>{% endif %}
        <input class="govuk-input{% if jobErr.tagline %} govuk-input--error{% endif %}" id="tagline" name="tagline" type="text" value="{{ jobForm.tagline or "" }}" maxlength="160" aria-describedby="{% if jobErr.tagline %}tagline-error {% endif %}tagline-hint">
      </div>

      <div class="govuk-form-group{% if jobErr.video_url %} govuk-form-group--error{% endif %}">
        <label class="govuk-label" for="video_url">{{ t("govuk_alpha_jobs.posting.video_label") }}</label>
        <div id="video_url-hint" class="govuk-hint">{{ t("govuk_alpha_jobs.posting.video_hint") }}</div>
        {% if jobErr.video_url %}<p id="video_url-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.video_url }}</p>{% endif %}
        <input class="govuk-input{% if jobErr.video_url %} govuk-input--error{% endif %}" id="video_url" name="video_url" type="url" inputmode="url" spellcheck="false" value="{{ jobForm.video_url or "" }}" maxlength="2000" aria-describedby="{% if jobErr.video_url %}video_url-error {% endif %}video_url-hint">
      </div>

      <div class="govuk-form-group{% if jobErr.company_size %} govuk-form-group--error{% endif %}">
        <label class="govuk-label" for="company_size">{{ t("govuk_alpha_jobs.posting.company_size_label") }}</label>
        {% if jobErr.company_size %}<p id="company_size-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.company_size }}</p>{% endif %}
        <select class="govuk-select{% if jobErr.company_size %} govuk-select--error{% endif %}" id="company_size"{% if jobErr.company_size %} aria-describedby="company_size-error"{% endif %} name="company_size">
          <option value=""{% if not jobForm.company_size %} selected{% endif %}>{{ t("govuk_alpha_jobs.posting.company_size_none") }}</option>
          {% for size in companySizes %}
            <option value="{{ size }}"{% if jobForm.company_size == size %} selected{% endif %}>{{ t("govuk_alpha_jobs.posting.company_size_people", { size: size }) }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="govuk-form-group{% if jobErr.benefits %} govuk-form-group--error{% endif %}">
        <label class="govuk-label" for="benefits">{{ t("govuk_alpha_jobs.posting.benefits_label") }}</label>
        <div id="benefits-hint" class="govuk-hint">{{ t("govuk_alpha_jobs.posting.benefits_hint") }}</div>
        {% if jobErr.benefits %}<p id="benefits-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ jobErr.benefits }}</p>{% endif %}
        <textarea class="govuk-textarea{% if jobErr.benefits %} govuk-textarea--error{% endif %}" id="benefits" name="benefits" rows="4" aria-describedby="{% if jobErr.benefits %}benefits-error {% endif %}benefits-hint">{{ jobForm.benefitsText or "" }}</textarea>
      </div>
    </fieldset>

    <fieldset class="govuk-fieldset govuk-!-margin-bottom-4">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">{{ t("govuk_alpha.jobs_t3.label_status") }}</legend>
      <div class="govuk-radios govuk-radios--inline" data-module="govuk-radios">
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" id="status-open" name="status" type="radio" value="open"{% if not jobForm.status or jobForm.status == "open" %} checked{% endif %}>
          <label class="govuk-label govuk-radios__label" for="status-open">{{ t("jobs_t3.status_open_option") }}</label>
        </div>
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" id="status-draft" name="status" type="radio" value="draft"{% if jobForm.status == "draft" %} checked{% endif %}>
          <label class="govuk-label govuk-radios__label" for="status-draft">{{ t("jobs_t3.status_draft_option") }}</label>
        </div>
      </div>
    </fieldset>

    <button type="submit" class="govuk-button" data-module="govuk-button">{% if formMode == "edit" %}{{ t("govuk_alpha.jobs_t3.submit_update") }}{% else %}{{ t("govuk_alpha.jobs_t3.submit_create") }}{% endif %}</button>

    {# After the main button on purpose: pressing Enter in a field submits the
       first button in the form, and that must post the advert, not a template. #}
    {% if jobTemplates !== null and jobTemplates !== undefined %}
      <details class="govuk-details"{% if jobForm.template_name %} open{% endif %}>
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">{{ t("govuk_alpha_jobs.posting.save_template_summary") }}</span>
        </summary>
        <div class="govuk-details__text">
          <p class="govuk-body">{{ t("govuk_alpha_jobs.posting.template_save_note") }}</p>
          <div class="govuk-form-group">
            <label class="govuk-label" for="template_name">{{ t("govuk_alpha_jobs.posting.template_name_label") }}</label>
            <div id="template_name-hint" class="govuk-hint">{{ t("govuk_alpha_jobs.posting.template_name_hint") }}</div>
            <input class="govuk-input" id="template_name" name="template_name" type="text" value="{{ jobForm.template_name or "" }}" maxlength="255" aria-describedby="template_name-hint">
          </div>
          <div class="govuk-form-group">
            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
              <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input" id="template_public" name="template_public" type="checkbox" value="1"{% if jobForm.template_public %} checked{% endif %}>
                <label class="govuk-label govuk-checkboxes__label" for="template_public">{{ t("govuk_alpha_jobs.posting.template_share_label") }}</label>
              </div>
            </div>
          </div>
          <button type="submit" name="intent" value="save_template" class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("govuk_alpha_jobs.posting.template_save_button") }}</button>
        </div>
      </details>
    {% endif %}
  </form>
{% endblock %}

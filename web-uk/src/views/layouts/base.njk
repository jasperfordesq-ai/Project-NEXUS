{#
  Local GOV.UK-compatible document wrapper for the shared accessible frontend.
  GOV.UK Frontend 6 exposes htmlLang but not an attribute hook on <html>, so
  this wrapper owns lang + dir while preserving its block and class contract.
#}

{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/macros/attributes.njk" import govukAttributes %}

{% set themeColor = themeColor | default("#1d70b8", true) %}

{# Keep isolated route-harness renders usable while the server supplies t(). #}
{% set shellSkipToContent = t('skip_to_content') if t else 'Skip to main content' %}
{% set shellServiceLinks = t('header.links_label') if t else 'Service links' %}
{% set shellLanguageLabel = t('header.language_label') if t else 'Choose a language' %}
{% set shellLanguageSubmit = t('header.language_submit') if t else 'Change' %}
{% set shellAccount = t('nav.account') if t else 'My account' %}
{% set shellServiceInformation = t('service_information_label') if t else 'Community service information' %}
{% set shellNavigation = t('navigation_label') if t else 'Community navigation' %}
{% set shellMenu = t('nav.menu') if t else 'Menu' %}
{% set shellLogin = t('nav.login') if t else 'Sign in' %}
{% set shellRegister = t('nav.register') if t else 'Register' %}
{% set shellAccountNavKeys = ['account', 'profile', 'messages', 'connections', 'wallet', 'matches', 'group_exchanges', 'achievements', 'leaderboard', 'nexus_score'] %}
{% set shellPhase = t('phase') if t else 'Beta' %}
{% set shellFeedback = t('feedback') if t else 'Give feedback' %}
{% set resolvedPageTitle = t(titleKey, titleReplacements) if titleKey and t else title %}

{#
  🔴 GDS convention: when a form page re-renders WITH a validation error, the <title>
  must be prefixed "Error: " so a screen reader announces the failure first, before the
  user hunts for it. See https://design-system.service.gov.uk/components/error-message.
  Neither accessible frontend did this — it is a shared gap with Blade, fixed here
  because GOV.UK guidance wins (owner decision 2026-08-13).

  Derived centrally rather than set at ~30 error re-render sites, because those sites
  signal errors through at least eight different local names and a hand-added boolean
  would silently be missed on the next new form. The four checked below are the
  VALIDATION surfaces actually used:
    errors.length  — the error list most forms pass to govukErrorSummary
    hasErrors      — contact.njk, where `errors` is a keyed object with no .length
    error          — login.njk and five others, a single message string
    pageHasErrors  — explicit opt-in for anything the above cannot see

  🔴 `errorMessage` is deliberately NOT included. It drives NOTIFICATION banners for
  page-level failures ("we could not load…") on ~24 pages, not field validation.
  Prefixing the title on a transient load failure would announce "Error:" on pages
  with nothing for the user to correct.

  Uses the already-translated states.error_prefix ("Error:" / "Earráid:" / "خطأ:"),
  so this is correct in all eleven locales rather than English-only.
#}
{#
  🔴 `errors | length` rather than `errors.length`, because `errors` is an ARRAY on most
  forms but a KEYED OBJECT on contact.njk (`errors.name`, `errors.email`), where
  `.length` is undefined. The `length` filter counts both.

  🔴 Do NOT rely on a child template's `{% set hasErrors = … %}`: a top-level `set` in a
  child runs too late to be visible in the parent's <head>, so contact.njk rendered its
  error summary while the title stayed unprefixed. `hasErrors` is still honoured for
  routes that pass it as a real local.
#}
{#
  🔴 `fieldErrors` added 2026-08-14. It is a keyed object of field->message set ONLY on
  form-validation failure (register, login 2FA, listings/form, events, groups, …), so a
  non-empty one is unambiguous field validation and correctly earns the title prefix. It
  is the single most common validation local not previously seen here, so adding it
  centrally fixes the prefix on a large slice of forms without editing each one.
  (Forms that instead signal validation via a `status == 'x-invalid'` string still rely
  on their own per-field error announcement — already in place — for the primary cue;
  wiring the title prefix for those is a smaller, separate follow-up.)
#}
{% set pageValidationFailed = pageHasErrors or hasErrors or error or (errors and (errors | length)) or (fieldErrors and (fieldErrors | length)) %}
{% set titleErrorPrefix = ((t('states.error_prefix') if t else 'Error:') ~ ' ') if pageValidationFailed else '' %}

<!DOCTYPE html>
<html lang="{{ htmlLang or 'en' }}" dir="{{ htmlDirection or 'ltr' }}" class="govuk-template{% if htmlClasses %} {{ htmlClasses }}{% endif %}">
  <head>
    <meta charset="utf-8">
    <title{% if pageTitleLang %} lang="{{ pageTitleLang }}"{% endif %}>{% block pageTitle %}{{ titleErrorPrefix }}{{ resolvedPageTitle }} - {{ serviceName }}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ themeColor }}">

    {% block head %}
      <link rel="stylesheet" href="/css/main.css">
    {% endblock %}

    {% block headIcons %}
      <link rel="icon" href="/assets/favicon.ico">
    {% endblock %}

    {% if opengraphImageUrl or assetUrl %}
      <meta property="og:image" content="{{ opengraphImageUrl | default(assetUrl + '/images/govuk-opengraph-image.png', true) }}">
    {% endif %}
  </head>
  <body class="govuk-template__body{% if bodyClasses %} {{ bodyClasses }}{% endif %}"{{ govukAttributes(bodyAttributes) }}>
    <script{% if cspNonce %} nonce="{{ cspNonce }}"{% endif %}>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>

    {% block bodyStart %}
      {% include "partials/cookie-banner.njk" %}
    {% endblock %}

    {% block govukSkipLink %}
      {% block skipLink %}
        <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">{{ shellSkipToContent }}</a>
      {% endblock %}
    {% endblock %}

    {% block header %}
      <header class="nexus-alpha-header" role="banner">
        <div class="govuk-width-container nexus-alpha-header__container">
          {# Structural parity with accessible-frontend/views/layout.blade.php: the
             brand link sits directly in the container. The former
             `__identity` wrapper existed only to pair the brand with a
             non-affiliation disclaimer that Blade never had, and which was
             removed on the owner's decision (2026-08-11) — the GOV.UK Frontend
             licence is MIT and requires attribution, not disavowal. The real
             brand limits are still enforced by scripts/brand-check.js, which
             refuses the crown, the copyright logo class, the crest, the official
             header/footer macros, and the government copyright wording. (This
             comment deliberately avoids quoting that wording: the check scans
             templates for it, and it caught this comment on the first run.)

             The logo is a tenant-uploaded RASTER image (transparent PNG
             preferred), never an inline or generated SVG, so light/dark contrast
             uses the real asset. The shell prefers the dark-background variant
             because this header is always dark, and no width/height is set:
             `.nexus-alpha-header__logo--{wide,landscape,square}` drives the
             height from the aspect-ratio bucket, and hardcoding a size would
             defeat it. Falls back to the tenant's name when no logo exists. #}
          <a class="nexus-alpha-header__brand govuk-!-font-size-24" href="{{ urlFor('/') }}">
            {% if tenantLogoUrl %}
              <img class="nexus-alpha-header__logo nexus-alpha-header__logo--{{ tenantLogoShape }}" src="{{ tenantLogoUrl }}" alt="{{ tenantName or serviceName }}" decoding="async">
            {% else %}
              {{ tenantName or serviceName }}
            {% endif %}
          </a>

          <nav class="nexus-alpha-header__links" aria-label="{{ shellServiceLinks }}">
            {% if alphaLocaleOptions and alphaLocaleOptions.length > 1 %}
              <form method="get" action="{{ currentPath or '/' }}" class="nexus-alpha-lang" aria-label="{{ shellLanguageLabel }}">
                {% for queryParam in alphaLanguageQueryParams %}
                  <input type="hidden" name="{{ queryParam.name }}" value="{{ queryParam.value }}">
                {% endfor %}
                <label class="govuk-visually-hidden" for="alpha-locale-select">{{ shellLanguageLabel }}</label>
                <select class="govuk-select nexus-alpha-lang__select" id="alpha-locale-select" name="locale">
                  {% for locale in alphaLocaleOptions %}
                    <option value="{{ locale[0] }}" {% if locale[0] == alphaCurrentLocale %}selected{% endif %}>{{ locale[1] }}</option>
                  {% endfor %}
                </select>
                <button type="submit" class="govuk-button govuk-button--secondary nexus-alpha-lang__submit govuk-!-margin-bottom-0" data-module="govuk-button">{{ shellLanguageSubmit }}</button>
              </form>
            {% endif %}

            {% if isAuthenticated %}
              <a class="nexus-alpha-header__link" href="{{ urlFor('/account') }}" {% if (activeNav or alphaActiveNav) in shellAccountNavKeys %}aria-current="page"{% endif %}>
                {{ shellAccount }}
                {% if unreadMessageCount > 0 %}
                  <span class="nexus-alpha-nav-badge" aria-hidden="true">{{ unreadMessageCount if unreadMessageCount < 100 else '99+' }}</span>
                  <span class="govuk-visually-hidden">{{ tc('messages.unread_count', unreadMessageCount, { count: unreadMessageCount }) if tc else (unreadMessageCount ~ ' unread messages') }}</span>
                {% endif %}
              </a>
            {% endif %}
          </nav>
        </div>
      </header>

      {% if tenantSlug %}
      <section class="govuk-service-navigation" data-module="govuk-service-navigation" aria-label="{{ shellServiceInformation }}">
        <div class="govuk-width-container">
          <div class="govuk-service-navigation__container">
            <nav class="govuk-service-navigation__wrapper" aria-label="{{ shellNavigation }}">
              <button type="button" class="govuk-service-navigation__toggle govuk-js-service-navigation-toggle" aria-controls="alpha-navigation" hidden aria-hidden="true">
                {{ shellMenu }}
              </button>
              <ul class="govuk-service-navigation__list" id="alpha-navigation">
                {% for item in alphaNavItems %}
                  <li class="govuk-service-navigation__item {% if (activeNav or alphaActiveNav) == item.key %}govuk-service-navigation__item--active{% endif %}">
                    <a class="govuk-service-navigation__link" href="{{ item.href }}" {% if (activeNav or alphaActiveNav) == item.key %}aria-current="page"{% endif %}>
                      {% if (activeNav or alphaActiveNav) == item.key %}
                        <strong class="govuk-service-navigation__active-fallback">{{ item.label }}</strong>
                      {% else %}
                        {{ item.label }}
                      {% endif %}
                    </a>
                  </li>
                {% endfor %}
                {% if not isAuthenticated %}
                  <li class="govuk-service-navigation__item {% if (activeNav or alphaActiveNav) == 'login' %}govuk-service-navigation__item--active{% endif %}">
                    <a class="govuk-service-navigation__link" href="{{ urlFor('/login') }}" {% if (activeNav or alphaActiveNav) == 'login' %}aria-current="page"{% endif %}>{% if (activeNav or alphaActiveNav) == 'login' %}<strong class="govuk-service-navigation__active-fallback">{{ shellLogin }}</strong>{% else %}{{ shellLogin }}{% endif %}</a>
                  </li>
                  <li class="govuk-service-navigation__item {% if (activeNav or alphaActiveNav) == 'register' %}govuk-service-navigation__item--active{% endif %}">
                    <a class="govuk-service-navigation__link" href="{{ urlFor('/register') }}" {% if (activeNav or alphaActiveNav) == 'register' %}aria-current="page"{% endif %}>{% if (activeNav or alphaActiveNav) == 'register' %}<strong class="govuk-service-navigation__active-fallback">{{ shellRegister }}</strong>{% else %}{{ shellRegister }}{% endif %}</a>
                  </li>
                {% endif %}
              </ul>
            </nav>
          </div>
        </div>
      </section>
      {% endif %}
    {% endblock %}

    {% block container %}
      <div class="govuk-width-container{% if containerClasses %} {{ containerClasses }}{% endif %}"{{ govukAttributes(containerAttributes) }}>
        {% block containerStart %}
          {% block beforeContent %}
            {{ govukPhaseBanner({
              tag: {
                text: phaseText or shellPhase
              },
              html: '<a class="govuk-link" href="' ~ feedbackUrl ~ '">' ~ shellFeedback ~ '</a>'
            }) }}
          {% endblock %}
        {% endblock %}

        {% block main %}
          <main class="govuk-main-wrapper{% if mainClasses %} {{ mainClasses }}{% endif %}" id="main-content" tabindex="-1"{% if mainLang %} lang="{{ mainLang }}"{% endif %}{{ govukAttributes(mainAttributes) }}>
            {#
              🔴 These two markers sit OUTSIDE {% block content %} on purpose.
              They used to be inside it, and 110 templates override `content`
              rather than `mainContent` — overriding a block replaces its whole
              body, so every one of those pages silently dropped both markers.
              The consequences were invisible in the markup: signed-in members
              got NO session-timeout warning on those 110 pages (the modal keys
              off data-authenticated), and the 22 of them with a character count
              fell back to govuk-frontend's hardcoded English in all 11 locales.
              Keep them here, above the block, so a page cannot lose them by
              choosing one perfectly reasonable block name over another.
              Contract test: tests/base-layout-shared-markers.test.js.
            #}
              {% if isAuthenticated %}
                {#
                  🔴 data-session-timeout-minutes carries the SERVER's real session
                  length to the client. public/js/timeout-warning.js used to hardcode
                  30 minutes independently of the Express session `maxAge`, so changing
                  the server's session length silently desynchronised the warning — it
                  would fire after the session had already died, or long before it,
                  with nothing failing to reveal it. res.locals.sessionTimeout was
                  already computed in src/server.js and consumed by nothing at all.
                #}
                <div
                  data-authenticated="true"
                  data-csrf-token="{{ csrfToken }}"
                  {% if sessionTimeout %}data-session-timeout-minutes="{{ sessionTimeout }}"{% endif %}
                  data-timeout-title="{{ t('web_uk.session_timeout.title') }}"
                  data-timeout-security-notice="{{ t('web_uk.session_timeout.security_notice') }}"
                  data-timeout-unsaved-changes="{{ t('web_uk.session_timeout.unsaved_changes') }}"
                  data-timeout-stay-signed-in="{{ t('web_uk.session_timeout.stay_signed_in') }}"
                  data-timeout-sign-out-now="{{ t('web_uk.session_timeout.sign_out_now') }}"
                  data-timeout-announcement="{{ t('web_uk.session_timeout.announcement') }}"
                  data-timeout-time-separator="{{ t('web_uk.session_timeout.time_separator') }}"
                  data-timeout-minutes-one="{{ t('web_uk.session_timeout.minutes.one') }}"
                  data-timeout-minutes-two="{{ t('web_uk.session_timeout.minutes.two') }}"
                  data-timeout-minutes-few="{{ t('web_uk.session_timeout.minutes.few') }}"
                  data-timeout-minutes-many="{{ t('web_uk.session_timeout.minutes.many') }}"
                  data-timeout-minutes-other="{{ t('web_uk.session_timeout.minutes.other') }}"
                  data-timeout-seconds-one="{{ t('web_uk.session_timeout.seconds.one') }}"
                  data-timeout-seconds-two="{{ t('web_uk.session_timeout.seconds.two') }}"
                  data-timeout-seconds-few="{{ t('web_uk.session_timeout.seconds.few') }}"
                  data-timeout-seconds-many="{{ t('web_uk.session_timeout.seconds.many') }}"
                  data-timeout-seconds-other="{{ t('web_uk.session_timeout.seconds.other') }}"
                  hidden
                ></div>
                <a id="session-timeout-login-link" href="{{ urlFor('/login') }}" hidden tabindex="-1" aria-hidden="true"></a>
                <form id="session-timeout-logout-form" method="post" action="{{ urlFor('/logout') }}" hidden>
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="hidden" name="timeout" value="true">
                </form>
              {% endif %}
              <div
                id="character-count-translations"
                data-i18n.characters-under-limit.one="{{ t('web_uk.character_count.characters_under_limit.one') }}"
                data-i18n.characters-under-limit.two="{{ t('web_uk.character_count.characters_under_limit.two') }}"
                data-i18n.characters-under-limit.few="{{ t('web_uk.character_count.characters_under_limit.few') }}"
                data-i18n.characters-under-limit.many="{{ t('web_uk.character_count.characters_under_limit.many') }}"
                data-i18n.characters-under-limit.other="{{ t('web_uk.character_count.characters_under_limit.other') }}"
                data-i18n.characters-at-limit="{{ t('web_uk.character_count.characters_at_limit') }}"
                data-i18n.characters-over-limit.one="{{ t('web_uk.character_count.characters_over_limit.one') }}"
                data-i18n.characters-over-limit.two="{{ t('web_uk.character_count.characters_over_limit.two') }}"
                data-i18n.characters-over-limit.few="{{ t('web_uk.character_count.characters_over_limit.few') }}"
                data-i18n.characters-over-limit.many="{{ t('web_uk.character_count.characters_over_limit.many') }}"
                data-i18n.characters-over-limit.other="{{ t('web_uk.character_count.characters_over_limit.other') }}"
                hidden
              ></div>
            {% block content %}
              {% block mainContent %}{% endblock %}
            {% endblock %}
          </main>
        {% endblock %}
        {% block containerEnd %}{% endblock %}
      </div>
    {% endblock %}

    {% block footer %}
      {% include "partials/footer.njk" %}
    {% endblock %}

    {% block bodyEnd %}
      <script type="module" src="/js/govuk-frontend.min.js"></script>
      <script type="module" src="/js/init.js"></script>
      <script src="/js/validation.js"></script>
      <script src="/js/loading-states.js"></script>
      <script src="/js/timeout-warning.js"></script>
    {% endblock %}
  </body>
</html>

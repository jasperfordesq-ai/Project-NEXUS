{#
  Standalone Laravel-compatible accessible error document. It intentionally
  avoids tenant navigation, session state, cookie controls, and application
  JavaScript so rendering an exception cannot trigger a second failure.
#}
<!DOCTYPE html>
<html lang="{{ htmlLang or 'en' }}" dir="{{ htmlDirection or 'ltr' }}" class="govuk-template">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block errorTitle %}{{ t("error_pages.generic_title") }}{% endblock %} - {{ t("service_name") }}</title>
    <meta name="robots" content="noindex">
    <link rel="stylesheet" href="/css/main.css">
  </head>
  <body class="govuk-template__body">
    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">{{ t("skip_to_content") }}</a>
    <div class="govuk-width-container">
      {# tabindex="-1" matches layouts/base.njk. Without it the skip link above
         points at an element that cannot take focus, so on an error page
         "Skip to content" moved the viewport but not the keyboard position —
         the one page where a lost visitor most needs the link to work. #}
      <main class="govuk-main-wrapper" id="main-content" tabindex="-1">
        {% block mainContent %}{% endblock %}
      </main>
    </div>
    <footer class="govuk-footer" role="contentinfo">
      <div class="govuk-width-container">
        <div class="govuk-footer__meta">
          <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
            <div class="govuk-footer__meta-custom">
              {# govuk-body: these carried only a spacing utility, so the licence
                 and attribution rendered at the browser's default 16px beside
                 19px GDS copy. #}
              <p class="govuk-body govuk-!-margin-bottom-2">{{ t("footer.licence") }}</p>
              <p class="govuk-body govuk-!-margin-bottom-2">{{ t("footer.attribution") }}</p>
              <p class="govuk-body govuk-!-margin-bottom-0">
                <a class="govuk-footer__link" href="https://github.com/jasperfordesq-ai/Project-NEXUS" rel="noopener noreferrer">{{ t("footer.source") }}</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

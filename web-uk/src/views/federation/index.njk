{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block mainContent %}
  <span class="govuk-caption-xl">{{ tenantName }}</span>
  {# 🔴 Was the hardcoded English word "Federation". Blade renders
     govuk_alpha.federation.title — "Partner communities" — which is both the
     member-facing wording and translated: in Irish this heading read "Federation"
     here and "Pobail chomhpháirtí" on Blade. "Federation" is our internal name for
     the feature, not a term to show members. #}
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha.federation.title") }}</h1>
  <p class="govuk-body-l">
    {% if stats.optedIn %}
      {{ t("federation.hub.subtitle_opted_in") }}
    {% else %}
      {{ t("federation.hub.subtitle_opted_out") }}
    {% endif %}
  </p>

  {% include "federation/_nav.njk" %}


  {% if statusBanner %}
    {% if statusBanner.type == "error" %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list"><li>{{ statusBanner.message }}</li></ul>
          </div>
        </div>
      </div>
    {% else %}
      <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="federation-status-title">
        <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="federation-status-title">{{ t("states.success_title") }}</h2></div>
        <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ statusBanner.message }}</p></div>
      </div>
    {% endif %}
  {% endif %}

  {% if not stats.tenantEnabled %}
    <div class="govuk-inset-text">
      <h2 class="govuk-heading-m">{{ t("federation.hub.not_available_title") }}</h2>
      <p class="govuk-body">{{ t("web_uk.federation_hub.not_enabled_description") }}</p>
      <p class="govuk-body">{{ t("web_uk.federation_hub.not_enabled_contact") }}</p>
    </div>
  {% else %}
    {% if not stats.optedIn %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h2 class="govuk-heading-l">{{ t("federation.hub.hero_title") }}</h2>
          <p class="govuk-body">{{ t("federation.hub.feature_privacy_description") }}</p>
          <p class="govuk-body"><a class="govuk-button" data-module="govuk-button" href="{{ urlFor('/federation/onboarding') }}">{{ t("federation.hub.optin_banner_cta") }}</a></p>
        </div>
      </div>

      <h2 class="govuk-heading-l">{{ t("federation.hub.how_it_works_heading") }}</h2>
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third"><h3 class="govuk-heading-s">{{ t("federation.hub.how_it_works_0_title") }}</h3><p class="govuk-body">{{ t("web_uk.federation_hub.discover_description") }}</p></div>
        <div class="govuk-grid-column-one-third"><h3 class="govuk-heading-s">{{ t("web_uk.federation_hub.connect_title") }}</h3><p class="govuk-body">{{ t("web_uk.federation_hub.connect_description") }}</p></div>
        <div class="govuk-grid-column-one-third"><h3 class="govuk-heading-s">{{ t("federation.hub.how_it_works_2_title") }}</h3><p class="govuk-body">{{ t("web_uk.federation_hub.exchange_description") }}</p></div>
      </div>
    {% endif %}

    <h2 class="govuk-heading-l">{{ t("federation.hub.stats_heading") }}</h2>
    <dl class="govuk-summary-list">
      <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">{{ t("federation.hub.stat_partnerships") }}</dt><dd class="govuk-summary-list__value">{{ stats.partnershipsCount }}</dd></div>
      <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">{{ t("federation.hub.stat_messages") }}</dt><dd class="govuk-summary-list__value">{{ stats.messagesCount }}</dd></div>
      <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">{{ t("federation.hub.stat_transactions") }}</dt><dd class="govuk-summary-list__value">{{ stats.transactionsCount }}</dd></div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("web_uk.federation_hub.status_label") }}</dt>
        <dd class="govuk-summary-list__value">
          {% if stats.optedIn %}
            {{ govukTag({ text: t("federation.hub.optin_on"), classes: "govuk-tag--green" }) }}
          {% else %}
            {{ govukTag({ text: t("federation.hub.optin_off"), classes: "govuk-tag--grey" }) }}
          {% endif %}
        </dd>
      </div>
    </dl>

    {% if stats.optedIn %}
      <h2 class="govuk-heading-l">{{ t("federation.hub.recent_activity_heading") }}</h2>
      {% if activity.length %}
        <div class="nexus-alpha-card-list">
          {% for item in activity %}
            <article class="nexus-alpha-card">
              <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ item.title }}</h3>
              {% if item.description %}<p class="govuk-body govuk-!-margin-bottom-1">{{ item.description }}</p>{% endif %}
              {% if item.community %}<p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-1">{{ t("federation.hub.activity_from_community", { community: item.community }) }}</p>{% endif %}
              {% if item.createdAt %}<p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-0">{{ item.createdAt | date }}</p>{% endif %}
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="govuk-inset-text">
          <p class="govuk-body govuk-!-margin-bottom-1"><strong>{{ t("web_uk.federation_hub.no_recent_activity") }}</strong></p>
          <p class="govuk-body govuk-!-margin-bottom-0">{{ t("web_uk.federation_hub.activity_appears") }}</p>
        </div>
      {% endif %}
    {% endif %}

    <h2 class="govuk-heading-l">{{ t("federation.hub.partners_heading") }}</h2>
    {% if partners.length %}
      <div class="nexus-alpha-card-list">
        {% for partner in partners %}
          <article class="nexus-alpha-card">
            <div class="nexus-alpha-module-row">
              <h3 class="govuk-heading-s govuk-!-margin-bottom-1"><a class="govuk-link" href="{{ urlFor(partner.href) }}">{{ partner.name }}</a></h3>
              {% if partner.isExternal %}
                {{ govukTag({ text: t("federation.levels.external"), classes: "govuk-tag--grey" }) }}
              {% elif partner.levelName %}
                {{ govukTag({ text: partner.levelName, classes: "govuk-tag--purple" }) }}
              {% endif %}
            </div>
            {% if partner.tagline %}<p class="govuk-body govuk-!-margin-bottom-2">{{ partner.tagline }}</p>{% endif %}
            <dl class="nexus-alpha-inline-list">
            {% if partner.location %}<div><dt>{{ t("federation.location_label") }}</dt><dd>{{ partner.location }}</dd></div>{% endif %}
            <div><dt>{{ t("federation.members_label") }}</dt><dd>{{ partner.memberCount }}</dd></div>
            <div><dt>{{ t("federation.listings_label") }}</dt><dd>{{ partner.listingCount }}</dd></div>
            {% if partner.partnershipSince %}<div><dt>{{ t("web_uk.federation_hub.since_label") }}</dt><dd>{{ partner.partnershipSince | date }}</dd></div>{% endif %}
            </dl>
            <p class="govuk-body-s govuk-!-margin-bottom-0"><a class="govuk-link" href="{{ urlFor(partner.href) }}">{{ t("federation.hub.view_partner") }}</a></p>
          </article>
        {% endfor %}
      </div>
      {% if partnerTotal > partners.length %}
        <p class="govuk-body govuk-!-margin-top-4"><a class="govuk-link" href="{{ urlFor('/federation/partners') }}">{{ t("federation.hub.view_all_partners", { count: partnerTotal }) }}</a></p>
      {% endif %}
    {% else %}
      <div class="govuk-inset-text"><p class="govuk-body">{{ t("web_uk.federation_hub.no_partners") }}</p></div>
    {% endif %}

    {% if stats.optedIn %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h2 class="govuk-heading-l">{{ t("web_uk.federation_hub.links_heading") }}</h2>
          <ul class="govuk-list">
            <li><a class="govuk-link" href="{{ urlFor('/federation/partners') }}">{{ t("web_uk.federation_hub.browse_partners") }}</a></li>
            <li><a class="govuk-link" href="{{ urlFor('/federation/members') }}">{{ t("web_uk.federation_hub.find_members") }}</a></li>
            <li><a class="govuk-link" href="{{ urlFor('/federation/connections') }}">{{ t("web_uk.federation_hub.manage_connections") }}</a></li>
            <li><a class="govuk-link" href="{{ urlFor('/federation/messages') }}">{{ t("web_uk.federation_hub.messages") }}</a></li>
            <li><a class="govuk-link" href="{{ urlFor('/federation/listings') }}">{{ t("federation.hub.quick_link_listings") }}</a></li>
            <li><a class="govuk-link" href="{{ urlFor('/federation/events') }}">{{ t("federation.events_browse.title") }}</a></li>
            <li><a class="govuk-link" href="{{ urlFor('/federation/groups') }}">{{ t("federation.hub.quick_link_groups") }}</a></li>
            <li><a class="govuk-link" href="{{ urlFor('/federation/settings') }}">{{ t("federation.hub.quick_link_settings") }}</a></li>
          </ul>
          <p class="govuk-body govuk-!-margin-top-4"><a class="govuk-link" href="{{ urlFor('/federation/opt-out') }}">{{ t("web_uk.federation_hub.turn_off") }}</a></p>
        </div>
      </div>
    {% endif %}
  {% endif %}
{% endblock %}

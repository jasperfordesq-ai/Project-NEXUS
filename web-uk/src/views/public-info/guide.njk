{% extends "layouts/base.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">{{ t("guide.caption", { community: communityName }) }}</span>
      <h1 class="govuk-heading-xl">{{ t("guide.title") if t else title }}</h1>
      <p class="govuk-body-l">{{ t("guide.intro") }}</p>

      <h2 class="govuk-heading-l">{{ t("guide.equal_title") }}</h2>
      <p class="govuk-body">{{ t("guide.equal_body") }}</p>

      <h2 class="govuk-heading-l">{{ t("guide.steps_title") }}</h2>
      <ol class="govuk-list govuk-list--number govuk-list--spaced">
        <li><span class="govuk-!-font-weight-bold">{{ t("guide.step1_title") }}.</span> {{ t("guide.step1_body") }}</li>
        <li><span class="govuk-!-font-weight-bold">{{ t("guide.step2_title") }}.</span> {{ t("guide.step2_body") }}</li>
        <li><span class="govuk-!-font-weight-bold">{{ t("guide.step3_title") }}.</span> {{ t("guide.step3_body") }}</li>
      </ol>

      {# Where timebanking comes from, and the five values (React TimebankingGuidePage,
         14 Nov 2026). The history is checked fact: see the note on GUIDE_TIMELINE_YEARS
         in routes/public-info.js before changing a date or a name. #}
      <h2 class="govuk-heading-l" id="guide-origins">{{ t("guide.origins_title") }}</h2>
      <p class="govuk-body">{{ t("guide.origins_lead") }}</p>
      <h3 class="govuk-heading-m"><bdi>{{ founder.name }}</bdi> <span class="govuk-!-font-weight-regular">(<bdi>{{ founder.years }}</bdi>)</span></h3>
      {% for paragraph in originsBody %}
        <p class="govuk-body" dir="auto">{{ paragraph }}</p>
      {% endfor %}
      <div class="govuk-inset-text" dir="auto">{{ t("guide.origins_note") }}</div>

      <h3 class="govuk-heading-m" id="guide-timeline">{{ t("guide.timeline_title") }}</h3>
      <dl class="govuk-summary-list" data-guide-timeline>
        {% for entry in timeline %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">{{ entry.when }}</dt>
            <dd class="govuk-summary-list__value" dir="auto">{{ entry.text }}</dd>
          </div>
        {% endfor %}
      </dl>

      <h2 class="govuk-heading-l" id="guide-values">{{ t("guide.values_title") }}</h2>
      <p class="govuk-body">{{ t("guide.values_lead") }}</p>
      <ol class="govuk-list govuk-list--number govuk-list--spaced" data-guide-values>
        {% for value in values %}
          <li>
            <span class="govuk-!-font-weight-bold">{{ value.title }}</span><br>
            {{ value.description }}
          </li>
        {% endfor %}
      </ol>

      <h2 class="govuk-heading-l">{{ t("guide.getting_started_title") }}</h2>
      <p class="govuk-body">{{ t("guide.getting_started_body") }}</p>

      <div class="govuk-button-group govuk-!-margin-top-4">
        {% if isAuthenticated %}
          {% if listingsEnabled %}
            <a class="govuk-button" href="{{ urlFor('/listings') }}" role="button" draggable="false" data-module="govuk-button">{{ t("guide.browse_listings") }}</a>
          {% endif %}
          {% if walletEnabled %}
            <a class="govuk-button govuk-button--secondary" href="{{ urlFor('/wallet') }}" role="button" draggable="false" data-module="govuk-button">{{ t("guide.go_to_wallet") }}</a>
          {% endif %}
        {% else %}
          <a class="govuk-button" href="{{ urlFor('/register') }}" role="button" draggable="false" data-module="govuk-button">{{ t("guide.create_account") }}</a>
          {% if listingsEnabled %}
            <a class="govuk-button govuk-button--secondary" href="{{ urlFor('/listings') }}" role="button" draggable="false" data-module="govuk-button">{{ t("guide.browse_listings") }}</a>
          {% endif %}
        {% endif %}
        {# React TimebankingGuidePage: "Partner With Us" beside the join/browse buttons.
           Only where /partner exists (hour-timebank, lib/tbi-pages.js). #}
        {% if showPartnerLink %}
          <a class="govuk-button govuk-button--secondary" href="{{ urlFor('/partner') }}" role="button" draggable="false" data-module="govuk-button">{{ t("govuk_alpha_partner.links.partner_with_us") }}</a>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}

{# A community's own published CMS page. Deliberately NOT static-page.njk, which
   is preparation-page furniture and prints a "shared accessible frontend
   preparation page" notice — real editorial content must never carry that. #}

{% extends "layouts/base.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ communityName or tenantName }}</span>
      <h1 class="govuk-heading-xl">{{ page.title }}</h1>

      {% if page.updatedAt %}
        <p class="govuk-body-s nexus-alpha-meta">
          {{ t("kb.updated_label") }}: {{ page.updatedAt | formatDate }}
        </p>
      {% endif %}

      {# Sanitized in the route by sanitizeCmsHtml before it reaches here. #}
      <div class="legal-content govuk-body">
        {{ page.content | safe }}
      </div>
    </div>
  </div>
{% endblock %}

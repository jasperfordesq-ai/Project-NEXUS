{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/podcasts/studio') }}">{{ t("govuk_alpha_commerce.podcast_studio.back_to_studio") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  {% if status %}
    {% if status.type == "success" %}
      <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="podcast-manage-status-heading" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="podcast-manage-status-heading">{{ t("states.success_title") }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">{{ status.message }}</p>
        </div>
      </div>
    {% else %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <li>{{ status.message }}</li>
              {% if status.detail %}<li>{{ status.detail }}</li>{% endif %}
            </ul>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_commerce.podcast_studio.caption", { community: tenantName or serviceName }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_commerce.podcast_studio.title_edit") }}</h1>

  <p class="govuk-body">{{ govukTag({ text: show.studioLabel, classes: show.studioTag }) }}</p>
  {% if show.moderationFeedback %}
    <div class="govuk-inset-text">{{ show.moderationFeedback }}</div>
  {% endif %}
  {% if show.status == "draft" %}
    <p class="govuk-body">{{ t("govuk_alpha_commerce.podcast_studio.publish_hint") }}</p>
  {% endif %}

  <h2 class="govuk-heading-m">{{ t("govuk_alpha_commerce.podcast_studio.stats_heading") }}</h2>
  <dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.podcast_studio.stats_subscribers") }}</dt>
      <dd class="govuk-summary-list__value">{{ formatLocaleNumber(stats.subscribers if stats else show.subscriberCount) }}</dd>
    </div>
    {% if stats %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.podcast_studio.stats_listens") }}</dt>
        <dd class="govuk-summary-list__value">{{ formatLocaleNumber(stats.listens) }}</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.podcast_studio.stats_unique_listeners") }}</dt>
        <dd class="govuk-summary-list__value">{{ formatLocaleNumber(stats.uniqueListeners) }}</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.podcast_studio.stats_completion_rate") }}</dt>
        <dd class="govuk-summary-list__value">{{ formatLocaleNumber(stats.completionRate) }}%</dd>
      </div>
    {% endif %}
  </dl>
  {% if stats %}
    <p class="govuk-body-s">{{ t("govuk_alpha_commerce.podcast_studio.stats_period", { days: stats.days }) }}</p>
    {% if stats.topEpisodes.length %}
      <h3 class="govuk-heading-s">{{ t("govuk_alpha_commerce.podcast_studio.stats_top_episodes") }}</h3>
      <ol class="govuk-list govuk-list--number">
        {% for row in stats.topEpisodes %}
          <li>{{ row.title }} — {{ tc("govuk_alpha_commerce.podcast_studio.stats_listen_count", row.listens, { count: formatLocaleNumber(row.listens) }) }}</li>
        {% endfor %}
      </ol>
    {% endif %}
  {% endif %}
  {% set shareShow = show %}{% include "podcasts/_share-links.njk" %}

  {% if rssFeedEnabled %}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/feed-check') }}">{{ t("govuk_alpha_commerce.podcast_studio.feed_check_link") }}</a>
    </p>
  {% endif %}

  <form method="post" action="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/update') }}" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div class="govuk-form-group">
      <label class="govuk-label govuk-label--s" for="title">{{ t("govuk_alpha_commerce.podcast_studio.show_title_label") }}</label>
      <input class="govuk-input" id="title" name="title" type="text" maxlength="200" value="{{ show.title }}">
    </div>

    <div class="govuk-form-group">
      <label class="govuk-label govuk-label--s" for="summary">{{ t("govuk_alpha_commerce.podcast_studio.summary_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
      <input class="govuk-input" id="summary" name="summary" type="text" maxlength="600" value="{{ show.summary }}">
    </div>

    <div class="govuk-form-group">
      <label class="govuk-label govuk-label--s" for="description">{{ t("govuk_alpha_commerce.podcast_studio.description_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
      <textarea class="govuk-textarea" id="description" name="description" rows="5">{{ show.description }}</textarea>
    </div>

    <div class="govuk-form-group">
      <label class="govuk-label govuk-label--s" for="category">{{ t("govuk_alpha_commerce.podcast_studio.category_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
      <input class="govuk-input govuk-input--width-20" id="category" name="category" type="text" maxlength="120" value="{{ show.category }}">
    </div>

    {% include "podcasts/_show-rss-fields.njk" %}

    <div class="govuk-form-group">
      <fieldset class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_commerce.podcast_studio.visibility_label") }}</legend>
        <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
          {% for visibility in visibilities %}
            <div class="govuk-radios__item">
              <input class="govuk-radios__input" id="{% if loop.first %}visibility{% else %}visibility-{{ visibility }}{% endif %}" name="visibility" type="radio" value="{{ visibility }}" {% if show.visibility == visibility %}checked{% endif %}>
              <label class="govuk-label govuk-radios__label" for="{% if loop.first %}visibility{% else %}visibility-{{ visibility }}{% endif %}">{{ t("govuk_alpha_commerce.podcast_studio.visibility_" + visibility) }}</label>
            </div>
          {% endfor %}
        </div>
      </fieldset>
    </div>

    <button class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_commerce.podcast_studio.submit_edit") }}</button>
  </form>

  <h2 class="govuk-heading-m govuk-!-margin-top-6">{{ t("govuk_alpha_commerce.podcast_studio.episodes_heading") }}</h2>

  {% if not episodes.length %}
    <p class="govuk-inset-text">{{ t("govuk_alpha_commerce.podcast_studio.no_episodes") }}</p>
  {% else %}
    <ul class="govuk-list nexus-alpha-card-list">
      {% for episode in episodes %}
        <li class="nexus-alpha-card">
          <div class="nexus-alpha-module-row">
            <span>
              {% if episode.episodeNumberLabel %}<span class="govuk-body-s nexus-alpha-meta">{{ episode.episodeNumberLabel }} - </span>{% endif %}
              {{ episode.title }}
            </span>
            {{ govukTag({ text: episode.studioLabel, classes: episode.studioTag }) }}
          </div>
          {% if episode.moderationFeedback %}
            <p class="govuk-body-s govuk-!-margin-top-2">{{ episode.moderationFeedback }}</p>
          {% endif %}
          <div class="nexus-alpha-actions govuk-!-margin-top-2">
            {% if episode.canPublish %}
              <form method="post" action="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/episodes/' + (episode.id | string) + '/publish') }}" class="govuk-!-display-inline">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button class="govuk-button govuk-button--secondary" data-module="govuk-button" data-prevent-double-click="true">{{ t("govuk_alpha_commerce.podcast_studio.episode_action_publish") }}</button>
              </form>
            {% endif %}
            {% if episode.canArchive %}
              <a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/episodes/' + (episode.id | string) + '/archive') }}">{{ t("govuk_alpha_commerce.podcast_studio.archive_episode_button") }}</a>
            {% endif %}
            <a class="govuk-button govuk-button--warning" data-module="govuk-button" href="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/episodes/' + (episode.id | string) + '/delete') }}">{{ t("govuk_alpha_commerce.podcast_studio.episode_action_delete") }}</a>
          </div>
          <form method="post" action="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/update') }}" enctype="multipart/form-data" class="govuk-!-margin-top-4" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="episode_id" value="{{ episode.id }}">
            {% set episodeField = episode %}
            {% set episodeFieldEdit = true %}
            {% set episodeFieldSuffix = '-' + (episode.id | string) %}
            {% set episodeFieldVisibilities = episode.visibilityOptions %}
            {% include "podcasts/_episode-fields.njk" %}
            <button class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("govuk_alpha_commerce.podcast_studio.submit_edit") }}</button>
          </form>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  <h3 class="govuk-heading-s govuk-!-margin-top-4">{{ t("govuk_alpha_commerce.podcast_studio.add_episode_heading") }}</h3>
  <form method="post" action="{{ urlFor(episodeStoreAction) }}" enctype="multipart/form-data" novalidate class="govuk-!-margin-bottom-6">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {% set episodeField = {} %}
    {% set episodeFieldEdit = false %}
    {% set episodeFieldSuffix = "" %}
    {% set episodeFieldVisibilities = episodeVisibilities %}
    {% include "podcasts/_episode-fields.njk" %}

    <button class="govuk-button govuk-button--secondary" data-module="govuk-button">{{ t("govuk_alpha_commerce.podcast_studio.add_episode_button") }}</button>
  </form>

  {% if show.status != "published" %}
    <h2 class="govuk-heading-m govuk-!-margin-top-6">{{ t("govuk_alpha_commerce.podcast_studio.action_publish_heading") }}</h2>
    <form method="post" action="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/publish') }}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="govuk-button govuk-button--secondary" data-module="govuk-button" data-prevent-double-click="true">{{ t("govuk_alpha_commerce.podcast_studio.action_publish") }}</button>
    </form>
  {% endif %}

  {% if show.status != "archived" %}
    <h2 class="govuk-heading-m govuk-!-margin-top-6">{{ t("govuk_alpha_commerce.podcast_studio.archive_show_heading") }}</h2>
    <p class="govuk-body">{{ t("govuk_alpha_commerce.podcast_studio.archive_show_warning") }}</p>
    <a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/archive') }}">{{ t("govuk_alpha_commerce.podcast_studio.archive_show_button") }}</a>
  {% endif %}

  {# A link to a confirmation page, as for one episode: deleting the whole show used to
     happen straight from this button. #}
  <h2 class="govuk-heading-m govuk-!-margin-top-6">{{ t("govuk_alpha_commerce.podcast_studio.delete_heading") }}</h2>
  <p class="govuk-body">{{ t("govuk_alpha_commerce.podcast_studio.delete_warning") }}</p>
  <a class="govuk-button govuk-button--warning" data-module="govuk-button" href="{{ urlFor('/podcasts/studio/' + (show.id | string) + '/delete') }}">{{ t("govuk_alpha_commerce.podcast_studio.action_delete") }}</a>
    </div>
  </div>
{% endblock %}

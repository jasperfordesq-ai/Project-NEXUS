{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/podcasts/studio/' + (showId | string)) }}">{{ t("govuk_alpha_commerce.podcast_studio.back_to_studio") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_commerce.podcast_studio.feed_check_title") }}</h1>

      <p class="govuk-body-l">{% if valid %}{{ t("govuk_alpha_commerce.podcast_studio.feed_check_valid") }}{% else %}{{ t("govuk_alpha_commerce.podcast_studio.feed_check_invalid") }}{% endif %}</p>

      {% if errors.length %}
        <h2 class="govuk-heading-m">{{ t("govuk_alpha_commerce.podcast_studio.feed_check_errors") }}</h2>
        <ul class="govuk-list govuk-list--bullet">
          {% for issue in errors %}<li>{{ issue }}</li>{% endfor %}
        </ul>
      {% endif %}

      {% if warnings.length %}
        <h2 class="govuk-heading-m">{{ t("govuk_alpha_commerce.podcast_studio.feed_check_warnings") }}</h2>
        <ul class="govuk-list govuk-list--bullet">
          {% for issue in warnings %}<li>{{ issue }}</li>{% endfor %}
        </ul>
      {% endif %}

      {% if skipped > 0 %}
        <div class="govuk-inset-text">{{ tc("govuk_alpha_commerce.podcast_studio.feed_check_skipped", skipped, { count: skipped }) }}</div>
      {% endif %}

      <p class="govuk-body">
        <a class="govuk-link" href="{{ urlFor('/podcasts/studio/' + (showId | string)) }}">{{ t("govuk_alpha_commerce.podcast_studio.back_to_studio") }}</a>
      </p>
    </div>
  </div>
{% endblock %}

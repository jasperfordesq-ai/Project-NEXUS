{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a href="{{ urlFor('/coupons') }}" class="govuk-back-link">{{ t("polish_commerce.coupon_detail_back") }}</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  <span class="govuk-caption-xl">{{ t("coupons.caption", { community: tenantName }) }}</span>
  <h1 class="govuk-heading-xl">{{ coupon.title }}</h1>

  {% if coupon.discountLabel %}
    <p class="govuk-body">{{ govukTag({ text: coupon.discountLabel, classes: "govuk-tag--green" }) }}</p>
  {% endif %}

  {% if coupon.description %}
    <p class="govuk-body govuk-!-margin-bottom-4">{{ coupon.description | striptags | nl2br | safe }}</p>
  {% endif %}

  {# govuk-panel--confirmation is the big green "you have completed a transaction"
     panel. This is an ordinary detail page rendering stored data on every load,
     so the code is inset text under a real heading instead. #}
  {% if coupon.code %}
    <h2 class="govuk-heading-m">{{ t("polish_commerce.coupon_code_panel_title") }}</h2>
    <div class="govuk-inset-text govuk-!-margin-bottom-4">
      <p class="govuk-body-l govuk-!-margin-bottom-0"><strong>{{ coupon.code }}</strong></p>
    </div>
  {% endif %}

  <h2 class="govuk-heading-m">{{ t("polish_commerce.coupon_redemption_heading") }}</h2>
  <p class="govuk-body">{{ t("polish_commerce.coupon_redemption_body") }}</p>

  {# React CouponDetailPage "Redeem in store": a one-time QR code staff scan at the till.
     The form works without JavaScript; the QR is drawn on the server. The one-time
     token is a credential, so it is encoded into the QR only, never printed
     (src/lib/qr-svg.js). #}
  <section id="redeem-in-store" aria-labelledby="redeem-in-store-heading" class="govuk-!-margin-bottom-6">
    <h2 class="govuk-heading-m" id="redeem-in-store-heading">{{ t("govuk_alpha_commerce.coupon_qr.heading") }}</h2>
    {% if qrError %}
      <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
        <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body"><p class="govuk-body">{{ qrError }}</p></div>
        </div>
      </div>
    {% endif %}
    {% if qr %}
      <figure class="govuk-!-margin-0 govuk-!-margin-bottom-4" role="img" aria-label="{{ t('govuk_alpha_commerce.coupon_qr.alt') }}">
        {{ qr.svg | safe }}
      </figure>
      <p class="govuk-body">{{ t("govuk_alpha_commerce.coupon_qr.scan_at_checkout") }}</p>
      {% if qr.expiresText %}<p class="govuk-body">{{ t("govuk_alpha_commerce.coupon_qr.expires_at", { time: qr.expiresText }) }}</p>{% endif %}
    {% else %}
      <p class="govuk-body">{{ t("govuk_alpha_commerce.coupon_qr.intro") }}</p>
    {% endif %}
    {% if coupon.id %}
      <form method="post" action="{{ urlFor('/coupons/' + (coupon.id | string) + '/qr') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button class="govuk-button{% if qr %} govuk-button--secondary{% endif %}" data-module="govuk-button" data-prevent-double-click="true">{{ t("govuk_alpha_commerce.coupon_qr.new_button") if qr else t("govuk_alpha_commerce.coupon_qr.button") }}</button>
      </form>
    {% endif %}
  </section>

  <dl class="govuk-summary-list">
    {% if coupon.merchantName %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("coupons.merchant_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ coupon.merchantName }}</dd>
      </div>
    {% endif %}
    {% if coupon.validUntilText %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("coupons.valid_until_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ coupon.validUntilText }}</dd>
      </div>
    {% endif %}
  </dl>
    </div>
  </div>
{% endblock %}

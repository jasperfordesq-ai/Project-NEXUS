{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a href="{{ urlFor('/coupons') }}" class="govuk-back-link">{{ t("polish_commerce.coupon_detail_back") }}</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  <span class="govuk-caption-xl">{{ t("coupons.caption", { community: tenantName }) }}</span>
  <h1 class="govuk-heading-xl">{{ coupon.title }}</h1>

  {% if coupon.discountLabel %}
    <p class="govuk-body">{{ govukTag({ text: coupon.discountLabel, classes: "govuk-tag--green" }) }}</p>
  {% endif %}

  {% if coupon.description %}
    <p class="govuk-body govuk-!-margin-bottom-4">{{ coupon.description | striptags | nl2br | safe }}</p>
  {% endif %}

  {# govuk-panel--confirmation is the big green "you have completed a transaction"
     panel. This is an ordinary detail page rendering stored data on every load,
     so the code is inset text under a real heading instead. #}
  {% if coupon.code %}
    <h2 class="govuk-heading-m">{{ t("polish_commerce.coupon_code_panel_title") }}</h2>
    <div class="govuk-inset-text govuk-!-margin-bottom-4">
      <p class="govuk-body-l govuk-!-margin-bottom-0"><strong>{{ coupon.code }}</strong></p>
    </div>
  {% endif %}

  <h2 class="govuk-heading-m">{{ t("polish_commerce.coupon_redemption_heading") }}</h2>
  <p class="govuk-body">{{ t("polish_commerce.coupon_redemption_body") }}</p>

  <dl class="govuk-summary-list">
    {% if coupon.merchantName %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("coupons.merchant_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ coupon.merchantName }}</dd>
      </div>
    {% endif %}
    {% if coupon.validUntilText %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("coupons.valid_until_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ coupon.validUntilText }}</dd>
      </div>
    {% endif %}
  </dl>
    </div>
  </div>
{% endblock %}

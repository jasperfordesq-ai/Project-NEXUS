{#
  Seller payouts — React StripeOnboardingPage (27 Oct 2026). The form posts here and
  the member is redirected to the Stripe-hosted page the API returns; no card or
  bank detail is ever entered on this site.
#}
{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block mainContent %}
  {% include "marketplace/_nav.njk" %}
  {% include "marketplace/_status-banner.njk" %}

  <span class="govuk-caption-xl">{{ t("marketplace.caption", { community: tenantName or serviceName }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_commerce.payouts.title") }}</h1>

  {% if payout.complete %}
    <div class="govuk-panel govuk-panel--confirmation">
      <h2 class="govuk-panel__title">{{ t("govuk_alpha_commerce.payouts.complete_title") }}</h2>
      <div class="govuk-panel__body">{{ t("govuk_alpha_commerce.payouts.complete_body") }}</div>
    </div>
    <dl class="govuk-summary-list">
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.payouts.charges_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ govukTag({ text: t("govuk_alpha_commerce.payouts.on" if payout.chargesEnabled else "govuk_alpha_commerce.payouts.off"), classes: "govuk-tag--green" if payout.chargesEnabled else "govuk-tag--grey" }) }}</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.payouts.payouts_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ govukTag({ text: t("govuk_alpha_commerce.payouts.on" if payout.payoutsEnabled else "govuk_alpha_commerce.payouts.off"), classes: "govuk-tag--green" if payout.payoutsEnabled else "govuk-tag--grey" }) }}</dd>
      </div>
    </dl>
    <p class="govuk-body"><a class="govuk-link" href="{{ urlFor('/marketplace/mine') }}">{{ t("govuk_alpha_commerce.nav.mine") }}</a></p>
  {% else %}
    <p class="govuk-body-l">{{ t("govuk_alpha_commerce.payouts.description") }}</p>

    {% if payout.started %}
      <div class="govuk-inset-text">
        <h2 class="govuk-heading-m">{{ t("govuk_alpha_commerce.payouts.incomplete_title") }}</h2>
        <p class="govuk-body">{{ t("govuk_alpha_commerce.payouts.incomplete_body") }}</p>
      </div>
    {% endif %}

    <h2 class="govuk-heading-m">{{ t("govuk_alpha_commerce.payouts.how_heading") }}</h2>
    <p class="govuk-body">{{ t("govuk_alpha_commerce.payouts.how_body") }}</p>

    <h2 class="govuk-heading-m">{{ t("govuk_alpha_commerce.payouts.need_heading") }}</h2>
    <ul class="govuk-list govuk-list--bullet">
      <li>{{ t("govuk_alpha_commerce.payouts.need_bank") }}</li>
      <li>{{ t("govuk_alpha_commerce.payouts.need_id") }}</li>
    </ul>

    <div class="govuk-warning-text">
      <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
      <strong class="govuk-warning-text__text">
        <span class="govuk-visually-hidden">{{ t("states.warning") }}</span>
        {{ t("govuk_alpha_commerce.payouts.security_note") }}
      </strong>
    </div>

    <form method="post" action="{{ urlFor('/marketplace/payouts/start') }}" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="govuk-button govuk-button--start" data-module="govuk-button" data-prevent-double-click="true">
        {{ t("govuk_alpha_commerce.payouts.continue_button" if payout.started else "govuk_alpha_commerce.payouts.start_button") }}
        <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false"><path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z"/></svg>
      </button>
    </form>
  {% endif %}
{% endblock %}

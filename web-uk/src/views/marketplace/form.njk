{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/marketplace/mine') }}">{{ t("govuk_alpha_commerce.common.back_to_my_listings") }}</a>
{% endblock %}

{% block mainContent %}
  {% include "marketplace/_nav.njk" %}

  {# 🔴 Every summary item used to be `<a href="#title">`, whatever the error was about, and
     no field carried an error of its own. The route now supplies `errorList` (one link per
     field at fault, in page order) and `fieldErrors` (keyed by field id). A whole-page
     failure arrives as `formMessage` and is written as a plain sentence, because a summary
     LIST is a list of links to things to fix — a link-less item just traps the reader. #}
  {% if (errorList and errorList.length) or formMessage %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_commerce.common.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          {% if formMessage %}<p class="govuk-body">{{ formMessage }}</p>{% endif %}
          {% if errorList and errorList.length %}
            <ul class="govuk-list govuk-error-summary__list">
              {% for error in errorList %}<li><a href="{{ error.href }}">{{ error.text }}</a></li>{% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_commerce.listing_form.caption", { community: tenantName or serviceName }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_commerce.listing_form.title_edit" if isEdit else "govuk_alpha_commerce.listing_form.title_create") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_commerce.listing_form.description") }}</p>

  {# The create form is multipart so photos can be chosen with the listing (no JavaScript
     needed). Editing keeps a plain form and links to the listing's own photos page. #}
  <form method="post" action="{{ urlFor(action) }}" novalidate{% if not isEdit %} enctype="multipart/form-data"{% endif %}>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
        <h2 class="govuk-fieldset__heading">{{ t("govuk_alpha_commerce.listing_form.section_about") }}</h2>
      </legend>

      <div class="govuk-form-group{% if fieldErrors.title %} govuk-form-group--error{% endif %}">
        <label class="govuk-label govuk-label--s" for="title">{{ t("govuk_alpha_commerce.listing_form.title_label") }}</label>
        <div id="title-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_form.title_hint") }}</div>
        {% if fieldErrors.title %}<p id="title-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.title }}</p>{% endif %}
        <input class="govuk-input{% if fieldErrors.title %} govuk-input--error{% endif %}" id="title" name="title" type="text" maxlength="200" value="{{ listing.title }}" aria-describedby="title-hint{% if fieldErrors.title %} title-error{% endif %}">
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="tagline">{{ t("govuk_alpha_commerce.listing_form.tagline_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
        <div id="tagline-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_form.tagline_hint") }}</div>
        <input class="govuk-input" id="tagline" name="tagline" type="text" maxlength="300" value="{{ listing.tagline }}" aria-describedby="tagline-hint">
      </div>

      <div class="govuk-form-group{% if fieldErrors.description %} govuk-form-group--error{% endif %}">
        <label class="govuk-label govuk-label--s" for="description">{{ t("govuk_alpha_commerce.listing_form.description_label") }}</label>
        <div id="description-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_form.description_hint") }}</div>
        {% if fieldErrors.description %}<p id="description-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.description }}</p>{% endif %}
        <textarea class="govuk-textarea{% if fieldErrors.description %} govuk-textarea--error{% endif %}" id="description" name="description" rows="6" aria-describedby="description-hint{% if fieldErrors.description %} description-error{% endif %}">{{ listing.description }}</textarea>
      </div>

      {% if isEdit %}
        <p class="govuk-body"><a class="govuk-link" href="{{ urlFor('/marketplace/' + (listing.id | string) + '/photos') }}">{{ t("govuk_alpha_commerce.photos.manage_link") }}</a></p>
        <p class="govuk-body"><a class="govuk-link" href="{{ urlFor('/marketplace/' + (listing.id | string) + '/video') }}">{{ t("govuk_alpha_commerce.listing_video.manage_link") }}</a></p>
      {% else %}
        <div class="govuk-form-group{% if fieldErrors.images %} govuk-form-group--error{% endif %}">
          <label class="govuk-label govuk-label--s" for="images">{{ t("govuk_alpha_commerce.photos.upload_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
          <div id="images-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.photos.upload_hint", { count: 10 }) }}</div>
          {% if fieldErrors.images %}<p id="images-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.images }}</p>{% endif %}
          <input class="govuk-file-upload{% if fieldErrors.images %} govuk-file-upload--error{% endif %}" id="images" name="images" type="file" multiple accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="images-hint{% if fieldErrors.images %} images-error{% endif %}">
        </div>

        {# React CreateMarketplaceListingPage: one optional video, uploaded once the listing exists. #}
        <div class="govuk-form-group{% if fieldErrors.video %} govuk-form-group--error{% endif %}">
          <label class="govuk-label govuk-label--s" for="video">{{ t("govuk_alpha_commerce.listing_video.label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
          <div id="video-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_video.hint") }}</div>
          {% if fieldErrors.video %}<p id="video-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.video }}</p>{% endif %}
          <input class="govuk-file-upload{% if fieldErrors.video %} govuk-file-upload--error{% endif %}" id="video" name="video" type="file" accept="video/mp4,video/webm,video/quicktime" aria-describedby="video-hint{% if fieldErrors.video %} video-error{% endif %}">
        </div>
      {% endif %}
    </fieldset>

    <fieldset class="govuk-fieldset govuk-!-margin-top-4">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
        <h2 class="govuk-fieldset__heading">{{ t("govuk_alpha_commerce.listing_form.section_price") }}</h2>
      </legend>

      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset" aria-describedby="price_type-hint">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_commerce.listing_form.price_type_label") }}</legend>
          <div id="price_type-hint" class="govuk-hint govuk-visually-hidden">{{ t("govuk_alpha_commerce.listing_form.price_type_label") }}</div>
          <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
            {% for option in priceTypes %}
              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="{{ 'price_type' if loop.first else 'price_type-' ~ option.value }}" name="price_type" type="radio" value="{{ option.value }}" {% if listing.priceType == option.value %}checked{% endif %}>
                <label class="govuk-label govuk-radios__label" for="{{ 'price_type' if loop.first else 'price_type-' ~ option.value }}">{{ t(option.labelKey) }}</label>
              </div>
            {% endfor %}
          </div>
        </fieldset>
      </div>

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
          {# The price error is raised when NEITHER a money price nor a time-credit price is
             given, so it is marked here — the first of the two fields, and the one the
             summary link targets. #}
          <div class="govuk-form-group{% if fieldErrors.price %} govuk-form-group--error{% endif %}">
            <label class="govuk-label govuk-label--s" for="price">{{ t("govuk_alpha_commerce.listing_form.price_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
            <div id="price-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_form.price_hint") }}</div>
            {% if fieldErrors.price %}<p id="price-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.price }}</p>{% endif %}
            <input class="govuk-input govuk-input--width-10{% if fieldErrors.price %} govuk-input--error{% endif %}" id="price" name="price" type="text" inputmode="decimal" value="{{ listing.price }}" aria-describedby="price-hint{% if fieldErrors.price %} price-error{% endif %}">
          </div>
        </div>
        <div class="govuk-grid-column-one-half">
          <div class="govuk-form-group">
            <label class="govuk-label govuk-label--s" for="price_currency">{{ t("govuk_alpha_commerce.listing_form.currency_label") }}</label>
            <input class="govuk-input govuk-input--width-5" id="price_currency" name="price_currency" type="text" maxlength="3" value="{{ listing.priceCurrency }}">
          </div>
        </div>
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="time_credit_price">{{ t("govuk_alpha_commerce.listing_form.time_credit_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
        <div id="time_credit_price-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_form.time_credit_hint") }}</div>
        <input class="govuk-input govuk-input--width-5" id="time_credit_price" name="time_credit_price" type="text" inputmode="decimal" value="{{ listing.timeCreditPrice }}" aria-describedby="time_credit_price-hint">
      </div>

      {# Borrow & lend only reads this field (the server ignores it for every other
         type), but it is always rendered: there is no JavaScript to show it on choice,
         and the hint says what it is for. #}
      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="loan_terms">{{ t("govuk_alpha_commerce.listing_form.loan_terms_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
        <div id="loan_terms-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_form.loan_terms_hint") }}</div>
        <textarea class="govuk-textarea" id="loan_terms" name="loan_terms" rows="3" maxlength="500" aria-describedby="loan_terms-hint">{{ listing.loanTerms }}</textarea>
      </div>
    </fieldset>

    <fieldset class="govuk-fieldset govuk-!-margin-top-4">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
        <h2 class="govuk-fieldset__heading">{{ t("govuk_alpha_commerce.listing_form.section_details") }}</h2>
      </legend>

      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="condition">{{ t("govuk_alpha_commerce.listing_form.condition_label") }}</label>
        <select class="govuk-select" id="condition" name="condition">
          <option value="">{{ t("govuk_alpha_commerce.listing_form.condition_none") }}</option>
          {% for option in conditions %}<option value="{{ option.value }}" {% if listing.condition == option.value %}selected{% endif %}>{{ t(option.labelKey) }}</option>{% endfor %}
        </select>
      </div>

      {% if categories.length %}
        <div class="govuk-form-group">
          <label class="govuk-label govuk-label--s" for="category_id">{{ t("govuk_alpha_commerce.listing_form.category_label") }}</label>
          <select class="govuk-select" id="category_id" name="category_id">
            <option value="">{{ t("govuk_alpha_commerce.listing_form.category_none") }}</option>
            {% for category in categories %}<option value="{{ category.id }}" {% if listing.categoryId == category.id %}selected{% endif %}>{{ category.name }}</option>{% endfor %}
          </select>
        </div>

        {# Without JavaScript the form cannot redraw itself when the category changes, so
           this button posts it back and it returns with that category's own fields. #}
        <div class="govuk-form-group">
          <div id="show-category-fields-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_template.show_fields_hint") }}</div>
          <button class="govuk-button govuk-button--secondary" data-module="govuk-button" name="form_action" value="show_category_fields" aria-describedby="show-category-fields-hint">{{ t("govuk_alpha_commerce.listing_template.show_fields_button") }}</button>
        </div>
      {% endif %}

      {% if templateFields and templateFields.length %}
        <fieldset class="govuk-fieldset govuk-!-margin-bottom-6" id="template-fields">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_commerce.listing_template.heading") }}</legend>
          {% for field in templateFields %}
            {% set fieldError = fieldErrors[field.id] if fieldErrors else undefined %}
            <div class="govuk-form-group{% if fieldError %} govuk-form-group--error{% endif %}">
              <label class="govuk-label" for="{{ field.id }}">{{ field.label }}{% if not field.required %} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span>{% endif %}</label>
              {% if fieldError %}<p id="{{ field.id }}-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldError }}</p>{% endif %}
              {% if field.type == "select" %}
                <select class="govuk-select{% if fieldError %} govuk-select--error{% endif %}" id="{{ field.id }}" name="{{ field.inputName }}"{% if fieldError %} aria-describedby="{{ field.id }}-error"{% endif %}>
                  <option value="">{{ t("govuk_alpha_commerce.listing_template.select_placeholder", { field: field.label }) }}</option>
                  {% for option in field.options %}<option value="{{ option }}"{% if field.value == option %} selected{% endif %}>{{ option }}</option>{% endfor %}
                </select>
              {% elseif field.type == "number" %}
                <input class="govuk-input govuk-input--width-10{% if fieldError %} govuk-input--error{% endif %}" id="{{ field.id }}" name="{{ field.inputName }}" type="text" inputmode="numeric" value="{{ field.value }}"{% if fieldError %} aria-describedby="{{ field.id }}-error"{% endif %}>
              {% else %}
                <input class="govuk-input{% if fieldError %} govuk-input--error{% endif %}" id="{{ field.id }}" name="{{ field.inputName }}" type="text" value="{{ field.value }}" maxlength="500"{% if fieldError %} aria-describedby="{{ field.id }}-error"{% endif %}>
              {% endif %}
            </div>
          {% endfor %}
        </fieldset>
      {% endif %}

      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_commerce.listing_form.delivery_label") }}</legend>
          <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
            {% for option in deliveryMethods %}
              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="{{ 'delivery_method' if loop.first else 'delivery_method-' ~ option.value }}" name="delivery_method" type="radio" value="{{ option.value }}" {% if listing.deliveryMethod == option.value %}checked{% endif %}>
                <label class="govuk-label govuk-radios__label" for="{{ 'delivery_method' if loop.first else 'delivery_method-' ~ option.value }}">{{ t(option.labelKey) }}</label>
              </div>
            {% endfor %}
          </div>
        </fieldset>
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="location">{{ t("govuk_alpha_commerce.listing_form.location_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
        <div id="location-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.listing_form.location_hint") }}</div>
        <input class="govuk-input" id="location" name="location" type="text" maxlength="255" value="{{ listing.location }}" autocomplete="off" aria-describedby="location-hint">
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="quantity">{{ t("govuk_alpha_commerce.listing_form.quantity_label") }}</label>
        <input class="govuk-input govuk-input--width-5" id="quantity" name="quantity" type="text" spellcheck="false" inputmode="numeric" value="{{ listing.quantity }}">
      </div>
    </fieldset>

    <div class="govuk-button-group govuk-!-margin-top-4">
      <button class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_commerce.listing_form.submit_edit" if isEdit else "govuk_alpha_commerce.listing_form.submit_create") }}</button>
      <a class="govuk-link" href="{{ urlFor('/marketplace/mine') }}">{{ t("govuk_alpha_commerce.common.cancel") }}</a>
    </div>
  </form>
{% endblock %}

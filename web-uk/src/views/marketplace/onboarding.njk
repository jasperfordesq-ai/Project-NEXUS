{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/marketplace') }}">{{ t("govuk_alpha_commerce.common.back_to_marketplace") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  {% include "marketplace/_nav.njk" %}
  {% if status and status.type == "success" %}
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">{{ t("govuk_alpha.states.success_title") }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">{{ status.message }}</p>
      </div>
    </div>
  {% endif %}

  {# 🔴 Two defects fixed here. Every summary item was `href="#display_name"`, so a
     business seller who left the BUSINESS NAME blank was pointed at the display-name box
     and the field at fault was unreachable from the summary. And the API-failure message
     was pushed in as a LINK-LESS `<li>` — an error summary list is a list of links to
     things to fix, so a page-level failure is now a plain sentence in the summary body. #}
  {% if (errorList and errorList.length) or formMessage or (status and status.type == "error") %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
      <div role="alert">
        <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_commerce.common.error_title") }}</h2>
        <div class="govuk-error-summary__body">
          {% if formMessage %}<p class="govuk-body">{{ formMessage }}</p>{% endif %}
          {% if status and status.type == "error" %}<p class="govuk-body">{{ status.message }}</p>{% endif %}
          {% if errorList and errorList.length %}
            <ul class="govuk-list govuk-error-summary__list">
              {% for error in errorList %}<li><a href="{{ error.href }}">{{ error.text }}</a></li>{% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_commerce.onboarding.caption", { community: tenantName or serviceName }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_commerce.onboarding.title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_commerce.onboarding.description") }}</p>

  {% if completed %}
    <div class="govuk-notification-banner" role="region" aria-labelledby="onboarding-complete-banner" data-module="govuk-notification-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="onboarding-complete-banner">{{ t("govuk_alpha_commerce.common.notice_title") }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">{{ t("govuk_alpha_commerce.onboarding.completed_banner") }}</p>
      </div>
    </div>
  {% endif %}

  <form method="post" action="{{ urlFor('/marketplace/onboarding') }}"{% if photoUploadsAvailable %} enctype="multipart/form-data"{% endif %} novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
        <h2 class="govuk-fieldset__heading">{{ t("govuk_alpha_commerce.onboarding.section_identity") }}</h2>
      </legend>

      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_commerce.onboarding.seller_type_label") }}</legend>
          <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
            {% for sellerType in sellerTypes %}
              <div class="govuk-radios__item">
                {% set sellerTypeId = "seller_type" if loop.first else "seller_type-" + sellerType.value %}
                <input class="govuk-radios__input" id="{{ sellerTypeId }}" name="seller_type" type="radio" value="{{ sellerType.value }}" {% if profile.seller_type == sellerType.value %}checked{% endif %}>
                <label class="govuk-label govuk-radios__label" for="{{ sellerTypeId }}">{{ sellerType.label }}</label>
              </div>
            {% endfor %}
          </div>
        </fieldset>
      </div>

      <div class="govuk-form-group{% if fieldErrors.display_name %} govuk-form-group--error{% endif %}">
        <label class="govuk-label govuk-label--s" for="display_name">{{ t("govuk_alpha_commerce.onboarding.display_name_label") }}</label>
        <div id="display_name-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.onboarding.display_name_hint") }}</div>
        {% if fieldErrors.display_name %}<p id="display_name-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.display_name }}</p>{% endif %}
        <input class="govuk-input{% if fieldErrors.display_name %} govuk-input--error{% endif %}" id="display_name" name="display_name" type="text" maxlength="200" autocomplete="nickname" value="{{ profile.display_name }}" aria-describedby="display_name-hint{% if fieldErrors.display_name %} display_name-error{% endif %}">
      </div>

      <div class="govuk-form-group{% if fieldErrors.business_name %} govuk-form-group--error{% endif %}">
        <label class="govuk-label govuk-label--s" for="business_name">{{ t("govuk_alpha_commerce.onboarding.business_name_label") }}</label>
        <div id="business_name-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.onboarding.business_name_hint") }}</div>
        {% if fieldErrors.business_name %}<p id="business_name-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ fieldErrors.business_name }}</p>{% endif %}
        <input class="govuk-input{% if fieldErrors.business_name %} govuk-input--error{% endif %}" id="business_name" name="business_name" type="text" maxlength="200" value="{{ profile.business_name }}" aria-describedby="business_name-hint{% if fieldErrors.business_name %} business_name-error{% endif %}">
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="bio">{{ t("govuk_alpha_commerce.onboarding.bio_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
        <div id="bio-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.onboarding.bio_hint") }}</div>
        <textarea class="govuk-textarea" id="bio" name="bio" rows="3" aria-describedby="bio-hint">{{ profile.bio }}</textarea>
      </div>

      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="business_registration">{{ t("govuk_alpha_commerce.onboarding.registration_label") }} <span class="govuk-hint govuk-!-display-inline">({{ t("govuk_alpha_commerce.common.optional") }})</span></label>
        <div id="business_registration-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.onboarding.registration_hint") }}</div>
        <input class="govuk-input govuk-input--width-20" id="business_registration" name="business_registration" type="text" maxlength="120" value="{{ profile.business_registration }}" aria-describedby="business_registration-hint">
      </div>
    </fieldset>

    <fieldset class="govuk-fieldset govuk-!-margin-top-4">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
        <h2 class="govuk-fieldset__heading">{{ t("govuk_alpha_commerce.onboarding.section_location") }}</h2>
      </legend>
      <p class="govuk-body">{{ t("govuk_alpha_commerce.onboarding.location_description") }}</p>

      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="address_street">{{ t("govuk_alpha_commerce.onboarding.address_street_label") }}</label>
        <input class="govuk-input" id="address_street" name="address_street" type="text" maxlength="200" value="{{ address.street }}" autocomplete="street-address">
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="address_city">{{ t("govuk_alpha_commerce.onboarding.address_city_label") }}</label>
        <input class="govuk-input govuk-input--width-20" id="address_city" name="address_city" type="text" maxlength="120" value="{{ address.city }}" autocomplete="address-level2">
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="address_postal_code">{{ t("govuk_alpha_commerce.onboarding.address_postal_code_label") }}</label>
        <input class="govuk-input govuk-input--width-10" id="address_postal_code" name="address_postal_code" type="text" maxlength="40" value="{{ address.postal_code }}" autocomplete="postal-code">
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="address_country">{{ t("govuk_alpha_commerce.onboarding.address_country_label") }}</label>
        <input class="govuk-input govuk-input--width-20" id="address_country" name="address_country" type="text" maxlength="120" value="{{ address.country }}" autocomplete="country-name">
      </div>
    </fieldset>

    {# Opening hours (React MerchantOnboardingPage step 2): one fieldset per day,
       a Closed tick box plus opening and closing times. #}
    <fieldset class="govuk-fieldset govuk-!-margin-top-4" aria-describedby="hours-hint">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
        <h2 class="govuk-fieldset__heading">{{ t("govuk_alpha_commerce.onboarding.section_hours") }}</h2>
      </legend>
      <div id="hours-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.onboarding.hours_hint") }}</div>
      {% for day in hoursDays %}
        {% set dayHours = hours[day] %}
        {% set dayError = fieldErrors["hours_" ~ day ~ "_open"] %}
        <div class="govuk-form-group{% if dayError %} govuk-form-group--error{% endif %}">
          <fieldset class="govuk-fieldset"{% if dayError %} aria-describedby="hours_{{ day }}-error"{% endif %}>
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_commerce.onboarding.day_" ~ day) }}</legend>
            {% if dayError %}<p id="hours_{{ day }}-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ dayError }}</p>{% endif %}
            <div class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-bottom-2" data-module="govuk-checkboxes">
              <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input" id="hours_{{ day }}_closed" name="hours_{{ day }}_closed" type="checkbox" value="1"{% if dayHours.closed %} checked{% endif %}>
                <label class="govuk-label govuk-checkboxes__label" for="hours_{{ day }}_closed">{{ t("govuk_alpha_commerce.onboarding.closed_label") }}</label>
              </div>
            </div>
            <div class="govuk-!-display-inline-block govuk-!-margin-right-4">
              <label class="govuk-label" for="hours_{{ day }}_open">{{ t("govuk_alpha_commerce.onboarding.open_time_label") }}</label>
              <input class="govuk-input govuk-input--width-5{% if dayError %} govuk-input--error{% endif %}" id="hours_{{ day }}_open" name="hours_{{ day }}_open" type="text" autocomplete="off" spellcheck="false" value="{{ dayHours.open }}">
            </div>
            <div class="govuk-!-display-inline-block">
              <label class="govuk-label" for="hours_{{ day }}_close">{{ t("govuk_alpha_commerce.onboarding.close_time_label") }}</label>
              <input class="govuk-input govuk-input--width-5{% if dayError %} govuk-input--error{% endif %}" id="hours_{{ day }}_close" name="hours_{{ day }}_close" type="text" autocomplete="off" spellcheck="false" value="{{ dayHours.close }}">
            </div>
          </fieldset>
        </div>
      {% endfor %}
    </fieldset>

    {% if photoUploadsAvailable %}
      {# Optional seller photos (React step 3). A cover goes only with a profile photo. #}
      <fieldset class="govuk-fieldset govuk-!-margin-top-4" aria-describedby="photos-hint">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
          <h2 class="govuk-fieldset__heading">{{ t("govuk_alpha_commerce.onboarding.section_photos") }}</h2>
        </legend>
        <div id="photos-hint" class="govuk-hint">{{ t("govuk_alpha_commerce.onboarding.photos_hint") }}</div>
        {% for photo in [{ field: "avatar", label: t("govuk_alpha_commerce.onboarding.avatar_label") }, { field: "cover_image", label: t("govuk_alpha_commerce.onboarding.cover_label") }] %}
          {% set photoError = fieldErrors[photo.field] %}
          <div class="govuk-form-group{% if photoError %} govuk-form-group--error{% endif %}">
            <label class="govuk-label govuk-label--s" for="{{ photo.field }}">{{ photo.label }}</label>
            {% if photoError %}<p id="{{ photo.field }}-error" class="govuk-error-message"><span class="govuk-visually-hidden">{{ t("states.error_prefix") }}</span> {{ photoError }}</p>{% endif %}
            <input class="govuk-file-upload{% if photoError %} govuk-file-upload--error{% endif %}" id="{{ photo.field }}" name="{{ photo.field }}" type="file" accept="image/jpeg,image/png,image/webp,image/gif"{% if photoError %} aria-describedby="{{ photo.field }}-error"{% endif %}>
          </div>
        {% endfor %}
      </fieldset>
    {% endif %}

    <div class="govuk-button-group govuk-!-margin-top-4">
      <button class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_commerce.onboarding.submit") }}</button>
      <a class="govuk-link" href="{{ urlFor('/marketplace') }}">{{ t("govuk_alpha_commerce.common.cancel") }}</a>
    </div>
  </form>
    </div>
  </div>
{% endblock %}

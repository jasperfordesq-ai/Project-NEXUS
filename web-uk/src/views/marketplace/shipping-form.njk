{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/marketplace/shipping') }}">{{ t("govuk_alpha_commerce.shipping.back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "marketplace/_form-error-summary.njk" %}
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_commerce.shipping.edit_title") }}</h1>
      <form method="post" action="{{ urlFor('/marketplace/shipping/' + (option.id | string) + '/update') }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% include "marketplace/_shipping-fields.njk" %}
        <div class="govuk-button-group">
          <button class="govuk-button" data-module="govuk-button" data-prevent-double-click="true">{{ t("govuk_alpha_commerce.common.save") }}</button>
          <a class="govuk-link" href="{{ urlFor('/marketplace/shipping') }}">{{ t("govuk_alpha_commerce.common.cancel") }}</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

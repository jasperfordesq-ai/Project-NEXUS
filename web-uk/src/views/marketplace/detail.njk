{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/marketplace') }}">{{ t("marketplace.back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
  {# The create/save/report handlers all redirect here with ?status=…; the page
     dropped it, so a seller never saw "Your listing has been published." #}
  {% include "marketplace/_status-banner.njk" %}
  {% if item.isPendingModeration %}
    <div class="govuk-notification-banner" role="region" aria-labelledby="listing-pending-banner-title" data-module="govuk-notification-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="listing-pending-banner-title">{{ t("states.important") }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-body">{{ t("govuk_alpha_commerce.listing_form.pending_review_notice") }}</p>
      </div>
    </div>
  {% endif %}
  <span class="govuk-caption-xl">{{ t("marketplace.caption", { community: tenantName or serviceName }) }}</span>
  <h1 class="govuk-heading-xl">{{ item.title }}</h1>
  <p class="govuk-body">{{ govukTag({ text: item.priceLabel, classes: (item.priceTagClass) }) }}</p>
  {% if item.isLend and item.loanTerms %}
    {# Borrow & lend: the owner's conditions, shown before the photos so a borrower
       reads "up to two weeks, collect from ..." before deciding to ask. #}
    <div class="govuk-inset-text">
      <h2 class="govuk-heading-s govuk-!-margin-bottom-1">{{ t("govuk_alpha_commerce.listing_form.loan_terms_label") }}</h2>
      <p class="govuk-body govuk-!-margin-bottom-0">{{ item.loanTerms }}</p>
    </div>
  {% endif %}

  {% if item.images.length == 1 %}
    <div class="nexus-alpha-detail-hero">
      <img src="{{ item.images[0] }}" alt="" loading="lazy" decoding="async">
    </div>
  {% elseif item.images.length > 1 %}
    <ul class="govuk-list nexus-alpha-image-strip govuk-!-margin-bottom-4">
      {% for image in item.images %}
        <li><a href="{{ image }}" target="_blank" rel="noopener noreferrer"><span class="govuk-visually-hidden"> {{ t("opens_new_tab") }}</span><img src="{{ image }}" alt="{{ t('listings.gallery_image_alt', { number: loop.index, title: item.title }) }}" loading="lazy" decoding="async"></a></li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if item.description %}
    <h2 class="govuk-heading-l">{{ t("marketplace.about_label") }}</h2>
    <div class="govuk-body">{{ item.description | nl2br | safe }}</div>
  {% endif %}

  {% if item.videoUrl %}
    <h2 class="govuk-heading-m">{{ t("govuk_alpha_commerce.listing_video.label") }}</h2>
    {% set videoUrl = item.videoUrl %}
    {% include "marketplace/_listing-video.njk" %}
  {% endif %}

  <dl class="govuk-summary-list">
    {% if item.condition %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("marketplace.condition_label") }}</dt>
        {# conditionLabel, not condition: the raw value is a database enum, so
           this row read "like_new" to the member. The route already translates
           it and falls back to the raw value when there is no key. #}
        <dd class="govuk-summary-list__value">{{ item.conditionLabel or item.condition }}</dd>
      </div>
    {% endif %}
    {% if item.location %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("marketplace.location_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ item.location }}</dd>
      </div>
    {% endif %}
    {% if item.deliveryMethod %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("marketplace.delivery_label") }}</dt>
        {# deliveryLabel, not deliveryMethod — this row read "local_pickup". #}
        <dd class="govuk-summary-list__value">{{ item.deliveryLabel or item.deliveryMethod }}</dd>
      </div>
    {% endif %}
    {% if item.sellerName %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("marketplace.seller_label") }}</dt>
        <dd class="govuk-summary-list__value">{{ item.sellerName }}</dd>
      </div>
    {% endif %}
  </dl>

  {# React MarketplaceListingPage: the category details the seller filled in. #}
  {% if itemDetails and itemDetails.length %}
    <h2 class="govuk-heading-m">{{ t("govuk_alpha_commerce.detail.item_details") }}</h2>
    <dl class="govuk-summary-list">
      {% for row in itemDetails %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ row.label }}</dt>
          <dd class="govuk-summary-list__value">{{ row.value }}</dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}

  {% if item.id and item.isOwnItem %}
    <div class="govuk-button-group govuk-!-margin-top-4">
      <a class="govuk-button govuk-button--secondary" href="{{ urlFor('/marketplace/' + (item.id | string) + '/edit') }}" role="button" draggable="false" data-module="govuk-button">{{ t("govuk_alpha_commerce.my_listings.action_edit") }}</a>
      <a class="govuk-link" href="{{ urlFor('/marketplace/' + (item.id | string) + '/photos') }}">{{ t("govuk_alpha_commerce.photos.manage_link") }}</a>
    </div>
  {% endif %}

  {% if item.id and not item.isOwnItem %}
    {# One button group, one primary. "Buy" is the primary action; everything
       else is secondary or a link — two primaries ("Buy" AND "Message seller")
       previously rendered together in two stacked groups with a doubled gap. #}
    <div class="govuk-button-group govuk-!-margin-top-4">
      {% if item.canBuy %}<a class="govuk-button" href="{{ urlFor('/marketplace/' + (item.id | string) + '/buy') }}" role="button" draggable="false" data-module="govuk-button">{{ t("govuk_alpha_commerce.nav.detail_buy") }}</a>{% endif %}
      {# Borrow & lend: nothing is bought, so "Ask to borrow" (a message to the owner)
         is the one primary action and the offer button is withheld — the API refuses
         offers on a lend listing. #}
      {% if item.isLend and item.sellerId %}<a class="govuk-button" href="{{ urlFor('/messages/new/' + (item.sellerId | string)) }}" role="button" draggable="false" data-module="govuk-button">{{ t("govuk_alpha_commerce.nav.detail_ask_to_borrow") }}</a>{% endif %}
      {% if item.canOffer %}<a class="govuk-button govuk-button--secondary" href="{{ urlFor('/marketplace/' + (item.id | string) + '/offer') }}" role="button" draggable="false" data-module="govuk-button">{{ t("govuk_alpha_commerce.nav.detail_offer") }}</a>{% endif %}
      <form method="post" action="{{ urlFor('/marketplace/' + (item.id | string) + '/save') }}">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("govuk_alpha_commerce.nav.detail_save") }}</button>
      </form>
      <a class="govuk-link" href="{{ urlFor('/marketplace/' + (item.id | string) + '/add-to-list') }}">{{ t("govuk_alpha_commerce.wish_lists.add_link") }}</a>
      {% if item.sellerId %}
        {% if not item.isLend %}<a class="govuk-button govuk-button--secondary" href="{{ urlFor('/messages/new/' + (item.sellerId | string)) }}" role="button" draggable="false" data-module="govuk-button">{{ t("polish_commerce.marketplace_message_seller") }}</a>{% endif %}
        <a class="govuk-link" href="{{ urlFor('/marketplace/' + (item.id | string) + '/report') }}">{{ t("govuk_alpha_commerce.nav.detail_report") }}</a>
      {% endif %}
    </div>
  {% endif %}

  {# React MarketplaceListingPage: "More from this seller". #}
  {% if sellerListings and sellerListings.length and item.sellerId %}
    <section aria-labelledby="more-from-seller-heading" class="govuk-!-margin-top-7">
      <h2 class="govuk-heading-m" id="more-from-seller-heading">{{ t("govuk_alpha_commerce.detail.more_from_seller", { name: item.sellerName }) if item.sellerName else t("govuk_alpha_commerce.detail.more_from_this_seller") }}</h2>
      {% set sellerHref = '/marketplace/seller/' + (item.sellerId | string) %}
      <div class="nexus-alpha-card-list">
        {% for item in sellerListings %}
          {% include "marketplace/_listing-card.njk" %}
        {% endfor %}
      </div>
      <p class="govuk-body"><a class="govuk-link" href="{{ urlFor(sellerHref) }}">{{ t("govuk_alpha_commerce.detail.view_all_from_seller") }}</a></p>
    </section>
  {% endif %}
    </div>
  </div>
{% endblock %}

{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/marketplace') }}">{{ t("govuk_alpha_commerce.common.back_to_marketplace") }}</a>
{% endblock %}

{% block mainContent %}
  <span class="govuk-caption-xl">{{ t("govuk_alpha_commerce.seller.caption", { community: tenantName or serviceName }) }}</span>
  <h1 class="govuk-heading-xl">{{ seller.name }}</h1>

  <div class="nexus-alpha-card govuk-!-margin-bottom-6">
    {% if seller.avatarUrl %}
      <img class="nexus-alpha-avatar" src="{{ seller.avatarUrl | thumb(80, 80) }}" alt="{{ seller.name }}" width="64" height="64" loading="lazy" decoding="async">
    {% endif %}
    <dl class="govuk-summary-list govuk-!-margin-bottom-0">
      {% if seller.verified %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.seller.verified") }}</dt>
          <dd class="govuk-summary-list__value"><strong class="govuk-tag govuk-tag--green">{{ t("govuk_alpha_commerce.seller.verified") }}</strong></dd>
        </div>
      {% endif %}
      {% if seller.createdAt %}
        <div class="govuk-summary-list__row">
          {# memberSinceText is the whole sentence "Member since March 2024", so
             using it as the KEY beside createdAt printed the date twice:
             "Member since March 2024 | March 2024". profile.joined_label is the
             short label the member profile already uses for this exact row. #}
          <dt class="govuk-summary-list__key">{{ t("profile.joined_label") }}</dt>
          <dd class="govuk-summary-list__value">{{ seller.createdAt }}</dd>
        </div>
      {% endif %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.seller.rating_label") }}</dt>
        <dd class="govuk-summary-list__value">
          {% if seller.totalRatings > 0 %}
            {# value must be the NUMBER, not averageRatingLabel: that is
               toLocaleString output, so in any comma-decimal locale it became
               "4,5" — an invalid progress value, and the bar rendered empty.
               The label stays the localised text for people reading it. #}
            <progress class="nexus-alpha-progress" value="{{ seller.averageRating }}" max="5" aria-label="{{ seller.ratingText }}">{{ seller.averageRatingLabel }}</progress>
            <span>{{ seller.ratingText }}</span>
          {% else %}
            {{ t("govuk_alpha_commerce.seller.no_ratings") }}
          {% endif %}
        </dd>
      </div>
      {% if seller.totalRatings > 0 and seller.totalSales > 0 %}
        <div class="govuk-summary-list__row">
          {# Same duplication: totalSalesText is "12 completed sales", so this
             row read "12 completed sales | 12". #}
          <dt class="govuk-summary-list__key">{{ t("govuk_alpha_commerce.nav.sales") }}</dt>
          <dd class="govuk-summary-list__value">{{ seller.totalSalesText }}</dd>
        </div>
      {% endif %}
    </dl>
  </div>

  <h2 class="govuk-heading-l">{{ t("govuk_alpha_commerce.seller.listings_heading") }}</h2>
  {% if not listings.length %}
    <div class="govuk-inset-text">
      <p class="govuk-body">{{ t("govuk_alpha_commerce.seller.empty") }}</p>
    </div>
  {% else %}
    <div class="nexus-alpha-card-list">
      {% for item in listings %}
        {% include "marketplace/_listing-card.njk" %}
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

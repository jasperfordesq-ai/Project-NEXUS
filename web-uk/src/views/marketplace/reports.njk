{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block mainContent %}
  {% include "marketplace/_nav.njk" %}

  <span class="govuk-caption-xl">{{ t("govuk_alpha_commerce.my_reports.caption", { community: tenantName or serviceName }) }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha_commerce.my_reports.title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha_commerce.my_reports.description") }}</p>

  {% if not reports.length %}
    <div class="govuk-inset-text">
      <p class="govuk-body">{{ t("govuk_alpha_commerce.my_reports.empty") }}</p>
    </div>
  {% else %}
    <div class="nexus-alpha-table-scroll" tabindex="0" role="region" aria-label="{{ t('govuk_alpha_commerce.my_reports.title') }}">
    <table class="govuk-table">
      <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">{{ t("govuk_alpha_commerce.my_reports.title") }}</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_commerce.my_reports.report_heading") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_commerce.report.item_label") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_commerce.my_reports.reason_label") }}</th>
          <th scope="col" class="govuk-table__header">{{ t("govuk_alpha_commerce.orders.status_label") }}</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for report in reports %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link" href="{{ urlFor(report.href) }}">{{ report.reference }}</a>
              <span class="govuk-body-s govuk-!-display-block nexus-alpha-meta govuk-!-margin-bottom-0">{{ report.roleLabel }}</span>
            </td>
            <td class="govuk-table__cell">{{ report.listingTitle or t("govuk_alpha_commerce.my_reports.listing_unavailable") }}</td>
            <td class="govuk-table__cell">{{ report.reasonLabel }}</td>
            <td class="govuk-table__cell">{{ govukTag({ text: report.statusLabel, classes: report.statusTagClass }) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  {% endif %}
{% endblock %}

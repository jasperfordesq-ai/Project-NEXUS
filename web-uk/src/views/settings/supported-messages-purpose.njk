{#
    🔴 The purpose form IS the page when no live purpose is held — not an overlay
    on top of loaded messages. Nothing has been fetched at this point, and
    nothing will be until this form is submitted.

    The reason is posted, stored in the session, and sent onward in a header. It
    is never placed in a web address: addresses reach access logs, browser
    history and shared screenshots, and this text can name a person.
#}

{% extends "layouts/base.njk" %}
{% from "_character-count.njk" import characterCount %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/settings/linked-accounts') }}">{{ t("govuk_alpha_settings.linked.activity_back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-xl">{{ t("govuk_alpha_settings.linked.caption") }}</span>
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_settings.linked_messages.purpose_title") }}</h1>

      {# The warning is shown BEFORE the field, so a supporter reads what this
         means for the other person before deciding to continue. #}
      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          {# Blade reuses common.error_title here as the screen-reader prefix;
             there is no separate `warning` key, and inventing one would leave it
             untranslated in the other ten locales. #}
          <span class="govuk-visually-hidden">{{ t("govuk_alpha_settings.common.error_title") }}</span>
          {{ t("govuk_alpha_settings.linked_messages.purpose_warning") }}
        </strong>
      </div>

      <form method="post" action="{{ urlFor('/settings/linked-accounts/messages/' + childUserId + '/purpose') }}">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if partnerId %}
          <input type="hidden" name="partner_id" value="{{ partnerId }}">
        {% endif %}

        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
              {{ t("govuk_alpha_settings.linked_messages.purpose_reason_legend") }}
            </legend>
            <div class="govuk-radios" data-module="govuk-radios">
              {% for reason in reasons %}
                <div class="govuk-radios__item">
                  <input class="govuk-radios__input" id="reason-{{ reason }}" name="reason" type="radio" value="{{ reason }}"{% if loop.first %} checked{% endif %}>
                  <label class="govuk-label govuk-radios__label" for="reason-{{ reason }}">
                    {{ t("govuk_alpha_settings.linked_messages.reason_" + reason) }}
                  </label>
                </div>
              {% endfor %}
            </div>
          </fieldset>
        </div>

        {% call characterCount(300, characterCountMessages, "detail") %}
        <div class="govuk-form-group">
          <label class="govuk-label" for="detail">{{ t("govuk_alpha_settings.linked_messages.purpose_detail_label") }}</label>
          <div id="detail-hint" class="govuk-hint">{{ t("govuk_alpha_settings.linked_messages.purpose_detail_hint") }}</div>
          <textarea class="govuk-textarea govuk-js-character-count" id="detail" name="detail" rows="3" maxlength="300" aria-describedby="detail-hint detail-info"></textarea>
        </div>
        {% endcall %}

        <button class="govuk-button" data-module="govuk-button" type="submit">
          {{ t("govuk_alpha_settings.linked_messages.purpose_continue") }}
        </button>
      </form>
    </div>
  </div>
{% endblock %}

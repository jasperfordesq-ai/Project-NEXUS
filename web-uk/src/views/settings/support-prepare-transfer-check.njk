{#
    Check page for a prepared transfer. Nothing has been sent yet. The button
    says exactly what happens next: ask the supported member, or move their
    credits now. "Change" posts back to the form so no amount enters a URL.
#}

{% extends "layouts/base.njk" %}

{% set base = '/settings/support-actions/prepare/' + (supportedUserId | string) + '/transfer' %}

{% macro hiddenFields(summary, csrfToken, idempotencyKey) %}
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <input type="hidden" name="recipient_id" value="{{ summary.recipientId }}">
  <input type="hidden" name="recipient_q" value="{{ summary.recipientQuery }}">
  <input type="hidden" name="amount" value="{{ summary.amountText }}">
  <input type="hidden" name="description" value="{{ summary.description }}">
  <input type="hidden" name="idempotency_key" value="{{ idempotencyKey }}">
{% endmacro %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/settings/linked-accounts') }}#children">{{ t("govuk_alpha_settings.linked.activity_back") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">{{ t("govuk_alpha_settings.support_prepare.transfer_title", { name: supportedName }) }}</span>
      <h1 class="govuk-heading-xl">{{ t("onboarding.confirm.title") }}</h1>

      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t("govuk_alpha_settings.support_prepare.recipient_label") }}</dt>
          <dd class="govuk-summary-list__value">{{ summary.recipientName }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t("govuk_alpha_settings.support_prepare.amount_label") }}</dt>
          <dd class="govuk-summary-list__value">{{ summary.amountText }}</dd>
        </div>
        {% if summary.description %}
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">{{ t("govuk_alpha_settings.support_prepare.description_label") }}</dt>
            <dd class="govuk-summary-list__value" dir="auto">{{ summary.description }}</dd>
          </div>
        {% endif %}
      </dl>

      {% if tier == "co_decide" %}
        <div class="govuk-inset-text">{{ t("govuk_alpha_settings.support_prepare.explainer_co_decide", { name: supportedName }) }}</div>
      {% else %}
        <div class="govuk-warning-text">
          <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
          <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">{{ t("states.warning") }}</span>
            {{ t("govuk_alpha_settings.support_prepare.explainer_represent", { name: supportedName }) }}
          </strong>
        </div>
      {% endif %}

      <form method="post" action="{{ urlFor(base) }}" novalidate>
        {{ hiddenFields(summary, csrfToken, idempotencyKey) }}
        <button class="govuk-button" data-module="govuk-button" type="submit" data-prevent-double-click="true">
          {{ t("govuk_alpha_settings.support_prepare.submit_prepare") if tier == "co_decide" else t("govuk_alpha_settings.support_prepare.submit_direct") }}
        </button>
      </form>

      <form method="post" action="{{ urlFor(base + '/review') }}" novalidate>
        {{ hiddenFields(summary, csrfToken, idempotencyKey) }}
        <input type="hidden" name="edit" value="1">
        <button class="govuk-button govuk-button--secondary" data-module="govuk-button" type="submit">{{ t("govuk_alpha_settings.support_prepare.recipient_change") }}</button>
      </form>
    </div>
  </div>
{% endblock %}

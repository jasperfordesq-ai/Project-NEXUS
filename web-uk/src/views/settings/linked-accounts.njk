{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% macro relationshipCard(relationship, mode, permissions, csrfToken) %}
  {% set isPending = relationship.status == "pending" %}
  <li class="nexus-alpha-card">
    <div class="nexus-alpha-card-head">
      {% if relationship.avatarUrl %}
        <img class="nexus-alpha-avatar" src="{{ relationship.avatarUrl | thumb(80, 80) }}" alt="" loading="lazy" decoding="async" width="48" height="48">
      {% else %}
        <span class="nexus-alpha-avatar nexus-alpha-avatar--placeholder" aria-hidden="true">{{ relationship.name | first | upper }}</span>
      {% endif %}
      <div>
        <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-0">{{ relationship.name }}</p>
        <p class="govuk-body-s nexus-alpha-meta govuk-!-margin-bottom-0">{{ relationship.relationshipTypeLabel }}</p>
      </div>
    </div>

    <p class="govuk-body-s govuk-!-margin-bottom-2">
      <strong class="govuk-tag{% if isPending %} govuk-tag--yellow{% else %} govuk-tag--green{% endif %}">
        {% if isPending %}{{ t("govuk_alpha_settings.linked.status_pending") }}{% else %}{{ t("govuk_alpha_settings.linked.status_active") }}{% endif %}
      </strong>
    </p>

    {# F-224: the API says whose answer a pending link waits for; without it, the supported member answers. #}
    {% if relationship.awaitingYourResponse === true or relationship.awaitingYourResponse === false %}
      {% set canApprove = relationship.awaitingYourResponse %}
    {% else %}
      {% set canApprove = mode == "parent" %}
    {% endif %}
    {% if relationship.relationshipId > 0 and isPending and canApprove %}
      <form method="post" action="{{ urlFor('/settings/linked-accounts/approve') }}" class="govuk-!-display-inline-block govuk-!-margin-right-2" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="relationship_id" value="{{ relationship.relationshipId }}">
        <button class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("govuk_alpha_settings.linked.approve_button") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></button>
      </form>
    {% endif %}

    {# Support levels (React SubAccountsManager). The tiers come from Laravel's
       own resolution of the stored grant, so this card shows what the supporter
       can ACTUALLY do — not what a tick box once said. Message access is not a
       level: it is the consent flow further down. #}
    {% set tiers = relationship.tiers %}
    {% if tiers and relationship.relationshipId > 0 and not isPending %}
      {% set listingsLabelTier = tiers.listings if (tiers.listings == "co_decide" or tiers.listings == "represent") else "none" %}
      {% set creditsLabelTier = tiers.credits if (tiers.credits == "co_decide" or tiers.credits == "represent") else "none" %}
      <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ t("govuk_alpha_settings.linked.permissions_heading") }}</h3>
      <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-3">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t("govuk_alpha_settings.linked.permissions.can_view_activity") }}</dt>
          <dd class="govuk-summary-list__value">{{ t("govuk_alpha_settings.linked_messages.state_active") if tiers.activity != "none" else t("govuk_alpha_settings.linked.tiers_option_none") }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t("govuk_alpha_settings.linked.tiers_capability_listings" if mode == "child" else "govuk_alpha_settings.guardians.tiers_capability_listings") }}</dt>
          <dd class="govuk-summary-list__value">{{ t(("govuk_alpha_settings.linked.tiers_option_" if mode == "child" else "govuk_alpha_settings.guardians.tiers_option_") + listingsLabelTier) }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t("govuk_alpha_settings.linked.tiers_capability_credits" if mode == "child" else "govuk_alpha_settings.guardians.tiers_capability_credits") }}</dt>
          <dd class="govuk-summary-list__value">{{ t(("govuk_alpha_settings.linked.tiers_option_" if mode == "child" else "govuk_alpha_settings.guardians.tiers_option_") + creditsLabelTier) }}</dd>
        </div>
      </dl>

      {% if relationship.staffRecorded %}
        {% if mode == "child" %}
          {# A coordinator-recorded arrangement: the member chose these levels on
             their own guardians page, and only they can change them. #}
          <p class="govuk-body-s nexus-alpha-meta">{{ t("govuk_alpha_settings.linked.tiers_set_by_member", { name: relationship.name }) }}</p>
        {% endif %}
      {% elif mode == "child" %}
        {# The supporter may lower or keep a level, never raise it. #}
        <form method="post" action="{{ urlFor('/settings/linked-accounts/tiers') }}" class="govuk-!-margin-bottom-2" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="relationship_id" value="{{ relationship.relationshipId }}">
          {% if tiers.activity != "none" %}
            <div class="govuk-form-group">
              <label class="govuk-label" for="tier_activity_{{ relationship.relationshipId }}">{{ t("govuk_alpha_settings.linked.permissions.can_view_activity") }}</label>
              <select class="govuk-select" id="tier_activity_{{ relationship.relationshipId }}" name="tier_activity">
                <option value="assist" selected>{{ t("govuk_alpha_settings.linked_messages.state_active") }}</option>
                <option value="none">{{ t("govuk_alpha_settings.linked.tiers_option_none") }}</option>
              </select>
            </div>
          {% endif %}
          {% for capability in ["listings", "credits"] %}
            <div class="govuk-form-group">
              <label class="govuk-label" for="tier_{{ capability }}_{{ relationship.relationshipId }}">{{ t("govuk_alpha_settings.linked.tiers_capability_" + capability) }}</label>
              <select class="govuk-select" id="tier_{{ capability }}_{{ relationship.relationshipId }}" name="tier_{{ capability }}">
                {% for tierOption in relationship.supporterTierOptions[capability] %}
                  <option value="{{ tierOption }}"{% if tierOption == tiers[capability] %} selected{% endif %}>{{ t("govuk_alpha_settings.linked.tiers_option_" + tierOption) }}</option>
                {% endfor %}
              </select>
            </div>
          {% endfor %}
          <p class="govuk-body-s">{{ t("govuk_alpha_settings.linked.tiers_co_decide_explainer") }}</p>
          <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button">{{ t("govuk_alpha_settings.guardians.tiers_save_button") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></button>
        </form>
      {% else %}
        {# The supported member grants, raises or removes each level. #}
        <form method="post" action="{{ urlFor('/settings/linked-accounts/member-tiers') }}" class="govuk-!-margin-bottom-2" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="relationship_id" value="{{ relationship.relationshipId }}">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_settings.guardians.tiers_title") }}</legend>
            <div class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-bottom-3" data-module="govuk-checkboxes">
              <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input" id="tier_activity_{{ relationship.relationshipId }}" name="tier_activity" type="checkbox" value="assist"{% if tiers.activity != "none" %} checked{% endif %}>
                <label class="govuk-label govuk-checkboxes__label" for="tier_activity_{{ relationship.relationshipId }}">{{ t("govuk_alpha_settings.linked.permissions.can_view_activity") }}</label>
              </div>
            </div>
            {% for capability in ["listings", "credits"] %}
              <div class="govuk-form-group">
                <label class="govuk-label" for="tier_{{ capability }}_{{ relationship.relationshipId }}">{{ t("govuk_alpha_settings.guardians.tiers_capability_" + capability) }}</label>
                <select class="govuk-select" id="tier_{{ capability }}_{{ relationship.relationshipId }}" name="tier_{{ capability }}">
                  {% for tierOption in grantableTiers %}
                    <option value="{{ tierOption }}"{% if tierOption == tiers[capability] %} selected{% endif %}>{{ t("govuk_alpha_settings.guardians.tiers_option_" + tierOption) }}</option>
                  {% endfor %}
                </select>
              </div>
            {% endfor %}
          </fieldset>
          <p class="govuk-body-s">{{ t("govuk_alpha_settings.guardians.tiers_explainer") }}</p>
          <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button">{{ t("govuk_alpha_settings.guardians.tiers_save_button") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></button>
        </form>
      {% endif %}

      {# Acting on the grant: offered only when a level actually permits it. #}
      {% if mode == "child" and relationship.userId > 0 and (relationship.canPrepareListing or relationship.canPrepareTransfer) %}
        <div class="govuk-button-group">
          {% if relationship.canPrepareListing %}
            <a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="{{ urlFor('/settings/support-actions/prepare/' + (relationship.userId | string) + '/listing') }}" role="button" draggable="false">{{ t("govuk_alpha_settings.support_prepare.prepare_listing_button") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></a>
          {% endif %}
          {% if relationship.canPrepareTransfer %}
            <a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="{{ urlFor('/settings/support-actions/prepare/' + (relationship.userId | string) + '/transfer') }}" role="button" draggable="false">{{ t("govuk_alpha_settings.support_prepare.prepare_transfer_button") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></a>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    {% if relationship.relationshipId > 0 and mode == "child" %}
      <div class="govuk-warning-text govuk-!-margin-bottom-2">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-visually-hidden">{{ t("states.warning") }}</span>
          {{ t("govuk_alpha_settings.linked.revoke_warning") }}
        </strong>
      </div>
    {% endif %}

    {# 🔴 Message access is NOT a permission checkbox, and must never become one
       again. `can_view_messages` is enforced as nothing at any tier, so the tick
       box that used to sit in the list above told families a carer could read a
       supported member's messages when no such access existed and the supported
       member had never been asked.

       The real capability is consent-gated: the supporter ASKS, the supported
       member agrees on their "Waiting for your approval" page, every read is
       recorded with a stated purpose, and either side can stop it. The three
       states come from the server (`message_access`), so both halves of this
       card agree with the consent machinery. Every string below already existed
       and was already translated - only the rendering was missing. #}
    {# The supported member sees this only once there is something to act on:
       asking is the supporter's move, so a "none" state on their side is a
       heading with nothing under it. #}
    {% set showMessageAccess = relationship.relationshipId > 0 and not isPending
      and (mode == "child" or relationship.messageAccess != "none") %}
    {% if showMessageAccess %}
      <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ t("govuk_alpha_settings.linked_messages.capability_heading") }}</h3>

      {% if mode == "child" %}
        {% if relationship.messageAccess == "active" %}
          <p class="govuk-body govuk-!-margin-bottom-1">
            {{ govukTag({ text: t("govuk_alpha_settings.linked_messages.state_active"), classes: "govuk-tag--green" }) }}
          </p>
          {% if relationship.messageAccessSince %}
            <p class="govuk-body-s nexus-alpha-meta">{{ t("govuk_alpha_settings.linked_messages.state_active_since", { date: relationship.messageAccessSince }) }}</p>
          {% endif %}
          {% if relationship.userId > 0 %}
            <p class="govuk-body">
              <a class="govuk-link" href="{{ urlFor('/settings/linked-accounts/messages/' + (relationship.userId | string)) }}">{{ t("govuk_alpha_settings.linked_messages.view_link") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></a>
            </p>
          {% endif %}
        {% elif relationship.messageAccess == "pending" %}
          {# Asking again while an ask is open is a no-op in the backend, so no
             button here: a second press would look like it did something. #}
          <p class="govuk-body">
            {{ govukTag({ text: t("govuk_alpha_settings.linked_messages.state_pending", { name: relationship.name }), classes: "govuk-tag--yellow" }) }}
          </p>
        {% else %}
          <p class="govuk-body-s nexus-alpha-meta">{{ t("govuk_alpha_settings.linked_messages.explainer", { name: relationship.name }) }}</p>
          <form method="post" action="{{ urlFor('/settings/linked-accounts/message-access/request') }}" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="relationship_id" value="{{ relationship.relationshipId }}">
            <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button">{{ t("govuk_alpha_settings.linked_messages.request_button") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></button>
          </form>
        {% endif %}
      {% else %}
        {% if relationship.messageAccess == "active" %}
          <p class="govuk-body">{{ t("govuk_alpha_settings.linked_messages.member_disclosure", { name: relationship.name }) }}</p>
          <form method="post" action="{{ urlFor('/settings/linked-accounts/message-access/withdraw') }}" novalidate>
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="relationship_id" value="{{ relationship.relationshipId }}">
            <button class="govuk-button govuk-button--warning govuk-!-margin-bottom-2" data-module="govuk-button">{{ t("govuk_alpha_settings.linked_messages.member_withdraw_button") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></button>
          </form>
        {% elif relationship.messageAccess == "pending" %}
          {# The member decides on /settings/support-actions, where every prepared
             action waits for their yes. Naming it here stops the ask being a
             thing that happened somewhere they never look. #}
          <p class="govuk-body">
            <a class="govuk-link" href="{{ urlFor('/settings/support-actions') }}">{{ t("govuk_alpha_settings.support_actions.title") }}</a>
          </p>
        {% endif %}
      {% endif %}
    {% endif %}

    {% if relationship.relationshipId > 0 %}
      <form method="post" action="{{ urlFor('/settings/linked-accounts/revoke') }}" class="govuk-!-display-inline-block" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="relationship_id" value="{{ relationship.relationshipId }}">
        <button class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">{{ t("govuk_alpha_settings.linked.revoke_button") }}<span class="govuk-visually-hidden"> {{ relationship.name }}</span></button>
      </form>
    {% endif %}
  </li>
{% endmacro %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/profile/settings') }}">{{ t("govuk_alpha_settings.common.back_to_settings") }}</a>
{% endblock %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if statusMessage and successStatus %}
        <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="linked-status-title">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="linked-status-title">{{ t("govuk_alpha_settings.common.success_title") }}</h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">{{ statusMessage }}</p>
          </div>
        </div>
      {% elif statusMessage and errorStatus %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t("govuk_alpha_settings.common.error_title") }}</h2>
            <div class="govuk-error-summary__body">
              <ul class="govuk-list govuk-error-summary__list">
                <li><a href="#request">{{ statusMessage }}</a></li>
              </ul>
            </div>
          </div>
        </div>
      {% endif %}

      {% if loadError %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" data-disable-auto-focus="true" tabindex="-1">
          <div role="alert">
          <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
          <div class="govuk-error-summary__body"><p class="govuk-body">{{ loadError }}</p></div>
          </div>
        </div>
      {% endif %}
      <span class="govuk-caption-xl">{{ t("govuk_alpha_settings.linked.caption") }}</span>
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_settings.linked.title") }}</h1>

      <p class="govuk-body-l">{{ t("govuk_alpha_settings.linked.description") }}</p>

      <section aria-labelledby="parents-heading" id="parents">
        <h2 class="govuk-heading-l" id="parents-heading">{{ t("govuk_alpha_settings.linked.parents_heading") }}</h2>
        <p class="govuk-body">{{ t("govuk_alpha_settings.linked.parents_description") }}</p>
        {% if not parents.length %}
          <div class="govuk-inset-text"><p class="govuk-body">{{ t("govuk_alpha_settings.linked.parents_empty") }}</p></div>
        {% else %}
          <ul class="govuk-list nexus-alpha-card-list">
            {% for parent in parents %}
              {{ relationshipCard(parent, "parent", permissions, csrfToken) }}
            {% endfor %}
          </ul>
        {% endif %}
      </section>

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

      <section aria-labelledby="children-heading" id="children">
        <h2 class="govuk-heading-l" id="children-heading">{{ t("govuk_alpha_settings.linked.children_heading") }}</h2>
        <p class="govuk-body">{{ t("govuk_alpha_settings.linked.children_description") }}</p>
        {% if not children.length %}
          <div class="govuk-inset-text"><p class="govuk-body">{{ t("govuk_alpha_settings.linked.children_empty") }}</p></div>
        {% else %}
          <ul class="govuk-list nexus-alpha-card-list">
            {% for child in children %}
              {{ relationshipCard(child, "child", permissions, csrfToken) }}
            {% endfor %}
          </ul>
        {% endif %}
      </section>

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

      <section aria-labelledby="request-heading">
        <h2 class="govuk-heading-l" id="request-heading">{{ t("govuk_alpha_settings.linked.request_heading") }}</h2>
        <p class="govuk-body">{{ t("govuk_alpha_settings.linked.request_description") }}</p>
        <p class="govuk-body-s nexus-alpha-meta">{{ t("govuk_alpha_settings.linked.request_max", { count: maxChildren }) }}</p>

        <form method="post" action="{{ urlFor('/settings/linked-accounts/request') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">

          <div class="govuk-form-group{% if status == 'link-email-invalid' or status == 'link-user-not-found' %} govuk-form-group--error{% endif %}">
            <label class="govuk-label" for="request">{{ t("govuk_alpha_settings.linked.email_label") }}</label>
            <div id="request-hint" class="govuk-hint">{{ t("govuk_alpha_settings.linked.email_hint") }}</div>
            {% if status == 'link-email-invalid' or status == 'link-user-not-found' %}
              <p id="request-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">{{ t("govuk_alpha_settings.common.error_title") }}:</span>
                {{ statusMessage }}
              </p>
            {% endif %}
            <input class="govuk-input" id="request" name="email" type="email" spellcheck="false" autocomplete="off" aria-describedby="request-hint{% if status == 'link-email-invalid' or status == 'link-user-not-found' %} request-error{% endif %}">
          </div>

          <div class="govuk-form-group">
            <label class="govuk-label" for="relationship_type">{{ t("govuk_alpha_settings.linked.type_label") }}</label>
            <select class="govuk-select" id="relationship_type" name="relationship_type">
              {% for type in linkTypes %}
                <option value="{{ type.value }}"{% if type.selected %} selected{% endif %}>{{ type.label }}</option>
              {% endfor %}
            </select>
          </div>

          <fieldset class="govuk-fieldset govuk-!-margin-bottom-3">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t("govuk_alpha_settings.linked.permissions_heading") }}</legend>
            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
              {% for permission in permissions %}
                <div class="govuk-checkboxes__item">
                  <input class="govuk-checkboxes__input" id="new_perm_{{ permission.value }}" name="{{ permission.field }}" type="checkbox" value="1"{% if permission.checkedByDefault %} checked{% endif %}>
                  <label class="govuk-label govuk-checkboxes__label" for="new_perm_{{ permission.value }}">{{ permission.label }}</label>
                </div>
              {% endfor %}
            </div>
          </fieldset>

          <button class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_settings.linked.request_button") }}</button>
        </form>
      </section>
    </div>
  </div>
{% endblock %}

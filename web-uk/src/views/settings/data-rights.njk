{% extends "layouts/base.njk" %}
{% from "_character-count.njk" import characterCount %}

{% block mainContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <a class="govuk-back-link" href="{{ urlFor('/profile/settings') }}">{{ t("govuk_alpha_settings.common.back_to_settings") }}</a>

      {% if statusMessage and successStatus %}
        <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="data-rights-status-title">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="data-rights-status-title">{{ t("states.success_title") }}</h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">{{ statusMessage }}</p>
          </div>
        </div>
      {% elif statusMessage and infoStatus %}
        <div class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="data-rights-status-title">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="data-rights-status-title">{{ t("states.important") }}</h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">{{ statusMessage }}</p>
          </div>
        </div>
      {% elif statusMessage and errorStatus %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t("states.error_title") }}</h2>
            <div class="govuk-error-summary__body">
              <ul class="govuk-list govuk-error-summary__list">
                <li><a href="#request_type">{{ statusMessage }}</a></li>
              </ul>
            </div>
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-xl">{{ t("govuk_alpha_settings.gdpr.caption") }}</span>
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_settings.gdpr.title") }}</h1>
      <p class="govuk-body-l">{{ t("govuk_alpha_settings.gdpr.description") }}</p>

      <section aria-labelledby="data-rights-request-heading" id="request">
        <h2 class="govuk-heading-l" id="data-rights-request-heading">{{ t("govuk_alpha_settings.gdpr.request_heading") }}</h2>
        <p class="govuk-body">{{ t("govuk_alpha_settings.gdpr.request_description") }}</p>

        <form method="post" action="{{ urlFor('/settings/data-rights') }}" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">

          <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
              <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                <h2 class="govuk-fieldset__heading">{{ t("govuk_alpha_settings.gdpr.type_label") }}</h2>
              </legend>
              <div class="govuk-radios" data-module="govuk-radios">
                {% for type in requestTypes %}
                  {% set inputId = "request_type" if loop.first else "request_type_" + type.value %}
                  <div class="govuk-radios__item">
                    <input class="govuk-radios__input" id="{{ inputId }}" name="request_type" type="radio" value="{{ type.value }}" aria-describedby="request_type_{{ type.value }}-hint">
                    <label class="govuk-label govuk-radios__label" for="{{ inputId }}">{{ type.label }}</label>
                    <div id="request_type_{{ type.value }}-hint" class="govuk-hint govuk-radios__hint">{{ type.hint }}</div>
                  </div>
                {% endfor %}
              </div>
            </fieldset>
          </div>

          {% call characterCount(2000, characterCountMessages, "notes") %}
          <div class="govuk-form-group">
            <label class="govuk-label" for="notes">{{ t("govuk_alpha_settings.gdpr.notes_label") }}</label>
            <div id="notes-hint" class="govuk-hint">{{ t("govuk_alpha_settings.gdpr.notes_hint") }}</div>
            <textarea class="govuk-textarea govuk-js-character-count" id="notes" name="notes" rows="4" maxlength="2000" aria-describedby="notes-hint notes-info"></textarea>
          </div>
          {% endcall %}

          <button class="govuk-button" data-module="govuk-button">{{ t("govuk_alpha_settings.gdpr.submit_button") }}</button>
        </form>
      </section>

      {# A "Requests you have made" table stood here. Laravel exposes no
         member-facing read for a member's own data-rights requests — only the
         admin endpoints under /v2/admin/enterprise/gdpr/requests — so the route
         passed a permanently empty list and the section always rendered "You
         have not made any data rights requests yet." That statement was shown
         to a member who had just submitted one, which risks them submitting the
         same request over and over. The submit confirmation already tells them
         the request is in and that we will be in touch. Restore this section
         only alongside a real member-scoped read endpoint; the table's
         translation keys (your_requests_*, request_status.*) are deliberately
         left in place for that. #}
    </div>
  </div>
{% endblock %}

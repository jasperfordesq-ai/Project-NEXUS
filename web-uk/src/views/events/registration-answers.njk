{% extends "layouts/base.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}{% block content %}<a class="govuk-back-link" href="{{ urlFor('/events/' + (eventId | string) + '/registration') }}">{{ t("event_registration.title") }}</a><span class="govuk-caption-xl">{{ t("event_registration.title") }}</span><h1 class="govuk-heading-xl">{{ t("event_registration.accessible.review_submission", { id: submissionId }) }}</h1><div class="govuk-inset-text"><h2 class="govuk-heading-s">{{ t("event_registration.submissions.audit_title") }}</h2><p class="govuk-body govuk-!-margin-bottom-0">{{ t("event_registration.submissions.audit_description") }}</p></div>{% for key, answer in answers %}<div class="govuk-summary-card"><div class="govuk-summary-card__title-wrapper"><h2 class="govuk-summary-card__title">{{ questions[answer.question_id] or key }}</h2>{{ govukTag({ text: t("event_registration.classifications." + (answer.classification or 'internal')) }) }}</div><div class="govuk-summary-card__content">{% if answer.purged %}<p class="govuk-body">{{ t("event_registration.submissions.purged") }}</p>{% elif answer.value is iterable and answer.value is not string %}<ul class="govuk-list govuk-list--bullet">{% for value in answer.value %}<li>{{ value }}</li>{% endfor %}</ul>{% else %}<p class="govuk-body">{{ answer.value | nl2br | safe }}</p>{% endif %}</div></div>{% else %}<p class="govuk-body">{{ t("event_registration.submissions.empty") }}</p>{% endfor %}{% endblock %}

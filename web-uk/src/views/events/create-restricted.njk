{% extends "layouts/base.njk" %}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/groups/' + (groupId | string)) if groupId else urlFor('/events') }}">{{ t("govuk_alpha_events.common.back_to_events") if not groupId else t("govuk_alpha_groups.common.back_to_group") }}</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ t("govuk_alpha_events.create_restricted.title") }}</h1>
      <p class="govuk-body">{{ t("govuk_alpha_events.create_restricted.body") }}</p>
      <p class="govuk-body">
        <a class="govuk-link" href="{{ urlFor('/events') }}">{{ t("govuk_alpha_events.common.back_to_events") }}</a>
      </p>
    </div>
  </div>
{% endblock %}

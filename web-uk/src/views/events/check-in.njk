{% from "govuk/components/tag/macro.njk" import govukTag %}
{% extends "layouts/base.njk" %}
{% from "_character-count.njk" import characterCount %}

{#
  The organiser's check-in page (E-105, 13 Oct 2026). Order is deliberate: how it
  works, then the counts, then the by-name list (the way almost every arrival is
  recorded), and only then the attendee-code form. The code form used to come first
  and push the list below the fold, so the page read as "paste a code" with the
  roster as an afterthought.
#}

{% block beforeContent %}
  <a class="govuk-back-link" href="{{ urlFor('/events/' + (event.id | string)) }}">{{ t("govuk_alpha.events.back_to_event") }}</a>
{% endblock %}

{% block content %}
  <span class="govuk-caption-xl">{{ event.title }}</span>
  <h1 class="govuk-heading-xl">{{ t("govuk_alpha.events.check_in_title") }}</h1>
  <p class="govuk-body-l">{{ t("govuk_alpha.events.check_in_intro") }}</p>

  {% if status == "attendance-updated" or status == "attendance-code-updated" %}
    <div class="govuk-notification-banner govuk-notification-banner--success" data-module="govuk-notification-banner" role="alert" aria-labelledby="checkin-status-title"><div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="checkin-status-title">{{ t("govuk_alpha.states.success_title") }}</h2></div><div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ t("govuk_alpha.events.attendance_updated") }}</p></div></div>
  {% elif status == "attendance-conflict" or status == "attendance-code-conflict" %}
    <div class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="checkin-conflict-title"><div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="checkin-conflict-title">{{ t("govuk_alpha.states.warning_prefix") }}</h2></div><div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ t("govuk_alpha.events.attendance_conflict") }}</p></div></div>
  {#- Every refusal below arrives as HTTP 409, the same as a genuine concurrent edit.
      They are separated because each has a different next step, and "review the
      roster" is wrong advice for every one of them. -#}
  {% elif status == "attendance-answers-outstanding" %}
    <div class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="checkin-answers-title"><div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="checkin-answers-title">{{ t("govuk_alpha.states.warning_prefix") }}</h2></div><div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ t("govuk_alpha_events.check_in.answers_outstanding") }}</p></div></div>
  {% elif status == "attendance-too-early" or status == "attendance-window-closed" or status == "attendance-not-registered" or status == "attendance-event-unavailable" or status == "attendance-not-possible" %}
    {% set attendanceRefusalKey = {
      "attendance-too-early": "govuk_alpha.events.attendance_too_early",
      "attendance-window-closed": "govuk_alpha.events.attendance_window_closed",
      "attendance-not-registered": "govuk_alpha.events.attendance_not_registered",
      "attendance-event-unavailable": "govuk_alpha.events.attendance_event_unavailable",
      "attendance-not-possible": "govuk_alpha.events.attendance_not_possible"
    }[status] %}
    <div class="govuk-notification-banner" data-module="govuk-notification-banner" role="region" aria-labelledby="checkin-refusal-title"><div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title" id="checkin-refusal-title">{{ t("govuk_alpha.states.warning_prefix") }}</h2></div><div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">{{ t(attendanceRefusalKey) }}</p></div></div>
  {% elif status == "attendance-reason-required" %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1"><div role="alert"><h2 class="govuk-error-summary__title">{{ t("govuk_alpha.states.error_title") }}</h2><div class="govuk-error-summary__body"><p>{{ t("govuk_alpha.events.attendance_reason_required") }}</p></div></div></div>
  {% elif status == "attendance-code-invalid" %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1"><div role="alert"><h2 class="govuk-error-summary__title">{{ t("govuk_alpha.states.error_title") }}</h2><div class="govuk-error-summary__body"><p>{{ t("event_offline_checkin.code.invalid") }}</p></div></div></div>
  {% elif status == "attendance-invalid" or status == "attendance-failed" or status == "attendance-code-failed" %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1"><div role="alert"><h2 class="govuk-error-summary__title">{{ t("govuk_alpha.states.error_title") }}</h2><div class="govuk-error-summary__body"><p>{{ apiReason if (status == "attendance-code-failed" and apiReason) else t("govuk_alpha.events.attendance_failed") }}</p></div></div></div>
  {% endif %}

  {# When check-in opens or closed, from the event's own times. The server still
     decides; this only explains why the list below may offer nothing. #}
  {% if attendanceWindow and attendanceWindow.state == "before" %}
    <div class="govuk-inset-text" id="check-in-window"><p class="govuk-body govuk-!-margin-bottom-0">{{ t("govuk_alpha.events.check_in_window_before", { date: attendanceWindow.opensLabel }) }}</p></div>
  {% elif attendanceWindow and attendanceWindow.state == "after" %}
    <div class="govuk-inset-text" id="check-in-window"><p class="govuk-body govuk-!-margin-bottom-0">{{ t("govuk_alpha.events.check_in_window_after", { date: attendanceWindow.closesLabel }) }}</p></div>
  {% elif attendanceWindow and attendanceWindow.state == "open" %}
    <p class="govuk-body" id="check-in-window">{{ t("govuk_alpha.events.check_in_window_open", { date: attendanceWindow.closesLabel }) }}</p>
  {% endif %}

  <details class="govuk-details" data-module="govuk-details" id="check-in-how">
    <summary class="govuk-details__summary"><span class="govuk-details__summary-text">{{ t("govuk_alpha.events.check_in_how_title") }}</span></summary>
    <div class="govuk-details__text">
      <ol class="govuk-list govuk-list--number">
        <li>{{ t("govuk_alpha.events.check_in_how_who") }}</li>
        <li>{{ t("govuk_alpha.events.check_in_how_when") }}</li>
        <li>{{ t("govuk_alpha.events.check_in_how_name") }}</li>
        <li>{{ t("govuk_alpha.events.check_in_how_code") }}</li>
        <li>{{ t("govuk_alpha.events.check_in_how_undo") }}</li>
      </ol>
      <p class="govuk-body">{{ t("govuk_alpha.events.check_in_how_credits") }}</p>
      <p class="govuk-body govuk-!-margin-bottom-0">{{ t("govuk_alpha.events.check_in_how_offline") }}</p>
    </div>
  </details>

  <h2 class="govuk-heading-m">{{ t("govuk_alpha.events.check_in_metrics_title") }}</h2>
  <dl class="govuk-summary-list">{% for metric in ["confirmed", "checked_in", "checked_out", "no_show", "attended"] %}<div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">{{ t("govuk_alpha.events.people_metrics." + metric) }}</dt><dd class="govuk-summary-list__value">{{ metrics[metric] or 0 }}</dd></div>{% endfor %}</dl>

  <section class="govuk-!-margin-bottom-8" aria-labelledby="check-in-by-name-heading" id="check-in-by-name">
    <h2 class="govuk-heading-l" id="check-in-by-name-heading">{{ t("govuk_alpha.events.check_in_search_title") }}</h2>
    <p class="govuk-body">{{ t("govuk_alpha.events.check_in_search_intro") }}</p>
    <form method="get" action="{{ urlFor('/events/' + (event.id | string) + '/check-in') }}" class="govuk-!-margin-bottom-7"><fieldset class="govuk-fieldset"><legend class="govuk-fieldset__legend govuk-visually-hidden">{{ t("govuk_alpha.events.check_in_search_title") }}</legend><div class="govuk-form-group"><label class="govuk-label" for="attendance-search">{{ t("govuk_alpha.events.check_in_search_label") }}</label><input class="govuk-input govuk-!-width-two-thirds" id="attendance-search" name="search" type="search" value="{{ query.search }}"></div><div class="govuk-form-group"><label class="govuk-label" for="attendance-state">{{ t("govuk_alpha.events.people_filters.attendance_state") }}</label><select class="govuk-select" id="attendance-state" name="attendance_state"><option value="">{{ t("govuk_alpha.events.people_states.all") }}</option>{% for state in attendanceStates %}<option value="{{ state }}"{% if query.attendance_state == state %} selected{% endif %}>{{ t("govuk_alpha.events.people_states." + state) }}</option>{% endfor %}</select></div><button class="govuk-button govuk-button--secondary">{{ t("govuk_alpha.actions.search") }}</button></fieldset></form>
    <p class="govuk-body">{{ tc("govuk_alpha.events.check_in_result_count", total, { count: total }) }}</p>
    {% if people.length == 0 %}<div class="govuk-inset-text"><h3 class="govuk-heading-m">{{ t("states.empty_title") }}</h3>{{ t("govuk_alpha.events.check_in_empty") }}</div>{% endif %}
    {% for person in people %}<section class="govuk-!-margin-bottom-6" aria-labelledby="attendee-{{ person.id }}"><h3 class="govuk-heading-m" id="attendee-{{ person.id }}">{{ person.name or t("govuk_alpha.members.unknown_member") }}</h3><dl class="govuk-summary-list"><div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">{{ t("govuk_alpha.events.people_registration") }}</dt><dd class="govuk-summary-list__value">{{ t("govuk_alpha.events.people_states." + person.registrationState) }}{% if person.requiredAnswersOutstanding %} {{ govukTag({ text: t("govuk_alpha_events.check_in.answers_outstanding_tag"), classes: "govuk-tag--yellow" }) }}{% endif %}</dd></div><div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">{{ t("govuk_alpha.events.people_attendance") }}</dt><dd class="govuk-summary-list__value">{{ t("govuk_alpha.events.people_states." + person.attendanceState) }}</dd></div></dl>
      {% set actions = person.attendanceActions %}{% if person.requiredAnswersOutstanding and not actions.check_in %}<p class="govuk-body">{{ t("govuk_alpha_events.check_in.answers_outstanding") }}</p>{% endif %}{% if not actions.check_in and not actions.check_out and not actions.no_show and not actions.undo %}{% if not person.requiredAnswersOutstanding %}<p class="govuk-body">{{ t("govuk_alpha.events.attendance_no_action") }}</p>{% endif %}{% else %}<form method="post" action="{{ urlFor('/events/' + (event.id | string) + '/check-in/' + (person.id | string)) }}"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="expected_version" value="{{ person.attendanceVersion }}"><input type="hidden" name="idempotency_key" value="{{ event.id }}-{{ person.id }}-{{ person.attendanceVersion }}"><div class="govuk-form-group"><label class="govuk-label" for="attendance-action-{{ person.id }}">{{ t("govuk_alpha.events.attendance_action_label") }}</label><select class="govuk-select" id="attendance-action-{{ person.id }}" name="action" required>{% for action in ["check_in", "check_out", "no_show", "undo"] %}{% if actions[action] %}<option value="{{ action }}">{{ t("govuk_alpha.events.attendance_actions." + action) }}</option>{% endif %}{% endfor %}</select></div>{% if actions.undo %}<div class="govuk-form-group"><label class="govuk-label" for="attendance-reason-{{ person.id }}">{{ t("govuk_alpha.events.attendance_reason_label") }}</label><div class="govuk-hint" id="attendance-reason-hint-{{ person.id }}">{{ t("govuk_alpha.events.attendance_reason_hint") }}</div><textarea class="govuk-textarea" id="attendance-reason-{{ person.id }}" name="reason" rows="2" aria-describedby="attendance-reason-hint-{{ person.id }}"></textarea></div>{% endif %}<div class="govuk-checkboxes govuk-checkboxes--small"><div class="govuk-checkboxes__item"><input class="govuk-checkboxes__input" id="attendance-confirm-{{ person.id }}" name="confirmation" type="checkbox" value="1" required><label class="govuk-label govuk-checkboxes__label" for="attendance-confirm-{{ person.id }}">{{ t("govuk_alpha.events.attendance_confirmation", { name: person.name or t('govuk_alpha.members.unknown_member') }) }}</label></div></div><button class="govuk-button govuk-!-margin-top-3">{{ t("govuk_alpha.events.attendance_apply") }}</button></form>{% endif %}
    </section>{% endfor %}
    {% if previousHref or nextHref %}<nav class="govuk-pagination" aria-label="{{ t('govuk_alpha.events.check_in_pagination') }}">{% if previousHref %}<div class="govuk-pagination__prev"><a class="govuk-link govuk-pagination__link" rel="prev" href="{{ urlFor(previousHref) }}">{{ t("govuk_alpha.events.check_in_previous") }}</a></div>{% endif %}{% if nextHref %}<div class="govuk-pagination__next"><a class="govuk-link govuk-pagination__link" rel="next" href="{{ urlFor(nextHref) }}">{{ t("govuk_alpha.events.check_in_next") }}</a></div>{% endif %}</nav>{% endif %}
  </section>

  <section class="govuk-!-margin-bottom-8" aria-labelledby="signed-code-heading" id="check-in-by-code">
    <h2 class="govuk-heading-l" id="signed-code-heading">{{ t("event_offline_checkin.code.title") }}</h2>
    <p class="govuk-body">{{ t("event_offline_checkin.code.intro") }}</p>
    <form method="post" action="{{ urlFor('/events/' + (event.id | string) + '/check-in/code') }}" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {# One key per rendered form, so a double-tapped submit is a replay of the SAME
         action rather than a second one. The API requires this field. #}
      <input type="hidden" name="idempotency_key" value="{{ codeIdempotencyKey }}">
      <div class="govuk-form-group">
        <label class="govuk-label" for="signed-attendee-code">{{ t("event_offline_checkin.code.label") }}</label>
        <div class="govuk-hint" id="signed-attendee-code-hint">{{ t("event_offline_checkin.code.hint") }}</div>
        <textarea class="govuk-textarea" id="signed-attendee-code" name="credential" rows="4" maxlength="1024" required aria-describedby="signed-attendee-code-hint" autocomplete="off" spellcheck="false"></textarea>
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="signed-code-action">{{ t("event_offline_checkin.code.action") }}</label>
        <select class="govuk-select" id="signed-code-action" name="action" required>{% for action in ["check_in", "check_out", "no_show", "undo"] %}<option value="{{ action }}">{{ t("event_offline_checkin.actions." + action) }}</option>{% endfor %}</select>
      </div>
      {% call characterCount(500, characterCountMessages, "signed-code-reason") %}<div class="govuk-form-group">
        <label class="govuk-label" for="signed-code-reason">{{ t("event_offline_checkin.code.reason") }}</label>
        <div class="govuk-hint" id="signed-code-reason-hint">{{ t("event_offline_checkin.code.reason_hint") }}</div>
        <textarea class="govuk-textarea govuk-js-character-count" id="signed-code-reason" name="reason" rows="2" maxlength="500" aria-describedby="signed-code-reason-info signed-code-reason-hint"></textarea>
      </div>{% endcall %}
      <div class="govuk-checkboxes govuk-checkboxes--small"><div class="govuk-checkboxes__item"><input class="govuk-checkboxes__input" id="signed-code-confirm" name="confirmation" type="checkbox" value="1" required><label class="govuk-label govuk-checkboxes__label" for="signed-code-confirm">{{ t("event_offline_checkin.code.confirm") }}</label></div></div>
      <button class="govuk-button govuk-!-margin-top-3">{{ t("event_offline_checkin.code.submit") }}</button>
    </form>
  </section>
{% endblock %}

# Project NEXUS UK Frontend - Environment Configuration

# Server port
PORT=3001

# Backend contract target. Laravel is the source-of-truth backend.
ACCESSIBLE_BACKEND_TARGET=laravel
LARAVEL_BASE_URL=http://127.0.0.1:8090

# Future ASP.NET target. Not certified.
ASPNET_BASE_URL=http://localhost:5080

# Optional explicit override. Prefer LARAVEL_BASE_URL for Laravel-first work.
# API_BASE_URL=http://127.0.0.1:8090

# Abort backend requests that exceed this duration (bounded to 1-120 seconds).
API_REQUEST_TIMEOUT_MS=15000

# Default Laravel tenant slug for tenant-aware public endpoints.
ACCESSIBLE_TENANT_SLUG=hour-timebank

# REQUIRED: Secret for signed cookies (generate a strong random string)
COOKIE_SECRET=change-this-to-a-secure-random-string

# Secret for sessions (defaults to COOKIE_SECRET if not set)
SESSION_SECRET=change-this-to-a-secure-random-string

# Required in production. Use rediss:// when the Redis service supports TLS.
SESSION_REDIS_URL=redis://localhost:6379/0
SESSION_REDIS_PREFIX=nexus:web-uk:sess:

# Environment: development or production
NODE_ENV=development

# Cloudflare Turnstile — the bot challenge on the CONTACT form. Not registration:
# that gate was removed server-side on 2026-05-16 in favour of a honeypot,
# minimum-form-time, per-IP throttle and admin approval.
#
# Only the SITE key belongs here. Verification happens in Laravel, which holds the
# secret; a TURNSTILE_SECRET_KEY in this app was dead configuration and has been
# removed. Leave the site key unset to render no widget at all.
TURNSTILE_SITE_KEY=

# Error reporting. Sentry project: nexus-webuk (created 2026-08-11).
#
# LEAVE BLANK IN DEVELOPMENT. With no DSN the reporter is a complete no-op and the
# SDK is never even loaded, which is what you want locally — your own mistakes
# should not land in the production issue list.
#
# The real value is deliberately NOT in this file: this repository is public. It
# lives in .secrets.local/sentry.env as SENTRY_DSN_WEBUK, and on the server in
# /opt/nexus-php/.env, which is what the blue/green deploy passes to compose.
# compose.webuk.bluegreen.yml maps SENTRY_DSN_WEBUK -> the container's SENTRY_DSN.
SENTRY_DSN=

# Performance tracing. Off by default: tracing every request is a quota decision,
# not a default. Errors are always reported at full rate.
SENTRY_TRACES_SAMPLE_RATE=0

# =============================================================================
# Project NEXUS - React Frontend Production Dockerfile
# =============================================================================
# Multi-stage build: Build with Node, serve with Nginx
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build
# -----------------------------------------------------------------------------
# Using Debian (not Alpine) for broad native dependency compatibility.
# Production tenant HTML is refreshed after deploy into a persistent volume,
# so the image build skips generic build-time Playwright pre-rendering.
# Production stage stays nginx:alpine — only the build image is larger.
FROM node:22-bookworm-slim AS builder

# Pin npm to match the version that generated package-lock.json locally.
RUN npm install -g npm@11

WORKDIR /app

# Build arguments (baked into the build)
# Note: Tenant is detected dynamically from subdomain/hostname, not hardcoded
ARG VITE_API_BASE=https://api.project-nexus.ie/api
ARG VITE_GOOGLE_MAPS_API_KEY=
ARG VITE_GOOGLE_MAPS_MAP_ID=
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_ENVIRONMENT=production
ARG VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
ARG VITE_PUSHER_KEY=
ARG VITE_PUSHER_CLUSTER=eu
ARG VITE_GIPHY_API_KEY=
ARG VITE_STRIPE_PUBLISHABLE_KEY=
ARG VITE_TURNSTILE_SITE_KEY=
# The "Accessible version" link in the navbar / mobile drawer. src/lib/accessible-frontend.ts
# reads this and falls back to the PRODUCTION host, so a containerised build that cannot
# pass it points every community's accessible link at the live site. The default keeps
# production byte-identical; non-production deployments MUST set it.
ARG VITE_ACCESSIBLE_FRONTEND_BASE_URL=https://accessible.project-nexus.ie
ARG BUILD_COMMIT=unknown

# Set environment variables for build
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
ENV VITE_GOOGLE_MAPS_MAP_ID=$VITE_GOOGLE_MAPS_MAP_ID
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT
ENV VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE
ENV VITE_PUSHER_KEY=$VITE_PUSHER_KEY
ENV VITE_PUSHER_CLUSTER=$VITE_PUSHER_CLUSTER
ENV VITE_GIPHY_API_KEY=$VITE_GIPHY_API_KEY
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY
ENV VITE_ACCESSIBLE_FRONTEND_BASE_URL=$VITE_ACCESSIBLE_FRONTEND_BASE_URL
ENV BUILD_COMMIT=$BUILD_COMMIT

# Install dependencies first (better layer caching)
COPY package.json package-lock.json ./
RUN npm ci --no-audit

# Copy source and build
# NODE_OPTIONS: tsc's overload resolution peaks above the default 2GB heap on
# this codebase and crashes with "Debug Failure. No error for last overload
# signature" (really an OOM mid-inference). Bump to 4GB.
ENV NODE_OPTIONS="--max-old-space-size=4096"
ENV NEXUS_SKIP_PRERENDER=1
COPY . .
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Production
# -----------------------------------------------------------------------------
FROM nginx:alpine3.21 AS production

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
#
# 🔴 Installed as a TEMPLATE, not straight into conf.d. The canonical SPA
# Content-Security-Policy carries a ${NEXUS_CSP_EXTRA_ORIGINS} placeholder so a
# deployment whose API is not on https://api.project-nexus.ie can permit its own API
# origin. ProductionContentSecurityPolicyTest requires nginx.conf and
# nginx.bluegreen.conf to hold an IDENTICAL policy, so both files carry the
# placeholder and both images must therefore substitute it. The nginx image's
# 20-envsubst-on-templates.sh does that automatically for files in
# /etc/nginx/templates.
#
# The ENV below must exist even when empty: envsubst only replaces variables that are
# DEFINED, so an undeclared placeholder would survive into the live header. Empty
# leaves the policy byte-identical to the historical production value.
ENV NEXUS_CSP_EXTRA_ORIGINS=""
COPY nginx.conf /etc/nginx/templates/default.conf.template

# Add healthcheck (use 127.0.0.1 to avoid IPv6 resolution issues in Alpine)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/health || exit 1

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

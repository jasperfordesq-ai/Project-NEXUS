# Test stub for `docker`, used by the backup/restore-drill shell tests.
#   docker exec … mariadb-dump …   → prints a tiny fake dump with the completion marker
#   docker exec -i … mariadb …      → (restore) saves stdin to $DOCKER_STUB_RESTORE_FILE
#   docker exec … -e "SELECT COUNT(*) …" → prints $STUB_ROW_COUNT (default 5)
#   docker inspect …                → "healthy"
#   docker run … -v HOST:/out … /out/NAME → writes a small tarball to HOST/NAME
# Anything else is logged and succeeds.
set -euo pipefail
printf 'docker %s\n' "$*" >> "${DOCKER_STUB_LOG:-/dev/null}"

case "${1:-}" in
    exec)
        case " $* " in
            *" mariadb-dump "*)
                printf -- '-- fake dump\nCREATE TABLE t (id INT);\nINSERT INTO t VALUES (1);\n'
                # STUB_DUMP_INCOMPLETE=1: a dump cut short, no completion line.
                [ -n "${STUB_DUMP_INCOMPLETE:-}" ] || printf -- '-- Dump completed on 2026-10-02 02:00:00\n'
                ;;
            *"information_schema.TRIGGERS"*)
                # STUB_DRILL_TRIGGERS: what the restored (throwaway) copy reports.
                if [ -n "${STUB_DRILL_TRIGGERS:-}" ] && [[ " $* " == *" nexus-restore-drill "* ]]; then
                    printf '%s\n' "$STUB_DRILL_TRIGGERS"
                else
                    printf '%s\n' "${STUB_ROW_COUNT:-5}"
                fi
                ;;
            *"SELECT COUNT"*)
                printf '%s\n' "${STUB_ROW_COUNT:-5}"
                ;;
            *" -i "*)
                cat > "${DOCKER_STUB_RESTORE_FILE:-/dev/null}"
                ;;
        esac
        ;;
    inspect)
        printf 'healthy\n'
        ;;
    run)
        out_host=""
        name=""
        for arg in "$@"; do
            case "$arg" in
                *:/out) out_host="${arg%:/out}" ;;
                /out/*) name="${arg#/out/}" ;;
            esac
        done
        if [ -n "$out_host" ] && [ -n "$name" ]; then
            tmp="$(mktemp -d)"
            printf 'volume contents for %s\n' "$name" > "$tmp/file.txt"
            tar czf "$out_host/$name" -C "$tmp" .
            rm -rf "$tmp"
        fi
        ;;
esac

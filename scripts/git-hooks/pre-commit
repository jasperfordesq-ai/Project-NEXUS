#!/bin/sh
#
# This hook has TWO independent gates:
#   (A) Credential scan — runs on EVERY commit, needs only git + grep.
#   (B) Staged-PHP-test verify-gate — runs only when tests/*Test.php is staged,
#       and needs php + phpunit + the test DB.
# Gate (A) is first precisely because (B) exits early on most commits.
#
#
# =============================================================================
# GATE A — Credential scan
# =============================================================================
# Restored 2026-08-10. The former ASP.NET repository carried its own
# hooks/pre-commit doing exactly this; the 2026-08-09 monorepo move did not
# import hooks/, so aspnet-backend/Makefile's `install-hooks` target copied a
# file that no longer existed and the capability was silently lost
# platform-wide. This repo is PUBLIC — a committed key is a disclosed key.
#
# 🔴 Two upstream patterns are deliberately NOT carried over:
#     'Password:\s*.+\S'  and  'password\s*[=:]\s*["\x27][^"\x27]{6,}'
# In a Laravel monorepo those match model factories, database seeders, config
# defaults, translation strings and test fixtures constantly. A gate that cries
# wolf teaches people to reach for --no-verify, which would then also bypass
# gate (B) below — the one gate AGENTS.md says must never be bypassed. That
# class of secret is covered in CI by TruffleHog and Semgrep instead.
#
# Detection is on STAGED content (`git show :FILE`), not the working tree, so
# it cannot be dodged by editing a file after `git add`.

CRED_HITS=0

cred_scan_file() {
    _file="$1"
    _content=$(git show ":$_file" 2>/dev/null) || return 0
    [ -z "$_content" ] && return 0

    # pattern<TAB>description
    printf '%s\n' \
"BEGIN[[:space:]]+(RSA|DSA|EC|OPENSSH)[[:space:]]+PRIVATE[[:space:]]+KEY	Private key block" \
"AKIA[0-9A-Z]{16}	AWS access key id" \
"sk-[a-zA-Z0-9]{20,}	API secret key (sk-… form)" \
"ssh[[:space:]]+-i[[:space:]]+.*@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+	SSH command with a literal host IP" \
"[Aa]zureuser@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+	Azure SSH connection string" \
"[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:8443	Admin panel URL with a literal IP" \
    | while IFS='	' read -r _pattern _desc; do
        [ -z "$_pattern" ] && continue
        _matches=$(printf '%s\n' "$_content" | grep -nE "$_pattern" 2>/dev/null | head -3)
        if [ -n "$_matches" ]; then
            # Findings go to STDOUT as data so the caller can print the header
            # first. Writing them straight to stderr here put the detail lines
            # above the "BLOCKED" banner.
            echo "  $_file — $_desc:"
            printf '%s\n' "$_matches" | sed 's/^/      line /'
        fi
    done
}

for FILE in $(git diff --cached --name-only --diff-filter=ACM); do
    case "$FILE" in
        # Binary and generated artefacts.
        *.dll|*.exe|*.pdf|*.png|*.jpg|*.jpeg|*.gif|*.ico|*.svg|*.woff|*.woff2|*.lock|*.map)
            continue ;;
        package-lock.json|composer.lock|*/package-lock.json|*/composer.lock)
            continue ;;
        # This hook, which necessarily contains every pattern it searches for.
        scripts/git-hooks/*)
            continue ;;
        # Fixtures and prose: high false-positive density, no real secrets.
        tests/*|*/tests/*|*Tests/*|*_test.*|*_spec.*|*.test.*|*.spec.*)
            continue ;;
        database/factories/*|database/seeders/*|lang/*|docs/*|docs-public/*|*/docs/*)
            continue ;;
    esac

    FINDINGS=$(cred_scan_file "$FILE")
    if [ -n "$FINDINGS" ]; then
        if [ "$CRED_HITS" -eq 0 ]; then
            echo "" >&2
            echo "=== BLOCKED: possible credentials in staged content ===" >&2
            echo "" >&2
        fi
        CRED_HITS=1
        printf '%s\n' "$FINDINGS" >&2
    fi
done

# Database dumps, by filename.
for FILE in $(git diff --cached --name-only --diff-filter=ACM); do
    case "$FILE" in
        *_dump.sql|*_backup.sql|*.dump|*prod*.sql)
            [ "$CRED_HITS" -eq 0 ] && echo "" >&2
            echo "  $FILE — looks like a database dump" >&2
            CRED_HITS=1
            ;;
    esac
done

if [ "$CRED_HITS" -ne 0 ]; then
    echo "" >&2
    echo "Commit BLOCKED. This repository is PUBLIC — remove the value, then" >&2
    echo "rotate it if it was ever real. Move real secrets to an untracked" >&2
    echo ".env or .secrets.local/." >&2
    echo "" >&2
    echo "If this is genuinely a false positive, --no-verify bypasses it — but" >&2
    echo "note that also bypasses the staged-PHP-test gate below, which must" >&2
    echo "never be bypassed. Prefer narrowing the exclusion list in this hook." >&2
    echo "" >&2
    exit 1
fi

#
# =============================================================================
# GATE B — Pre-commit verify-gate (test batches)
# =============================================================================
# Auto-generated/coverage test batches kept landing on `main` broken (failing
# tests) or inflating schema-skip debt, turning CI red. This gate runs two
# checks whenever PHP test files are staged:
#
#   1. Schema-skip budget ratchet (scripts/check-test-skip-budget.mjs) — static,
#      git-aware (counts tracked+staged only). Blocks if a staged test pushes the
#      schema-driven markTestSkipped count over the committed budget.
#   2. The staged test files themselves (phpunit) — blocks if any fail in
#      isolation. Skips gracefully when php/phpunit or the test DB are absent.
#
# Order-dependent failures that only appear in the full suite are NOT caught
# here; CI remains the backstop for those.
#
# A failure from THIS gate is always in a file you are committing — fix or drop
# it. Do NOT --no-verify past it (see AGENTS.md).
#

# Match phpunit.xml's own definition of a test file (suffix="Test.php"). The
# tests/ tree also holds ~28 base classes, traits and fixture helpers
# (tests/Laravel/TestCase.php, tests/Laravel/Concerns/*, tests/Laravel/Traits/*).
# Passing one of those to phpunit always fails with "Class X cannot be found",
# so the old '^tests/.*\.php$' pattern made it impossible to ever commit a test
# helper. Narrowing to *Test.php does not weaken the gate — every real test file
# staged in the commit still runs.
STAGED_TESTS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^tests/.*Test\.php$' || true)
[ -z "$STAGED_TESTS" ] && exit 0

# (1) Schema-skip budget — static, needs only node.
if command -v node >/dev/null 2>&1 && [ -f scripts/check-test-skip-budget.mjs ]; then
  BUDGET_OUT=$(node scripts/check-test-skip-budget.mjs 2>&1)
  if [ $? -ne 0 ]; then
    echo "$BUDGET_OUT" | tail -7 >&2
    echo "" >&2
    echo "pre-commit: schema-skip budget exceeded — commit BLOCKED." >&2
    echo " A staged test adds a markTestSkipped() guard for a missing table/column." >&2
    echo " The table likely exists — make it a real test or drop the guard." >&2
    echo " Do NOT --no-verify past this." >&2
    exit 1
  fi
fi

# (2) Run the staged test files — in the CONTAINER.
#
# 🔴 This ran on the HOST until 2026-08-22, and on a Windows dev box that meant
# it never ran at all. The condition was `command -v php` plus a host
# vendor/bin/phpunit, and AGENTS.md deliberately keeps neither: the host
# vendor/ is incomplete (no ext-gmp/pcntl/posix) and host PHPUnit produces
# dozens of false failures. So the guard below correctly declined to run — and
# nothing ran it anywhere else. The gate AGENTS.md calls the one gate that must
# never be bypassed was silently inert for months. Measured on this machine:
# php absent from PATH, no host vendor/bin/phpunit, so it took the skip branch
# on every commit.
#
# The container is the supported place to run PHPUnit, so ask it instead.
#
# 🔴 Note the scope limit this shares with the old host version: the container
# sees the WORKING TREE via its bind mount, not staged content. Gate A above
# reads `git show :FILE` and so cannot be dodged by editing after `git add`;
# this gate can. Narrowing that would mean materialising staged blobs into a
# temp tree, which is not worth it for a gate whose job is "does this test file
# pass at all" — CI re-runs it against the real commit regardless.
CONTAINER="${NEXUS_TEST_CONTAINER:-nexus-php-app}"

if ! docker exec "$CONTAINER" test -f vendor/bin/phpunit >/dev/null 2>&1; then
  echo "" >&2
  echo "==============================================================" >&2
  echo " pre-commit: cannot verify staged test file(s) — commit BLOCKED." >&2
  echo "" >&2
  echo " Container '$CONTAINER' is not running, or has no vendor/." >&2
  echo " Start Docker Desktop and retry:  docker compose up -d app" >&2
  echo "" >&2
  echo " 🔴 This BLOCKS rather than skips deliberately. 'I could not check'" >&2
  echo " reporting as 'this is fine' is exactly how this gate stayed inert" >&2
  echo " for months. If you genuinely cannot start Docker, --no-verify is" >&2
  echo " the deliberate override — but you are then committing an unverified" >&2
  echo " test file, so say so in the commit message." >&2
  echo "==============================================================" >&2
  exit 1
fi

echo "pre-commit: verifying staged test file(s) in $CONTAINER..."
echo "$STAGED_TESTS" | sed 's/^/  - /'
# APP_KEY: the container .env ships a dev placeholder that is NOT a valid
# base64 32-byte key, so anything touching Crypt dies with "Unsupported cipher
# or incorrect key length". This is the same fixed, non-secret test key
# phpunit.xml already declares (see AGENTS.md).
# BROADCAST_CONNECTION: routes/channels.php resolves the default broadcaster at
# route load and the pusher driver throws on a null key.
docker exec \
  -e MAIL_MAILER=array \
  -e BROADCAST_CONNECTION=null \
  -e APP_KEY="base64:HfQEDtbtr90JIXhsaAhSFWnzIo1f31VZ2e5qLqKKnls=" \
  "$CONTAINER" php vendor/bin/phpunit --no-coverage --stop-on-failure $STAGED_TESTS
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  echo "" >&2
  echo "==============================================================" >&2
  echo " Staged test file(s) FAILED — commit BLOCKED." >&2
  echo " These tests are part of THIS commit — fix or drop them." >&2
  echo " Do NOT bypass with --no-verify." >&2
  echo "==============================================================" >&2
  exit 1
fi

echo "pre-commit: staged tests pass + schema-skip budget OK — proceeding."
exit 0

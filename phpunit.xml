<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" executionOrder="depends,defects" requireCoverageMetadata="false" beStrictAboutCoverageMetadata="false" beStrictAboutOutputDuringTests="true" failOnRisky="true" failOnWarning="true" stopOnFailure="false">
  <testsuites>
    <testsuite name="Laravel">
      <directory suffix="Test.php">tests/Laravel</directory>
      <exclude>tests/Laravel/Migrated</exclude>
    </testsuite>
    <testsuite name="Integration">
      <directory suffix="Test.php">tests/Laravel/Integration</directory>
    </testsuite>
    <testsuite name="LaravelMigrated">
      <directory suffix="Test.php">tests/Laravel/Migrated</directory>
    </testsuite>
  </testsuites>
  <php>
    <!-- force: a Docker dev container exports APP_ENV=development, and without
         force PHPUnit leaves an already-set variable alone. Note force alone is
         NOT sufficient — PhpHandler writes putenv()/$_ENV but not $_SERVER, which
         is the adapter Laravel consults first; tests/bootstrap.php sets $_SERVER
         and is the authoritative fix. Both are kept so neither path regresses. -->
    <env name="APP_ENV" value="testing" force="true"/>
    <!-- Fixed test key (NOT a secret) so encryption/cookie/session tests don't throw
         MissingAppKeyException — the CI phpunit step never set APP_KEY (~107 errors). -->
    <env name="APP_KEY" value="base64:HfQEDtbtr90JIXhsaAhSFWnzIo1f31VZ2e5qLqKKnls=" force="true"/>
    <!-- DB_NAME takes precedence over DB_DATABASE in config/database.php.
         Both must be set to nexus_test to prevent RefreshDatabase from wiping the dev DB. -->
    <env name="DB_NAME" value="nexus_test" force="true"/>
    <env name="DB_DATABASE" value="nexus_test" force="true"/>
    <!-- The container defines CACHE_DRIVER=redis. Force the isolated array store
         before providers boot so named rate limiters retain their registrations
         without sharing counters across tests or PHPUnit runs. -->
    <env name="CACHE_DRIVER" value="array" force="true"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="MAIL_DRIVER" value="array"/>
    <!-- Laravel normalizes an unquoted `null` environment value to PHP null.
         Preserve the quotes so the configured no-op channel name is selected. -->
    <env name="LOG_CHANNEL" value="&quot;null&quot;"/>
    <!-- Tests must NOT instantiate the real Pusher broadcaster. PUSHER_* are
         unset in CI/test, so BroadcastServiceProvider::boot() resolving the
         default ('pusher') connection makes Pusher::__construct() throw on a
         null key, which errored ~8000 tests at bootstrap. The 'null' broadcaster
         (config/broadcasting.php) is the standard test driver. -->
    <env name="BROADCAST_CONNECTION" value="null"/>
  </php>
  <coverage>
    <report>
      <html outputDirectory="coverage/html"/>
      <clover outputFile="coverage/clover.xml"/>
      <cobertura outputFile="coverage/cobertura.xml"/>
      <text outputFile="coverage/coverage.txt"/>
    </report>
  </coverage>
  <source>
    <include>
      <directory suffix=".php">app</directory>
    </include>
  </source>
  <groups>
    <exclude>
      <group>slow</group>
      <group>external</group>
    </exclude>
  </groups>
</phpunit>

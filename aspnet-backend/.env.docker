# =============================================================================
# Docker Environment Variables for the ASP.NET backend
# =============================================================================
# Tracked, non-secret defaults. This file exists so a clean clone can run the
# Compose stack without first inventing values. It holds PLACEHOLDERS ONLY.
#
# Usage:
#   cp .env.docker .env
#   # edit .env and replace the placeholder below with a real generated secret
#   docker compose up -d
#
# .env is gitignored. Never commit real secrets to this file — it is public.
# =============================================================================

# JWT signing secret - MUST be at least 32 characters.
# Generate one with:
#   openssl rand -base64 32
#   head -c 32 /dev/urandom | base64
#
# REPLACE THIS. It is a placeholder, not a usable secret.
JWT_SECRET=REPLACE_ME_WITH_A_SECURE_32_CHAR_SECRET

# Note: the database connection is configured in compose.yml to use Docker
# networking (Host=db) and does not need to be set here for Docker.

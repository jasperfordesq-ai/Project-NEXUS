    "react-native-zoom-toolkit": "5.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tweetnacl": "1.0.3",
    "uniwind": "^1.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "lint-staged": "^17.6.0",
    "patch-package": "8.0.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "react-test-renderer": "19.3.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "shell-quote": "^1.11.0",

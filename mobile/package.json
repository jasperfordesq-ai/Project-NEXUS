    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-video": "~58.0.12",
    "heroui-native": "^1.0.11",
    "i18next": "^26.5.11",
    "marked": "18.1.2",
    "pusher-js": "^8.6.0",
    "query-string": "10.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-qrcode-svg": "6.3.32",
    "react-native-reanimated": "4.7.1",

    "browserslist": "^4.28.7",
    "decode-uri-component": "0.5.1",
    "fast-uri": "^3.1.6",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.10",
    "tar": "^7.5.16",
    "undici": "^6.27.0",
    "uuid": "^11.1.1",
    "ws@^6": "^6.2.4",
    "ws@^7": "^7.5.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": "echo type-check deferred to CI"
  }

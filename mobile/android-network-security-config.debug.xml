<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY Android network security configuration.

  🔴 THIS FILE IS NEVER PACKAGED INTO A RELEASE BUILD. The config plugin
  (plugins/with-android-network-security.js) writes it to
  `android/app/src/debug/res/xml/`, and Android's resource merging means the
  debug variant overrides `main`'s copy while release keeps the pinned,
  cleartext-forbidding config untouched. Verify with
  `npm run verify:network-security` before trusting that claim.

  WHY IT EXISTS

  The production config forbids cleartext for every variant, and a network
  security config OVERRIDES `android:usesCleartextTraffic` on API 24+. So the
  debug manifest's `usesCleartextTraffic="true"` was dead, and a debug build could
  not reach a local HTTP dev server — not the API on :8090, and not Metro on
  :8081. That made running the app against local data impossible on a device, and
  is the likeliest reason the Maestro suite was never run.

  WHAT IT PERMITS, AND WHAT IT DELIBERATELY DOES NOT

  Cleartext is permitted ONLY for the loopback and private-range hosts a
  development machine actually uses. It is NOT a blanket
  `cleartextTrafficPermitted="true"`, because that would let a debug build be
  pointed at any plaintext host on the internet and silently downgrade traffic.

  Certificate pinning for api.project-nexus.ie is deliberately NOT repeated here.
  A debug build must be able to talk to a proxy or a staging certificate; pinning
  in debug turns an ordinary networking problem into an unreadable handshake
  failure. Pinning is a production protection and lives in the production config.
-->
<network-security-config>
  <!-- Local development hosts only. 10.0.2.2 / 10.0.3.2 are the Android and
       Genymotion emulator aliases for the host machine's loopback; 192.168.x.x
       and 10.x.x.x cover a physical device on the same LAN as the dev machine. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">10.0.3.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
    <!-- The dev machine's LAN address. A release build refuses a loopback host
         (see lib/constants.ts isLoopbackHost), so a LAN address is the route for
         testing a release-like build against a local API. -->
    <domain includeSubdomains="true">192.168.0.0</domain>
    <domain includeSubdomains="true">192.168.1.0</domain>
  </domain-config>

  <!-- Everything else keeps the system trust store and NO cleartext, so a debug
       build still cannot silently talk plaintext to an arbitrary host. -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
      <!-- Debug builds additionally trust user-installed CAs so a local HTTPS
           proxy (mitmproxy, Charles) can be used when inspecting traffic. This
           is a debug-only capability and must never appear in the production
           config. -->
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>

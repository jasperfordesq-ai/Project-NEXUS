      "supportsTablet": false,
      "associatedDomains": [
        "applinks:app.project-nexus.ie"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a marketplace QR code when you choose to use the scanner.",
        "NSPhotoLibraryUsageDescription": "Choose a photo from your library for your profile or post.",
        "NSMicrophoneUsageDescription": "Record a voice message when you choose to send one.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#006FEE"
      },
      "package": "ie.project.nexus",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.project-nexus.ie"
            },
            {
              "scheme": "nexus"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock the Timebank Global session already saved on this device."
        }
      ],
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Timebank Global uses your location only when you choose to search nearby marketplace listings.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Timebank Global uses the camera only when you choose to scan marketplace QR codes."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#006FEE",
          "sounds": []
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "de",
              "en",
              "es",
              "fr",
              "ga",
              "it",
              "pt"
            ],
            "android": [
              "de",
              "en",
              "es",
              "fr",
              "ga",
              "it",
              "pt"
            ]
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "hour-timebank-clg",
          "project": "nexus-mobile",
          "url": "https://de.sentry.io/"
        }
      ],
      "./plugins/with-android-network-security",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          },
          "ios": {
            "deploymentTarget": "15.1",
            "privacyManifestAggregationEnabled": true
          }
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/90f411f3-b6b4-4251-85ad-00937bb0513d"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://api.project-nexus.ie",
      "defaultTenant": "hour-timebank",
      "router": {},
      "eas": {
        "projectId": "90f411f3-b6b4-4251-85ad-00937bb0513d"
      }
    }

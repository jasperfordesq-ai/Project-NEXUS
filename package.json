    "check:i18n:drift": "node scripts/check-i18n-drift.mjs",
    "check:i18n:literals": "node scripts/check-i18n-literals.mjs",
    "check:i18n:gaps": "node scripts/translate-i18n-gaps.mjs --summary",
    "check:i18n:status": "npm --prefix react-frontend run i18n:status",
    "check:i18n:stubs": "node scripts/check-i18n-stubs.mjs",
    "check:i18n:coverage": "node scripts/check-i18n-coverage.mjs",
    "check:i18n:vars": "node scripts/check-i18n-vars.mjs",
    "check:i18n:interpolation-parity": "npm --prefix react-frontend run i18n:interpolation-parity",
    "check:i18n:php": "node scripts/check-php-i18n-coverage.mjs && node scripts/check-govuk-alpha-translations.mjs",
    "check:test-skips": "node scripts/check-test-skip-budget.mjs",
    "check:events:e2e-quality": "node scripts/check-events-e2e-quality.mjs",
    "check:admin:breadcrumbs": "node scripts/check-admin-breadcrumbs.mjs",
    "check:i18n:types": "npm --prefix react-frontend run i18n:types",
    "check:i18n": "npm run check:i18n:json-integrity && npm run check:i18n:drift && npm run check:i18n:literals && npm run check:admin-i18n && npm run check:i18n:baseline && npm run check:i18n:stubs && npm run check:i18n:coverage && npm run check:i18n:vars && npm run check:i18n:interpolation-parity && npm run check:i18n:php",
    "check:docs": "node scripts/check-docs-hygiene.mjs",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:doc-scores": "node scripts/check-doc-scores.mjs",
    "check:changelog": "node scripts/check-changelog-updated.mjs",
    "check:db-columns": "node scripts/check-db-column-references.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "licenses:write": "node scripts/check-licenses.mjs --write",
    "translate:i18n:gaps": "node scripts/translate-i18n-gaps.mjs",
    "dev:docker": "docker compose --profile docker-php up -d app && npm --prefix react-frontend run dev:laravel -- --host 127.0.0.1 --port 5173 --strictPort",
    "dev:frontend": "npm --prefix react-frontend run dev:laravel -- --host 127.0.0.1 --port 5173 --strictPort",
    "dev:frontend:docker": "docker compose --profile docker-frontend up -d frontend",
    "build:accessible-frontend": "vite build --config vite.accessible-frontend.config.ts",
    "dev:accessible-frontend": "vite --config vite.accessible-frontend.config.ts --host 127.0.0.1 --port 5174",
    "build:govuk-alpha": "npm run build:accessible-frontend",
    "dev:govuk-alpha": "npm run dev:accessible-frontend",
    "test:govuk-alpha:php": "vendor\\bin\\phpunit --no-coverage --testsuite=Laravel --filter=GovukAlphaFrontendTest",
    "test:accessible-frontend:php": "npm run test:govuk-alpha:php",
    "test:govuk-alpha:a11y": "cd e2e && npx playwright test --config=playwright.alpha.config.ts",
    "test:accessible-frontend:a11y": "npm run test:govuk-alpha:a11y",
    "test:e2e": "npx playwright test",
    "test:events": "node scripts/test-events.mjs",
    "test:events:php": "node scripts/test-events.mjs --php-only",
    "test:events:react": "node scripts/test-events.mjs --react-only",
    "test:events:mobile": "node scripts/test-events.mjs --mobile-only",
    "test:events:e2e": "npx playwright test e2e/tests/events/events.spec.ts --project=chromium-modern",
    "test:events:e2e:enterprise": "npx playwright test --config=playwright.events-enterprise.config.ts --project=events-enterprise",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:auth": "npx playwright test --project=unauthenticated",
    "test:e2e:admin": "npx playwright test --project=admin",
    "test:e2e:firefox": "npx playwright test --project=firefox-modern",
    "test:e2e:mobile": "npx playwright test --project=mobile-chrome",
    "test:e2e:performance": "npx playwright test e2e/tests/performance/loading-budget.spec.ts --project=chromium-modern",
    "test:e2e:editor-isolation": "npx playwright test e2e/tests/performance/editor-isolation.spec.ts --project=chromium-modern",
    "test:e2e:pwa": "npx playwright test e2e/tests/pwa/offline-install.spec.ts --project=pwa",
    "audit:performance:routes": "node scripts/audit-performance-routes.mjs",
    "audit:performance:cache": "node scripts/audit-cache-headers.mjs",
    "test:e2e:report": "npx playwright show-report e2e/reports/html",
    "test:e2e:codegen": "npx playwright codegen http://localhost:5173/hour-timebank"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "dotenv": "^17.4.2",
    "govuk-frontend": "^6.1.0",
    "pa11y": "^9.1.1",
    "picocolors": "^1.1.1",
    "prisma": "^5.22.0",
